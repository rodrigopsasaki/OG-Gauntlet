;;-*-Lisp-*-
(in-package goal)
(bundles "GAME.CGO")
(require "engine/common-obs/nav-enemy.gc")
(require "pc/features/gauntlet-h.gc")

;; DECOMP BEGINS

;; gauntlet: a babak may be born charged with eco, on every level (babak.gc is in GAME.CGO). Blue runs at Jak faster, red
;; hits twice as hard and throws him far, the same as the stampede's red yakows. Which one is rolled once, in
;; nav-enemy-method-48, and kept here. See "the eco charge" in pc/features/gauntlet-h.gc.
;; The eco is stronger the weaker Jak is (gauntlet-desperation), so a charged babak re-reads its strength every frame
;; (babak-burn!): blue-pace is the speed it has at Jak's full health, run-pace the speed it runs at now.
;; The charge a babak wears is not fixed at birth any more, because on Misty Island it follows the muse (see "the muse" in gauntlet.gc): a babak
;; rolls two charges when it is born, born-charge (the chance babak-charge-chance) and mayhem-charge (the island's own chance, for a babak
;; that Misty placed), and wears the second while the muse is loose and the first otherwise. charge is the one it wears now. A babak that may
;; ever wear a charge has an info of its own (own-info), made once, at birth: the writes of babak-burn! go in it, and the shared one is never touched.
(deftype babak (nav-enemy)
  ((charge        gauntlet-eco)
   (born-charge   gauntlet-eco)
   (mayhem-charge gauntlet-eco)
   (own-info      symbol)
   (blue-pace     float)
   (run-pace      float))
  (:states
   babak-run-to-cannon))

(defskelgroup *babak-sg*
  babak
  babak-lod0-jg
  -1
  ((babak-lod0-mg (meters 20)) (babak-lod1-mg (meters 40)) (babak-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 2 0 3)
  :longest-edge (meters 1)
  :shadow babak-shadow-mg)

(defstate nav-enemy-patrol (babak)
  :virtual #t
  :code
    (behavior ()
      (cond
        ((ja-group? babak-give-up-hop-ja)
         (ja-channel-push! 1 (seconds 0.15))
         (ja-no-eval :group! babak-walk-ja :num! (seek!) :frame-num (ja-aframe 12.0 0))
         (until (ja-done? 0)
           (suspend)
           (ja :num! (seek!))))
        (else (ja-channel-push! 1 (seconds 0.2))))
      ((the-as (function none) (-> (method-of-type nav-enemy nav-enemy-patrol) code)))))

(defstate nav-enemy-chase (babak)
  :virtual #t
  :code
    (behavior ()
      ;; gauntlet: the run cycle plays run-pace times faster, which a babak that walks by its animation's own motion
      ;; (use-align in its info) covers as ground: 1.0 for a plain one, the blue speed for a blue one, times the desperation.
      ;; run-pace is read on every frame of the cycle, so a Jak who heals mid-chase calms the babak at once
      (let ((jitter (nav-enemy-rnd-float-range 0.9 1.1)))
        (cond
          ((ja-group? babak-jump-land-ja)
           (ja-no-eval :num! (seek!))
           (ja-channel-push! 1 (seconds 0.17))
           (ja-no-eval :group! (-> self draw art-group data (-> self nav-info run-anim)) :num! (seek! max (* (-> self run-pace) jitter)) :frame-num 0.0)
           (until (ja-done? 0)
             (ja-blend-eval)
             (suspend)
             (ja :num! (seek! max (* (-> self run-pace) jitter)))))
          (else
           (ja-channel-push! 1 (seconds 0.2))
           (ja :group! (-> self draw art-group data (-> self nav-info run-anim)))
           (ja :num-func num-func-identity :frame-num 0.0)))
        (loop
          (suspend)
          (ja :num! (loop! (* (-> self run-pace) jitter)))))))

(defstate nav-enemy-stare (babak)
  :virtual #t
  :code
    (behavior ()
      (set! (-> self turn-time) (seconds 0.2))
      (let ((f30-0 (nav-enemy-rnd-float-range 0.8 1.2)))
        (when (or (logtest? (-> self nav-enemy-flags) (nav-enemy-flags navenmf8))
                  (and (nav-enemy-player-vulnerable?) (nav-enemy-rnd-percent? 0.5)))
          (ja-channel-push! 1 (seconds 0.1))
          (ja-no-eval :group! babak-win-ja :num! (seek! (ja-aframe 68.0 0) f30-0) :frame-num 0.0)
          (until (ja-done? 0)
            (suspend)
            (ja :num! (seek! (ja-aframe 68.0 0) f30-0))))
        (loop
          (when (not (nav-enemy-facing-player? 2730.6667))
            (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
            (ja-no-eval :num! (loop!))
            (ja-channel-push! 1 (seconds 0.2))
            (ja :group! babak-turn-ja)
            (ja :num-func num-func-identity :frame-num 0.0)
            (until (nav-enemy-facing-player? 1820.4445)
              (ja-blend-eval)
              (suspend)
              (ja :num! (loop! 0.75)))
            (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel)))
          (if (not (ja-group? babak-idle-ja)) (ja-channel-push! 1 (seconds 0.2)))
          (ja-no-eval :group! babak-idle-ja :num! (seek! max f30-0) :frame-num 0.0)
          (until (ja-done? 0)
            (suspend)
            (ja :num! (seek! max f30-0)))
          (when (nav-enemy-rnd-percent? 0.3)
            (ja-channel-push! 1 (seconds 0.1))
            (ja-no-eval :group! babak-win-ja :num! (seek! (ja-aframe 68.0 0) f30-0) :frame-num 0.0)
            (until (ja-done? 0)
              (suspend)
              (ja :num! (seek! (ja-aframe 68.0 0) f30-0))))))))

(defstate nav-enemy-give-up (babak)
  :virtual #t
  :code
    (behavior ()
      (set! (-> self rotate-speed) 218453.33)
      (set! (-> self turn-time) (seconds 0.5))
      (ja-channel-push! 1 (seconds 0.15))
      (let ((s4-0 (-> self collide-info))
            (s5-0 (target-pos 0)))
        (when (< (fabs (deg-diff (y-angle s4-0) (vector-y-angle (vector-! (new 'stack-no-clear 'vector) s5-0 (-> s4-0 trans)))))
                 12743.111)
          (ja-no-eval :group! babak-give-up-ja :num! (seek!) :frame-num 0.0)
          (until (ja-done? 0)
            (suspend)
            (ja :num! (seek!)))))
      (logclear! (-> self nav flags) (nav-control-flags navcf17 navcf19))
      (nav-enemy-get-new-patrol-point)
      (ja-no-eval :group! babak-give-up-hop-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (seek-to-point-toward-point! (-> self collide-info)
                                     (-> self nav destination-pos)
                                     (-> self rotate-speed)
                                     (-> self turn-time))
        (suspend)
        (ja :num! (seek!)))
      (go-virtual nav-enemy-patrol)))

(defstate nav-enemy-jump-land (babak)
  :virtual #t
  :code
    (behavior ()
      (ja-no-eval :num! (seek!))
      (ja-channel-push! 1 (seconds 0.075))
      (ja-no-eval :group!
                  (-> self draw art-group data (-> self nav-info jump-land-anim))
                  :num!
                  (seek! (ja-aframe 32.0 0) 0.5)
                  :frame-num 0.0)
      (until (ja-done? 0)
        (ja-blend-eval)
        (suspend)
        (ja :num! (seek! (ja-aframe 32.0 0) 0.5)))
      (go-virtual nav-enemy-chase)))

(define *babak-nav-enemy-info*
  (new 'static
       'nav-enemy-info
       :idle-anim 5
       :walk-anim 6
       :turn-anim 16
       :notice-anim 7
       :run-anim 8
       :jump-anim 13
       :jump-land-anim 14
       :victory-anim 11
       :taunt-anim 11
       :die-anim 12
       :neck-joint 5
       :player-look-at-joint 5
       :run-travel-speed (meters 6)
       :run-rotate-speed (degrees 2880)
       :run-acceleration (meters 1)
       :run-turn-time (seconds 0.1)
       :walk-travel-speed (meters 3)
       :walk-rotate-speed (degrees 720)
       :walk-acceleration (meters 1)
       :walk-turn-time (seconds 0.5)
       :attack-shove-back (meters 3)
       :attack-shove-up (meters 2)
       :shadow-size (meters 2)
       :notice-nav-radius (meters 2)
       :nav-nearest-y-threshold (meters 10)
       :notice-distance (meters 30)
       :proximity-notice-distance (meters 20)
       :stop-chase-distance (meters 40)
       :frustration-distance (meters 8)
       :frustration-time (seconds 4)
       :die-anim-hold-frame 24.0
       :jump-anim-start-frame 10.0
       :jump-land-anim-end-frame 10000000000.0
       :jump-height-min (meters 3)
       :jump-height-factor 0.5
       :jump-start-anim-speed 1.0
       :shadow-max-y (meters 1)
       :shadow-min-y (meters -1)
       :shadow-locus-dist (meters 150)
       :use-align #t
       :draw-shadow #t
       :move-to-ground #t
       :hover-if-no-ground #f
       :use-momentum #f
       :use-flee #t
       :use-proximity-notice #t
       :use-jump-blocked #t
       :use-jump-patrol #f
       :gnd-collide-with (collide-kind background)
       :debug-draw-neck #f
       :debug-draw-jump #f))

(defmethod initialize-collision ((this babak))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) default-collision-reaction)
    (set! (-> s5-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 3) 0)))
      (set! (-> s4-0 prim-core collide-as) (collide-kind enemy))
      (set! (-> s4-0 collide-with) (collide-kind target))
      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set-vector! (-> s4-0 local-sphere) 0.0 8192.0 0.0 12288.0)
      (set-root-prim! s5-0 s4-0)
      (let ((s3-0 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 3))))
        (set! (-> s3-0 prim-core collide-as) (collide-kind enemy))
        (set! (-> s3-0 collide-with) (collide-kind target))
        (set! (-> s3-0 prim-core action) (collide-action solid))
        (set! (-> s3-0 prim-core offense) (collide-offense touch))
        (set-vector! (-> s3-0 local-sphere) 0.0 4096.0 0.0 3072.0)
        (append-prim s4-0 s3-0))
      (let ((s3-1 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 3))))
        (set! (-> s3-1 prim-core collide-as) (collide-kind enemy))
        (set! (-> s3-1 collide-with) (collide-kind target))
        (set! (-> s3-1 prim-core action) (collide-action solid))
        (set! (-> s3-1 prim-core offense) (collide-offense touch))
        (set-vector! (-> s3-1 local-sphere) 0.0 9830.4 0.0 3072.0)
        (append-prim s4-0 s3-1))
      (let ((s3-2 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 1))))
        (set! (-> s3-2 prim-core collide-as) (collide-kind enemy))
        (set! (-> s3-2 collide-with) (collide-kind target))
        (set! (-> s3-2 prim-core offense) (collide-offense normal-attack))
        (set! (-> s3-2 transform-index) 6)
        (set-vector! (-> s3-2 local-sphere) 0.0 0.0 0.0 2048.0)
        (append-prim s4-0 s3-2)))
    (set! (-> s5-0 nav-radius) 6144.0)
    (backup-collide-with-as s5-0)
    (set! (-> s5-0 max-iteration-count) (the-as uint 2))
    (set! (-> this collide-info) s5-0))
  0
  (none))

;; gauntlet: the charge a babak should wear now: the mayhem's while the muse is loose and the babak is Misty's, else the one it was born with.
(defun babak-charge-want ((this babak))
  (if (gauntlet-mayhem-for? this) (-> this mayhem-charge) (-> this born-charge)))

;; gauntlet: bring the charge a babak wears to the one it should wear, if they differ: the pace it has at full health (blue is the blue speed, the others
;; the game's own), the glow (the eco's, or the game's plain look). Called every frame it is posted and when a hit is dealt, and
;; by gauntlet-babak-sync for the babaks asleep, which are not posted.
(defun babak-charge-sync! ((this babak))
  (let ((want (babak-charge-want this)))
    (when (!= want (-> this charge))
      (set! (-> this charge) want)
      (set! (-> this blue-pace) (if (= want (gauntlet-eco blue)) *gauntlet-babak-blue-speed* 1.0))
      (cond
        ((= want (gauntlet-eco none))
         (set-vector! (-> this draw color-mult) 1.0 1.0 1.0 1.0)
         (set-vector! (-> this draw color-emissive) 0.0 0.0 0.0 0.0))
        (else (gauntlet-eco-glow! this want)))))
  0)

;; gauntlet: one frame of the babak's strength and pace. A blue one runs blue-pace times the desperation faster than a
;; plain one (the multiplier itself is scaled), and the info says the same of its run speed and acceleration, which the
;; rest of nav-enemy reads (an align babak does not move by them); a red one throws Jak the red distance times the
;; desperation, and any other the game's own distance, so a babak that has been calmed is plain again. Only a babak with an info of its
;; own (see nav-enemy-method-48) has one to write in, the shared one is never touched.
;; On Misty Island, while the muse is loose, every babak (a plain one too: its run cycle is all it has) runs misty-pace times
;; faster again, on top of whatever the eco and the desperation make of it: they compose by multiplication. The cannon babak
;; is left as the game made it.
(defun babak-burn! ((this babak))
  (babak-charge-sync! this)
  (let ((strength (gauntlet-desperation))
        (mayhem (if (= (-> this type) babak) (gauntlet-misty-pace this) 1.0)))
    (set! (-> this run-pace) (* (-> this blue-pace) mayhem))
    (case (-> this charge)
      (((gauntlet-eco blue))
       (set! (-> this run-pace) (* (-> this run-pace) strength))))
    (when (-> this own-info)
      (set! (-> this nav-info run-travel-speed) (* (-> *babak-nav-enemy-info* run-travel-speed) (-> this run-pace)))
      (set! (-> this nav-info run-acceleration) (* (-> *babak-nav-enemy-info* run-acceleration) (-> this run-pace)))
      (case (-> this charge)
        (((gauntlet-eco red))
         (set! (-> this nav-info attack-shove-back) (* GAUNTLET_ECO_RED_SHOVE_BACK strength))
         (set! (-> this nav-info attack-shove-up) (* GAUNTLET_ECO_RED_SHOVE_UP strength)))
        (else
         (set! (-> this nav-info attack-shove-back) (-> *babak-nav-enemy-info* attack-shove-back))
         (set! (-> this nav-info attack-shove-up) (-> *babak-nav-enemy-info* attack-shove-up))))))
  0)

(defun babak-roll-charge ((chance float))
  "A charge for a babak being born: with the chance given, red or blue by the toss of a coin, else none."
  (if (rand-vu-percent? chance)
    (if (rand-vu-percent? 0.5) (gauntlet-eco blue) (gauntlet-eco red))
    (gauntlet-eco none)))

;; gauntlet: the muse tells every babak in the pool that her state has changed, so that the ones asleep (which are not posted, and so would
;; keep the colour they had) change with the rest.
(defun gauntlet-babak-sync ((proc process))
  (let ((babak (as-type proc babak)))
    (if babak (babak-burn! babak)))
  (none))

;; gauntlet: whether proc is a babak that wears an eco now, for the mod's tint of Misty's lurkers (which leaves a charged one to its own glow)
(defun gauntlet-babak-charged? ((proc process))
  (let ((babak (as-type proc babak)))
    (and babak (!= (-> babak charge) (gauntlet-eco none)))))

;; gauntlet: only a plain babak, the type itself, is charged. babak-with-cannon shares this method but is left as the game
;; made it: never charged, its run-pace 1.0. Both charges are rolled here, once, and the info is copied here, once: a copy made later,
;; in some other process's turn, would take memory from a heap that is full by then. A babak the island placed rolls the island's chance
;; as well as babak-charge-chance (with the muse's setting off the island has none, and the second is the first).
(defmethod nav-enemy-method-48 ((this babak))
  (initialize-skeleton this *babak-sg* '())
  (set! (-> this charge) (gauntlet-eco none))
  (set! (-> this born-charge) (gauntlet-eco none))
  (set! (-> this mayhem-charge) (gauntlet-eco none))
  (set! (-> this own-info) #f)
  (set! (-> this run-pace) 1.0)
  (set! (-> this blue-pace) 1.0)
  ;; a babak that may wear a charge has an info of its own, a copy on its own heap, so the shared one the others read is never touched
  (let ((info *babak-nav-enemy-info*))
    (when (and *gauntlet-babak-charge-enabled* (= (-> this type) babak))
      (set! (-> this born-charge) (babak-roll-charge *gauntlet-babak-charge-chance*))
      (set! (-> this mayhem-charge)
            (if (and *gauntlet-misty-muse-enabled* (-> this entity) (= (-> this entity extra level name) 'misty))
              (babak-roll-charge *gauntlet-misty-mayhem-charge-chance*)
              (-> this born-charge)))
      (when (or (!= (-> this born-charge) (gauntlet-eco none)) (!= (-> this mayhem-charge) (gauntlet-eco none)))
        (set! info (copy info 'process))
        (set! (-> this own-info) #t)))
    (init-defaults! this info)
    ;; the charge it wears now, and so its glow, its speed and its shove: red is strength (it throws Jak as far as a red yakow does, and its touch
    ;; costs a second hit: nav-enemy-touch-handler and touch-handler below), blue is speed (the run cycle plays faster, run-pace, and the info says the same of
    ;; its run speed and acceleration, which the rest of nav-enemy reads; an align babak does not move by them)
    (babak-burn! this))
  (set! (-> this neck up) (the-as uint 0))
  (set! (-> this neck nose) (the-as uint 1))
  (set! (-> this neck ear) (the-as uint 2))
  0
  (none))

(defmethod nav-enemy-method-59 ((this babak))
  (cond
    ((and (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))
          (logtest? (-> this enemy-info options) (fact-options has-power-cell)))
     (go (method-of-object this nav-enemy-fuel-cell)))
    ((logtest? (-> this enemy-info options) (fact-options fop5)) (go (method-of-object this nav-enemy-wait-for-cue)))
    (else (go (method-of-object this nav-enemy-idle))))
  0
  (none))

;; gauntlet: the info a babak copied for itself lives on its own heap, so when the process moves (nav-enemy's relocate does
;; the same for the neck joint-mod and the random generator) the pointer to it moves with it. The shared info is static.
(defmethod relocate ((this babak) (offset int))
  (if (-> this own-info)
    (set! (-> this nav-info) (the-as nav-enemy-info (+ (the-as int (-> this nav-info)) offset))))
  (call-parent-method this offset))

;; gauntlet: the strength and the aura of a charged babak, every frame it is posted. A babak waiting in its idle state is
;; not posted by common-post, so it glows but does not spark until it wakes.
(defmethod common-post ((this babak))
  (babak-burn! this)
  (gauntlet-eco-aura! this (-> this charge))
  (call-parent-method this)
  (none))

(defun babak-follow-through ((this babak) (victim process) (landed object))
  "Whether the hit a touch just tried landed on victim, handed back as it came; a red babak's that did land costs a second hit."
  (if (and landed (= (-> this charge) (gauntlet-eco red))) (gauntlet-eco-second-hit! victim))
  landed)

(defmethod touch-handler ((this babak) (arg0 process) (arg1 event-message-block))
  (babak-burn! this)
  (babak-follow-through this arg0 (call-parent-method this arg0 arg1)))

(defmethod nav-enemy-touch-handler ((this babak) (arg0 process) (arg1 event-message-block))
  (babak-burn! this)
  (babak-follow-through this arg0 (call-parent-method this arg0 arg1)))
