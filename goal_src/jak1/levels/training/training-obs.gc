(deftype scarecrow-a (process-drawable)
  ((root                collide-shape :override)
   (incomming-attack-id uint64)
   (intersection        vector :inline)
   (sage                handle))
  (:state-methods
   idle
   (hit float vector symbol)))


(deftype scarecrow-b (process-drawable)
  ((root                collide-shape :override)
   (incomming-attack-id uint64)
   (intersection        vector :inline)
   (sage                handle))
  (:state-methods
   idle
   (hit float vector symbol)))


;; gauntlet: the training dummies turn on Jak. The knobs for how hard they shoot are globals, with their defaults, in
;; pc/features/gauntlet-h.gc; the gauntlet console steers them live.
(defconstant GAUNTLET_HERALD_DUMMY "scarecrow-a-1") ;; entity name of the dummy that heralds the rest, which wakes from further away

;; gauntlet: Jak's yellow eco shot, turned around. It flies straight along the heading it was
;; fired on and hits Jak (plus walls). Jak's own projectile-yellow is untouched.
(deftype gauntlet-shot (projectile-yellow)
  ())


(defmethod projectile-method-26 ((this gauntlet-shot))
  "Collide with Jak and walls only. Leaving enemy out is what stops the shot from ever hitting the dummy that fired it."
  ((method-of-type projectile-yellow projectile-method-26) this)
  (set! (-> this root root-prim collide-with) (collide-kind background target))
  (backup-collide-with-as (-> this root))
  (none))

(defmethod projectile-method-27 ((this gauntlet-shot))
  "The launch flash points where the root faces, and a dummy does not face Jak, so face along the flight."
  (quaternion-vector-angle! (-> this root quat) (new 'static 'vector :y 1.0 :w 1.0) (vector-y-angle (-> this root transv)))
  ((method-of-type projectile-yellow projectile-method-27) this)
  (none))

(defmethod projectile-method-28 ((this gauntlet-shot))
  "Jak's shot searches for the nearest enemy to home on. This one keeps the point fixed at launch, so it flies straight."
  (set! (-> this target quad) (-> this target-base quad))
  (none))

;; The sage's art group is made common (GAME.CGO, see common_art_groups in the decompiler config), so he is
;; available on Geyser Rock even though yellowsage-ag.go originally ships in CIT.DGO only.
;; Common art registers in the default level, so he must look there (texture-level 2), not in the
;; level of the dummy's entity, or initialize-skeleton fails to find his art group.
;; Sort 1 is the pris (character) draw group, as for Jak, the sidekick and the other common characters.
;; No :shadow. His shadow mesh is the heaviest in the game (335 double edges, the next is 225). The EE writes the
;; silhouette edge list for the shadow VU1 with an 8-bit VIF NUM field (shadow-add-double-edges), which wraps once
;; 252 entries are listed; gk's ShadowRenderer then asserts offset + 16 == next.size_bytes. In his bind pose he
;; already lists 166 to 215 entries whichever way the light points, so a posed body leaves little room.
(defskelgroup *gauntlet-yellowsage-sg*
  yellowsage
  yellowsage-lod0-jg
  yellowsage-yellowsage-idle-ja
  ((yellowsage-lod0-mg (meters 20)) (yellowsage-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3)
  :texture-level 2
  :sort 1)

(deftype gauntlet-volley (structure)
  ((start-time     time-frame)
   (next-shot-time time-frame)
   (size           int32)
   (shots-left     int32)
   (sweep          float)
   (heading        vector :inline)
   (muzzle         vector :inline)))


;; The sage is the brain: range, puff, volleys, leaving. His body is a manipy (see gauntlet-sage-init-by-other),
;; the game's own way to put a character from code on screen, so the sage has no skeleton or draw-control of his own.
(deftype gauntlet-sage (process-drawable)
  ((volley       gauntlet-volley :inline)
   (appear-range float)
   (leave-range  float)
   (body         handle))
  (:states
   gauntlet-sage-attack
   gauntlet-sage-vanish))

(defconstant GAUNTLET_SAGE_ORIGIN_JOINT 3) ;; every sage in the game is drawn and culled around his main joint (process-taskable-method-40)

;; The telegraph. His three anims, measured from yellowsage-ag.go and the game log: idle 151 frames, attack-start 9,
;; attack-loop 31, all playing at 15 frames a second. A 'play anim is done at its length minus 2, so the wind-up is
;; 7 frames: 0.47 s.
(defconstant GAUNTLET_SAGE_WINDUP (seconds 0.47)) ;; attack-start, from the moment it is asked for to its done
(defconstant GAUNTLET_SAGE_PUFF_CLEAR (seconds 0.5)) ;; the smoke of his appearing hides him this long, so the first wind-up waits


(defun gauntlet-jak-in-range? ((source process-drawable) (range float))
  "True while Jak is within range of source."
  (and *target* (>= range (vector-vector-distance (-> source root trans) (-> *target* control trans)))))

(defun gauntlet-jak-shootable? ()
  "True while Jak is in a state worth shooting at: not mid-hit, invulnerable, in a cutscene or dying."
  (and *target*
       (not (logtest? (-> *target* state-flags)
                      (state-flags being-attacked invulnerable timed-invulnerable invuln-powerup do-not-notice dying)))))

(defun gauntlet-puff ((where vector))
  "A burst of yellow eco at chest height over where: the sage appearing and vanishing."
  (let ((burst-at (new 'stack-no-clear 'vector)))
    (set! (-> burst-at quad) (-> where quad))
    (+! (-> burst-at y) 6144.0)
    (process-spawn part-tracker :init part-tracker-init group-part-yellow-eco-fireball-hit -1 #f #f #f burst-at :to *entity-pool*))
  0)

(defun gauntlet-volley-start ((volley gauntlet-volley) (origin vector))
  "Capture the aim at Jak once. The whole volley sweeps around this heading, it is not re-aimed per shot.
   Shots leave from origin (the cane) on a level line toward Jak, like every shooting enemy in the game."
  (let ((heading (-> volley heading)))
    (set! (-> heading quad) (-> (target-pos 0) quad))
    (vector-! heading heading origin)
    ;; level on purpose: this is the tutorial, the shot does not track Jak's height. A shot can pass under or over him
    ;; when he stands higher or lower than the cane, and the player learns the pattern and adjusts. The sweep (a
    ;; rotation about world y) keeps it level.
    (set! (-> heading y) 0.0)
    (vector-normalize! heading 1.0))
  ;; the shots always leave from the cane, wherever Jak stands
  (set! (-> volley muzzle quad) (-> origin quad))
  ;; alternate left-to-right and right-to-left, like a sprinkler
  (set! (-> volley sweep) (if (> (-> volley sweep) 0.0) -1.0 1.0))
  (set! (-> volley size) *gauntlet-dummy-volley-size*)
  (set! (-> volley shots-left) (-> volley size))
  (set-time! (-> volley start-time))
  0)

(defun gauntlet-volley-fire-next ((source process-drawable) (volley gauntlet-volley))
  "Fire the next shot of the volley on the captured heading."
  (let ((shot-heading (new 'stack-no-clear 'vector))
        (velocity (new 'stack-no-clear 'vector))
        (index (- (-> volley size) (-> volley shots-left))))
    (vector-rotate-y! shot-heading
                      (-> volley heading)
                      (* (-> volley sweep)
                         *gauntlet-dummy-volley-spread*
                         (- (the float index) (* 0.5 (the float (+ (-> volley size) -1))))))
    (vector-float*! velocity shot-heading *gauntlet-dummy-shot-speed*)
    (process-spawn gauntlet-shot :init projectile-init-by-other (-> source entity) (-> volley muzzle) velocity 0 #f :to source))
  (+! (-> volley shots-left) -1)
  (set-time! (-> volley next-shot-time))
  0)

(defun gauntlet-volley-update ((source process-drawable) (volley gauntlet-volley) (origin vector) (range float))
  "One frame of a volley leaving origin: start one every interval, then fire its shots one gap apart.
   If Jak leaves range or stops being shootable, the rest of the volley is dropped."
  (cond
    ((not (and (gauntlet-jak-in-range? source range) (gauntlet-jak-shootable?))) (set! (-> volley shots-left) 0))
    ((> (-> volley shots-left) 0)
     (if (time-elapsed? (-> volley next-shot-time) *gauntlet-dummy-volley-gap*) (gauntlet-volley-fire-next source volley)))
    ((time-elapsed? (-> volley start-time) *gauntlet-dummy-volley-interval*)
     (gauntlet-volley-start volley origin)
     (gauntlet-volley-fire-next source volley)))
  0)

;; His body. A manipy is how the game draws a character from code (finalboss spawns these very sages as manipys, with
;; exactly these events); it carries the setup a hand-written process-drawable lacks: eye and blend-shape status, the
;; origin joint, and a code loop that runs the joint math and animation channels.
(defun gauntlet-sage-body ((body handle))
  "The manipy that draws the sage, or #f once it is gone."
  (let ((proc (handle->process body)))
    (the-as manipy (if (and proc (type-type? (-> proc type) manipy)) proc))))

(defbehavior gauntlet-sage-play gauntlet-sage ((anim string) (mode symbol) (blend time-frame))
  "Have his body play anim through manipy's own events: mode 'play runs it once, 'loop runs it forever.
   The name is looked up here as well, the way manipy will look it up, because manipy keeps the current anim
   without a word when a name finds nothing. One GAUNTLET SAGE line per call says what was found."
  (let ((body (gauntlet-sage-body (-> self body))))
    (when body
      (let ((found (the-as art-joint-anim (lookup-art (-> body draw art-group) anim art-joint-anim))))
        (if found
          (format 0 "GAUNTLET SAGE pid ~D anim ~A (~D frames)~%" (-> self pid) anim (-> found data 0 length))
          (format 0 "GAUNTLET SAGE pid ~D anim ~A NOT FOUND in the body's art group~%" (-> self pid) anim)))
      (send-event body 'anim-mode mode)
      (send-event body 'art-joint-anim anim blend)))
  0)

(defbehavior gauntlet-sage-anim-done? gauntlet-sage ()
  "True once the 'play anim he was last asked for has reached its end. The body takes a new anim up a frame
   after being asked, so it must really be showing the anim asked for, or 'done would be answered for the previous one."
  (let ((body (gauntlet-sage-body (-> self body))))
    (and body
         (> (-> body skel active-channels) 0)
         (= (-> body skel root-channel 0 frame-group) (-> body new-joint-anim))
         (send-event body 'query 'done))))

(defbehavior gauntlet-sage-can-shoot? gauntlet-sage ()
  "True while Jak is where this sage fires at him."
  (and (gauntlet-jak-in-range? self (-> self appear-range)) (gauntlet-jak-shootable?)))

(defbehavior gauntlet-sage-cane gauntlet-sage ((out vector))
  "Where the cane's exhaust is in the world, which is where the volleys leave. Falls back to where he stands."
  (set! (-> out quad) (-> self root trans quad))
  (let ((body (gauntlet-sage-body (-> self body))))
    (when body
      (vector<-cspace! out (-> body node-list data (joint-node-index yellowsage-lod0-jg caneExhaust)))))
  out)

(defun gauntlet-sage-feet ((body manipy) (out vector))
  "Where his feet are in the world: the lowest of his two toe-ball joints in height, and halfway between them
   on the ground plane. Falls back to the body's own root while the skeleton is not up."
  (set! (-> out quad) (-> body root trans quad))
  (let ((nodes (-> body node-list))
        (left (new 'stack-no-clear 'vector))
        (right (new 'stack-no-clear 'vector)))
    (when (and (< (joint-node-index yellowsage-lod0-jg Lball) (-> nodes length))
               (< (joint-node-index yellowsage-lod0-jg Rball) (-> nodes length)))
      (vector<-cspace! left (-> nodes data (joint-node-index yellowsage-lod0-jg Lball)))
      (vector<-cspace! right (-> nodes data (joint-node-index yellowsage-lod0-jg Rball)))
      (set! (-> out x) (* 0.5 (+ (-> left x) (-> right x))))
      (set! (-> out y) (fmin (-> left y) (-> right y)))
      (set! (-> out z) (* 0.5 (+ (-> left z) (-> right z))))))
  out)

(defbehavior gauntlet-sage-plant gauntlet-sage ()
  "Stand his body on the spot he appears at. His attack anims come from the Citadel scene and are authored around a
   different origin (his main joint plays about 7 m below the body's root), so his feet are read off the skeleton and the
   body's root is moved by however far they are from the ground. The skeleton he is read from was posed from the root
   as set last frame, so the correction is exact and stays put once he is planted, for either of his anims."
  (let ((body (gauntlet-sage-body (-> self body))))
    ;; was-drawn is the sign that the body has been posed at least once, so the joints are real
    (when (and body (nonzero? (-> body draw)) (logtest? (-> body draw status) (draw-status was-drawn)))
      (let ((feet (new 'stack-no-clear 'vector))
            (planted (new 'stack-no-clear 'vector)))
        (gauntlet-sage-feet body feet)
        (vector-! planted (-> self root trans) feet)
        (vector+! planted planted (-> body root trans))
        (set! (-> planted w) 1.0)
        (send-event body 'trans planted))))
  0)

(defstate gauntlet-sage-attack (gauntlet-sage)
  :trans
    (behavior ()
      (let ((body (gauntlet-sage-body (-> self body))))
        ;; no body, no sage
        (if (or (not body) (not (gauntlet-jak-in-range? self (-> self leave-range))))
          (go gauntlet-sage-vanish))
        (seek-to-point-toward-point! (-> self root) (target-pos 0) 524288.0 (seconds 0.1))
        (send-event body 'rot-quat (-> self root quat))
        (gauntlet-sage-plant)))
  :code
    (behavior ()
      ;; Every volley is announced. He stands in his idle, winds up with attack-start so that the wind-up ends on the
      ;; volley's first shot, holds attack-loop while the shots fly and drops back to idle after the last one. The
      ;; volley itself is the dummies' (gauntlet-volley-start and -fire-next, aimed and swept the same way); only the
      ;; timing around it is the sage's own, because the telegraph has to come before the first shot.
      (gauntlet-sage-play "yellowsage-yellowsage-idle" 'loop 0)
      ;; his first volley is due as soon as the smoke has cleared
      (set! (-> self volley start-time) (- (current-time) *gauntlet-dummy-volley-interval*))
      (suspend-for GAUNTLET_SAGE_PUFF_CLEAR)
      (loop
        ;; The wind-up starts one wind-up early, so its end meets the moment the volley is due. When the interval is
        ;; shorter than the wind-up it starts at once and the volley simply waits for it.
        (until (and (gauntlet-sage-can-shoot?)
                    (time-elapsed? (-> self volley start-time) (max 0 (- *gauntlet-dummy-volley-interval* GAUNTLET_SAGE_WINDUP))))
          (suspend))
        (gauntlet-sage-play "yellowsage-yellowsage-attack-start" 'play (seconds 0.1))
        ;; one frame for the body to take the new anim up, so 'done is asked of the right one
        (suspend)
        (let ((asked-at (current-time)))
          ;; the timeout is for an anim that is not there: he would otherwise wait for the wrong one to end
          (until (or (gauntlet-sage-anim-done?) (time-elapsed? asked-at (seconds 2.0)))
            (suspend)))
        (cond
          ((gauntlet-sage-can-shoot?)
           (gauntlet-sage-play "yellowsage-yellowsage-attack-loop" 'loop 0)
           ;; shots leave from his cane, where the Citadel beam starts
           (gauntlet-volley-start (-> self volley) (gauntlet-sage-cane (new 'stack-no-clear 'vector)))
           (gauntlet-volley-fire-next self (-> self volley))
           (while (> (-> self volley shots-left) 0)
             (gauntlet-volley-update self (-> self volley) (gauntlet-sage-cane (new 'stack-no-clear 'vector)) (-> self appear-range))
             (suspend)))
          ;; Jak was hit or left while he wound up: no volley, and the next wind-up waits its turn
          (else (set-time! (-> self volley start-time))))
        (gauntlet-sage-play "yellowsage-yellowsage-idle" 'loop (seconds 0.15)))))

(defstate gauntlet-sage-vanish (gauntlet-sage)
  :code
    (behavior ()
      (gauntlet-puff (-> self root trans))
      (cleanup-for-death self)))

(defbehavior gauntlet-sage-init-by-other gauntlet-sage ((dummy process-drawable) (appear-range float) (leave-range float))
  "Appear where the dummy stands, facing Jak. He fires while Jak is within appear-range and leaves beyond leave-range."
  (set! (-> self appear-range) appear-range)
  (set! (-> self leave-range) leave-range)
  (set! (-> self body) (the-as handle #f))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> dummy root trans quad))
  (quaternion-copy! (-> self root quat) (-> dummy root quat))
  (vector-identity! (-> self root scale))
  (point-toward-point! (-> self root) (target-pos 0))
  ;; He is not a placed actor, and his body is not either: no entity, so his draw is filed under the default level
  ;; (engine, light and shadow settings), where common art like Jak's lives.
  (set! (-> self entity) #f)
  (let ((body (manipy-spawn (-> self root trans) #f *gauntlet-yellowsage-sg* #f :to self)))
    (when body
      (set! (-> self body) (ppointer->handle body))
      (send-event (ppointer->process body) 'rot-quat (-> self root quat))
      ;; the same events finalboss sends its yellow sage: eye and blend-shape status, and the origin joint
      (send-event (ppointer->process body) 'blend-shape #t)
      (send-event (ppointer->process body) 'origin-joint-index GAUNTLET_SAGE_ORIGIN_JOINT)))
  (gauntlet-puff (-> self root trans))
  (go gauntlet-sage-attack)
  (none))

;; His body has no entity, so if initialize-skeleton ever failed for it, process-drawable-art-error would
;; dereference (-> self entity extra perm) and fault the game. These two ask the questions initialize-skeleton asks,
;; of the same art, so the dummy only spawns him when his init cannot take that path. Art groups from GAME.CGO are
;; registered in level-default when they link (relocate in joint.gc runs with loading-level = level-default), under
;; the name stored in the group itself ("yellowsage", which is the skelgroup's art-group-name, not "yellowsage-ag").
(defun gauntlet-sage-art-complete? ((art art-group) (skel skeleton-group))
  "True when the skelgroup's joint geometry and every lod mesh exist in the art group with the types the draw needs."
  (when (or (>= (-> skel jgeo) (-> art length)) (!= (-> (-> art data (-> skel jgeo)) type) art-joint-geo))
    (return #f))
  (dotimes (lod (+ (-> skel max-lod) 1))
    (when (or (>= (-> skel mgeo lod) (-> art length)) (!= (-> (-> art data (-> skel mgeo lod)) type) merc-ctrl))
      (return #f)))
  #t)

(defun gauntlet-sage-art-ready? ()
  "True when the sage's art group is already registered in level-default and complete, which is where
   initialize-skeleton looks for a texture-level 2 skelgroup. Never loads anything."
  (let ((art (art-group-get-by-name (-> *level* level-default) (-> *gauntlet-yellowsage-sg* art-group-name))))
    (and art (gauntlet-sage-art-complete? art *gauntlet-yellowsage-sg*))))

(defun gauntlet-dummy-herald? ((dummy process-drawable))
  "True for the first dummy, the one that heralds the rest."
  (name= (res-lump-struct (-> dummy entity) 'name basic) GAUNTLET_HERALD_DUMMY))

(defun gauntlet-dummy-tick ((dummy process-drawable) (sage handle))
  "Once per frame while a dummy idles. When Jak comes into range the dummy gives way to a sage, who
   stays until Jak leaves; the dummy is hidden for exactly as long as its sage is attacking. Returns the sage.
   With the dummies switched off (*gauntlet-dummies-enabled*) there is never a sage: one already out puffs away
   and the dummy is the game's own."
  (cond
    ((not *gauntlet-dummies-enabled*)
     (let ((sage-process (handle->process sage)))
       (when sage-process
         (gauntlet-puff (-> dummy root trans))
         (deactivate sage-process)))
     (logclear! (-> dummy draw status) (draw-status hidden))
     (the-as handle #f))
    (else
     (let ((current-sage sage)
           (appear-range (if (gauntlet-dummy-herald? dummy) *gauntlet-herald-range* *gauntlet-dummy-range*))
           (leave-range (if (gauntlet-dummy-herald? dummy) *gauntlet-herald-leave-range* *gauntlet-dummy-leave-range*)))
       ;; no sage without his art: his init would otherwise fault, and the dummy just stays a dummy
       (when (and (not (handle->process sage))
                  (gauntlet-jak-in-range? dummy appear-range)
                  (gauntlet-sage-art-ready?))
         (let ((spawned (process-spawn gauntlet-sage :init gauntlet-sage-init-by-other dummy appear-range leave-range :to dummy)))
           (if spawned (set! current-sage (ppointer->handle spawned)))))
       ;; hide the dummy only while its sage is really attacking, so a sage that never reached
       ;; his attack state leaves the dummy standing instead of vanishing silently
       (let ((sage-process (handle->process current-sage)))
         (if (and sage-process (= (-> sage-process next-state name) 'gauntlet-sage-attack))
           (logior! (-> dummy draw status) (draw-status hidden))
           (logclear! (-> dummy draw status) (draw-status hidden))))
       current-sage))))

(defun gauntlet-dummy-dismiss-sage ((dummy process-drawable) (sage handle))
  "The dummy was hit: the sage puffs away and the dummy shows again."
  (let ((sage-process (handle->process sage)))
    (when sage-process
      (gauntlet-puff (-> dummy root trans))
      (deactivate sage-process)))
  (logclear! (-> dummy draw status) (draw-status hidden))
  0)

(defskelgroup *scarecrow-a-sg*
  scarecrow-a
  scarecrow-a-lod0-jg
  scarecrow-a-idle-ja
  ((scarecrow-a-lod0-mg (meters 20)) (scarecrow-a-lod1-mg (meters 40)) (scarecrow-a-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 2.5 0 3))

(defskelgroup *scarecrow-a-break-sg*
  scarecrow-a
  scarecrow-a-lod0-jg
  scarecrow-a-idle-ja
  ((scarecrow-a-break-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 -15 0 50))

(defstate idle (scarecrow-a)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack)
         (let* ((s3-0 (-> block param 2))
                (s4-0 (get-task-control (game-task training-gimmie)))
                (v1-2 (get-reminder s4-0 0)))
           (when (!= s3-0 (-> self incomming-attack-id))
             (set! (-> self incomming-attack-id) s3-0)
             (cond
               ((= (-> self type) scarecrow-b))
               ((and (= (-> block param 1) 'spin) (zero? v1-2)) (save-reminder s4-0 1 0) 1)
               ((and (= (-> block param 1) 'punch) (= v1-2 1)) (save-reminder s4-0 2 0) 2)
               ((zero? v1-2))
               ((= v1-2 1)))
             (let* ((sage-out? (if (handle->process (-> self sage)) #t #f)) ;; the sage is standing on this dummy right now
                    (s4-1 proc)
                    (v1-14 (if (and (nonzero? s4-1) (type-type? (-> s4-1 type) process-drawable)) s4-1))
                    (f30-0 (cond
                             (v1-14
                              (let ((s4-2 (-> self root))
                                    (s2-0 (-> (the-as process-drawable v1-14) root trans)))
                                (deg-diff (y-angle s4-2) (vector-y-angle (vector-! (new 'stack-no-clear 'vector) s2-0 (-> s4-2 trans))))))
                             (else 0.0)))
                    (a0-24 ((method-of-type touching-shapes-entry prims-touching?)
                            (the-as touching-shapes-entry (-> block param 0))
                            (the-as collide-shape-moving (-> self root))
                            (the-as uint -1))))
               (go-virtual hit
                           f30-0
                           (if a0-24 (get-middle-of-bsphere-overlap a0-24 (-> self intersection)) (target-pos 0))
                           ;; While the sage stands on this dummy he is what the player sees and aims at, so any attack that
                           ;; reaches the dummy breaks it and the sage dies with it. Without this, a pole dummy (scarecrow-b)
                           ;; only broke from a jump hit on its top sphere (prim 2), far above where the sage stands. With no
                           ;; sage out the vanilla rule is untouched.
                           (the-as symbol
                                   (or sage-out?
                                       (and ((method-of-type touching-shapes-entry prims-touching?)
                                             (the-as touching-shapes-entry (-> block param 0))
                                             (the-as collide-shape-moving (-> self root))
                                             (the-as uint 2))
                                            (or (= (-> self type) scarecrow-a)
                                                (and (= (-> proc type) target)
                                                     (logtest? (-> (the-as target proc) control mod-surface flags) (surface-flags jump))
                                                     (not (logtest? (-> (the-as target proc) control status) (cshape-moving-flags onsurf)))))))))))))
        (('touch) (send-shove-back (-> self root) proc (the-as touching-shapes-entry (-> block param 0)) 0.7 6144.0 16384.0))))
  :trans
    (behavior ()
      (if (and *target* (>= 40960.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (get-reminder (get-task-control (game-task training-gimmie)) 0))
      (set! (-> self sage) (gauntlet-dummy-tick self (-> self sage))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.12))
      (loop
        (ja-no-eval :group! scarecrow-a-idle-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!)))))
  :post ja-post)

(defstate hit (scarecrow-a)
  :virtual #t
  :enter
    (behavior ((arg0 float) (arg1 vector) (arg2 symbol))
      (gauntlet-dummy-dismiss-sage self (-> self sage)))
  :code
    (behavior ((arg0 float) (arg1 vector) (arg2 symbol))
      (when (not arg2)
        (effect-control-method-10 (-> self skel effect) 'group-scarecrow-hit 4.0 -1)
        (ja-channel-push! 1 (seconds 0.07))
        (cond
          ((< (fabs arg0) 8192.0)
           (ja-no-eval :group! scarecrow-a-hit-front-ja :num! (seek!) :frame-num 0.0)
           (until (ja-done? 0)
             (suspend)
             (ja :num! (seek!))))
          ((and (< 8192.0 arg0) (< arg0 24576.0))
           (ja-no-eval :group! scarecrow-a-hit-left-ja :num! (seek!) :frame-num 0.0)
           (until (ja-done? 0)
             (suspend)
             (ja :num! (seek!))))
          (else
           (ja-no-eval :group! scarecrow-a-hit-right-ja :num! (seek!) :frame-num 0.0)
           (until (ja-done? 0)
             (suspend)
             (ja :num! (seek!)))))
        (go-virtual idle))
      (clear-collide-with-as (-> self root))
      (effect-control-method-10 (-> self skel effect) 'group-scarecrow-joint-explode 12.0 -1)
      (effect-control-method-10 (-> self skel effect) 'group-scarecrow-joint-explode 20.0 -1)
      (effect-control-method-10 (-> self skel effect) 'group-scarecrow-explode 4.0 -1)
      (sound-play "break-dummy")
      (ja-channel-set! 0)
      (let ((s5-2 (new 'stack 'joint-exploder-tuning 1)))
        (set! (-> s5-2 duration) (seconds 1.5))
        (set! (-> s5-2 gravity) -327680.0)
        (set! (-> s5-2 fountain-rand-transv-hi x) 32768.0)
        (set! (-> s5-2 fountain-rand-transv-hi y) 81920.0)
        (set! (-> s5-2 fountain-rand-transv-hi z) 20480.0)
        (set! (-> s5-2 fountain-rand-transv-hi w) 49152.0)
        (set! (-> s5-2 fountain-rand-transv-lo quad) (-> arg1 quad))
        (process-spawn joint-exploder
                       *scarecrow-a-break-sg*
                       5
                       s5-2
                       (new 'static
                            'joint-exploder-static-params
                            :joints
                            (new 'static
                                 'boxed-array
                                 :type
                                 joint-exploder-static-joint-params
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 12)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 10)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 20)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 4)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 5)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 11)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 9)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 7)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 14)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 13)))
                       :to
                       self))
      (while (-> self child)
        (suspend))
      (cleanup-for-death self))
  :post ja-post)

(defmethod init-from-entity! ((this scarecrow-a) (arg0 entity-actor))
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s3-0 (new 'process 'collide-shape-prim-group s4-0 (the-as uint 2) 0)))
      (set! (-> s3-0 prim-core collide-as) (collide-kind enemy))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set! (-> s3-0 prim-core action) (collide-action solid))
      (set-vector! (-> s3-0 local-sphere) 0.0 10240.0 0.0 12288.0)
      (set-root-prim! s4-0 s3-0)
      (let ((s2-0 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 2))))
        (set! (-> s2-0 prim-core collide-as) (collide-kind enemy))
        (set! (-> s2-0 collide-with) (collide-kind target))
        (set! (-> s2-0 prim-core action) (collide-action solid))
        (set! (-> s2-0 prim-core offense) (collide-offense touch))
        (set-vector! (-> s2-0 local-sphere) 0.0 7372.8 0.0 7372.8)
        (append-prim s3-0 s2-0))
      (let ((s2-1 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 2))))
        (set! (-> s2-1 prim-core collide-as) (collide-kind enemy))
        (set! (-> s2-1 collide-with) (collide-kind target))
        (set! (-> s2-1 prim-core action) (collide-action solid))
        (set! (-> s2-1 prim-core offense) (collide-offense touch))
        (set-vector! (-> s2-1 local-sphere) 0.0 12288.0 0.0 7372.8)
        (append-prim s3-0 s2-1)))
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (backup-collide-with-as s4-0)
    (set! (-> this root) s4-0))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *scarecrow-a-sg* '())
  (set! (-> this sage) (the-as handle #f))
  (go (method-of-object this idle))
  (none))

(defskelgroup *scarecrow-b-sg*
  scarecrow-b
  scarecrow-b-lod0-jg
  scarecrow-b-idle-ja
  ((scarecrow-b-lod0-mg (meters 20)) (scarecrow-b-lod1-mg (meters 40)) (scarecrow-b-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 3.5 0 3.8))

(defskelgroup *scarecrow-b-break-sg*
  scarecrow-b
  scarecrow-b-lod0-jg
  scarecrow-b-idle-ja
  ((scarecrow-b-break-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 -15 0 50))

(defstate idle (scarecrow-b)
  :virtual #t
  :event
    (-> (method-of-type scarecrow-a idle)
        event)
  :trans
    (behavior ()
      (set! (-> self sage) (gauntlet-dummy-tick self (-> self sage))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.12))
      (loop
        (ja-no-eval :group! scarecrow-b-idle-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!)))))
  :post ja-post)

(defstate hit (scarecrow-b)
  :virtual #t
  :enter
    (behavior ((arg0 float) (arg1 vector) (arg2 symbol))
      (gauntlet-dummy-dismiss-sage self (-> self sage)))
  :code
    (behavior ((arg0 float) (arg1 vector) (arg2 symbol))
      (when (not arg2)
        (effect-control-method-10 (-> self skel effect) 'group-scarecrow-hit 4.0 -1)
        (ja-channel-push! 1 (seconds 0.07))
        (cond
          ((< (fabs arg0) 8192.0)
           (ja-no-eval :group! scarecrow-b-hit-front-ja :num! (seek!) :frame-num 0.0)
           (until (ja-done? 0)
             (suspend)
             (ja :num! (seek!))))
          ((and (< 8192.0 arg0) (< arg0 24576.0))
           (ja-no-eval :group! scarecrow-b-hit-left-ja :num! (seek!) :frame-num 0.0)
           (until (ja-done? 0)
             (suspend)
             (ja :num! (seek!))))
          (else
           (ja-no-eval :group! scarecrow-b-hit-right-ja :num! (seek!) :frame-num 0.0)
           (until (ja-done? 0)
             (suspend)
             (ja :num! (seek!)))))
        (go-virtual idle))
      (clear-collide-with-as (-> self root))
      (effect-control-method-10 (-> self skel effect) 'group-scarecrow-joint-explode 12.0 -1)
      (effect-control-method-10 (-> self skel effect) 'group-scarecrow-joint-explode 21.0 -1)
      (effect-control-method-10 (-> self skel effect) 'group-scarecrow-explode 4.0 -1)
      (sound-play "break-dummy")
      (ja-channel-set! 0)
      (let ((s5-2 (new 'stack 'joint-exploder-tuning 1)))
        (set! (-> s5-2 duration) (seconds 1.5))
        (set! (-> s5-2 fountain-rand-transv-hi x) 32768.0)
        (set! (-> s5-2 fountain-rand-transv-hi y) 81920.0)
        (set! (-> s5-2 fountain-rand-transv-hi z) 40960.0)
        (set! (-> s5-2 fountain-rand-transv-hi w) 102400.0)
        (set! (-> s5-2 fountain-rand-transv-lo quad) (-> arg1 quad))
        (process-spawn joint-exploder
                       *scarecrow-b-break-sg*
                       5
                       s5-2
                       (new 'static
                            'joint-exploder-static-params
                            :joints
                            (new 'static
                                 'boxed-array
                                 :type
                                 joint-exploder-static-joint-params
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 12)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 10)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 21)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 4)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 5)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 11)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 9)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 7)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 14)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 13)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 14)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 13)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 16)
                                 (new 'static 'joint-exploder-static-joint-params :joint-index 15)))
                       :to
                       self))
      (while (-> self child)
        (suspend))
      (cleanup-for-death self))
  :post ja-post)

