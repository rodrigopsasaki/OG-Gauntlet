;;-*-Lisp-*-
(in-package goal)

;; Declarations for the gauntlet mod (pc/features/gauntlet.gc). Files compiled before the module
;; (main.gc, the levels) call into it, so those calls are declared here.

;; Per-frame work of the mod: settings file, and everything that watches for Jak. Cheap when idle.
(define-extern gauntlet-poll! (function none))

;; Called by the pelican (beach/pelican.gc) when it is at its nest with the cell: Klaww falls onto it.
(define-extern gauntlet-klaww-pelican-at-nest! (function process none))

;; Called by the cannon (misty/mistycannon.gc, also in BEA.DGO) for each shot: where, and how wide.
;; A blast on Klaww heals him one hit.
(define-extern gauntlet-klaww-cannon-blast! (function vector float none))

;; Called by the farm yakows (village1/yakow.gc) when Jak attacks one, with the yakow hit.
(define-extern gauntlet-stampede-yakow-hit! (function process-drawable int))

;; Misty Island's muse (gauntlet.gc, "the muse"). Catching her calms the island; a hit, bonk or death loses her
;; and starts the mayhem. babak.gc and bonelurker.gc ask these for their pace and whether mayhem is on;
;; the answer differs from plain only for things Misty placed, while the muse is loose. muse.gc reports catches.
;; Defined in gauntlet.gc, only called once a level is running.
(define-extern gauntlet-misty-pace (function process float))
(define-extern gauntlet-mayhem-for? (function process basic))
(define-extern gauntlet-babak-sync (function process none)) ;; babak.gc defines it: the muse's change, told to a babak asleep
(define-extern gauntlet-babak-charged? (function process basic)) ;; babak.gc defines it: whether a babak wears an eco now
(define-extern gauntlet-muse-caught! (function symbol none))

;; Fishing game (jungle/fisher.gc). Holding X raises the net to a flying fish; with the net up the river's fish
;; cannot be caught, except ones that leap. begin/end bracket a game; update runs every frame with the fisher,
;; the net's place on the river, the lane width, the net radius, and the misses so far and allowed.
(define-extern gauntlet-fisher-begin! (function int))
(define-extern gauntlet-fisher-end! (function int))
(define-extern gauntlet-fisher-update! (function process-drawable vector float float int int none))
;; True while the net is down far enough to catch the river's fish.
(define-extern gauntlet-fisher-net-low? (function symbol))
;; True when the net can catch a fish lifted this far (game units) off its swimming line.
(define-extern gauntlet-fisher-net-catches? (function float symbol))
;; Whether a river fish that is being born will leap once on its way down the river.
(define-extern gauntlet-fisher-jump-roll! (function symbol))
;; Height of a leaping fish above its swimming line (game units, 0 outside the leap), and nose pitch (rotation units).
(define-extern gauntlet-fisher-jump-lift (function vector vector float))
(define-extern gauntlet-fisher-jump-pitch (function vector vector float))
;; The net's root joint: Jak's right hand plus the net's rise. target-fishing uses it in place of cspace<-cspace+quaternion!.
(define-extern gauntlet-fisher-net-cspace! (function cspace cspace quaternion matrix))

;; Where a dropped muse starts (muse.gc, muse-path-point-nearest). With w at 1.0 she starts on the path point nearest xyz
;; and muse.gc resets w to 0.0; with w at 0.0 she starts where the game puts her.
(define *gauntlet-muse-start* (new 'global 'vector))

;; Eco mastery (gauntlet.gc), earned by clearing Geyser Rock of scarecrows. training-obs.gc calls this as a scarecrow's
;; break finishes; the mod checks whether it was the last. *target-goggles-shot-paid-hook* (target2.gc) is set by the mod.
(define-extern gauntlet-scarecrow-broken! (function process-drawable none))

;; ---------------------------------------------------------- the eco charge --

;; Eco colour tells the player what a hazard does. Red: hits for two and throws Jak far. Blue: pulls Jak in or runs faster.
;; Yellow and green are not hazards (scout fly boxes ask for them). A charged hazard glows and carries Jak's own aura.
;; babak.gc loads before gauntlet.gc, so the enum and constants live here and the functions are declared here.
(defenum gauntlet-eco
  :type uint32
  (none 0)
  (red 1)
  (blue 2)
  (yellow 3)
  (green 4))

(defconstant GAUNTLET_ECO_RED_SHOVE_BACK (meters 9)) ;; a red hit throws Jak this far (2.5x a plain yakow)
(defconstant GAUNTLET_ECO_RED_SHOVE_UP (meters 3)) ;; and this high

;; Eco gets stronger as Jak gets weaker: effects are multiplied by this, read live. 1.0 at full health,
;; *gauntlet-desperation-max* at one hit left, linear between, 1.0 with no Jak.
(define-extern gauntlet-desperation (function float))

;; Tint a process-drawable's draw toward a kind's eco, glowing harder with desperation. Called at birth and by the aura.
(define-extern gauntlet-eco-glow! (function process-drawable gauntlet-eco none))
;; One frame of a kind's eco aura at the joints; call every frame it should show.
(define-extern gauntlet-eco-aura! (function process-drawable gauntlet-eco none))
;; The second hit of a red strike, after the first has landed on the process given.
(define-extern gauntlet-eco-second-hit! (function process none))

;; ------------------------------------------------------------ the volley --

;; Yellow eco fired at Jak in volleys, by the training sage and the plant boss's yellow minions (aphid.gc).
;; Functions are in gauntlet.gc ("the volley"); the shot itself (gauntlet-shot) is in engine/game/projectiles.gc.
(deftype gauntlet-volley (structure)
  ((start-time     time-frame)
   (next-shot-time time-frame)
   (size           int32)
   (shots-left     int32)
   (sweep          float)
   (heading        vector :inline)
   (muzzle         vector :inline)))

(define-extern gauntlet-jak-in-range? (function process-drawable float object))
(define-extern gauntlet-jak-shootable? (function object))
(define-extern gauntlet-volley-start (function gauntlet-volley vector int))
(define-extern gauntlet-volley-fire-next (function process-drawable gauntlet-volley int))
(define-extern gauntlet-volley-update (function process-drawable gauntlet-volley vector float int))

;; ------------------------------------------------------------ the tunables --

;; Defaults are constants in game units (meters 4096, seconds 300 ticks, degrees 65536 a turn); the globals start from
;; them and are what the mod reads. gauntlet.gc owns the settings file and resets the globals to these defaults.
(defconstant GAUNTLET_BOMB_COUNTDOWN_DEFAULT (seconds 4)) ;; from landing to blast, with the warning beeps speeding up
(defconstant GAUNTLET_BOMB_BLAST_RADIUS_DEFAULT (meters 35)) ;; Jak inside this when it goes off dies, unless a recent hit still has him invulnerable
(defconstant GAUNTLET_BOMB_PULL_RADIUS_DEFAULT GAUNTLET_BOMB_BLAST_RADIUS_DEFAULT) ;; the bomb pulls Jak while closer than this, sideways
(defconstant GAUNTLET_BOMB_PULL_DEFAULT (meters 20)) ;; in the air: added drag toward the bomb per second, a third of gravity (a 0.7 s jump loses 4.6 m)
(defconstant GAUNTLET_BOMB_GROUND_PULL_DEFAULT (meters 0.5)) ;; on foot or in water: steady slide speed toward it
(defconstant GAUNTLET_BOMB_DROP_HEIGHT_DEFAULT (meters 25)) ;; how high above Jak the bomb appears
(defconstant GAUNTLET_BOMB_GRAVITY_DEFAULT (meters 30)) ;; meters per second per second (about 1.3 s from 25 m)
(defconstant GAUNTLET_BRIDGE_ENABLED_DEFAULT #t) ;; the bomb drops by itself on the bridge
(defconstant GAUNTLET_VENT_ENABLED_DEFAULT #t) ;; and, a second after Gol's warning, on the blue eco vent before the precursor door
(defconstant GAUNTLET_BRIDGE_TRIGGER_RADIUS_DEFAULT (meters 5)) ;; Jak this close (sideways) to a Geyser Rock drop spot (bridge, vent) sets its bomb off
(defconstant GAUNTLET_BRIDGE_REARM_RANGE_DEFAULT (meters 60)) ;; and it will not drop again until he has been farther than this; dying and respawning also rearms
(defconstant GAUNTLET_DUMMIES_ENABLED_DEFAULT #t) ;; the training dummies turn into sages and shoot
(defconstant GAUNTLET_DUMMY_VOLLEY_INTERVAL_DEFAULT (seconds 3.0)) ;; time between volley starts, per dummy
(defconstant GAUNTLET_DUMMY_VOLLEY_GAP_DEFAULT (seconds 0.4)) ;; time between shots within a volley
(defconstant GAUNTLET_DUMMY_VOLLEY_SIZE_DEFAULT 5) ;; shots per volley, swept across a fan centred on the aim at Jak
(defconstant GAUNTLET_DUMMY_VOLLEY_SPREAD_DEFAULT (degrees 15)) ;; angle between neighbouring shots in the fan
(defconstant GAUNTLET_DUMMY_RANGE_DEFAULT (meters 20)) ;; a dummy turns into a sage and fires once Jak is this close
(defconstant GAUNTLET_SAGE_LEAVE_RANGE_DEFAULT (meters 24)) ;; the sage leaves only beyond this, so Jak at the edge of range does not flicker him in and out
;; The first dummy heralds the rest from the top of the stairs (28 m), so it wakes from further away.
(defconstant GAUNTLET_HERALD_RANGE_DEFAULT (meters 30)) ;; its appear and firing range
(defconstant GAUNTLET_HERALD_LEAVE_RANGE_DEFAULT (meters 34)) ;; its sage leaves beyond this
(defconstant GAUNTLET_DUMMY_SHOT_SPEED_DEFAULT (meters 40)) ;; Jak's own shot is 60; slower so a sidestep beats it
(defconstant GAUNTLET_STAMPEDE_ENABLED_DEFAULT #t) ;; the herd charges by itself at the spot beside the farmer in Sandover
(defconstant GAUNTLET_STAMPEDE_HERD_SIZE_DEFAULT 8) ;; yakows in a herd, filled three to a row
(defconstant GAUNTLET_STAMPEDE_SPEED_DEFAULT (meters 14)) ;; Jak runs at 10 m/s, so he must sidestep
(defconstant GAUNTLET_STAMPEDE_TRIGGER_RADIUS_DEFAULT (meters 5)) ;; Jak this close to the Sandover spot, sideways, sets the herd off
(defconstant GAUNTLET_STAMPEDE_REARM_RANGE_DEFAULT (meters 60)) ;; and it will not charge again until he has been farther than this from it
(defconstant GAUNTLET_YAKOW_STAMPEDE_ENABLED_DEFAULT #t) ;; hitting a farm yakow sends the herd through it, at Jak
(defconstant GAUNTLET_STAMPEDE_LAUNCH_UP_DEFAULT (meters 30)) ;; a yakow's hit throws Jak this high (see gauntlet-yakow-trample)
(defconstant GAUNTLET_STAMPEDE_RED_COUNT_DEFAULT 3) ;; yakows charged with red eco, the first slots of the herd (the lead row)
(defconstant GAUNTLET_BABAK_CHARGE_ENABLED_DEFAULT #t) ;; babaks may be born charged with eco, on every level
(defconstant GAUNTLET_BABAK_CHARGE_CHANCE_DEFAULT 0.5) ;; chance (0 to 1) a babak is born charged; a charged one is red or blue by coin toss
(defconstant GAUNTLET_BABAK_BLUE_SPEED_DEFAULT 3.0) ;; a blue babak runs this many times faster than a plain one at full health
;; Eco effects scale with Jak's missing health (gauntlet-desperation), and a power cell heals him.
(defconstant GAUNTLET_DESPERATION_MAX_DEFAULT 2.0) ;; every eco effect is this many times stronger with one hit left (linear from 1.0)
(defconstant GAUNTLET_CELL_HEAL_ENABLED_DEFAULT #t) ;; a power cell heals Jak up to 3 hits, never above
;; Misty's muse: caught means calm, loose (not caught, or dropped by a hit, bonk or death) means mayhem.
(defconstant GAUNTLET_MISTY_MUSE_ENABLED_DEFAULT #t) ;; the muse is shown by an icon; a loose one brings the mayhem below
(defconstant GAUNTLET_MISTY_MAYHEM_EXTRA_DEFAULT 2) ;; extra clones of every lurker Misty places while the muse is loose, on top of lurker-multiplier's
(defconstant GAUNTLET_MISTY_MAYHEM_SPEED_DEFAULT 1.8) ;; Misty's babaks and bonelurkers run this many times faster while she is loose
(defconstant GAUNTLET_MISTY_MAYHEM_CHARGE_CHANCE_DEFAULT 1.0) ;; chance a Misty babak is born charged while she is loose, instead of babak-charge-chance
(defconstant GAUNTLET_MISTY_MAYHEM_ATMOSPHERE_DEFAULT 1.0) ;; how far the world is tinted dark-eco violet while she is loose, 0 to 1
(defconstant GAUNTLET_MISTY_MAYHEM_MUSIC_DEFAULT #t) ;; Misty's battle music (sound-flava misty-battle) plays while she is loose
(defconstant GAUNTLET_MISTY_MAYHEM_VOICE_DEFAULT #t) ;; Daxter says a line when she is lost and another when she is caught, at most one in a few seconds
(defconstant GAUNTLET_MUSE_GRACE (seconds 1.5)) ;; a dropped muse cannot be caught for this long, or she would be caught where she lands
(defconstant GAUNTLET_MUSE_ICON_SCALE_DEFAULT 1.0) ;; how many times its usual size the checkbox is drawn
;; Lurkerworms of Sentinel Beach raise Snowy Mountain's ice cubes out of the sand (beach/lurkerworm.gc).
(defconstant GAUNTLET_WORM_CUBES_ENABLED_DEFAULT #t) ;; a worm that rises raises ice cubes around it
(defconstant GAUNTLET_WORM_CUBE_COUNT_DEFAULT 2) ;; ice cubes per rise, evenly around the worm; a new wave only once the last is gone
;; Every lurker the level places gets company (gauntlet.gc, "the horde"; hook in entity.gc).
(defconstant GAUNTLET_LURKER_MULTIPLIER_DEFAULT 3) ;; each placed lurker becomes this many (itself plus clones); 1 is the game's own
;; The cap bounds the cost: each clone is a whole nav enemy process with its own collision, nav walk and animation.
(defconstant GAUNTLET_HORDE_MAX_CLONES_DEFAULT 60) ;; clones alive at once, all groups together; a birth past it gets only the clones that fit
;; Klaww stands in the pelican's nest at Sentinel Beach and lobs boulders at Jak. The beach buttons (a table in gauntlet.gc) hit him.
(defconstant GAUNTLET_KLAWW_ENABLED_DEFAULT #t) ;; Klaww and his buttons appear on the beach
(defconstant GAUNTLET_KLAWW_THROW_CYCLE 1580) ;; ticks (5.2667 s): the throw animations at their own speed, measured from a play log (158 frames at 30 fps)
(defconstant GAUNTLET_KLAWW_THROW_INTERVAL_DEFAULT GAUNTLET_KLAWW_THROW_CYCLE) ;; release to release with no hit taken; shorter plays the animations faster
(defconstant GAUNTLET_KLAWW_RAGE_MAX_DEFAULT 2.5) ;; he throws this many times as often with one hit left (linear from 1.0); 2.1 s between boulders by default
(defconstant GAUNTLET_KLAWW_RADIUS_MAX_DEFAULT 2.0) ;; and his boulders blast this many times as wide with one hit left (linear from 1.0)
(defconstant GAUNTLET_KLAWW_RANGE_DEFAULT (meters 140)) ;; he throws while Jak is within this, sideways: the first button is 100 m from the nest
(defconstant GAUNTLET_KLAWW_BOULDER_RADIUS_DEFAULT (meters 5)) ;; Jak this close to where a boulder lands is hit; the landing marker draws this circle
;; Scout fly boxes of Sentinel Beach each want an eco to open (table in gauntlet.gc); lurkers carry it ("the scout fly boxes").
(defconstant GAUNTLET_FLYBOX_ENABLED_DEFAULT #t) ;; the boxes of the table want their eco; carriers glow and spill it
(defconstant GAUNTLET_FLYBOX_BOUNCE_DEFAULT (meters 2.5)) ;; a box that refuses Jak throws him this far back (and 1.5 m up), no damage
(defconstant GAUNTLET_CARRIER_RETURN_DEFAULT (seconds 20)) ;; a dead carrier returns charged this long after while its box is closed; 0 is never
;; The skull TNT barrels of Mountain Pass stand where a table in gauntlet.gc puts them.
(defconstant GAUNTLET_TNT_ENABLED_DEFAULT #t) ;; the barrels stand at their spots
;; Forbidden Jungle temple (gauntlet.gc, "the temple"): floating platforms are not born; cross on boosted and roll jumps.
(defconstant GAUNTLET_FJ_TEMPLE_PLATFORMS_REMOVED_DEFAULT #t) ;; the temple's floating platforms are not there
;; Forbidden Jungle plant boss (gauntlet.gc, "the plant boss"): minions are charged with eco by round.
(defconstant GAUNTLET_PLANT_BOSS_REWORK_DEFAULT #t) ;; the rework is on; off is the game's own boss
;; Fishing game: a big fish on a zoomer flies down the river; hold X to raise the net to it.
(defconstant GAUNTLET_FISHER_FLYER_ENABLED_DEFAULT #t) ;; the flying fish comes, and X raises the net; off is the game's own fishing
(defconstant GAUNTLET_FISHER_FLYER_INTERVAL_DEFAULT (seconds 20)) ;; from one flying fish to the next, give or take a quarter; the first comes after half
(defconstant GAUNTLET_FISHER_FLYER_POUNDS_DEFAULT 20) ;; catching it is worth this (a river fish 1, a big one 5), and missing it costs this when that loses the game
(defconstant GAUNTLET_FISHER_FLYER_MISS_LOSES_DEFAULT #t) ;; letting it get away ends the game of fishing as too many misses do
(defconstant GAUNTLET_FISHER_FLYER_SPEED_DEFAULT 2.2) ;; path positions per second (a river fish crosses at 2.6 to 4.1, about 3.6 m per position)
(defconstant GAUNTLET_FISHER_FLYER_EEL_CHANCE_DEFAULT 33) ;; chance in a hundred that a flying fish is an eel instead, to be dodged
(defconstant GAUNTLET_FISHER_JUMP_CHANCE_DEFAULT 20) ;; chance in a hundred that a river fish (eels too) leaps once on its way down
(defconstant GAUNTLET_FISHER_FLYER_HEIGHT_DEFAULT (meters 3.5)) ;; how far above the net's usual height the flying fish flies and X lifts the net: clear of Jak's head

;; Eco mastery (gauntlet.gc): clearing every Geyser Rock scarecrow in one visit earns two powers. The goggles fire
;; without yellow charge for orbs; R2 blasts nearby enemies away and stuns them, for one hit of health.
(defconstant GAUNTLET_ECO_MASTERY_ENABLED_DEFAULT #t) ;; the powers exist once earned; off: nothing is earned or paid
(defconstant GAUNTLET_ECO_BLAST_RADIUS_DEFAULT (meters 12)) ;; R2's blast reaches nav enemies this far from Jak, sideways and up
(defconstant GAUNTLET_ECO_BLAST_STUN_DEFAULT (seconds 4)) ;; and holds each of them for this long
(defconstant GAUNTLET_ECO_BLAST_PUSH_DEFAULT (meters 6)) ;; and throws it about this far away from Jak first
(defconstant GAUNTLET_GOGGLES_ORB_COST_DEFAULT 1) ;; orbs a goggles shot costs when Jak has no yellow eco; with it, none

;; Times are ticks (300 a second), lengths and speeds game units, the spread rotation units.
;; Things already in the world keep the values they were made with (a bomb in the air, a sage's ranges).
(define *gauntlet-bomb-countdown* (the int GAUNTLET_BOMB_COUNTDOWN_DEFAULT))
(define *gauntlet-bomb-blast-radius* GAUNTLET_BOMB_BLAST_RADIUS_DEFAULT)
(define *gauntlet-bomb-pull-radius* GAUNTLET_BOMB_PULL_RADIUS_DEFAULT)
(define *gauntlet-bomb-pull* GAUNTLET_BOMB_PULL_DEFAULT) ;; per second, per second
(define *gauntlet-bomb-ground-pull* GAUNTLET_BOMB_GROUND_PULL_DEFAULT) ;; per second
(define *gauntlet-bomb-drop-height* GAUNTLET_BOMB_DROP_HEIGHT_DEFAULT)
(define *gauntlet-bomb-gravity* GAUNTLET_BOMB_GRAVITY_DEFAULT) ;; per second, per second
(define *gauntlet-bridge-enabled* GAUNTLET_BRIDGE_ENABLED_DEFAULT) ;; off: the bomb never drops by itself on the bridge
(define *gauntlet-vent-enabled* GAUNTLET_VENT_ENABLED_DEFAULT) ;; off: the bomb never drops by itself on the vent
(define *gauntlet-bridge-trigger-radius* GAUNTLET_BRIDGE_TRIGGER_RADIUS_DEFAULT)
(define *gauntlet-bridge-rearm-range* GAUNTLET_BRIDGE_REARM_RANGE_DEFAULT)
(define *gauntlet-dummies-enabled* GAUNTLET_DUMMIES_ENABLED_DEFAULT) ;; off: the training dummies are the game's own, no sage and no shots
(define *gauntlet-dummy-volley-interval* (the int GAUNTLET_DUMMY_VOLLEY_INTERVAL_DEFAULT))
(define *gauntlet-dummy-volley-gap* (the int GAUNTLET_DUMMY_VOLLEY_GAP_DEFAULT))
(define *gauntlet-dummy-volley-size* GAUNTLET_DUMMY_VOLLEY_SIZE_DEFAULT)
(define *gauntlet-dummy-volley-spread* GAUNTLET_DUMMY_VOLLEY_SPREAD_DEFAULT)
(define *gauntlet-dummy-range* GAUNTLET_DUMMY_RANGE_DEFAULT)
(define *gauntlet-dummy-leave-range* GAUNTLET_SAGE_LEAVE_RANGE_DEFAULT)
(define *gauntlet-herald-range* GAUNTLET_HERALD_RANGE_DEFAULT)
(define *gauntlet-herald-leave-range* GAUNTLET_HERALD_LEAVE_RANGE_DEFAULT)
(define *gauntlet-dummy-shot-speed* GAUNTLET_DUMMY_SHOT_SPEED_DEFAULT) ;; per second
(define *gauntlet-stampede-enabled* GAUNTLET_STAMPEDE_ENABLED_DEFAULT) ;; off: the herd never charges by itself in Sandover
(define *gauntlet-stampede-herd-size* GAUNTLET_STAMPEDE_HERD_SIZE_DEFAULT)
(define *gauntlet-stampede-speed* GAUNTLET_STAMPEDE_SPEED_DEFAULT) ;; per second
(define *gauntlet-stampede-trigger-radius* GAUNTLET_STAMPEDE_TRIGGER_RADIUS_DEFAULT)
(define *gauntlet-stampede-rearm-range* GAUNTLET_STAMPEDE_REARM_RANGE_DEFAULT)
(define *gauntlet-yakow-stampede-enabled* GAUNTLET_YAKOW_STAMPEDE_ENABLED_DEFAULT) ;; off: hitting a farm yakow does nothing extra
(define *gauntlet-stampede-launch-up* GAUNTLET_STAMPEDE_LAUNCH_UP_DEFAULT) ;; live: read as each yakow's hit is sent
(define *gauntlet-stampede-red-count* GAUNTLET_STAMPEDE_RED_COUNT_DEFAULT) ;; the herd's first this-many slots are red, however big the herd
(define *gauntlet-babak-charge-enabled* GAUNTLET_BABAK_CHARGE_ENABLED_DEFAULT) ;; off: babaks are the game's own, never charged
(define *gauntlet-babak-charge-chance* GAUNTLET_BABAK_CHARGE_CHANCE_DEFAULT) ;; rolled once per babak, when it is born
(define *gauntlet-babak-blue-speed* GAUNTLET_BABAK_BLUE_SPEED_DEFAULT) ;; at full health; a babak keeps its birth base and the desperation multiplies it live
(define *gauntlet-desperation-max* GAUNTLET_DESPERATION_MAX_DEFAULT) ;; live: read every frame an eco effect is applied
(define *gauntlet-cell-heal-enabled* GAUNTLET_CELL_HEAL_ENABLED_DEFAULT) ;; off: a power cell leaves Jak's health as the game made it
(define *gauntlet-misty-muse-enabled* GAUNTLET_MISTY_MUSE_ENABLED_DEFAULT) ;; off: no icon, no mayhem; the muse and her catch are the game's
(define *gauntlet-misty-mayhem-extra* GAUNTLET_MISTY_MAYHEM_EXTRA_DEFAULT) ;; live: dropping the muse tops up every group, catching her removes all clones
(define *gauntlet-misty-mayhem-speed* GAUNTLET_MISTY_MAYHEM_SPEED_DEFAULT) ;; live: read every frame a Misty lurker moves; multiplies with the desperation
(define *gauntlet-misty-mayhem-charge-chance* GAUNTLET_MISTY_MAYHEM_CHARGE_CHANCE_DEFAULT) ;; read as each babak is born
(define *gauntlet-misty-mayhem-atmosphere* GAUNTLET_MISTY_MAYHEM_ATMOSPHERE_DEFAULT) ;; live: read every frame the mood is tinted
(define *gauntlet-misty-mayhem-music* GAUNTLET_MISTY_MAYHEM_MUSIC_DEFAULT) ;; live: read every frame
(define *gauntlet-misty-mayhem-voice* GAUNTLET_MISTY_MAYHEM_VOICE_DEFAULT) ;; live: read as each line would be said
(define *gauntlet-misty-muse-icon-scale* GAUNTLET_MUSE_ICON_SCALE_DEFAULT) ;; live: read every frame the icon is drawn
(define *gauntlet-worm-cubes-enabled* GAUNTLET_WORM_CUBES_ENABLED_DEFAULT) ;; off: the worms rise as the game made them
(define *gauntlet-worm-cube-count* GAUNTLET_WORM_CUBE_COUNT_DEFAULT) ;; read at each rise
(define *gauntlet-lurker-multiplier* GAUNTLET_LURKER_MULTIPLIER_DEFAULT) ;; read as each lurker is born; existing ones keep their company
(define *gauntlet-horde-max-clones* GAUNTLET_HORDE_MAX_CLONES_DEFAULT) ;; read as each lurker is born; clones already standing are never taken away
(define *gauntlet-klaww-enabled* GAUNTLET_KLAWW_ENABLED_DEFAULT) ;; off: no Klaww, no buttons, and whatever stands is taken away
(define *gauntlet-klaww-throw-interval* (the int GAUNTLET_KLAWW_THROW_INTERVAL_DEFAULT))
(define *gauntlet-klaww-rage-max* GAUNTLET_KLAWW_RAGE_MAX_DEFAULT) ;; live: read every frame he decides whether to throw, and every frame of a throw
(define *gauntlet-klaww-radius-max* GAUNTLET_KLAWW_RADIUS_MAX_DEFAULT) ;; read as each boulder leaves his hand
(define *gauntlet-klaww-range* GAUNTLET_KLAWW_RANGE_DEFAULT)
(define *gauntlet-klaww-boulder-radius* GAUNTLET_KLAWW_BOULDER_RADIUS_DEFAULT) ;; a boulder in the air keeps the radius it was thrown with
(define *gauntlet-flybox-enabled* GAUNTLET_FLYBOX_ENABLED_DEFAULT) ;; live for the rule (off: every box opens as the game made it); look and carriers are made at birth
(define *gauntlet-flybox-bounce* GAUNTLET_FLYBOX_BOUNCE_DEFAULT) ;; read as each refusal happens
(define *gauntlet-carrier-return* (the int GAUNTLET_CARRIER_RETURN_DEFAULT)) ;; read as each carrier dies
(define *gauntlet-tnt-enabled* GAUNTLET_TNT_ENABLED_DEFAULT) ;; off: no barrels, and whatever stands is put away
(define *gauntlet-fj-temple-platforms-removed* GAUNTLET_FJ_TEMPLE_PLATFORMS_REMOVED_DEFAULT) ;; read as each temple actor is born; off: born as the game made them
(define *gauntlet-plant-boss-rework* GAUNTLET_PLANT_BOSS_REWORK_DEFAULT) ;; live: read as each round starts (minion eco) and as each bite lands
(define *gauntlet-fisher-flyer-enabled* GAUNTLET_FISHER_FLYER_ENABLED_DEFAULT) ;; live: read every frame of the fishing game
(define *gauntlet-fisher-flyer-interval* (the int GAUNTLET_FISHER_FLYER_INTERVAL_DEFAULT)) ;; read when the next flying fish is scheduled
(define *gauntlet-fisher-flyer-pounds* GAUNTLET_FISHER_FLYER_POUNDS_DEFAULT) ;; read as the flying fish is caught
(define *gauntlet-fisher-flyer-miss-loses* GAUNTLET_FISHER_FLYER_MISS_LOSES_DEFAULT) ;; read as the flying fish gets away
(define *gauntlet-fisher-flyer-speed* GAUNTLET_FISHER_FLYER_SPEED_DEFAULT) ;; live: read every frame the flying fish flies
