;; ------------------------------------------------------------------ the art --

(defskelgroup *gauntlet-darkecobomb-sg*
  darkecobomb
  darkecobomb-lod0-jg
  darkecobomb-idle-ja
  ((darkecobomb-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 3.5 0 6)
  :texture-level 2)

;; Art groups from GAME.CGO are registered in level-default when they link, under the name stored in the group itself
;; (the skelgroup's art-group-name, not the "-ag" file name). The bomb has no entity, so if initialize-skeleton ever
;; failed for it, process-drawable-art-error would dereference (-> self entity extra perm) and fault the game. These two
;; ask the questions initialize-skeleton asks, of the same art, so the bomb is only dropped when its init cannot take
;; that path. The sage's pair in training-obs.gc is the same check.
(defun gauntlet-art-complete? ((art art-group) (skel skeleton-group))
  "True when the skelgroup's joint geometry and every lod mesh exist in the art group with the types the draw needs."
  (when (or (>= (-> skel jgeo) (-> art length)) (!= (-> (-> art data (-> skel jgeo)) type) art-joint-geo))
    (return #f))
  (dotimes (lod (+ (-> skel max-lod) 1))
    (when (or (>= (-> skel mgeo lod) (-> art length)) (!= (-> (-> art data (-> skel mgeo lod)) type) merc-ctrl))
      (return #f)))
  #t)

(defun gauntlet-art-ready? ((skel skeleton-group))
  "True when the skelgroup's art group is already registered in level-default and complete, which is where
   initialize-skeleton looks for a texture-level 2 skelgroup. Never loads anything."
  (let ((art (art-group-get-by-name (-> *level* level-default) (-> skel art-group-name))))
    (and art (gauntlet-art-complete? art skel))))

;; ---------------------------------------------------------------- the eco charge --

;; The eco language (the kind and its declarations are in gauntlet-h.gc, where babak.gc can reach them). A charged hazard
;; looks like it and sparks like it, with Jak's own: his red eco aura is particles 273 and 274 (a flash) and 275 (a spark)
;; and his blue eco aura 255 and 256 (a flash), 257 (a spark) and 260 (a glint), all launched at his joints each frame
;; (target-powerup-process in powerups.gc). Blue's lightning bolt, 259, is left out: Jak bends its angle by whether he is
;; jumping, which is his own state. A hazard with no eco shows nothing.

;; The desperation. The eco is stronger the weaker Jak is: it multiplies the strength of every eco effect, which is how far a
;; blue babak's speed and the bomb's pull go and how far a red hit throws him (never their chance or their number, and the
;; red second hit stays one extra hit). It is 1.0 with Jak at full health (his fact's health-max, 3 in the game) and
;; *gauntlet-desperation-max* with one hit left, linear between, so with the default 2.0 three hits is 1.0, two is 1.5 and
;; one is 2.0. A blue babak that runs three times faster at full health runs six times faster at one hit, because the
;; multiplier itself is scaled. It is read live wherever an effect is applied, so a power cell calms the lurkers at once.
;; It is also what makes a charge look stronger: the aura below is denser and the glow brighter by the same number.

(defconstant GAUNTLET_ECO_GLOW_MAX 2.0) ;; the glow of a charge is at most this many times its usual light, however high the desperation
(defconstant GAUNTLET_ECO_AURA_MAX_EXTRA 2.0) ;; and its aura launches at most this many more bursts a frame than its usual one

(defun gauntlet-desperation ()
  "How many times stronger the eco is for Jak's health now: 1.0 at his full health, *gauntlet-desperation-max* at one hit
   (or none) left, linear between, and 1.0 when there is no Jak or a Jak with no more than one hit to lose."
  (if (and *target* (< 1.0 (-> *target* fact health-max)))
    (lerp-scale 1.0 *gauntlet-desperation-max* (-> *target* fact health) (-> *target* fact health-max) 1.0)
    1.0))

(define *gauntlet-desperation-health* -1.0) ;; Jak's health the last time the poll looked, -1 with no Jak, so a change is told once

(defun gauntlet-desperation-poll! ()
  "Per-frame: say when Jak's health has changed, and what the eco does to him now."
  (let ((health (if *target* (-> *target* fact health) -1.0)))
    (when (!= health *gauntlet-desperation-health*)
      (set! *gauntlet-desperation-health* health)
      (if *target*
        (format 0 "GAUNTLET DESPERATION health ~F of ~F, effects x ~F~%" health (-> *target* fact health-max) (gauntlet-desperation)))))
  0)

(defun gauntlet-eco-glow! ((pd process-drawable) (kind gauntlet-eco))
  "Push the colors of pd's draw toward kind's eco, with a light of its own on top (the ogre boss's draw glows the same
   way), the light burning harder as the desperation rises. When pd is made, after its skeleton is, and again every frame
   by the aura."
  (let ((burn (fmin (gauntlet-desperation) GAUNTLET_ECO_GLOW_MAX)))
    (case kind
      (((gauntlet-eco red))
       (set-vector! (-> pd draw color-mult) 1.0 0.55 0.55 1.0)
       (set-vector! (-> pd draw color-emissive) (* 0.4 burn) (* 0.02 burn) 0.0 0.0))
      (((gauntlet-eco blue))
       (set-vector! (-> pd draw color-mult) 0.55 0.75 1.0 1.0)
       (set-vector! (-> pd draw color-emissive) 0.0 (* 0.1 burn) (* 0.45 burn) 0.0))))
  (none))

(defun gauntlet-eco-burst! ((pd process-drawable) (kind gauntlet-eco))
  "One burst of kind's eco aura: a flash at one of pd's joints, a spark at another. The first three joints are the root's
   and are left alone."
  (let ((flash (rand-vu-int-range 3 (+ (-> pd node-list length) -1)))
        (spark (rand-vu-int-range 3 (+ (-> pd node-list length) -1))))
    (case kind
      (((gauntlet-eco red))
       (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 273 274))
                         (vector<-cspace! (new 'stack-no-clear 'vector) (-> pd node-list data flash)))
       (launch-particles (-> *part-id-table* 275) (vector<-cspace! (new 'stack-no-clear 'vector) (-> pd node-list data spark))))
      (((gauntlet-eco blue))
       (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 255 256))
                         (vector<-cspace! (new 'stack-no-clear 'vector) (-> pd node-list data flash)))
       (if (rand-vu-percent? 0.5)
         (launch-particles (-> *part-id-table* 257) (vector<-cspace! (new 'stack-no-clear 'vector) (-> pd node-list data flash))))
       (launch-particles (-> *part-id-table* 260) (vector<-cspace! (new 'stack-no-clear 'vector) (-> pd node-list data spark))))))
  (none))

(defun gauntlet-eco-aura! ((pd process-drawable) (kind gauntlet-eco))
  "One frame of kind's eco aura: a burst, which on something that moves streams out behind it as a trail, and as many more
   as the desperation is over 1.0 (a fraction of a burst is the chance of one), at most GAUNTLET_ECO_AURA_MAX_EXTRA, so a
   charge burns thicker the weaker Jak is. The glow is kept up with it. Not while pd is off screen."
  (when (and (!= kind (gauntlet-eco none)) (not (logtest? (-> pd draw status) (draw-status hidden no-anim))))
    (gauntlet-eco-glow! pd kind)
    (gauntlet-eco-burst! pd kind)
    (let* ((extra (fmin (+ (gauntlet-desperation) -1.0) GAUNTLET_ECO_AURA_MAX_EXTRA))
           (whole (the int extra)))
      (dotimes (i whole)
        (gauntlet-eco-burst! pd kind))
      (if (rand-vu-percent? (- extra (the float whole)))
        (gauntlet-eco-burst! pd kind))))
  (none))

(defun gauntlet-eco-second-hit! ((jak process))
  "The second hit of a red strike. An attack has no damage field (a plain one takes one hit, and the one that would take
   his last kills him), so once the first has landed on a Jak with more than one hit left, the second is taken the way any
   pickup takes health, a negative green eco. It can never be the one that kills him, only the first can."
  (when (and *target* (< 1.0 (-> *target* fact health)))
    (send-event jak 'get-pickup (pickup-type eco-green) (- (-> *FACT-bank* health-single-inc))))
  (none))

;; ------------------------------------------------------------- the power cell --

;; A power cell heals Jak. The game leaves his health alone when he takes one (pickup-collectable! in engine/game/game-info.gc
;; only counts it and closes the task), so there is nothing to fight: the hook that file calls as the cell is taken (the same
;; shape as *entity-born-hook*) raises his health to 3 hits if it was lower. Never above 3, and never for a Jak who is already
;; dying. In the game 3 is health-max-default and nothing raises health-max or health past it (green eco seeks to health-max,
;; the pills too), so 4 is not reachable; the heal is clamped to 3 anyway, and to health-max if that were ever lower.

(defconstant GAUNTLET_CELL_HEAL_TO 3.0) ;; the hits a power cell heals Jak up to

(defun *fuel-cell-picked-hook* ()
  "Jak has just taken a power cell: with *gauntlet-cell-heal-enabled* on, heal him to GAUNTLET_CELL_HEAL_TO hits, or leave
   him as he is when he has that many or more, or none left."
  (when (and *gauntlet-cell-heal-enabled* *target*)
    (let* ((fact (-> *target* fact))
           (before (-> fact health))
           (after (fmax before (fmin GAUNTLET_CELL_HEAL_TO (-> fact health-max)))))
      (cond
        ((and (< 0.0 before) (< before after))
         (set! (-> fact health) after)
         (set-time! (-> fact health-pickup-time))
         (format 0 "GAUNTLET CELL healed from ~F to ~F~%" before after))
        (else (format 0 "GAUNTLET CELL no heal needed, health ~F~%" before)))))
  (none))

;; ------------------------------------------------------------------ the muse --

;; Misty Island has one state that matters, and it is the muse's: is she with Jak or not. The island's muse (levels/misty/muse.gc)
;; is a power cell that runs; catching her ends a chase. Here catching her is the island calming down.
;;   LOOSE    she is not with Jak: mayhem. The state on arrival, before the first catch: "you catch her and things behave
;;            normally" makes not having caught her yet the abnormal one.
;;   CARRIED  she is: the mod's usual lurkers (the eco-charged ones, the clones of "the horde"), nothing more.
;; *gauntlet-muse-carried* is the one authority, for the log, the state file, the icon and every effect below; nothing keeps a
;; second copy. It flips in three places only, all below: gauntlet-muse-caught! (the muse's own state calls it as she is caught),
;; gauntlet-muse-drop! (Jak is hit, bonks, or dies) and gauntlet-muse-poll! (Misty is entered or left). The first catch is the
;; game's (the cell, the cutscene) and the muse is gone as the game makes her; the catches after it are over at once and give nothing.
;; Dropping her pops a new muse out on her path where Jak lost her, to be chased and caught again (see "the muse's body").
;;
;; While LOOSE, on Misty only (every effect asks gauntlet-mayhem-for? of its own process, whose entity says what level it is of):
;;   more enemies   each lurker Misty places has misty-mayhem-extra more clones, on top of lurker-multiplier's ("the horde"); catching
;;                  her takes only those away, with a puff
;;   faster         babaks and bonelurkers run misty-mayhem-speed times faster (babak.gc, bonelurker.gc): live, and it composes
;;                  with the desperation by multiplication, a blue babak at one hit running both
;;   stronger       a babak is born charged with the chance misty-mayhem-charge-chance instead of babak-charge-chance
;; The muse herself, the sharkey and the lurkers that are not nav enemies (the balloon lurkers, the quicksand ones) are not
;; reached; the first has no use for it and the rest have no pace or charge to scale.

(defconstant GAUNTLET_MUSE_FLASH_TIME (seconds 0.8)) ;; the icon's flash, and the burn of its glow, after a flip

(define *gauntlet-muse-carried* #f) ;; THE authority: the muse is with Jak. Starts every visit to Misty #f
(define *gauntlet-muse-episode* 0) ;; counts the times she has gone loose (arriving counts), so a group of the horde tops itself up once for each
(define *gauntlet-muse-flip-time* (- 0 (seconds 3600))) ;; when the state last flipped, long ago until it does: the icon's flash reads it
(define *gauntlet-muse-was-here* #f) ;; Misty was active the last time the poll looked
(define *gauntlet-muse-health* -1.0) ;; Jak's health the last time the poll looked, -1 with no Jak: a fall in it is a hit

(defun gauntlet-misty-active? ()
  "True while Misty Island is loaded and running, wherever Jak is: the muse's state lives exactly that long."
  (= (level-status *level* 'misty) 'active))

(defun gauntlet-muse-loose? ()
  "True while the mayhem is on: the setting is on, Misty is running and the muse is not with Jak."
  (and *gauntlet-misty-muse-enabled* (not *gauntlet-muse-carried*) (gauntlet-misty-active?)))

(defun gauntlet-mayhem-for? ((proc process))
  "True when the mayhem applies to proc: the muse is loose and proc is something Misty placed (its entity is of Misty's level),
   so a babak of the swamp is never rushed because a muse got away."
  (and (gauntlet-muse-loose?) (-> proc entity) (= (-> proc entity extra level name) 'misty)))

(defun gauntlet-misty-pace ((proc process))
  "How many times faster than its own pace proc moves now: *gauntlet-misty-mayhem-speed* in the mayhem, else 1.0."
  (if (gauntlet-mayhem-for? proc) *gauntlet-misty-mayhem-speed* 1.0))

(defun gauntlet-babak-charge-chance ((proc process))
  "The chance the babak proc, being born, is charged with eco: the mayhem's in the mayhem, else babak-charge-chance."
  (if (gauntlet-mayhem-for? proc) *gauntlet-misty-mayhem-charge-chance* *gauntlet-babak-charge-chance*))

(defun gauntlet-muse-flip! ((carried symbol))
  "Make carried the muse's state and say so, once: an eco burst at Jak (blue and a green eco chime when she is his, red and the
   warning when he has lost her) beside the icon's flash. A flip to the state she is in already is nothing."
  (when (!= carried *gauntlet-muse-carried*)
    (set! *gauntlet-muse-carried* carried)
    (set-time! *gauntlet-muse-flip-time*)
    (if (not carried) (+! *gauntlet-muse-episode* 1))
    (format 0 "GAUNTLET MUSE now ~A~%" (if carried "carried, things are calm" "loose, mayhem"))
    (when *target*
      (dotimes (i 6)
        (gauntlet-eco-burst! *target* (if carried (gauntlet-eco blue) (gauntlet-eco red))))
      (if carried
        (sound-play "g-eco-pickup" :position #f)
        (sound-play "robo-warning" :position #f))))
  0)

;; ------------------------------------------------------------------ the ring --

(defconstant GAUNTLET_RING_LIFT (meters 0.3)) ;; a ring floats this far over the ground so it is not buried
(defconstant GAUNTLET_RING_EDGE_SPACING (meters 1)) ;; along the arc, between the spots of the wall at the edge: close enough that they run together into one line
(defconstant GAUNTLET_RING_CLOCK_SPACING (meters 1.5)) ;; and of the ring that grows from the middle, which is the lighter of the two
(defconstant GAUNTLET_RING_MIN_SPOTS 6) ;; a ring this small is still a ring, not a spot
(defconstant GAUNTLET_RING_MAX_SPOTS 112) ;; the most spots one ring takes, however big a radius the console sets: the particle table's cost. A bigger circle spaces its spots wider, it never costs more
(defconstant GAUNTLET_RIM_SPACING (meters 2.5)) ;; along the arc, between the ground probes of a rim
(defconstant GAUNTLET_RIM_SAMPLES 96) ;; the most probes a rim keeps. gauntlet-rim holds this many, and a circle with more spots reads between them
(defconstant GAUNTLET_RING_PULSE_HZ 1.5) ;; the wall pulses this many times a second before the clock has started...
(defconstant GAUNTLET_RING_PULSE_EXTRA 6.0) ;; ...and by the time the clock has run out it has pulsed this many times more, quicker the nearer the end gets
(defconstant GAUNTLET_RING_MAX_EMBERS 16) ;; the most embers launched in one frame over the swept ground
(defconstant GAUNTLET_RING_EMBER_AREA 50.0) ;; square meters of swept ground one ember a frame is spread over, so a small blast is not a bonfire
(defconstant GAUNTLET_PART_RING_EDGE_DIM 3551) ;; the particles a ring launches: the wall between pulses...
(defconstant GAUNTLET_PART_RING_EDGE_BRIGHT 3552) ;; ...and on a pulse,
(defconstant GAUNTLET_PART_RING_CLOCK 3553) ;; the ring that grows from the middle,
(defconstant GAUNTLET_PART_RING_EMBER 3554) ;; and the glow of the ground it has swept

;; A ring over ground that is not flat. The ground is probed for once, where the ring will stand, and what the probes found
;; is kept here: how much higher or lower the ground is at each of count spots around the rim than at the center, all at
;; the radius the probes were made at. A circle of any smaller radius takes its heights from these, in proportion.
(deftype gauntlet-rim (structure)
  ((count  int32)
   (radius float)
   (rise   float 96))) ;; GAUNTLET_RIM_SAMPLES of them

;; the rim of a ring on flat ground: no spots, so every ring that is given it stands at the height of its center
(define *gauntlet-flat-rim* (new 'global 'gauntlet-rim))
(set! (-> *gauntlet-flat-rim* count) 0)

(defun gauntlet-ring-spots ((radius float) (spacing float) (most int))
  "How many spots a circle of radius takes to have one every spacing along its arc, at least GAUNTLET_RING_MIN_SPOTS and at
   most most."
  (max GAUNTLET_RING_MIN_SPOTS (min most (the int (/ (* TWO_PI radius) spacing)))))

(defun gauntlet-ring-rise ((rim gauntlet-rim) (radius float) (angle float))
  "How far above the ground at the center the ground is at angle (in rotation units) on a ring of radius: between the two
   probes of rim on either side of that angle, and in proportion to radius over the radius they were made at, so the
   circles inside settle onto the center's own ground. Nothing for a flat rim. A circle wider than the probes were made at
   keeps the heights of the rim."
  (cond
    ((zero? (-> rim count)) 0.0)
    (else
     (let* ((turns (/ angle DEGREES_PER_ROT))
            (past (- turns (the float (the int turns))))
            (around (if (< past 0.0) (+ past 1.0) past))
            (at (* around (the float (-> rim count))))
            (low (min (the int at) (+ (-> rim count) -1)))
            (high (if (>= (+ low 1) (-> rim count)) 0 (+ low 1)))
            (inward (if (< 0.0 (-> rim radius)) (fmin 1.0 (/ radius (-> rim radius))) 0.0)))
       (* inward (lerp (-> rim rise low) (-> rim rise high) (- at (the float low))))))))

;; Every circle drawn on the ground in this mod means the same thing: get out before the inner ring reaches you. The red wall
;; at the edge, standing still, is where the hurt ends; it pulses, quicker the less time is left. The inner ring grows from the
;; middle and reaches the wall at the moment of impact: it is the clock. Whatever it has swept already glows, and is the blast's:
;; being behind the inner ring is not being safe, it is the one place to get out of. A new hazard with an area shows its area
;; this way, with gauntlet-ring, and never some other way.

;; The wall between pulses is dim, and a pulse lights it up, so the line never goes out: it only breathes. Launched on every
;; spot of a circle every frame, so each lives two or three frames, long enough that no frame shows a gap, short enough that
;; nothing trails. Red, the colour of strength. Big enough that spots 2 m apart run together.
(defpart 3551
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 2.6))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 12.0)
   (:b 4.0)
   (:a 30.0)
   (:timer (seconds 0.04))
   (:flags (bit2 bit3 bit14))))

(defpart 3552
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 3.2))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 70.0)
   (:b 24.0)
   (:a 112.0)
   (:timer (seconds 0.04))
   (:flags (bit2 bit3 bit14))))

;; The clock: hotter than the wall, orange going on yellow, so the ring that is coming and the wall it is coming to are not one thing.
(defpart 3553
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 2.2))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 170.0)
   (:b 50.0)
   (:a 96.0)
   (:timer (seconds 0.04))
   (:flags (bit2 bit3 bit14))))

;; The swept ground: a few embers a frame, each rising a little and fading over a quarter of a second.
(defpart 3554
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 1.0) (meters 0.8))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 40.0 70.0)
   (:b 4.0 12.0)
   (:a 60.0)
   (:vel-y (meters 0.002))
   (:fade-a -0.8)
   (:timer (seconds 0.25))
   (:flags (bit2 bit3 bit14))))

(defun gauntlet-fraction ((value float))
  "The part of a non-negative value after the point."
  (- value (the float (the int value))))

(defun gauntlet-ring-circle ((center vector) (radius float) (spots int) (part int) (rim gauntlet-rim))
  "Launch the particle part on each of spots, evenly around a circle of radius on the ground at center. rim says how the
   ground rises and falls around center, or *gauntlet-flat-rim* when it is flat."
  (let ((at (new 'stack-no-clear 'vector)))
    (dotimes (i spots)
      (let ((angle (* (/ DEGREES_PER_ROT (the float spots)) (the float i))))
        (set! (-> at x) (+ (-> center x) (* radius (sin angle))))
        (set! (-> at y) (+ (-> center y) (gauntlet-ring-rise rim radius angle) GAUNTLET_RING_LIFT))
        (set! (-> at z) (+ (-> center z) (* radius (cos angle))))
        (set! (-> at w) 1.0)
        (launch-particles (-> *part-id-table* part) at))))
  0)

(defun gauntlet-ring-fill ((center vector) (swept float) (rim gauntlet-rim))
  "Launch a few embers on the ground inside swept of center: a sunflower, the points of one frame at the golden angle from
   one another and at radii whose squares are evenly spaced, so they cover the disc evenly and never in clumps. Each frame
   the whole pattern is turned and shifted by amounts that never come round, so over the life of an ember the disc is
   covered without a spoke or a ring showing. The ground under each is the rim's, in proportion."
  (let* ((meters-swept (/ swept METER_LENGTH))
         (embers (min GAUNTLET_RING_MAX_EMBERS
                      (max 2 (the int (/ (* (* PI meters-swept) meters-swept) GAUNTLET_RING_EMBER_AREA)))))
         (tick (the float (logand (current-time) #xfff)))
         (shift (gauntlet-fraction (* tick 0.1236068)))
         (turn (gauntlet-fraction (* tick 0.0472136)))
         (at (new 'stack-no-clear 'vector)))
    (dotimes (i embers)
      (let* ((from-middle (* swept (sqrtf (/ (+ (the float i) shift) (the float embers)))))
             (angle (* DEGREES_PER_ROT (gauntlet-fraction (+ (* (the float i) 0.381966) turn)))))
        (set! (-> at x) (+ (-> center x) (* from-middle (sin angle))))
        (set! (-> at y) (+ (-> center y) (gauntlet-ring-rise rim from-middle angle) GAUNTLET_RING_LIFT))
        (set! (-> at z) (+ (-> center z) (* from-middle (cos angle))))
        (set! (-> at w) 1.0)
        (launch-particles (-> *part-id-table* GAUNTLET_PART_RING_EMBER) at))))
  0)

(defun gauntlet-ring ((center vector) (radius float) (clock float) (elapsed float) (rim gauntlet-rim))
  "Draw an area that will hurt, on the ground at center, for one frame: a wall of red at radius that does not turn and pulses,
   a ring that has grown from the middle to radius times clock, and embers over the ground that ring has swept. clock is the
   part of the time that has run, 0.0 while it has not started and 1.0 at the moment of impact, so the ring reaches the wall
   exactly then. elapsed is the seconds since the drawing began, which the pulse runs by: it beats GAUNTLET_RING_PULSE_HZ times
   a second, and over the whole run of the clock GAUNTLET_RING_PULSE_EXTRA times more, in proportion to the square of the clock
   so that the rate climbs as the clock does. rim says how the ground rises and falls around center, or *gauntlet-flat-rim*
   when it is flat."
  (let* ((run (fmax 0.0 (fmin 1.0 clock)))
         (pulse (+ (* GAUNTLET_RING_PULSE_HZ elapsed) (* (* GAUNTLET_RING_PULSE_EXTRA run) run)))
         (swept (* radius run)))
    (gauntlet-ring-circle center radius (gauntlet-ring-spots radius GAUNTLET_RING_EDGE_SPACING GAUNTLET_RING_MAX_SPOTS)
                          (if (< (gauntlet-fraction pulse) 0.5) GAUNTLET_PART_RING_EDGE_BRIGHT GAUNTLET_PART_RING_EDGE_DIM)
                          rim)
    ;; the clock has not started, or the area is a point: nothing has been swept
    (when (< (meters 1) swept)
      (gauntlet-ring-circle center swept (gauntlet-ring-spots swept GAUNTLET_RING_CLOCK_SPACING GAUNTLET_RING_MAX_SPOTS)
                            GAUNTLET_PART_RING_CLOCK rim)
      (gauntlet-ring-fill center swept rim)))
  0)

;; ------------------------------------------------------------------ the bomb --

(deftype gauntlet-bomb (process-drawable)
  ((body      handle)
   (ground-y  float)
   (fall-from float)
   (next-tick float)
   (pull-speed float)
   (pulling symbol)
   (countdown int)
   (gravity float)
   (start-time time-frame) ;; when it appeared: the wall pulses by it, through the fall and the countdown alike
   (rim gauntlet-rim :inline)) ;; how the ground rises and falls around where it lands, probed once
  (:states
   gauntlet-bomb-fall
   gauntlet-bomb-countdown
   gauntlet-bomb-explode
   gauntlet-bomb-gone))

(defun gauntlet-seconds-since ((start time-frame))
  "How many seconds have passed since start."
  (/ (the float (- (current-time) start)) (the float (seconds 1))))

(defun gauntlet-ground-below ((where vector) (out vector))
  "The ground under where, written to out. The ground is searched for from just above where, and where itself
   stands in for it when there is none in reach, so the bomb always has somewhere to land."
  (set! (-> out quad) (-> where quad))
  (find-ground-and-draw-shadow where
                               out
                               0.0
                               (collide-kind background ground-object)
                               (the-as process-drawable #f)
                               GAUNTLET_GROUND_PROBE_UP
                               GAUNTLET_GROUND_PROBE_LENGTH)
  ;; a probe that found nothing hands back a spot above the start, which is no ground
  (if (< (+ (-> where y) GAUNTLET_GROUND_PROBE_UP) (-> out y))
    (set! (-> out y) (-> where y)))
  out)

(defun gauntlet-bomb-body ((body handle))
  "The manipy that draws the bomb, or #f once it is gone."
  (let ((proc (handle->process body)))
    (the-as manipy (if (and proc (type-type? (-> proc type) manipy)) proc))))

(defbehavior gauntlet-bomb-play gauntlet-bomb ((anim string) (mode symbol))
  "Have its body play anim through manipy's own events: mode 'play runs it once, 'loop runs it forever."
  (let ((body (gauntlet-bomb-body (-> self body))))
    (when body
      (send-event body 'anim-mode mode)
      (send-event body 'art-joint-anim anim 0)))
  0)

(defbehavior gauntlet-bomb-aura gauntlet-bomb ()
  "One frame of the bomb's blue eco aura at its body's joints, for as long as the body is there."
  (let ((body (gauntlet-bomb-body (-> self body))))
    (if body (gauntlet-eco-aura! body (gauntlet-eco blue))))
  0)

(defbehavior gauntlet-bomb-anim-done? gauntlet-bomb ()
  "True once the 'play anim has reached its end."
  (let ((body (gauntlet-bomb-body (-> self body))))
    (and body (send-event body 'query 'done))))

(defbehavior gauntlet-bomb-log gauntlet-bomb ((label string))
  "One GAUNTLET BOMB line: where the root is and where the body's main joint is drawn, in meters, so a play test
   can say whether its animations carry an offset from the root (the Yellow Sage's put him 7 m underground).
   Printed in two format calls because format takes at most six arguments each."
  (let ((body (gauntlet-bomb-body (-> self body))))
    (when (and body (nonzero? (-> body skel)) (-> body node-list) (nonzero? (-> body node-list)))
      (let ((nodes (-> body node-list))
            (probe (new 'stack-no-clear 'vector)))
        (when (< (joint-node-index darkecobomb-lod0-jg main) (-> nodes length))
          (vector<-cspace! probe (-> nodes data (joint-node-index darkecobomb-lod0-jg main)))
          (format 0 "GAUNTLET BOMB ~S root ~M ~M ~M" label (-> self root trans x) (-> self root trans y) (-> self root trans z))
          (format 0 " main ~M ~M ~M ground ~M~%" (-> probe x) (-> probe y) (-> probe z) (-> self ground-y))))))
  0)

(defbehavior gauntlet-bomb-probe-rim gauntlet-bomb ()
  "Find the ground around where the bomb lands, once: the height of the ground at each spot of a ring at *gauntlet-bomb-blast-radius*
   from the landing, against the height under the bomb, kept in its rim for the circles to be drawn from every frame after. A
   spot with no ground to be found under it takes the height of the ground under the bomb."
  (let* ((radius *gauntlet-bomb-blast-radius*)
         (spots (gauntlet-ring-spots radius GAUNTLET_RIM_SPACING GAUNTLET_RIM_SAMPLES))
         (low (-> self ground-y))
         (high (-> self ground-y))
         (probe (new 'stack-no-clear 'vector))
         (ground (new 'stack-no-clear 'vector)))
    (set! (-> self rim count) spots)
    (set! (-> self rim radius) radius)
    (dotimes (i spots)
      (let ((angle (* (/ DEGREES_PER_ROT (the float spots)) (the float i))))
        (set! (-> probe x) (+ (-> self root trans x) (* radius (sin angle))))
        (set! (-> probe y) (+ (-> self ground-y) GAUNTLET_BOMB_RING_PROBE_RAISE))
        (set! (-> probe z) (+ (-> self root trans z) (* radius (cos angle))))
        (set! (-> probe w) 1.0)
        (gauntlet-ground-below probe ground)
        ;; a probe that found nothing hands back its own start
        (if (>= (-> ground y) (-> probe y))
          (set! (-> ground y) (-> self ground-y)))
        (set! (-> self rim rise i) (- (-> ground y) (-> self ground-y)))
        (set! low (fmin low (-> ground y)))
        (set! high (fmax high (-> ground y)))))
    (format 0 "GAUNTLET BOMB ring ~D spots, radius ~M m, ground from ~M m to ~M m~%" spots radius low high))
  0)

(defbehavior gauntlet-bomb-mark-blast gauntlet-bomb ((clock float))
  "Draw what the blast will take, from the moment the bomb starts to fall until it goes off, in the mod's one language for an
   area that will hurt (gauntlet-ring): a red wall at *gauntlet-bomb-blast-radius* on the ground where it lands, a ring that
   grows from the middle and reaches the wall when the countdown reaches zero, and the ground it has swept glowing. clock is
   the part of the countdown that has run: 0.0 through the fall, when the clock has not started, up to 1.0 at the blast. All
   of it follows the ground the way the probes found it."
  (let ((center (new 'stack-no-clear 'vector)))
    ;; the bomb is high in the air while it falls, and the circles are on the ground it will land on
    (set! (-> center x) (-> self root trans x))
    (set! (-> center y) (-> self ground-y))
    (set! (-> center z) (-> self root trans z))
    (set! (-> center w) 1.0)
    (gauntlet-ring center *gauntlet-bomb-blast-radius* clock (gauntlet-seconds-since (-> self start-time)) (-> self rim)))
  0)

;; ------------------------------------------------------------------ the pull --

(defun gauntlet-pullable? ((jak target))
  "True when Jak is moving of his own accord, on foot, in the air or in water, where a sideways step is safe. Not while
   he is dying or something else has grabbed him (a cutscene, a sage, a warp gate), and not while he hangs from an
   edge, where his own state holds him in place."
  (and (not (logtest? (-> jak state-flags) (state-flags dying grabbed)))
       (not (real-movie?))
       (!= (-> jak next-state name) 'target-edge-grab)))

(defun gauntlet-jak-gripped? ((jak target))
  "True when Jak has something under his feet to push against: the ground, or the water he stands in."
  (or (logtest? (-> jak control status) (cshape-moving-flags onground))
      (logtest? (-> jak water flag) (water-flag touch-water))))

(defbehavior gauntlet-bomb-pull gauntlet-bomb ()
  "One frame of the bomb's gravity well. Jak within *gauntlet-bomb-pull-radius* of the bomb, sideways, is stepped toward
   it, never up or down and never past it. Gripped he moves at *gauntlet-bomb-ground-pull*; in the air his pull speed
   grows by *gauntlet-bomb-pull* every second and starts over from the ground speed when he lands. Either way the step is
   the desperation times that speed, taken now, so the bomb pulls a weak Jak harder and a healed one at once less. The step is the whirlpool's
   (levels/sunken/whirlpool.gc): the cache filled around him, integrate-and-collide! with the sideways velocity, his
   status put back so his own state logic does not see a move it did not make."
  (let ((jak *target*))
    (when (and jak (gauntlet-pullable? jak))
      (let* ((control (-> jak control))
             (toward (vector-! (new 'stack-no-clear 'vector) (-> self root trans) (-> control trans)))
             (distance (vector-xz-length toward)))
        (cond
          ((or (>= distance *gauntlet-bomb-pull-radius*) (< distance 1.0))
           (set! (-> self pull-speed) 0.0))
          (else
           (when (not (-> self pulling))
             (set! (-> self pulling) #t)
             (format 0 "GAUNTLET BOMB pull starts, Jak ~M m away~%" distance))
           (if (gauntlet-jak-gripped? jak)
             (set! (-> self pull-speed) *gauntlet-bomb-ground-pull*)
             (+! (-> self pull-speed) (* *gauntlet-bomb-pull* (seconds-per-frame))))
           ;; never carry him past the bomb: the speed is capped at what covers the distance in one frame
           (set! (-> toward y) 0.0)
           (vector-xz-normalize! toward (fmin (* (-> self pull-speed) (gauntlet-desperation)) (/ distance (seconds-per-frame))))
           (fill-cache-for-shape! control (+ 8192.0 (vector-xz-length toward)) (-> control root-prim collide-with))
           (let ((status (-> control status)))
             (integrate-and-collide! control toward)
             (set! (-> control status) status)))))))
  0)

(defbehavior gauntlet-bomb-init-by-other gauntlet-bomb ((where vector))
  "Appear *gauntlet-bomb-drop-height* above where, which is where Jak stands, and fall to the ground under it. The countdown
   and the fall's gravity are taken now, so changing them while the bomb is in the air does not bend this bomb's clock."
  ;; keep ticking whatever the actors around do (the finale's bomb does the same)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self body) (the-as handle #f))
  (set! (-> self pull-speed) 0.0)
  (set! (-> self pulling) #f)
  (set! (-> self countdown) *gauntlet-bomb-countdown*)
  (set! (-> self gravity) *gauntlet-bomb-gravity*)
  (set-time! (-> self start-time))
  (set! (-> self root) (new 'process 'trsqv))
  (let ((ground (new 'stack-no-clear 'vector)))
    (gauntlet-ground-below where ground)
    (set! (-> self ground-y) (-> ground y)))
  (set! (-> self root trans quad) (-> where quad))
  ;; where it lands is known now, and so is the ground around it: found once, for the circles of the fall and the countdown
  (gauntlet-bomb-probe-rim)
  (+! (-> self root trans y) *gauntlet-bomb-drop-height*)
  (set! (-> self fall-from) (-> self root trans y))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  ;; no entity, and a body that has none either: its draw is filed under the default level, where common art lives
  (set! (-> self entity) #f)
  (let ((body (manipy-spawn (-> self root trans) #f *gauntlet-darkecobomb-sg* #f :to self)))
    (when body
      (set! (-> self body) (ppointer->handle body))
      (send-event (ppointer->process body) 'rot-quat (-> self root quat))
      ;; its draw exists by now (manipy-init ran to its first state), and keeps this glow for good
      (let ((made (gauntlet-bomb-body (-> self body))))
        (if made (gauntlet-eco-glow! made (gauntlet-eco blue))))))
  (go gauntlet-bomb-fall)
  (none))

(defstate gauntlet-bomb-fall (gauntlet-bomb)
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (let ((body (gauntlet-bomb-body (-> self body))))
        ;; no body, no bomb
        (if (not body) (go gauntlet-bomb-gone))
        (gauntlet-bomb-aura)
        ;; the clock has not started: only the wall stands
        (gauntlet-bomb-mark-blast 0.0)
        (let* ((fallen (gauntlet-seconds-since (-> self state-time)))
               (y (- (-> self fall-from) (* 0.5 (-> self gravity) fallen fallen))))
          (set! (-> self root trans y) (fmax y (-> self ground-y)))
          (send-event body 'trans (-> self root trans))
          (if (>= (-> self ground-y) y) (go gauntlet-bomb-countdown)))))
  :code
    (behavior ()
      (gauntlet-bomb-play "darkecobomb-blast" 'play)
      ;; one frame for the body to take the new anim up, so 'done is asked of the right one
      (suspend)
      (until (gauntlet-bomb-anim-done?)
        (suspend))
      (gauntlet-bomb-play "darkecobomb-idle" 'loop)
      (suspend-for (seconds 0.2))
      (gauntlet-bomb-log "falling")
      (loop
        (suspend))))

(defstate gauntlet-bomb-countdown (gauntlet-bomb)
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self next-tick) GAUNTLET_BOMB_FIRST_TICK))
  :exit
    (behavior ()
      (if (-> self pulling)
        (format 0 "GAUNTLET BOMB pull ends, Jak ~M m away~%" (if *target* (vector-vector-xz-distance (-> self root trans) (target-pos 0)) 0.0))))
  :trans
    (behavior ()
      (gauntlet-bomb-pull)
      (gauntlet-bomb-aura)
      (let* ((elapsed (- (current-time) (-> self state-time)))
             (remaining (fmax 0.0 (/ (the float (- (-> self countdown) elapsed)) (the float (-> self countdown))))))
        ;; the growing ring is the clock itself: it reaches the wall on the frame the blast goes off
        (gauntlet-bomb-mark-blast (- 1.0 remaining))
        ;; the finale's own warning: a beep and a flash each time the clock's cosine drops under the bar,
        ;; and the bar drops with every beep, so they come faster as the end nears
        (when (< (cos (* 16384.0 (- 1.0 remaining))) (-> self next-tick))
          (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_TICK) 150 #f #f #f (-> self root trans) :to *entity-pool*)
          (+! (-> self next-tick) (- GAUNTLET_BOMB_TICK_STEP))
          (sound-play "robo-warning"))
        (if (>= elapsed (-> self countdown)) (go gauntlet-bomb-explode))))
  :code
    (behavior ()
      (sound-play "bomb-open")
      (gauntlet-bomb-play "darkecobomb-open" 'play)
      (suspend)
      (until (gauntlet-bomb-anim-done?)
        (suspend))
      (gauntlet-bomb-play "darkecobomb-spin-cycle" 'loop)
      (suspend-for (seconds 0.2))
      (gauntlet-bomb-log "landed")
      (loop
        (suspend))))

(defstate gauntlet-bomb-explode (gauntlet-bomb)
  :code
    (behavior ()
      (sound-play "explosion" :position #f)
      (activate! *camera-smush-control* 819.2 37 600 1.0 0.995)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_BLAST) 900 #f #f #f (-> self root trans) :to *entity-pool*)
      (let ((body (gauntlet-bomb-body (-> self body))))
        (if body (send-event body 'draw #f)))
      ;; Jak inside the blast loses all his health: he takes his hit reaction, then dies the normal death. A plain 'attack, so a recent hit's invulnerability spares him
      (when (and *target* (< (vector-vector-distance (-> self root trans) (target-pos 0)) *gauntlet-bomb-blast-radius*))
        (send-event *target* 'attack #f (static-attack-info ((mode 'death)))))
      ;; Jak's hit reads the bomb for where it came from when he next runs, so it stays until he has
      (suspend-for (seconds 1))
      (deactivate self)))

(defstate gauntlet-bomb-gone (gauntlet-bomb)
  :code
    (behavior ()
      (deactivate self)))

(define *gauntlet-bomb* (the-as handle #f)) ;; the bomb last dropped, so the drop spots know whether one is still alive

(defun gauntlet-bomb-alive? ()
  "True while the last bomb dropped is still in the world, from the moment it appears to the end of its blast."
  (if (handle->process *gauntlet-bomb*) #t #f))

(defun gauntlet-bomb-drop! ((where vector))
  "Drop the bomb on where, if its art is there to draw. A request is never held back for a bomb that is still alive: the new
   one comes down beside it, and from then on is the bomb the spots and the state file look at. Only the spots wait for the
   last bomb to end, and they check for themselves."
  (cond
    ((not (gauntlet-art-ready? *gauntlet-darkecobomb-sg*))
     (format 0 "GAUNTLET DROP: the bomb's art group is not loaded, nothing dropped~%"))
    (else
     (if (gauntlet-bomb-alive?)
       (format 0 "GAUNTLET DROP: a bomb is already alive, this one comes down beside it~%"))
     (let ((bomb (process-spawn gauntlet-bomb :init gauntlet-bomb-init-by-other where :to *entity-pool*)))
       (if bomb
         (set! *gauntlet-bomb* (ppointer->handle bomb))
         (format 0 "GAUNTLET DROP: no process left for the bomb, nothing dropped~%")))))
  0)

;; ------------------------------------------------------------- the drop spots --

(defun gauntlet-in-level? ((which symbol))
  "True when Jak is inside the level called which."
  (let ((lev (level-get-target-inside *level*)))
    (and lev (= (-> lev name) which))))

(defun gauntlet-in-training? ()
  "True when Jak is in Geyser Rock."
  (gauntlet-in-level? 'training))

;; The places on Geyser Rock (level training) where the bomb drops by itself, one table row each: (row index name enabled x y z),
;; the spot in meters and enabled the switch that turns the spot off. Each spot is armed on its own: Jak walking within
;; *gauntlet-bridge-trigger-radius* of it, sideways, drops the bomb on it, and it drops there again only once he has been
;; farther than *gauntlet-bridge-rearm-range* from it. The spots share those two settings. Only one bomb is alive at a time,
;; whichever spot asks. The only place that says how many spots there are is this table; GAUNTLET_DROP_SPOTS, below, is the count.
;;
;; Row 0 is the bridge: the tall pillar runners jump from is about 17 m away, so the pull drags that jump back toward the bridge.
;; Row 1 is the blue eco vent before the precursor door, the only vent in the level (ecovent-245 of training-actors.json, with
;; the camera that introduces it, training-cam index 4, standing on it; the door, tra-iris-door-1, is 69 m east-southeast).
;; The lesson it teaches is the bomb's: Jak charges up with the blue eco, the circle goes up, and he runs out of it.
(defmacro gauntlet-drop-spot-table (join row)
  "Expand row once per spot, (row index name enabled x y z), under the form join (begin, to do something for each)."
  `(,join
     (,row 0 "bridge" *gauntlet-bridge-enabled* -1313.8 40.5 946.4)
     (,row 1 "vent" *gauntlet-vent-enabled* -1307.98 29.55 854.21)))

;; The rows of the table, written out: deftype needs a literal array size. A row added above needs this raised with it.
(defconstant GAUNTLET_DROP_SPOTS 2)

(deftype gauntlet-drop-world (structure)
  ((armed symbol GAUNTLET_DROP_SPOTS))) ;; false from a spot's drop until Jak has been far from it again

(define *gauntlet-drop-world* (new 'global 'gauntlet-drop-world))

(dotimes (i GAUNTLET_DROP_SPOTS)
  (set! (-> *gauntlet-drop-world* armed i) #t))

(defmacro gauntlet-row-spot-at (index name enabled x y z)
  `(if (= i ,index) (set-vector! out (meters ,x) (meters ,y) (meters ,z) 1.0)))

(defun gauntlet-drop-spot-at ((i int) (out vector))
  "Spot i of the table, written to out and handed back."
  (gauntlet-drop-spot-table begin gauntlet-row-spot-at)
  out)

(defun gauntlet-spot-poll! ((index int) (name string) (enabled symbol))
  "Per-frame, for one spot while Jak is on Geyser Rock: drop one bomb on it when Jak comes within
   *gauntlet-bridge-trigger-radius* of it and no bomb is alive; do not again until he has been farther than
   *gauntlet-bridge-rearm-range* from it. With its switch (enabled) off it never drops, though it keeps track of Jak coming
   and going."
  (let* ((spot (gauntlet-drop-spot-at index (new 'stack-no-clear 'vector)))
         (distance (vector-vector-xz-distance (target-pos 0) spot)))
    (cond
      ((> distance *gauntlet-bridge-rearm-range*) (set! (-> *gauntlet-drop-world* armed index) #t))
      ((and enabled (-> *gauntlet-drop-world* armed index) (< distance *gauntlet-bridge-trigger-radius*) (not (gauntlet-bomb-alive?)))
       (set! (-> *gauntlet-drop-world* armed index) #f)
       (format 0 "GAUNTLET SPOT: Jak is ~M m from the ~S spot, dropping the bomb on it~%" distance name)
       (gauntlet-bomb-drop! spot))))
  0)

(defmacro gauntlet-row-spot-poll (index name enabled x y z)
  `(gauntlet-spot-poll! ,index ,name ,enabled))

(defun gauntlet-drop-spots-poll! ()
  "Per-frame: every spot of the table is watched while Jak is on Geyser Rock, as gauntlet-spot-poll! says."
  (when (and *target* (gauntlet-in-training?))
    (gauntlet-drop-spot-table begin gauntlet-row-spot-poll))
  0)

(defun gauntlet-drop-on-spot! ((index int) (kind string))
  "The console's bomb on spot index: the spot itself, whatever the trigger radius or the arming say. Only on Geyser Rock; kind
   is what was asked for, for the log."
  (if (gauntlet-in-training?)
    (gauntlet-bomb-drop! (gauntlet-drop-spot-at index (new 'stack-no-clear 'vector)))
    (format 0 "GAUNTLET DROP: ~S asked for off Geyser Rock, ignored~%" kind))
  0)

;; -------------------------------------------------------------- the stampede --

;; A herd of yakows charges at Jak in a straight line and runs on through. Like the bomb it is available on every level:
;; the yakow's art group is in GAME.CGO (common_art_groups, with Sandover's pris tpage 400, see game.gd), its skelgroup asks for
;; texture level 2, and the yakows are a new entity-less process, not the village's yakow, whose code ships in VI1.DGO and
;; wants a nav mesh. They are a pattern to learn, not a threat that adapts: one fixed formation, one fixed heading, no homing.
;;
;; The formation is three columns across a band, the center one on the line through the spot the herd is aimed at, and rows
;; spaced along the heading, the side columns half a row behind, so a row is a staggered chevron with the center yakow
;; first. Slot 0 is the center of the lead row and hits the spot dead on, so standing still is always wrong. Between columns
;; there is a lane about 2 m clear (more than Jak is wide) to sidestep into, and the band is narrow enough to run out of.
;; Slot i is row i / 3, column i mod 3, so a bigger herd only adds rows behind and the slots of a smaller one never move.
;;
;; Some yakows are charged with red eco, which in the player's language is strength: a red yakow is the same yakow, in the
;; same slot, with a heavier hit. The first *gauntlet-stampede-red-count* slots are red, so the lead row is red first and the
;; danger sits where the player learns to look. A red yakow glows red and trails red eco sparks ("the eco charge", above),
;; and its touch costs two hits instead of one and throws Jak far.

(defconstant GAUNTLET_STAMPEDE_COLUMNS 3) ;; yakows to a row
(defconstant GAUNTLET_STAMPEDE_COLUMN_SPACING (meters 6.5)) ;; between the columns' centers: the band is 13 m from center to center
(defconstant GAUNTLET_STAMPEDE_ROW_SPACING (meters 9)) ;; between rows, so at 14 m/s a row arrives every 0.65 s
(defconstant GAUNTLET_STAMPEDE_APPROACH (meters 50)) ;; the lead row starts this far upstream of the spot it is aimed at
(defconstant GAUNTLET_STAMPEDE_EXIT (meters 30)) ;; and vanishes this far past it
(defconstant GAUNTLET_STAMPEDE_PROBE_RAISE (meters 6)) ;; the ground under a yakow is searched for from this far above it, so a rise in the ground does not bury it
(defconstant GAUNTLET_STAMPEDE_GROUND_SEEK (meters 20)) ;; and a yakow follows the ground up or down at most this fast
(defconstant GAUNTLET_STAMPEDE_SHOVE_BACK (meters 3.5)) ;; how far a hit throws Jak, about; his own hit reaction runs about as far again as this (target-hit-move)
(defconstant GAUNTLET_STAMPEDE_SHOVE_UP (meters 1.5)) ;; and how high
(defconstant GAUNTLET_YAKOW_RADIUS (meters 1.4)) ;; the touch sphere, snug to the body so the lanes are as wide as they look
(defconstant GAUNTLET_YAKOW_CENTER (meters 1.3)) ;; and how high above its feet it sits
(defconstant GAUNTLET_YAKOW_RUN_PACE 1.5) ;; the village yakow's run animation speed (yakow-bank run-anim-speed, capped) at its run speed...
(defconstant GAUNTLET_YAKOW_RUN_PACE_SPEED (meters 6)) ;; ...which is this; faster legs scale with the speed so the stride keeps up

;; No :shadow. Its shadow mesh has not been measured, and the sage's was the heaviest in the game, wrapping the shadow VU1's
;; 8-bit edge count (see *gauntlet-yellowsage-sg*); a herd of 30 would put 30 shadows on screen at once. Sort 1 is the pris
;; (character) draw group, and texture level 2 finds the art in level-default, where common art registers. The bounds and
;; lods are the village yakow's.
(defskelgroup *gauntlet-yakow-sg*
  yakow
  yakow-lod0-jg
  yakow-run-ja
  ((yakow-lod0-mg (meters 20)) (yakow-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 2.5 0 4.4)
  :longest-edge (meters 1.3)
  :texture-level 2
  :sort 1)

(deftype gauntlet-yakow (process-drawable)
  ((root      collide-shape :override)
   (heading   vector :inline)
   (speed     float)
   (remaining float)
   (timeout   int)
   (index     int)
   (pace      float)
   (phase     float)
   (eco       gauntlet-eco))
  (:states
   gauntlet-yakow-run
   gauntlet-yakow-gone))

(define *gauntlet-stampede-alive* 0) ;; yakows in the world, so the herd as a whole can be told finished
(define *gauntlet-stampede-last-hit* (- 0 (seconds 3600))) ;; when a yakow last hurt Jak, long ago until one does
(define *gauntlet-stampede-armed* #t) ;; false from Sandover's charge until Jak has been far from its spot again

;; Where the Sandover herd comes from, and how that was worked out. The spot is where the player stood, 11 m from farmer-3 and
;; 19 m from yakow-8 (village1-actors.json). The Forbidden Jungle is not in village1, so there are two readings of which
;; way it lies from the spot, and they agree: (1) the load boundary that makes the jungle display while Jak is in Sandover
;; (load-boundary-data.gc, ":fwd (display jungle display-no-wait)") is a small triangle on the way out to it, 98 m, -149 m
;; / 85 m, -120 m / 115 m, -112 m, whose center is the point below, 126 m to the east and a little north of the spot (north
;; being -z); (2) the jungle's own first continue point, "jungle-start" (level-info.gc), is at 258 m, -158 m, on the same side
;; of the spot, 13 degrees off the first reading. The first is used: it is the route Jak actually takes out of Sandover.
;; The herd starts GAUNTLET_STAMPEDE_APPROACH along the line from the spot toward that point and runs back through the spot.
(define *gauntlet-stampede-spot* (new 'static 'vector :x (meters -4.059) :y (meters 2.299) :z (meters -55.185) :w 1.0))
(define *gauntlet-stampede-jungle* (new 'static 'vector :x (meters 99.5) :y (meters 0) :z (meters -127.1) :w 1.0))

(defun gauntlet-stampede-alive? ()
  "True while any yakow of a herd is still in the world."
  (> *gauntlet-stampede-alive* 0))

(defun gauntlet-stampede-recent-hit? ()
  "True from the moment a yakow hurts Jak until the invulnerability that hit gives him has run out. The herd leaves him
   alone for that long: no yakow hits him again (the target would refuse, and a second hit in the frames before his hit
   reaction starts would not be refused), and none is solid to him, so he is not held inside a yakow that runs through
   him while he cannot be hurt."
  (not (time-elapsed? *gauntlet-stampede-last-hit* (-> *TARGET-bank* hit-invulnerable-timeout))))

(defbehavior gauntlet-yakow-trample gauntlet-yakow ((jak process) (touching touching-shapes-entry))
  "Jak touched this yakow: one plain 'attack, which his own invulnerability can refuse, never a kill. He is thrown away from
   the yakow, which with the herd coming at him is mostly along its heading, out of the lane he was standing in. A red yakow
   throws him much farther, the farther the weaker he is (the desperation), and costs him a second hit once the first has
   landed (gauntlet-eco-second-hit!)."
  (when (not (gauntlet-stampede-recent-hit?))
    (let* ((knock (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> self root trans)))
           (red? (= (-> self eco) (gauntlet-eco red)))
           (strength (gauntlet-desperation))
           (back (if red? (* GAUNTLET_ECO_RED_SHOVE_BACK strength) GAUNTLET_STAMPEDE_SHOVE_BACK))
           (up (if red? (* GAUNTLET_ECO_RED_SHOVE_UP strength) GAUNTLET_STAMPEDE_SHOVE_UP)))
      (set! (-> knock y) 0.0)
      ;; standing exactly on the yakow's center has no direction away from it, so use the way it runs
      (if (< (vector-xz-length knock) 40.96)
        (set! (-> knock quad) (-> self heading quad)))
      (vector-xz-normalize! knock back)
      (set! (-> knock y) up)
      (when (send-event jak 'attack touching (static-attack-info ((mode 'generic) (shove-back back) (shove-up up) (vector knock))))
        (set! *gauntlet-stampede-last-hit* (current-time))
        (if red? (gauntlet-eco-second-hit! jak))
        (format 0 "GAUNTLET STAMPEDE: ~S yakow ~D trampled Jak~%" (if red? "red" "plain") (-> self index)))))
  0)

(defbehavior gauntlet-yakow-event gauntlet-yakow ((proc process) (argc int) (message symbol) (block event-message-block))
  "The only thing a yakow listens to is Jak touching it: his shape sends 'touched, and he answers every one with 'touch."
  (case message
    (('touch) (gauntlet-yakow-trample proc (the-as touching-shapes-entry (-> block param 0)))))
  #f)

(defbehavior gauntlet-yakow-follow-ground gauntlet-yakow ((most float))
  "Move the yakow's height toward the ground under it, by at most most. The ground comes back as the probe's own height when
   there was none to find (see gauntlet-ground-below), and then the yakow keeps the height it has."
  (let ((probe (new 'stack-no-clear 'vector))
        (ground (new 'stack-no-clear 'vector)))
    (set! (-> probe quad) (-> self root trans quad))
    (+! (-> probe y) GAUNTLET_STAMPEDE_PROBE_RAISE)
    (gauntlet-ground-below probe ground)
    (if (< (-> ground y) (-> probe y))
      (seek! (-> self root trans y) (-> ground y) most)))
  0)

(defbehavior gauntlet-yakow-step gauntlet-yakow ()
  "One frame of the charge: a step along the heading at the stampede speed, the height of the ground under it, and whether
   it is time to go. It gives out when it has run its distance, or when its timeout has passed as a backstop, in case a
   yakow ever stops getting there."
  (let ((step (* (-> self speed) (seconds-per-frame))))
    (+! (-> self root trans x) (* (-> self heading x) step))
    (+! (-> self root trans z) (* (-> self heading z) step))
    (+! (-> self remaining) (- step))
    (gauntlet-yakow-follow-ground (* GAUNTLET_STAMPEDE_GROUND_SEEK (seconds-per-frame)))
    (set! (-> self root transv x) (* (-> self heading x) (-> self speed)))
    (set! (-> self root transv z) (* (-> self heading z) (-> self speed)))
    (set! (-> self root root-prim prim-core offense)
          (if (gauntlet-stampede-recent-hit?) (collide-offense no-offense) (collide-offense indestructible)))
    (when (or (<= (-> self remaining) 0.0) (time-elapsed? (-> self state-time) (-> self timeout)))
      (go gauntlet-yakow-gone)))
  0)

(defbehavior gauntlet-yakow-post gauntlet-yakow ()
  "The usual post, and the aura of the yakow's eco, which at its speed streams out behind it as a trail."
  (transform-post)
  (gauntlet-eco-aura! self (-> self eco))
  0)

(defstate gauntlet-yakow-run (gauntlet-yakow)
  :event gauntlet-yakow-event
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (gauntlet-yakow-step))
  :code
    (behavior ()
      (ja-channel-push! 1 0)
      (ja :group! yakow-run-ja :num! min)
      ;; each yakow starts its stride at its own point in the cycle, so a row does not gallop in lockstep
      (ja :num-func num-func-identity :frame-num (-> self phase))
      (loop
        (suspend)
        (ja :num! (loop! (-> self pace)))))
  :post gauntlet-yakow-post)

(defstate gauntlet-yakow-gone (gauntlet-yakow)
  :code
    (behavior ()
      (deactivate self)))

(defmethod deactivate ((this gauntlet-yakow))
  "However a yakow goes, running its distance, timing out or the level being torn down under it, it stops counting, and the
   last to go tells the log the herd is over."
  (+! *gauntlet-stampede-alive* -1)
  (if (zero? *gauntlet-stampede-alive*)
    (format 0 "GAUNTLET STAMPEDE: the herd is gone~%"))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defbehavior gauntlet-yakow-init-by-other gauntlet-yakow ((start vector) (heading vector) (run-length float) (index int) (speed float) (eco gauntlet-eco))
  "Appear at start, which is where this slot of the herd begins, facing along heading (a unit vector on the ground plane)
   and run-length meters of ground to cover, in game units, at speed. eco says what it is charged with, if anything."
  (stack-size-set! (-> self main-thread) 512)
  ;; counted from the start, so the count and deactivate's uncounting agree whatever happens next
  (+! *gauntlet-stampede-alive* 1)
  ;; keep running whatever the actors around do, as the bomb does
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self index) index)
  (set! (-> self speed) speed)
  (set! (-> self eco) eco)
  (set! (-> self remaining) run-length)
  ;; twice the time the distance takes, and five seconds more
  (set! (-> self timeout) (+ (the int (* 2.0 (/ run-length speed) (the float (seconds 1)))) (seconds 5)))
  (set! (-> self heading quad) (-> heading quad))
  (set! (-> self pace) (fmax 1.0 (* GAUNTLET_YAKOW_RUN_PACE (/ speed GAUNTLET_YAKOW_RUN_PACE_SPEED))))
  (set! (-> self phase) (the float (mod (* index 5) 16)))
  ;; a touch sphere that only Jak's own collision looks for: solid, so his move finds it and sends 'touch, and indestructible,
  ;; which is what makes the move report the touch at all (see the collide-offense comment in collide-shape-h.gc)
  (let ((shape (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-sphere shape (the uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind wall-object))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid))
      (set! (-> prim prim-core offense) (collide-offense indestructible))
      (set-vector! (-> prim local-sphere) 0.0 GAUNTLET_YAKOW_CENTER 0.0 GAUNTLET_YAKOW_RADIUS)
      (set-root-prim! shape prim))
    (backup-collide-with-as shape)
    (set! (-> self root) shape))
  (set! (-> self root trans quad) (-> start quad))
  ;; it appears on the ground wherever that is, rather than climbing to it
  (gauntlet-yakow-follow-ground (meters 1000))
  (quaternion-vector-angle! (-> self root quat) (new 'static 'vector :y 1.0 :w 1.0) (vector-y-angle heading))
  (vector-identity! (-> self root scale))
  (initialize-skeleton self *gauntlet-yakow-sg* '())
  (gauntlet-eco-glow! self eco)
  (update-transforms! (-> self root))
  (format 0 "GAUNTLET STAMPEDE yakow ~D start ~M ~M ~M ~S~%" index (-> start x) (-> start y) (-> start z) (if (= eco (gauntlet-eco red)) "red" "plain"))
  (go gauntlet-yakow-run)
  (none))

(defun gauntlet-stampede-slot ((index int) (out vector))
  "Where slot index of the herd stands, written to out: x is how far to the herd's right of its line (the line through the
   spot it is aimed at), z how far behind the lead row. Column 0 is the center and leads its row, 1 and 2 are the left and
   right half a row behind."
  (let* ((row (/ index GAUNTLET_STAMPEDE_COLUMNS))
         (column (- index (* row GAUNTLET_STAMPEDE_COLUMNS))))
    (set! (-> out x)
          (cond
            ((= column 0) 0.0)
            ((= column 1) (- GAUNTLET_STAMPEDE_COLUMN_SPACING))
            (else GAUNTLET_STAMPEDE_COLUMN_SPACING)))
    (set! (-> out z) (+ (* (the float row) GAUNTLET_STAMPEDE_ROW_SPACING) (if (= column 0) 0.0 (* 0.5 GAUNTLET_STAMPEDE_ROW_SPACING)))))
  out)

(defun gauntlet-stampede! ((spot vector) (heading vector) (why string))
  "Send the herd at spot: the lead row starts GAUNTLET_STAMPEDE_APPROACH upstream of it along heading (a unit vector on the
   ground plane, the way the herd runs), the rest in the formation behind it, and every yakow runs on through to
   GAUNTLET_STAMPEDE_EXIT past the spot. why says what asked, for the log. Nothing is sent when the yakow's art is not there to draw."
  (cond
    ((not (gauntlet-art-ready? *gauntlet-yakow-sg*))
     (format 0 "GAUNTLET STAMPEDE: the yakow's art group is not loaded, nothing sent~%"))
    (else
     (let ((size *gauntlet-stampede-herd-size*)
           (speed *gauntlet-stampede-speed*)
           (red-count (min *gauntlet-stampede-red-count* *gauntlet-stampede-herd-size*))
           (slot (new 'stack-no-clear 'vector))
           (start (new 'stack-no-clear 'vector)))
       (format 0 "GAUNTLET STAMPEDE triggered by ~S: aimed at ~M ~M ~M~%" why (-> spot x) (-> spot y) (-> spot z))
       (format 0 "GAUNTLET STAMPEDE heading ~D degrees, lead row starts ~M ~M ~M, herd of ~D at ~M m/s~%"
               (the int (* (vector-y-angle heading) (/ 360.0 DEGREES_PER_ROT)))
               (- (-> spot x) (* (-> heading x) GAUNTLET_STAMPEDE_APPROACH))
               (-> spot y)
               (- (-> spot z) (* (-> heading z) GAUNTLET_STAMPEDE_APPROACH))
               size
               speed)
       (format 0 "GAUNTLET STAMPEDE red yakows: ~D of ~D~S~%" red-count size (if (> red-count 0) ", the first slots, the lead row first" ""))
       (dotimes (i size)
         (gauntlet-stampede-slot i slot)
         ;; upstream is behind the heading, and the herd's right is the heading turned a quarter, (z, -x)
         (let ((upstream (+ GAUNTLET_STAMPEDE_APPROACH (-> slot z))))
           (set! (-> start x) (+ (- (-> spot x) (* (-> heading x) upstream)) (* (-> heading z) (-> slot x))))
           (set! (-> start y) (-> spot y))
           (set! (-> start z) (- (- (-> spot z) (* (-> heading z) upstream)) (* (-> heading x) (-> slot x))))
           (process-spawn gauntlet-yakow
                          :init gauntlet-yakow-init-by-other
                          start
                          heading
                          (+ upstream GAUNTLET_STAMPEDE_EXIT)
                          i
                          speed
                          (if (< i red-count) (gauntlet-eco red) (gauntlet-eco none))
                          :to *entity-pool*))))))
  0)

(defun gauntlet-stampede-ahead! ()
  "The console's stampede: the herd charges at Jak's spot from GAUNTLET_STAMPEDE_APPROACH ahead of where he faces, so
   he sees it coming, on any level."
  (let ((heading (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> *target* control quat-for-control))))
    (set! (-> heading y) 0.0)
    ;; the herd runs against his facing, toward him
    (vector-xz-normalize! heading -1.0)
    (gauntlet-stampede! (target-pos 0) heading "request"))
  0)

(defun gauntlet-stampede-from-jungle! ()
  "Sandover's herd: aimed at the spot beside the farmer, upstream toward the Forbidden Jungle, so it charges back out of it."
  (let ((heading (vector-! (new 'stack-no-clear 'vector) *gauntlet-stampede-spot* *gauntlet-stampede-jungle*)))
    (set! (-> heading y) 0.0)
    (vector-xz-normalize! heading 1.0)
    (gauntlet-stampede! *gauntlet-stampede-spot* heading "Sandover"))
  0)

;; How close, sideways, Jak and a yakow he hit must be for "from behind the yakow, at Jak" to have no direction: a hair.
(defconstant GAUNTLET_STAMPEDE_SAME_SPOT (meters 0.01))

(defun gauntlet-stampede-yakow-hit! ((yakow process-drawable))
  "Jak just attacked a farm yakow (yakow.gc calls this once per new attack, vulnerable or not). With
   *gauntlet-yakow-stampede-enabled* on and no herd running, the herd comes from behind that yakow, through it, at Jak: the
   heading is the way from the yakow to him, so the cause is the first thing the player sees when he turns around. The
   stampede's own yakows are another type and never reach this, so a herd cannot start a herd. When Jak is on top of the yakow
   there is no way from one to the other, and the herd comes the way the console's does, from ahead of where he faces."
  (cond
    ((not *target*) #f)
    ((not *gauntlet-yakow-stampede-enabled*) (format 0 "GAUNTLET STAMPEDE: yakow hit, off~%"))
    ((gauntlet-stampede-alive?) (format 0 "GAUNTLET STAMPEDE: yakow hit, skipped, a herd is running~%"))
    (else
     (let* ((jak (target-pos 0))
            (hit (-> yakow root trans))
            (heading (vector-! (new 'stack-no-clear 'vector) jak hit)))
       (format 0 "GAUNTLET STAMPEDE: yakow hit at ~M ~M ~M, herd sent~%" (-> hit x) (-> hit y) (-> hit z))
       (cond
         ((< (vector-vector-xz-distance jak hit) GAUNTLET_STAMPEDE_SAME_SPOT) (gauntlet-stampede-ahead!))
         (else
          (set! (-> heading y) 0.0)
          (vector-xz-normalize! heading 1.0)
          (gauntlet-stampede! jak heading "yakow"))))))
  0)

(defun gauntlet-stampede-poll! ()
  "Per-frame: in Sandover, send the herd when Jak comes within *gauntlet-stampede-trigger-radius* of the spot and no herd is
   running; not again until he has been farther than *gauntlet-stampede-rearm-range* from it, or has left the level. With
   *gauntlet-stampede-enabled* off it never charges, though it keeps track of Jak coming and going."
  (cond
    ((and *target* (gauntlet-in-level? 'village1))
     (let ((distance (vector-vector-xz-distance (target-pos 0) *gauntlet-stampede-spot*)))
       (cond
         ((> distance *gauntlet-stampede-rearm-range*) (set! *gauntlet-stampede-armed* #t))
         ((and *gauntlet-stampede-enabled*
               *gauntlet-stampede-armed*
               (< distance *gauntlet-stampede-trigger-radius*)
               (not (gauntlet-stampede-alive?)))
          (set! *gauntlet-stampede-armed* #f)
          (format 0 "GAUNTLET STAMPEDE: Jak is ~M m from the Sandover spot~%" distance)
          (gauntlet-stampede-from-jungle!)))))
    (else (set! *gauntlet-stampede-armed* #t)))
  0)

;; ------------------------------------------------------------------- Klaww --

;; The ogre boss of Mountain Pass arrives with the pelican at Sentinel Beach. When the pelican lands at its nest with the
;; stolen power cell (pelican-wait-at-nest, reached on landing, pelican.gc), Klaww falls out of the sky onto it and blows it up
;; the way the cannon does, except that the cell is not born: he holds it. He then lobs boulders at Jak, and the player can
;; shoot back: the buttons dotted around the beach (one table row each, see "state") each throw one of his own boulders back
;; at his chest, and one hit per button brings him down, at which point the cell falls out of him at the nest. "The world turns
;; against Jak", with an answer.
;;
;; The pelican is the one who knows when to start: it only announces (gauntlet-klaww-pelican-at-nest!) and the per-frame poll
;; acts on it, so the same story plays when the level loads with the pelican already at its nest, and does not when Jak is
;; not on the beach or the art is not there yet. Klaww's fall is a plain drop under gravity from GAUNTLET_KLAWW_FALL_HEIGHT,
;; with the landing ringed on the ground the way a boulder's is, so the player can see it coming and step off.
;;
;; The request file can drop him anywhere ("klaww"). On the beach that is the same fall onto the nest, crushing the pelican
;; if it is at its nest and otherwise just landing. On any other level he falls about GAUNTLET_KLAWW_AHEAD in front of Jak and
;; fights there: the buttons exist only on the beach, so off it he simply throws until Jak leaves the level or the console
;; turns him off. The level he arrived in is his home, and leaving it is what takes him away.
;;
;; Like the bomb and the herd he is entity-less and his art is common (ogreboss-ag.go and the tpage its textures live in, in
;; GAME.CGO; generic-button-ag.go for the buttons; common_art_groups in the decompiler config), so none of this depends on
;; the beach level's code or art: the beach only decides where he stands (the nest) and when he exists (Jak is inside it).
;; The levels/ogre/ogreboss.gc type is not reused: it is welded to the ogre level (entity perms, lava, columns, camera,
;; continue points). Its art, its anim names and its way of lobbing a boulder (a trajectory, a tumbling mesh, an impact
;; burst) are borrowed.
;;
;; Where he stands. pelican-1's entity (decompiler_out/jak1/entities/beach-actors.json) is at -162.25 11.65 -423.03, and that
;; is the nest: the first vertex of the pelican's path-from-nest0 and the end of its path-to-nest0 are the same point (the
;; path lump is all eight paths in one array; index 32 of 78 is the shared vertex), and pelican-wait-at-nest parks it
;; there. His skeleton's root is at his feet (the bind pose puts the toes at y 0.02 and the head at 13.6 m, with the arms
;; spread 6.8 m to the side), so the feet go on the ground the nest has under it, found with the same probe the bomb uses,
;; and the pelican, which is 3 m across, is left to sleep where it is. At full size he would be 14 m tall and as wide as the
;; rock, so he is drawn at GAUNTLET_KLAWW_SCALE: 10 m tall, still four times Jak's height seen across the bay.
;;
;; Why he draws himself (the yakow's way) and not through a manipy (the sage's and the bomb's): a manipy is one animation
;; at a time driven by events, with nothing to read from it but its joints through the manipy. A boss that winds up, throws,
;; flinches and dies wants the animation channels in his own hands, and the skeleton's joints (his claw for the boulder,
;; his chest for the shots) are then plain reads of his own node list.
;;
;; The buttons are basebutton's own (engine/common-obs/basebutton.gc): a subtype that only changes what a press does. The
;; engine's button already runs without an entity (spawned-by-other? is how the game's own spawned buttons work: no perm
;; status, no actor link), presses on Jak's flop, sinks, and stays down. The press throws a boulder back at Klaww instead of sending an actor
;; event, and the skeleton is asked for through a skelgroup of our own, with texture level 2 and sort 1 like every other
;; common-art character, since the stock one would draw in the default sink group.
;;
;; A hit is one of GAUNTLET_KLAWW_MAX_HITS, and each is a different button's: a button is spent once its boulder has reached
;; him. The fight lives in globals, not in the processes: Jak dying (or a speedrun reset) runs reset-actors, which puts away
;; every process in *entity-pool*, Klaww and the buttons among them, and they are born again from the globals (the spent
;; buttons down, the pelican's story or the console's landing spot to bring Klaww back, the hits as they were). The fight is
;; only reset when Jak leaves the level it is in, when klaww-enabled goes off, or when "klaww" is asked for again.
;;
;; The fewer hits he has left the faster he throws (his rage, below), and a shot from the beach's lurker cannon heals him one
;; hit and gives one of the spent buttons back (the cannon's easter egg, below).

(defconstant GAUNTLET_KLAWW_FALL_HEIGHT (meters 60)) ;; he starts this far above the ground he will land on: high enough to be seen coming
(defconstant GAUNTLET_KLAWW_FALL_GRAVITY (meters 40)) ;; per second per second, so the drop takes 1.7 s: a plunge, not a float
(defconstant GAUNTLET_KLAWW_LAND_RADIUS (meters 9)) ;; the ring drawn on the ground where he will land, wide enough for his feet and the shock
(defconstant GAUNTLET_KLAWW_AHEAD (meters 25)) ;; the console's Klaww off the beach falls this far in front of Jak
(defconstant GAUNTLET_KLAWW_QUAKE_RANGE (meters 150)) ;; Jak this close to a landing feels the camera shake
(defconstant GAUNTLET_KLAWW_SCALE 0.7) ;; his size against the model: 10 m tall instead of 14, so he fits the nest rock
(defconstant GAUNTLET_KLAWW_BOULDER_SPEED (meters 30)) ;; sideways, so a boulder to Jak 100 m away is 3.3 s in the air
(defconstant GAUNTLET_KLAWW_BOULDER_MIN_FLIGHT 1.5) ;; seconds, so a throw at Jak close by is not a blink
(defconstant GAUNTLET_KLAWW_BOULDER_GRAVITY (meters 10)) ;; per second per second: a lob, not the game's flat 5 or Jak's own 60
(defconstant GAUNTLET_KLAWW_SHOVE_BACK (meters 5)) ;; how far a landing throws Jak off, about, away from where it landed
(defconstant GAUNTLET_KLAWW_SHOVE_UP (meters 2))
(defconstant GAUNTLET_KLAWW_SHOT_SPEED (meters 40)) ;; sideways: the boulder a button throws back, 100 m to his chest in 2.5 s
(defconstant GAUNTLET_KLAWW_SHOT_GRAVITY (meters 14)) ;; per second per second: a steeper lob than his own, so the arc reads from far away
(defconstant GAUNTLET_KLAWW_SHOT_LIFT (meters 1.5)) ;; it leaves from this far above the button
(defconstant GAUNTLET_KLAWW_FLINCH (seconds 0.4)) ;; how long a hit boulder's flinch takes: the ogre's own takes 0.15 s, stretched so it reads across the beach
(defconstant GAUNTLET_KLAWW_PROBE_RAISE (meters 3)) ;; the ground under a hand-picked spot is searched for from this far above it, so a rise in the ground does not bury the search
(defconstant GAUNTLET_KLAWW_CHEST (meters 8.75)) ;; the chest's height in his bind pose, for a chest to aim at before his skeleton has been drawn
(defconstant GAUNTLET_KLAWW_BODY_HEIGHT (meters 9.5)) ;; the column a cannon blast counts his body as: his head, 13.6 m in the bind pose, at GAUNTLET_KLAWW_SCALE
(defconstant GAUNTLET_KLAWW_BODY_RADIUS (meters 3)) ;; and this wide, a little under his arms (6.8 m to a side in the bind pose, at scale), more than his trunk
(defconstant GAUNTLET_PART_GROUP_KLAWW_TRAIL 1002) ;; ids this file adds to the particle tables, after the bomb's
(defconstant GAUNTLET_PART_GROUP_KLAWW_IMPACT 1003)
(defconstant GAUNTLET_PART_KLAWW_CENTER 3533)

