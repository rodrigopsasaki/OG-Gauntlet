;; ogre-obs.gc's *tntbarrel-sg*, for the common art; sort 1 like other common-art props.
(defskelgroup *gauntlet-tntbarrel-sg*
  tntbarrel
  tntbarrel-lod0-jg
  tntbarrel-idle-ja
  ((tntbarrel-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 2 0 4)
  :texture-level 2
  :sort 1)

;; One row per barrel: (row index level x y z), spot in meters. y is only a hint: the barrel is put on the ground found by
;; gauntlet-klaww-ground, so a spot read off a floating power cell still works. GAUNTLET_TNT_BARRELS must match the row count.
;; Row 0: Sentinel Beach, midpoint between the player and fuel-cell-42, at foot height.
(defmacro gauntlet-tnt-table (join row)
  "Expand row once per barrel, as (row index level x y z), under the form join (begin)."
  `(,join
     (,row 0 beach -351.54 23.5 -435.73)))

;; Written out because deftype needs a literal array size; raise it with each row added above.
(defconstant GAUNTLET_TNT_BARRELS 1)

(deftype gauntlet-tnt-world (structure)
  ((barrels handle GAUNTLET_TNT_BARRELS)))

(define *gauntlet-tnt-world* (new 'global 'gauntlet-tnt-world))

;; a null handle has process #f, not zero (see gauntlet-klaww-forget-all!)
(dotimes (i GAUNTLET_TNT_BARRELS)
  (set! (-> *gauntlet-tnt-world* barrels i) (the-as handle #f)))


(deftype gauntlet-tnt (process-drawable)
  ((root collide-shape :override)
   (row  int)
   (big  symbol)) ;; true after 'die-big (the bigger explosion)
  (:states
   gauntlet-tnt-idle
   gauntlet-tnt-die))

(defstate gauntlet-tnt-die (gauntlet-tnt)
  :code
    (behavior ()
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self root))
      (ja-post)
      (sound-play "dcrate-break")
      (process-spawn part-tracker
                     :init
                     part-tracker-init
                     (get-part-group (if (-> self big) GAUNTLET_PART_GROUP_TNT_BIG GAUNTLET_PART_GROUP_TNT))
                     -1
                     #f
                     #f
                     #f
                     (-> self root trans)
                     :to
                     *entity-pool*)
      (suspend)
      (cleanup-for-death self)
      (deactivate self)))

(defstate gauntlet-tnt-idle (gauntlet-tnt)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('die-big)
         (set! (-> self big) #t)
         (go gauntlet-tnt-die))
        (('die) (go gauntlet-tnt-die))
        (('attack 'touch)
         (send-event proc 'attack-invinc (-> block param 0) (static-attack-info ((mode 'death))))
         (go gauntlet-tnt-die))))
  :code
    (behavior ()
      (transform-post)
      (logior! (-> self mask) (process-mask sleep))
      (suspend)
      0))

(defbehavior gauntlet-tnt-init-by-other gauntlet-tnt ((row int) (feet vector))
  "Appear on feet (the ground under the spot) as table row row. The touch shape is the game barrel's mesh prim, which
   only Jak's collision looks for."
  (stack-size-set! (-> self main-thread) 512)
  ;; keep standing whatever the actors around do, like the bomb
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self row) row)
  (set! (-> self big) #f)
  (let ((shape (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-mesh shape (the-as uint 0) (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind crate))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid))
      (set! (-> prim prim-core offense) (collide-offense touch))
      (set! (-> prim transform-index) 3)
      (set-vector! (-> prim local-sphere) 0.0 9216.0 0.0 14336.0)
      (set-root-prim! shape prim))
    (set! (-> shape nav-radius) (* 0.75 (-> shape root-prim local-sphere w)))
    (backup-collide-with-as shape)
    (set! (-> self root) shape))
  (set! (-> self root trans quad) (-> feet quad))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (initialize-skeleton self *gauntlet-tntbarrel-sg* '())
  (set-vector! (-> self draw color-mult) 1.3 1.3 1.3 1.0)
  (go gauntlet-tnt-idle)
  (none))

(defun gauntlet-tnt-keep! ((index int) (home symbol) (x float) (y float) (z float))
  "Keep barrel index standing at its table row (x y z in meters) while Jak is in level home and the setting is on, else
   put it away. A missing one is stood again only past GAUNTLET_TNT_REARM_RANGE."
  (let ((barrel (-> *gauntlet-tnt-world* barrels index))
        (spot (set-vector! (new 'stack-no-clear 'vector) x y z 1.0)))
    (cond
      ((or (not *gauntlet-tnt-enabled*) (not (gauntlet-in-level? home)))
       (gauntlet-klaww-remove barrel))
      ((handle->process barrel))
      ((not (gauntlet-art-ready? *gauntlet-tntbarrel-sg*)))
      ((< GAUNTLET_TNT_REARM_RANGE (vector-vector-xz-distance (target-pos 0) spot))
       (let ((ground (new 'stack-no-clear 'vector)))
         (gauntlet-klaww-ground spot ground)
         (let ((made (process-spawn gauntlet-tnt :init gauntlet-tnt-init-by-other index ground :to *entity-pool*)))
           (when made
             (set! (-> *gauntlet-tnt-world* barrels index) (ppointer->handle made))))))))
  0)

(defmacro gauntlet-row-tnt-keep (index level x y z)
  `(gauntlet-tnt-keep! ,index (quote ,level) (meters ,x) (meters ,y) (meters ,z)))

(defun gauntlet-tnt-poll! ()
  "Per-frame: keep every table barrel standing or put away (gauntlet-tnt-keep!). Does nothing without Jak."
  (when *target*
    (gauntlet-tnt-table begin gauntlet-row-tnt-keep))
  0)

;; ------------------------------------------------------------------ the horde --

;; Each nav-mesh enemy a level places is born with *gauntlet-lurker-multiplier* minus one clones on a ring: same init-from-entity!, same entity,
;; but the entity's own process stays the original, so a clone dying never marks the entity dead (see *entity-born-hook*).
;; A small watcher per birth ends the clones when the original is culled by distance or none is left; a level unload ends them via the shared entity.
;; The crowd cap *gauntlet-horde-max-clones* is recounted from live handles in *entity-pool*, never kept as a tally, which would drift.

(defconstant GAUNTLET_HORDE_MAX_CLONES 4) ;; clones per group: the multiplier tops out at 5; Misty's extras also cap at 4
(defconstant GAUNTLET_HORDE_SLOTS 8) ;; handles per group: 0-3 normal clones, 4-7 Misty's extras; deftype needs it literal
(defconstant GAUNTLET_HORDE_RING_RADIUS (meters 3)) ;; clones stand this far from the original, evenly around it
(defconstant GAUNTLET_HORDE_EXTRA_RADIUS (meters 5)) ;; Misty's extras: quarter turns from a diagonal, outside the others

;; Misty Island: with the muse loose (see "the muse") lurkers get normal clones plus *gauntlet-misty-mayhem-extra* extras, once per
;; *gauntlet-muse-episode*; caught, all of it goes with a puff. Normal clones fill slots 0-3, extras 4-7, each at its slot's angle,
;; so a top-up lands where a birth would. A Misty watcher stays while company could still come.
(deftype gauntlet-horde (process)
  ((ent        entity-actor) ;; the actor cloned; read only while its level is active, and never copy its name string
   (original   handle) ;; the actor's own process, the one the entity system manages
   (level-name symbol) ;; the level the actor belongs to
   (episode    int32) ;; muse episode the extras were last topped up for; 0 before any
   (clones     handle 8)) ;; GAUNTLET_HORDE_SLOTS handles, a null handle (not zero) where empty
  (:states
   gauntlet-horde-watch))

(defun gauntlet-horde-live-clones ((horde gauntlet-horde))
  "How many of horde's clones, normal and extra, are still alive."
  (let ((alive 0))
    (dotimes (i GAUNTLET_HORDE_SLOTS)
      (if (handle->process (-> horde clones i)) (+! alive 1)))
    alive))

(define *gauntlet-horde-groups* 0) ;; watchers standing, as of the last gauntlet-horde-recount!
(define *gauntlet-horde-clones* 0) ;; clones alive across them, as of the same recount

(defun gauntlet-horde-tally! ((proc process))
  "Add proc to the totals if it is a watcher: one more group plus its live clones."
  (let ((horde (as-type proc gauntlet-horde)))
    (when horde
      (+! *gauntlet-horde-groups* 1)
      (+! *gauntlet-horde-clones* (gauntlet-horde-live-clones horde))))
  (none))

(defun gauntlet-horde-recount! ()
  "Count the watchers in *entity-pool* and their live clones into *gauntlet-horde-groups* and *gauntlet-horde-clones*."
  (set! *gauntlet-horde-groups* 0)
  (set! *gauntlet-horde-clones* 0)
  (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-horde-tally! proc) (none)) *null-kernel-context*)
  0)

(defbehavior gauntlet-horde-remove-clones gauntlet-horde ()
  "Take away every clone still alive, extras too."
  (dotimes (i GAUNTLET_HORDE_SLOTS)
    (let ((alive (handle->process (-> self clones i))))
      (if alive (deactivate alive))))
  0)

(defbehavior gauntlet-horde-level-left? gauntlet-horde ()
  "True once the actor's level is no longer active; its entity must not be read after that."
  (!= (level-status *level* (-> self level-name)) 'active))

(defbehavior gauntlet-horde-walked-away? gauntlet-horde ()
  "True once the original is gone without being killed (culled by distance or a death reset); it is reborn with fresh
   clones when Jak returns."
  (and (not (handle->process (-> self original)))
       (not (logtest? (-> self ent extra perm status) (entity-perm-status dead)))))

(define-extern gauntlet-horde-clone! (function entity-actor vector handle)) ;; defined below

(defun gauntlet-puff! ((where vector))
  "A puff of dust at where, from the game's landing particles (target-part.gc, in GAME.CGO)."
  (process-spawn part-tracker :init part-tracker-init group-land-poof-dirt 300 #f #f #f where :to *entity-pool*)
  0)

(defun gauntlet-horde-base-asked ()
  "How many normal clones a lurker is owed: lurker-multiplier minus one, at most GAUNTLET_HORDE_MAX_CLONES (slots 0 up)."
  (min (+ *gauntlet-lurker-multiplier* -1) GAUNTLET_HORDE_MAX_CLONES))

(defun gauntlet-horde-extras-asked ()
  "How many extras a Misty lurker is owed while the muse is loose: misty-mayhem-extra, at most GAUNTLET_HORDE_MAX_CLONES (slots 4 up)."
  (min *gauntlet-misty-mayhem-extra* GAUNTLET_HORDE_MAX_CLONES))

(defun gauntlet-horde-calm! ((horde gauntlet-horde) (all symbol))
  "Take away horde's live clones, each with a puff: all of them when all is true (muse with Jak), only the extras when
   false (muse setting off)."
  (let ((slot (if all 0 GAUNTLET_HORDE_MAX_CLONES)))
    (while (< slot GAUNTLET_HORDE_SLOTS)
      (let* ((alive (handle->process (-> horde clones slot)))
             (body (if alive (as-type alive process-drawable))))
        (when alive
          (if body (gauntlet-puff! (-> body root trans)))
          (deactivate alive)))
      (+! slot 1)))
  0)

(defun gauntlet-horde-slot-born! ((horde gauntlet-horde) (slot int) (centre vector) (angle float) (radius float))
  "Born the clone of slot slot at radius from centre, angle round from +z towards +x, with a burst of dark eco. True if one
   came, false if no process was free."
  (let ((spot (new 'stack-no-clear 'vector)))
    (set! (-> spot x) (+ (-> centre x) (* radius (sin angle))))
    (set! (-> spot y) (-> centre y))
    (set! (-> spot z) (+ (-> centre z) (* radius (cos angle))))
    (set! (-> spot w) 1.0)
    (let ((twin (gauntlet-horde-clone! (-> horde ent) spot)))
      (when (handle->process twin)
        (set! (-> horde clones slot) twin)
        (process-spawn part-tracker :init part-tracker-init group-dark-eco-box-explosion -1 #f #f #f spot :to *entity-pool*)
        #t))))

(defun gauntlet-horde-mayhem! ((horde gauntlet-horde))
  "The muse is loose: top horde's company up to what it is owed (normal clones, then extras, within the crowd cap), each in
   its own slot's ring round the original's current spot (its placed spot if gone). Once per episode, so killed clones stay dead."
  (set! (-> horde episode) *gauntlet-muse-episode*)
  (gauntlet-horde-recount!)
  (let* ((ent (-> horde ent))
         (proc (handle->process (-> horde original)))
         (live (if proc (as-type proc process-drawable)))
         (centre (new 'stack-no-clear 'vector))
         (base-total (gauntlet-horde-base-asked))
         (extras-total (gauntlet-horde-extras-asked))
         (room (max 0 (- *gauntlet-horde-max-clones* *gauntlet-horde-clones*))))
    (set! (-> centre quad) (-> (if live (-> live root trans) (-> ent extra trans)) quad))
    (dotimes (i base-total)
      (when (and (not (handle->process (-> horde clones i)))
                 (> room 0)
                 (gauntlet-horde-slot-born! horde i centre (* (/ (degrees 360) (the float base-total)) (the float i)) GAUNTLET_HORDE_RING_RADIUS))
        (+! room -1)))
    (dotimes (i extras-total)
      (let ((slot (+ GAUNTLET_HORDE_MAX_CLONES i)))
        (when (and (not (handle->process (-> horde clones slot)))
                   (> room 0)
                   (gauntlet-horde-slot-born! horde slot centre (+ (degrees 45) (* (degrees 90) (the float i))) GAUNTLET_HORDE_EXTRA_RADIUS))
          (+! room -1)))))
  0)

(defun gauntlet-horde-misty-watch? ((horde gauntlet-horde))
  "True when horde is Misty's and clones could still come: with the muse loose a lurker is owed clones and extras, with
   her caught it is owed none."
  (and (= (-> horde level-name) 'misty)
       *gauntlet-misty-muse-enabled*
       (or (> (gauntlet-horde-base-asked) 0) (> (gauntlet-horde-extras-asked) 0))))

(defun gauntlet-horde-mayhem-poll! ((horde gauntlet-horde))
  "Per-frame for a Misty group. Muse setting on: all clones go when the muse is with Jak and come once when she is loose.
   Off: only the extras go."
  (when (= (-> horde level-name) 'misty)
    (cond
      ((not *gauntlet-misty-muse-enabled*) (gauntlet-horde-calm! horde #f))
      ((gauntlet-mayhem-on?)
       (if (!= (-> horde episode) *gauntlet-muse-episode*) (gauntlet-horde-mayhem! horde)))
      (else (gauntlet-horde-calm! horde #t))))
  0)

(defstate gauntlet-horde-watch (gauntlet-horde)
  :code
    (behavior ()
      (loop
        (cond
          ((gauntlet-horde-level-left?)
           (gauntlet-horde-remove-clones)
           (deactivate self))
          ((and (zero? (gauntlet-horde-live-clones self))
                (not (and (gauntlet-horde-misty-watch? self) (handle->process (-> self original)))))
           (deactivate self))
          ((gauntlet-horde-walked-away?)
           (gauntlet-horde-remove-clones)
           (deactivate self))
          (else (gauntlet-horde-mayhem-poll! self)))
        (suspend))))

(defbehavior gauntlet-horde-init-by-other gauntlet-horde ((ent entity-actor) (original handle))
  "Watch over the clones of actor ent, whose own process is original. The spawner fills in the clones."
  (set! (-> self ent) ent)
  (set! (-> self original) original)
  (set! (-> self level-name) (-> ent extra level name))
  (set! (-> self episode) 0)
  (dotimes (i GAUNTLET_HORDE_SLOTS)
    (set! (-> self clones i) (the-as handle #f)))
  (go gauntlet-horde-watch)
  (none))

(defun gauntlet-horde-lurker? ((proc process))
  "Whether proc, just born from an actor, gets company: any nav-enemy except those whose story lives in the original (cannon
   babak, ram boss, muse and lightning moles for their counted task, sharkey which reads the actor's spot, double lurker)."
  (and (type-type? (-> proc type) nav-enemy)
       (case (-> proc type symbol)
         (('babak-with-cannon 'ram-boss 'muse 'lightning-mole 'sharkey 'double-lurker) #f)
         (else #t))))

(defun gauntlet-horde-clone! ((ent entity-actor) (spot vector))
  "Born one more process of ent's type at spot; return its handle, or a null handle if none is free or it died in init. Like
   init-entity (entity.gc) minus setting (-> ent extra process), so the clone is not the original."
  (let* ((kind (-> ent etype))
         (info (entity-info-lookup kind))
         (fresh (get-process *default-dead-pool* kind (if info (-> info heap-size) #x4000))))
    (if (not fresh) (return (the-as handle #f)))
    (set! (-> fresh type) kind)
    (activate fresh *entity-pool* (res-lump-struct ent 'name basic) *scratch-memory-top*)
    (set! (-> fresh entity) ent)
    (let ((born (process->handle fresh))
          (home (new 'stack-no-clear 'vector)))
      (set! (-> home quad) (-> ent extra trans quad))
      ;; the spot is lent to the entity for init (position and nav poly are read then) and given back at once
      (set! (-> ent extra trans quad) (-> spot quad))
      (run-now-in-process fresh (method-of-object fresh init-from-entity!) fresh ent)
      (set! (-> ent extra trans quad) (-> home quad))
      ;; a clone drops pills like a beach ice cube, never the actor's power cell or special pickup
      (let* ((alive (handle->process born))
             (nav (if alive (as-type alive nav-enemy))))
        (when (and nav (nonzero? (-> nav enemy-info)))
          (set! (-> nav enemy-info pickup-type) (pickup-type eco-pill-random))
          (set! (-> nav enemy-info pickup-amount) (-> *FACT-bank* default-pill-inc))
          (logclear! (-> nav enemy-info options) (fact-options has-power-cell))))
      born)))

(defun gauntlet-horde-born! ((ent entity-actor))
  "Hook for a newborn actor ent: if it is a lurker that gets company and is not complete, spawn the watcher and ring the
   clones (first along +z), within the crowd cap. A Misty one with the muse on always gets a watcher."
  (let* ((original (-> ent extra process))
         (asked (gauntlet-horde-base-asked))
         (misty (and *gauntlet-misty-muse-enabled*
                     (= (-> ent extra level name) 'misty)
                     (or (> asked 0) (> (gauntlet-horde-extras-asked) 0)))))
    (when (and original
               (or (> asked 0) misty)
               (not (logtest? (-> ent extra perm status) (entity-perm-status complete)))
               (gauntlet-horde-lurker? original))
      (gauntlet-horde-recount!)
      (let* ((name (res-lump-struct ent 'name string))
             (room (max 0 (- *gauntlet-horde-max-clones* *gauntlet-horde-clones*)))
             ;; Misty's normal clones are the muse's to bring (gauntlet-horde-mayhem!)
             (wanted (if misty 0 (min asked room))))
        (when (or (> wanted 0) misty)
          (let ((watcher (process-spawn gauntlet-horde :init gauntlet-horde-init-by-other ent (process->handle original) :to *entity-pool*)))
            (when watcher
              (let ((horde (-> watcher 0))
                    (home (new 'stack-no-clear 'vector))
                    (spot (new 'stack-no-clear 'vector))
                    (step (/ (degrees 360) (the float (max wanted 1))))
                    (born 0))
                (set! (-> home quad) (-> ent extra trans quad))
                ;; a clone is tried only if all before it were born; the first failure ends the line
                (dotimes (i wanted)
                  (when (= born i)
                    (let ((angle (* step (the float i))))
                      (set! (-> spot x) (+ (-> home x) (* GAUNTLET_HORDE_RING_RADIUS (sin angle))))
                      (set! (-> spot y) (-> home y))
                      (set! (-> spot z) (+ (-> home z) (* GAUNTLET_HORDE_RING_RADIUS (cos angle))))
                      (set! (-> spot w) 1.0))
                    (let ((twin (gauntlet-horde-clone! ent spot)))
                      (when (handle->process twin)
                        (set! (-> horde clones born) twin)
                        (+! born 1)))))
                ;; muse loose: the company is born with the lurker
                (if (and misty (gauntlet-mayhem-on?)) (gauntlet-horde-mayhem! horde))
                (cond
                  ((> born 0))
                  (misty)
                  (else (deactivate horde))))))))))
  (none))

;; ------------------------------------------------------- the scout fly boxes --

;; Each scout fly box (crate-buzzer, crates.gc) in the table wants an eco: it wears that colour and opens only when Jak breaks it
;; (the attacks that already break an iron crate) while carrying that eco. Boxes not in the table are ordinary.
;; Carrying means his fact has that eco type and an eco level above 0. A yellow eco shot also counts for yellow.

;; Green is carried only on the zoomer, after a green vent (pickup-collectable!, game-info.gc). The basin (rolling) has one,
;; ecovent-242, so green boxes exist only there.

;; A wrong eco, or none, makes the box refuse: it bounces Jak back with a 'shove (no health lost) and flashes its colour.
;; Only Jak's attacks and yellow shots are asked; boulders, cannon sacks and bombs still break it. Blue eco's pull
;; (notice-blue, crates.gc) is kept for blue boxes only. The game asks through *crate-attack-gate-hook*.
;; The gate must have no side effects: 'query 'pickup in pckernel.gc reaches pickup-collectable! with amount 0 every frame.

;; Eco comes from free eco the game placed (vent, singles, eco crate) or from a carrier lurker; the mod places none. The second
;; table names up to two carriers per box (crabs, puppies, bunnies, hoppers, rats, bonelurkers, nearest first). A carrier glows
;; and spills a pickup of that eco when it dies. It only looks and spills: babaks keep their own blue and red fields
;; (babak.gc), so they are never carriers.

;; The spill uses fact-options one-off so the pickup is gone once taken; otherwise the game respawns eco once Jak's own runs out.
;; To avoid stranding the player, *gauntlet-carrier-return* after a death, while the box is closed, a charged clone is born at
;; the placed spot (gauntlet-horde-clone!, timed by the watcher). The entity's own respawn would bring company and wait for Jak.

;; Both tables are keyed by level and entity name and generated offline from decompiler_out/jak1/entities/*-actors.json
;; (a buzzer crate has an eco-info lump of type 8). Geyser Rock (training) is all blue, from the level's own blue eco.

;; Elsewhere a box takes a colour only if a source is in reach: free eco (vent, singles, eco crate) or a carrier.
;; Reach: a single lasts 5 s, the most pickups add up to is 20 s (*FACT-bank*); Jak runs 10 m/s (*walk-mods*), counted as 8 m/s
;; with 1.5 s spare. So a vent reaches 148 m, two singles 68 m, one single 28 m, and free eco counts within 85 percent of that.
;; A carrier spills one single, so its placed spot is within 28 m plus its notice range (25 m crab, 30 m others).

;; Green has no carriers (a green pickup on foot is health). Zoomer levels (rolling, firecanyon, ogre, lavatube) have no blue
;; box: the zoomer turns blue eco into a boost, never carried.

;; Colours are dealt to give the most boxes a source, then evenly, then nearest first. Sentinel Beach keeps hand-made rows.
;; A box no colour reaches has no row and is an ordinary scout fly box.

(defconstant GAUNTLET_FLYBOX_LIFT (meters 0.75)) ;; the middle of a box, above its base
(defconstant GAUNTLET_FLYBOX_SHOVE_UP (meters 1.5)) ;; how high a refusal throws Jak
(defconstant GAUNTLET_FLYBOX_REFUSE_BURSTS 8) ;; bursts of a box's colour when it refuses
(defconstant GAUNTLET_FLYBOX_SPILL_BURSTS 10) ;; bursts when a carrier spills
(defconstant GAUNTLET_FLYBOX_SCATTER (meters 1.2)) ;; bursts are scattered this far around the middle

;; Boxes with no eco in reach are left out and stay ordinary scout fly boxes.
(defmacro gauntlet-flybox-table (join row)
  "Expand row once per box, (row level name eco): the buzzer crate name of level wants eco (red, blue, yellow or green)."
  `(,join
     ;; beach
     (,row beach "crate-213" blue)
     (,row beach "crate-2467" blue)
     (,row beach "crate-646" yellow)
     (,row beach "crate-647" red)
     (,row beach "crate-648" blue)
     (,row beach "crate-649" yellow)
     (,row beach "crate-651" red)
     ;; citadel
     (,row citadel "crate-2997" red)
     (,row citadel "crate-2999" blue)
     (,row citadel "crate-3000" blue)
     (,row citadel "crate-3001" blue)
     (,row citadel "crate-3002" yellow)
     ;; jungle
     (,row jungle "crate-1844" blue)
     (,row jungle "crate-28" blue)
     (,row jungle "crate-3" blue)
     (,row jungle "crate-47" blue)
     (,row jungle "crate-58" blue)
     (,row jungle "crate-688" yellow)
     (,row jungle "crate-689" red)
     ;; lavatube
     (,row lavatube "crate-3027" yellow)
     (,row lavatube "crate-3117" yellow)
     ;; maincave
     (,row maincave "crate-2685" yellow)
     (,row maincave "crate-2689" yellow)
     (,row maincave "crate-2697" yellow)
     (,row maincave "crate-3018" yellow)
     ;; misty
     (,row misty "crate-659" yellow)
     (,row misty "crate-673" blue)
     (,row misty "crate-684" red)
     ;; robocave
     (,row robocave "crate-2779" yellow)
     (,row robocave "crate-2985" blue)
     ;; rolling
     (,row rolling "crate-2176" green)
     (,row rolling "crate-2209" green)
     ;; snow
     (,row snow "crate-1132" yellow)
     (,row snow "crate-1133" red)
     (,row snow "crate-1138" red)
     (,row snow "crate-3134" red)
     (,row snow "crate-975" blue)
     (,row snow "crate-976" blue)
     (,row snow "crate-980" yellow)
     ;; sunken
     (,row sunken "crate-917" blue)
     ;; sunkenb
     (,row sunkenb "crate-2705" blue)
     ;; swamp
     (,row swamp "crate-2936" yellow)
     (,row swamp "crate-748" red)
     (,row swamp "crate-762" yellow)
     (,row swamp "crate-786" blue)
     (,row swamp "crate-787" blue)
     (,row swamp "crate-843" red)
     (,row swamp "crate-849" yellow)
     ;; training
     (,row training "crate-2955" blue)
     (,row training "crate-2956" blue)
     (,row training "crate-2957" blue)
     (,row training "crate-2958" blue)
     (,row training "crate-2959" blue)
     (,row training "crate-2960" blue)
     (,row training "crate-2961" blue)
     ;; village2
     (,row village2 "crate-3127" blue)
     ))

