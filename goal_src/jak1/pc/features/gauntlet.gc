;; ------------------------------------------------------------------ the art --

(defskelgroup *gauntlet-darkecobomb-sg*
  darkecobomb
  darkecobomb-lod0-jg
  darkecobomb-idle-ja
  ((darkecobomb-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 3.5 0 6)
  :texture-level 2)

;; Art groups from GAME.CGO register in level-default under the name stored in the group (not the "-ag" file name). The bomb has
;; no entity, so a failed initialize-skeleton would fault in process-drawable-art-error. These two run its checks first (as the
;; sage's pair in training-obs.gc does), so the bomb only drops when init cannot take that path.
(defun gauntlet-art-complete? ((art art-group) (skel skeleton-group))
  "True when the skelgroup's joint geometry, initial animation and lod meshes all exist in the art group with the right types.
   Same checks as initialize-skeleton; a stripped element is #f and fails."
  (when (or (>= (-> skel jgeo) (-> art length)) (!= (-> (-> art data (-> skel jgeo)) type) art-joint-geo))
    (return #f))
  (when (and (>= (-> skel janim) 0)
             (or (>= (-> skel janim) (-> art length)) (!= (-> (-> art data (-> skel janim)) type) art-joint-anim)))
    (return #f))
  (dotimes (lod (+ (-> skel max-lod) 1))
    (when (or (>= (-> skel mgeo lod) (-> art length)) (!= (-> (-> art data (-> skel mgeo lod)) type) merc-ctrl))
      (return #f)))
  #t)

(defun gauntlet-art-ready? ((skel skeleton-group))
  "True when the skelgroup's art group is registered in level-default and complete. Never loads anything."
  (let ((art (art-group-get-by-name (-> *level* level-default) (-> skel art-group-name))))
    (and art (gauntlet-art-complete? art skel))))

;; ---------------------------------------------------------------- the eco charge --

;; The eco language (kind and declarations in gauntlet-h.gc). A charged hazard wears Jak's own aura: red is particles 273-275, blue
;; 255-257 and 260, launched at his joints each frame (target-powerup-process in powerups.gc). Blue's bolt, 259, is left out
;; because Jak bends its angle by his jump state.
;;
;; Desperation: the eco is stronger the weaker Jak is, scaling the strength of every effect (blue babak speed, bomb pull, red
;; throw), never their chance or number. It is 1.0 at full health (health-max, 3) and *gauntlet-desperation-max* at one hit,
;; linear between. Read live wherever an effect applies. It also thickens the aura and brightens the glow.

(defconstant GAUNTLET_ECO_GLOW_MAX 2.0) ;; glow is at most this times its usual light
(defconstant GAUNTLET_ECO_AURA_MAX_EXTRA 2.0) ;; aura launches at most this many extra bursts a frame

(defun gauntlet-desperation ()
  "How many times stronger the eco is for Jak's health: 1.0 at full health, *gauntlet-desperation-max* at one hit, 1.0 with no Jak."
  (if (and *target* (< 1.0 (-> *target* fact health-max)))
    (lerp-scale 1.0 *gauntlet-desperation-max* (-> *target* fact health) (-> *target* fact health-max) 1.0)
    1.0))

(defun gauntlet-eco-glow! ((pd process-drawable) (kind gauntlet-eco))
  "Tint pd's draw toward kind's eco, with a light on top that burns harder with desperation. Called at birth and every frame
   by the aura."
  (let ((burn (fmin (gauntlet-desperation) GAUNTLET_ECO_GLOW_MAX)))
    (case kind
      (((gauntlet-eco red))
       (set-vector! (-> pd draw color-mult) 1.0 0.55 0.55 1.0)
       (set-vector! (-> pd draw color-emissive) (* 0.4 burn) (* 0.02 burn) 0.0 0.0))
      (((gauntlet-eco blue))
       (set-vector! (-> pd draw color-mult) 0.55 0.75 1.0 1.0)
       (set-vector! (-> pd draw color-emissive) 0.0 (* 0.1 burn) (* 0.45 burn) 0.0))
      (((gauntlet-eco yellow))
       (set-vector! (-> pd draw color-mult) 1.0 0.95 0.5 1.0)
       (set-vector! (-> pd draw color-emissive) (* 0.4 burn) (* 0.35 burn) 0.0 0.0))
      (((gauntlet-eco green))
       (set-vector! (-> pd draw color-mult) 0.6 1.0 0.6 1.0)
       (set-vector! (-> pd draw color-emissive) 0.0 (* 0.4 burn) (* 0.05 burn) 0.0))))
  (none))

(defun gauntlet-eco-burst-at! ((kind gauntlet-eco) (flash vector) (spark vector))
  "One burst of kind's eco aura: flash launched at flash, spark at spark, using Jak's own particles (green is the health eco's)."
  (case kind
    (((gauntlet-eco red))
     (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 273 274)) flash)
     (launch-particles (-> *part-id-table* 275) spark))
    (((gauntlet-eco blue))
     (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 255 256)) flash)
     (if (rand-vu-percent? 0.5)
       (launch-particles (-> *part-id-table* 257) flash))
     (launch-particles (-> *part-id-table* 260) spark))
    (((gauntlet-eco yellow))
     (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 269 270)) flash)
     (launch-particles (-> *part-id-table* 271) spark))
    (((gauntlet-eco green))
     (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 277 278)) flash)
     (launch-particles (-> *part-id-table* 279) spark)))
  (none))

(defun gauntlet-eco-burst! ((pd process-drawable) (kind gauntlet-eco))
  "One burst of kind's aura: a flash at one joint, a spark at another. The first three joints are the root's and are skipped."
  (let ((flash (rand-vu-int-range 3 (+ (-> pd node-list length) -1)))
        (spark (rand-vu-int-range 3 (+ (-> pd node-list length) -1))))
    (gauntlet-eco-burst-at! kind
                            (vector<-cspace! (new 'stack-no-clear 'vector) (-> pd node-list data flash))
                            (vector<-cspace! (new 'stack-no-clear 'vector) (-> pd node-list data spark))))
  (none))

(defun gauntlet-eco-aura! ((pd process-drawable) (kind gauntlet-eco))
  "One frame of kind's aura: a burst plus extra ones as the desperation is over 1.0 (a fraction is the chance of one), capped at
   GAUNTLET_ECO_AURA_MAX_EXTRA. Skipped while pd is off screen."
  (when (and (!= kind (gauntlet-eco none)) (not (logtest? (-> pd draw status) (draw-status hidden no-anim))))
    (gauntlet-eco-glow! pd kind)
    (gauntlet-eco-burst! pd kind)
    (let* ((extra (fmin (+ (gauntlet-desperation) -1.0) GAUNTLET_ECO_AURA_MAX_EXTRA))
           (whole (the int extra)))
      (dotimes (i whole)
        (gauntlet-eco-burst! pd kind))
      (if (rand-vu-percent? (- extra (the float whole)))
        (gauntlet-eco-burst! pd kind))))
  (none))

(defun gauntlet-eco-second-hit! ((jak process))
  "The second hit of a red strike. An attack has no damage field, so it is a negative green eco pickup. It can never kill, only the first hit can."
  (when (and *target* (< 1.0 (-> *target* fact health)))
    (send-event jak 'get-pickup (pickup-type eco-green) (- (-> *FACT-bank* health-single-inc))))
  (none))

;; ------------------------------------------------------------------ the volley --

;; Yellow eco fired at Jak in volleys (type and declarations in gauntlet-h.gc). Shared by the training dummies and the plant boss's
;; yellow aphids (levels/jungleb/aphid.gc), so it lives here, which every level reaches. Knobs are the dummy-volley-* settings.

(defun gauntlet-jak-in-range? ((source process-drawable) (range float))
  "True while Jak is within range of source."
  (and *target* (>= range (vector-vector-distance (-> source root trans) (-> *target* control trans)))))

(defun gauntlet-jak-shootable? ()
  "True while Jak is worth shooting at: not mid-hit, invulnerable, in a cutscene or dying."
  (and *target*
       (not (logtest? (-> *target* state-flags)
                      (state-flags being-attacked invulnerable timed-invulnerable invuln-powerup do-not-notice dying)))))
(defun gauntlet-volley-start ((volley gauntlet-volley) (origin vector))
  "Capture the aim at Jak once; the whole volley sweeps around this heading. Shots leave from origin on a level line, like every
   shooting enemy."
  (let ((heading (-> volley heading)))
    (set! (-> heading quad) (-> (target-pos 0) quad))
    (vector-! heading heading origin)
    ;; level on purpose: the shot does not track Jak's height, so the player can learn the pattern. The sweep keeps it level.
    (set! (-> heading y) 0.0)
    (vector-normalize! heading 1.0))
  (set! (-> volley muzzle quad) (-> origin quad))
  ;; alternate left-to-right and right-to-left, like a sprinkler
  (set! (-> volley sweep) (if (> (-> volley sweep) 0.0) -1.0 1.0))
  (set! (-> volley size) *gauntlet-dummy-volley-size*)
  (set! (-> volley shots-left) (-> volley size))
  (set-time! (-> volley start-time))
  0)

(defun gauntlet-volley-fire-next ((source process-drawable) (volley gauntlet-volley))
  "Fire the next shot of the volley on the captured heading."
  (let ((shot-heading (new 'stack-no-clear 'vector))
        (velocity (new 'stack-no-clear 'vector))
        (index (- (-> volley size) (-> volley shots-left))))
    (vector-rotate-y! shot-heading
                      (-> volley heading)
                      (* (-> volley sweep)
                         *gauntlet-dummy-volley-spread*
                         (- (the float index) (* 0.5 (the float (+ (-> volley size) -1))))))
    (vector-float*! velocity shot-heading *gauntlet-dummy-shot-speed*)
    (process-spawn gauntlet-shot :init projectile-init-by-other (-> source entity) (-> volley muzzle) velocity 0 #f :to source))
  (+! (-> volley shots-left) -1)
  (set-time! (-> volley next-shot-time))
  0)

(defun gauntlet-volley-update ((source process-drawable) (volley gauntlet-volley) (origin vector) (range float))
  "One frame of a volley leaving origin: start one every interval, fire its shots a gap apart.
   Dropped if Jak leaves range or is not shootable."
  (cond
    ((not (and (gauntlet-jak-in-range? source range) (gauntlet-jak-shootable?))) (set! (-> volley shots-left) 0))
    ((> (-> volley shots-left) 0)
     (if (time-elapsed? (-> volley next-shot-time) *gauntlet-dummy-volley-gap*) (gauntlet-volley-fire-next source volley)))
    ((time-elapsed? (-> volley start-time) *gauntlet-dummy-volley-interval*)
     (gauntlet-volley-start volley origin)
     (gauntlet-volley-fire-next source volley)))
  0)
;; ---------------------------------------------------------------- the plant boss --

;; The Forbidden Jungle plant boss (levels/jungleb/plant-boss.gc), reworked by plant-boss-rework:
;;   every bite eats: the bite takes all of Jak's health, so it is the one that eats him (*plant-boss-bite-hook*, called from
;;                    engine/target/target-death.gc).
;;   eco by round: the boss tells his aphids what eco to wear: yellow, red, blue. See plant-boss.gc and aphid.gc.

(defun *plant-boss-bite-hook* ()
  "A plant boss bite landed on Jak: with the rework on, in play mode, take all his health so the game's own check reads it
   as the bite that eats him."
  (when (and *gauntlet-plant-boss-rework* *target* (= (-> *target* game mode) 'play))
    (pickup-collectable! (-> *target* fact) (pickup-type eco-green) -1000.0 (the-as handle #f)))
  (none))

;; ------------------------------------------------------------- the power cell --

;; A power cell heals Jak. The game leaves his health alone when he takes one, so the hook that pickup-collectable! in
;; engine/game/game-info.gc calls (like *entity-born-hook*) raises it to 3 hits if lower, never for a dying Jak. 3 is
;; health-max-default and nothing raises past it; the heal is also clamped to health-max.

(defconstant GAUNTLET_CELL_HEAL_TO 3.0) ;; the hits a power cell heals Jak up to

(defun *fuel-cell-picked-hook* ()
  "Jak took a power cell: with *gauntlet-cell-heal-enabled*, heal him to GAUNTLET_CELL_HEAL_TO hits unless he has that many or none."
  (when (and *gauntlet-cell-heal-enabled* *target*)
    (let* ((fact (-> *target* fact))
           (before (-> fact health))
           (after (fmax before (fmin GAUNTLET_CELL_HEAL_TO (-> fact health-max)))))
      (cond
        ((and (< 0.0 before) (< before after))
         (set! (-> fact health) after)
         (set-time! (-> fact health-pickup-time))))))
  (none))

;; ------------------------------------------------------------------ the muse --

;; Misty Island has one state that matters: is the muse (levels/misty/muse.gc, a power cell that runs) with Jak. Catching her calms it.
;;   LOOSE      mayhem. The state on arrival, before the first catch.
;;   CARRIED    calm: only the lurkers Misty places, at their own pace, charged as babak-charge-chance makes them (rolled at birth).
;;   DELIVERED  the game's muse was already caught on arrival: mayhem all visit, no muse is made and no icon is drawn. Decided on arrival.
;; *gauntlet-muse-state* is the one authority. It changes only in gauntlet-muse-caught!, gauntlet-muse-drop! (hit, bonk, death)
;; and gauntlet-muse-poll! (Misty entered or left). Dropping her pops a new muse out where Jak lost her (see "the muse's body").
;;
;; While LOOSE, on Misty only (gauntlet-mayhem-for? checks the entity's level):
;;   more enemies   each placed lurker gets lurker-multiplier clones ("the horde") plus misty-mayhem-extra; a catch removes them, a drop brings them back
;;   faster         babaks and bonelurkers run misty-mayhem-speed times faster, multiplying with the desperation
;;   stronger       babaks roll both charge chances at birth and wear misty-mayhem-charge-chance while she is loose (babak.gc, babak-charge-sync!)
;; The muse, the sharkey and non-nav lurkers (balloon, quicksand) are not reached.

(defconstant GAUNTLET_MUSE_FLASH_TIME (seconds 0.8)) ;; the icon's flash, and the burn of its glow, after a flip

(defenum gauntlet-muse-state
  :type uint32
  (loose 0)
  (carried 1)
  (delivered 2))

(define *gauntlet-muse-state* (gauntlet-muse-state loose)) ;; THE authority: where the muse is on this visit to Misty. Starts LOOSE or DELIVERED
(define *gauntlet-muse-episode* 0) ;; counts the times she has gone loose (arriving counts), so a group of the horde tops itself up once for each
(define *gauntlet-muse-flip-time* (- 0 (seconds 3600))) ;; when the state last flipped; the icon's flash reads it
(define *gauntlet-muse-was-here* #f) ;; Misty was active the last time the poll looked
(define *gauntlet-muse-health* -1.0) ;; Jak's health at the last poll, -1 with no Jak; a fall is a hit

(defun gauntlet-muse-carried? ()
  "True while the muse is with Jak."
  (= *gauntlet-muse-state* (gauntlet-muse-state carried)))

(defun gauntlet-muse-delivered? ()
  "True on a visit that began with the game's muse already caught."
  (= *gauntlet-muse-state* (gauntlet-muse-state delivered)))

(defun gauntlet-misty-active? ()
  "True while Misty is loaded and running, wherever Jak is."
  (= (level-status *level* 'misty) 'active))

(defun gauntlet-mayhem-on? ()
  "True while the mayhem is on: the setting is on, Misty runs and the muse is not with Jak (loose, or delivered)."
  (and *gauntlet-misty-muse-enabled* (not (gauntlet-muse-carried?)) (gauntlet-misty-active?)))

(defun gauntlet-mayhem-for? ((proc process))
  "True when the mayhem applies to proc: it is something Misty placed, so swamp babaks are never rushed."
  (and (gauntlet-mayhem-on?) (-> proc entity) (= (-> proc entity extra level name) 'misty)))

(defun gauntlet-misty-pace ((proc process))
  "How many times faster than its own pace proc moves now: *gauntlet-misty-mayhem-speed* in the mayhem, else 1.0."
  (if (gauntlet-mayhem-for? proc) *gauntlet-misty-mayhem-speed* 1.0))

;; The beat of a change: a loss flashes the screen violet (icon's process, over GAUNTLET_MUSE_FLASH_TIME), shakes the camera at half a
;; boulder's landing, roars, bursts dark eco at Jak and has Daxter speak; a catch chimes and Daxter is relieved.
;; Settings: misty-mayhem-atmosphere scales the flash, misty-mayhem-voice is the line.
(defconstant GAUNTLET_MAYHEM_ROAR_GAP (seconds 0.15)) ;; the babak answers the bonelurker this long after
(defconstant GAUNTLET_MAYHEM_VOICE_GAP (seconds 6)) ;; Daxter speaks at most this often, a loss and a catch in quick turn included
(defconstant GAUNTLET_MAYHEM_FLASH_ALPHA 60.0) ;; the violet flash's first-frame alpha, of 128 opaque

(define *gauntlet-mayhem-roar-at* (the-as time-frame 0)) ;; when the second roar is due, 0 for none; the icon's process plays it
(define *gauntlet-mayhem-voice-time* (- 0 (seconds 3600))) ;; when Daxter last spoke, long ago until he does
(define *gauntlet-mayhem-voice-last* -1) ;; the last line said, so the next one differs

(defun gauntlet-mayhem-say! ((lines (array string)))
  "Daxter says one of lines at random, never the same twice, as an ambient hint (like the mayor's lines). Rate-limited by
   GAUNTLET_MAYHEM_VOICE_GAP; if another hint is playing (*hint-semaphore*) the line is dropped, not retried."
  (when (and *gauntlet-misty-mayhem-voice* (time-elapsed? *gauntlet-mayhem-voice-time* GAUNTLET_MAYHEM_VOICE_GAP))
    (let ((pick (rand-vu-int-range 0 (+ (length lines) -1))))
      (if (= pick *gauntlet-mayhem-voice-last*) (set! pick (mod (+ pick 1) (length lines))))
      (set! *gauntlet-mayhem-voice-last* pick)
      (cond
        ((ambient-hint-spawn (-> lines pick) (the-as vector #f) *entity-pool* 'ambient)
         (set-time! *gauntlet-mayhem-voice-time*)))))
  0)

(defun gauntlet-mayhem-onset! ()
  "The muse was just lost: the beat that says so. (The screen flash is the icon process's.)"
  ;; half a boulder's shake
  (activate! *camera-smush-control* 410.0 37 600 1.0 0.995)
  (sound-play "bonelurk-roar" :position #f)
  (set! *gauntlet-mayhem-roar-at* (+ (current-time) GAUNTLET_MAYHEM_ROAR_GAP))
  (when *target*
    (process-spawn part-tracker :init part-tracker-init group-dark-eco-box-explosion -1 #f #f #f (target-pos 0) :to *entity-pool*))
  ;; "it's an ambush", "look out", "a bad feeling"
  (gauntlet-mayhem-say! (new 'static 'boxed-array :type string "sksp0069" "sksp0152" "sksp0124"))
  0)

(defun gauntlet-mayhem-relief! ()
  "The muse was just caught: Daxter's relief. (The chime and burst are the flip's.)"
  ;; "we showed him a thing or two", "we made it"
  (gauntlet-mayhem-say! (new 'static 'boxed-array :type string "sksp009a" "sksp0095"))
  0)

(defun gauntlet-mayhem-roar-poll! ()
  "Per-frame, from the icon's process: play the babak's answer to the bonelurker's roar when it is due."
  (when (and (nonzero? *gauntlet-mayhem-roar-at*) (>= (current-time) *gauntlet-mayhem-roar-at*))
    (set! *gauntlet-mayhem-roar-at* 0)
    (sound-play "babak-roar" :position #f))
  0)

(define-extern gauntlet-in-level? (function symbol basic))

(defconstant GAUNTLET_MAYHEM_MUSIC_PRIORITY 40.0) ;; the flava's priority, above the level's music zones (default 10, ambient.gc)

(define *gauntlet-mayhem-music* #f) ;; the icon's process has asked for the battle flavour and not yet taken it back

(defun gauntlet-mayhem-music-off! ()
  "Take back the battle flavour if asked for. set-setting! belongs to the process that made it, which is the caller."
  (when *gauntlet-mayhem-music*
    (set! *gauntlet-mayhem-music* #f)
    (remove-setting! 'sound-flava))
  0)

(defun gauntlet-mayhem-music-poll! ()
  "Per-frame, from the icon's process (set-setting! belongs to the calling process and dies with it, and this one lives as long
   as Misty): while the muse is loose and Jak is on the island, play Misty's battle flavour (gsound.gc, flava-table-add misty).
   A flavour chosen in the progress menu still wins."
  (let ((want (and *gauntlet-misty-mayhem-music* (gauntlet-mayhem-on?) (gauntlet-in-level? 'misty))))
    (cond
      ((and want (not *gauntlet-mayhem-music*))
       (set! *gauntlet-mayhem-music* #t)
       (set-setting! 'sound-flava #f GAUNTLET_MAYHEM_MUSIC_PRIORITY (music-flava misty-battle)))
      ((and (not want) *gauntlet-mayhem-music*) (gauntlet-mayhem-music-off!))))
  0)

(defun gauntlet-muse-flip! ((carried symbol))
  "Make carried the muse's state and say so once: eco burst at Jak (blue and chime if caught, red and warning if lost), then
   the beat (gauntlet-mayhem-onset!, gauntlet-mayhem-relief!). A no-op if the state is unchanged."
  (when (!= carried (gauntlet-muse-carried?))
    (set! *gauntlet-muse-state* (if carried (gauntlet-muse-state carried) (gauntlet-muse-state loose)))
    (set-time! *gauntlet-muse-flip-time*)
    (if (not carried) (+! *gauntlet-muse-episode* 1))
    (when *target*
      (dotimes (i 6)
        (gauntlet-eco-burst! *target* (if carried (gauntlet-eco blue) (gauntlet-eco red))))
      (if carried
        (sound-play "g-eco-pickup" :position #f)
        (sound-play "robo-warning" :position #f)))
    (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-babak-sync proc) (none)) *null-kernel-context*)
    (if carried (gauntlet-mayhem-relief!) (gauntlet-mayhem-onset!)))
  0)

;; ------------------------------------------------------------ the mayhem's world --

;; While the muse is loose, Misty turns dark eco violet with thicker fog, and fades back when she is caught.
;; The mood is rewritten every frame by update-mood-misty, so *mood-post-hook* (time-of-day.gc) tints it after, in place.
;; Colours the game writes only once (second light group) are left alone: a multiply there would compound.
;; Only the level named misty is touched. Units are the mood's own: 0 to 255 for colours, 0 to 1 for lights.

(defconstant GAUNTLET_MAYHEM_FADE_IN 1.2) ;; seconds to turn when she is lost
(defconstant GAUNTLET_MAYHEM_FADE_OUT 3.0) ;; slower coming back, a relief and not a cut
(defconstant GAUNTLET_MAYHEM_FOG_CLOSING 0.45) ;; share the fog's far end closes at full blend (180 m to about 100 m)

(define *gauntlet-mayhem-blend* 0.0) ;; 0.0 calm up to 1.0 mayhem

(defun gauntlet-mayhem-blend-poll! ()
  "Per-frame: ease the blend toward 1.0 while the muse is loose, else 0.0; zero at once when Misty is not running."
  (cond
    ((not (gauntlet-misty-active?)) (set! *gauntlet-mayhem-blend* 0.0))
    ((paused?))
    ((gauntlet-mayhem-on?)
     (set! *gauntlet-mayhem-blend* (seek *gauntlet-mayhem-blend* 1.0 (/ (seconds-per-frame) GAUNTLET_MAYHEM_FADE_IN))))
    (else
     (set! *gauntlet-mayhem-blend* (seek *gauntlet-mayhem-blend* 0.0 (/ (seconds-per-frame) GAUNTLET_MAYHEM_FADE_OUT)))))
  0)

(defun gauntlet-mood-toward! ((colour vector) (r float) (g float) (b float) (amount float))
  "Move colour's red, green and blue amount of the way (0 to 1) to r, g and b; its fourth is left as it is."
  (set! (-> colour x) (lerp (-> colour x) r amount))
  (set! (-> colour y) (lerp (-> colour y) g amount))
  (set! (-> colour z) (lerp (-> colour z) b amount))
  0)

(defun gauntlet-mood-dim! ((colour vector) (blend float))
  "Take the green out of colour and a little of the red and the blue, as far as blend (0 to 1): what leaves a light violet."
  (set! (-> colour x) (* (-> colour x) (- 1.0 (* 0.25 blend))))
  (set! (-> colour y) (* (-> colour y) (- 1.0 (* 0.65 blend))))
  (set! (-> colour z) (* (-> colour z) (- 1.0 (* 0.10 blend))))
  0)

(defun gauntlet-mayhem-tint! ((mood mood-context) (blend float))
  "Tint mood, the mood of Misty this frame, blend of the way to the mayhem's violet."
  (let ((fog (-> mood current-fog))
        (sun (-> mood current-sun))
        (lights (-> mood light-group)))
    (gauntlet-mood-toward! (-> fog fog-color) 118.0 18.0 110.0 (* 0.7 blend))
    (gauntlet-mood-toward! (-> fog erase-color) 52.0 0.0 48.0 blend)
    (gauntlet-mood-toward! (-> sun env-color) 118.0 18.0 110.0 (* 0.6 blend))
    (gauntlet-mood-toward! (-> sun sun-color) 200.0 20.0 160.0 (* 0.8 blend))
    (set! (-> fog fog-dists y) (* (-> fog fog-dists y) (- 1.0 (* GAUNTLET_MAYHEM_FOG_CLOSING blend))))
    ;; Lights Jak and the lurkers use: group 0 ambient and first light, plus its second light between palette snapshots.
    ;; The mood function copies group 0 ambient into group 1 every frame.
    (gauntlet-mood-dim! (-> lights 0 ambi color) blend)
    (gauntlet-mood-dim! (-> lights 0 dir0 color) blend)
    (if (< 0.0 (-> lights 0 dir1 levels x)) (gauntlet-mood-dim! (-> lights 0 dir1 color) blend))
    (gauntlet-mood-dim! (-> lights 1 ambi color) blend)
    (gauntlet-mood-dim! (-> mood current-prt-color) blend))
  0)

;; called by time-of-day.gc for each active level, after its mood function has run
(defun *mood-post-hook* ((lev level))
  (when (and (= (-> lev name) 'misty) (= (-> lev status) 'active))
    (let ((blend (* *gauntlet-mayhem-blend* *gauntlet-misty-mayhem-atmosphere*)))
      (if (< 0.001 blend) (gauntlet-mayhem-tint! (-> lev mood) blend))))
  (none))

;; ------------------------------------------------------------------ the ring --

(defconstant GAUNTLET_RING_LIFT (meters 0.3)) ;; keeps a ring off the ground so it is not buried
(defconstant GAUNTLET_RING_EDGE_SPACING (meters 1)) ;; between spots of the edge wall, close enough to read as one line
(defconstant GAUNTLET_RING_CLOCK_SPACING (meters 1.5)) ;; between spots of the growing ring
(defconstant GAUNTLET_RING_MIN_SPOTS 6) ;; a small ring is still a ring, not a spot
(defconstant GAUNTLET_RING_MAX_SPOTS 112) ;; cap per ring (particle table cost): a bigger circle spaces wider, never costs more
(defconstant GAUNTLET_RIM_SPACING (meters 2.5)) ;; between ground probes of a rim
(defconstant GAUNTLET_RIM_SAMPLES 96) ;; must match the rise array in gauntlet-rim
(defconstant GAUNTLET_RING_PULSE_HZ 1.5) ;; wall pulses per second before the clock starts
(defconstant GAUNTLET_RING_PULSE_EXTRA 6.0) ;; extra pulses over the whole clock, quicker near the end
(defconstant GAUNTLET_RING_MAX_EMBERS 16) ;; most embers launched in one frame
(defconstant GAUNTLET_RING_EMBER_AREA 50.0) ;; square meters per ember a frame, so a small blast is not a bonfire
(defconstant GAUNTLET_PART_RING_EDGE_DIM 3551) ;; wall between pulses
(defconstant GAUNTLET_PART_RING_EDGE_BRIGHT 3552) ;; wall on a pulse
(defconstant GAUNTLET_PART_RING_CLOCK 3553) ;; the ring that grows from the middle
(defconstant GAUNTLET_PART_RING_EMBER 3554) ;; glow of the swept ground

;; Ground heights for a ring on uneven ground, probed once where it stands: the rise above the center at count
;; spots around the rim, at the probed radius. A smaller circle takes its heights from these, scaled.
(deftype gauntlet-rim (structure)
  ((count  int32)
   (radius float)
   (rise   float 96))) ;; GAUNTLET_RIM_SAMPLES

;; flat ground: no spots, so every ring stands at its center's height
(define *gauntlet-flat-rim* (new 'global 'gauntlet-rim))
(set! (-> *gauntlet-flat-rim* count) 0)

(defun gauntlet-ring-spots ((radius float) (spacing float) (most int))
  "Spots for a circle of radius with one per spacing along the arc, clamped to GAUNTLET_RING_MIN_SPOTS and most."
  (max GAUNTLET_RING_MIN_SPOTS (min most (the int (/ (* TWO_PI radius) spacing)))))

(defun gauntlet-ring-rise ((rim gauntlet-rim) (radius float) (angle float))
  "Height of the ground at angle (rotation units) on a ring of radius, above the center, read from the probes of rim and
   scaled by radius. 0.0 for a flat rim; a circle wider than the probes keeps the rim's heights."
  (cond
    ((zero? (-> rim count)) 0.0)
    (else
     (let* ((turns (/ angle DEGREES_PER_ROT))
            (past (- turns (the float (the int turns))))
            (around (if (< past 0.0) (+ past 1.0) past))
            (at (* around (the float (-> rim count))))
            (low (min (the int at) (+ (-> rim count) -1)))
            (high (if (>= (+ low 1) (-> rim count)) 0 (+ low 1)))
            (inward (if (< 0.0 (-> rim radius)) (fmin 1.0 (/ radius (-> rim radius))) 0.0)))
       (* inward (lerp (-> rim rise low) (-> rim rise high) (- at (the float low))))))))

;; Every ground circle in this mod means: get out before the inner ring reaches you. The red wall is the edge of the hurt and
;; pulses faster as time runs out; the inner ring is the clock and hits the wall at impact. Ground it has swept is still
;; the blast's. A new area hazard is drawn with gauntlet-ring, never some other way.

;; The wall is dim between pulses and bright on one, so it breathes and never goes out. Spots are launched every
;; frame and live 2 or 3 frames: no gaps, no trail. Big enough that spots 2 m apart run together.
(defpart 3551
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 2.6))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 12.0)
   (:b 4.0)
   (:a 30.0)
   (:timer (seconds 0.04))
   (:flags (bit2 bit3 bit14))))

(defpart 3552
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 3.2))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 70.0)
   (:b 24.0)
   (:a 112.0)
   (:timer (seconds 0.04))
   (:flags (bit2 bit3 bit14))))

;; The clock: hotter (orange to yellow) than the wall so the two read apart.
(defpart 3553
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 2.2))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 170.0)
   (:b 50.0)
   (:a 96.0)
   (:timer (seconds 0.04))
   (:flags (bit2 bit3 bit14))))

;; Swept ground: a few embers a frame, rising a little and fading over a quarter second.
(defpart 3554
  :init-specs
  ((:texture (hotdot effects))
   (:num 1.0)
   (:scale-x (meters 1.0) (meters 0.8))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 40.0 70.0)
   (:b 4.0 12.0)
   (:a 60.0)
   (:vel-y (meters 0.002))
   (:fade-a -0.8)
   (:timer (seconds 0.25))
   (:flags (bit2 bit3 bit14))))

(defun gauntlet-fraction ((value float))
  "The part of a non-negative value after the point."
  (- value (the float (the int value))))

(defun gauntlet-ring-circle ((center vector) (radius float) (spots int) (part int) (rim gauntlet-rim))
  "Launch particle part on each of spots evenly around a circle of radius at center; rim gives the ground's rise, or *gauntlet-flat-rim*."
  (let ((at (new 'stack-no-clear 'vector)))
    (dotimes (i spots)
      (let ((angle (* (/ DEGREES_PER_ROT (the float spots)) (the float i))))
        (set! (-> at x) (+ (-> center x) (* radius (sin angle))))
        (set! (-> at y) (+ (-> center y) (gauntlet-ring-rise rim radius angle) GAUNTLET_RING_LIFT))
        (set! (-> at z) (+ (-> center z) (* radius (cos angle))))
        (set! (-> at w) 1.0)
        (launch-particles (-> *part-id-table* part) at))))
  0)

(defun gauntlet-ring-fill ((center vector) (swept float) (rim gauntlet-rim))
  "Launch a few embers over the disc of radius swept at center: a sunflower at the golden angle, turned and shifted
   each frame so it never shows a spoke or a ring. The ground under each is the rim's, scaled."
  (let* ((meters-swept (/ swept METER_LENGTH))
         (embers (min GAUNTLET_RING_MAX_EMBERS
                      (max 2 (the int (/ (* (* PI meters-swept) meters-swept) GAUNTLET_RING_EMBER_AREA)))))
         (tick (the float (logand (current-time) #xfff)))
         (shift (gauntlet-fraction (* tick 0.1236068)))
         (turn (gauntlet-fraction (* tick 0.0472136)))
         (at (new 'stack-no-clear 'vector)))
    (dotimes (i embers)
      (let* ((from-middle (* swept (sqrtf (/ (+ (the float i) shift) (the float embers)))))
             (angle (* DEGREES_PER_ROT (gauntlet-fraction (+ (* (the float i) 0.381966) turn)))))
        (set! (-> at x) (+ (-> center x) (* from-middle (sin angle))))
        (set! (-> at y) (+ (-> center y) (gauntlet-ring-rise rim from-middle angle) GAUNTLET_RING_LIFT))
        (set! (-> at z) (+ (-> center z) (* from-middle (cos angle))))
        (set! (-> at w) 1.0)
        (launch-particles (-> *part-id-table* GAUNTLET_PART_RING_EMBER) at))))
  0)

(defun gauntlet-ring ((center vector) (radius float) (clock float) (elapsed float) (rim gauntlet-rim))
  "Draw one frame of a hurt area at center: a pulsing red wall at radius, a ring grown to radius times clock, and embers on
   the swept ground. clock runs 0.0 to 1.0 (impact); elapsed (seconds) drives the pulse, GAUNTLET_RING_PULSE_HZ plus extra by clock squared."
  (let* ((run (fmax 0.0 (fmin 1.0 clock)))
         (pulse (+ (* GAUNTLET_RING_PULSE_HZ elapsed) (* (* GAUNTLET_RING_PULSE_EXTRA run) run)))
         (swept (* radius run)))
    (gauntlet-ring-circle center radius (gauntlet-ring-spots radius GAUNTLET_RING_EDGE_SPACING GAUNTLET_RING_MAX_SPOTS)
                          (if (< (gauntlet-fraction pulse) 0.5) GAUNTLET_PART_RING_EDGE_BRIGHT GAUNTLET_PART_RING_EDGE_DIM)
                          rim)
    ;; nothing swept yet (clock not started, or a point)
    (when (< (meters 1) swept)
      (gauntlet-ring-circle center swept (gauntlet-ring-spots swept GAUNTLET_RING_CLOCK_SPACING GAUNTLET_RING_MAX_SPOTS)
                            GAUNTLET_PART_RING_CLOCK rim)
      (gauntlet-ring-fill center swept rim)))
  0)

;; ------------------------------------------------------------------ the bomb --

(deftype gauntlet-bomb (process-drawable)
  ((body      handle)
   (ground-y  float)
   (fall-from float)
   (next-tick float)
   (pull-speed float)
   (pulling symbol)
   (countdown int)
   (gravity float)
   (start-time time-frame) ;; when it appeared: the wall pulses by it
   (rim gauntlet-rim :inline)) ;; ground heights around the landing, probed once
  (:states
   gauntlet-bomb-fall
   gauntlet-bomb-countdown
   gauntlet-bomb-explode
   gauntlet-bomb-gone))

(defun gauntlet-seconds-since ((start time-frame))
  "How many seconds have passed since start."
  (/ (the float (- (current-time) start)) (the float (seconds 1))))

(defun gauntlet-ground-below ((where vector) (out vector))
  "The ground under where, written to out; where itself when none is in reach, so the bomb always has somewhere to land."
  (set! (-> out quad) (-> where quad))
  (find-ground-and-draw-shadow where
                               out
                               0.0
                               (collide-kind background ground-object)
                               (the-as process-drawable #f)
                               GAUNTLET_GROUND_PROBE_UP
                               GAUNTLET_GROUND_PROBE_LENGTH)
  ;; a failed probe returns a spot above the start, not ground
  (if (< (+ (-> where y) GAUNTLET_GROUND_PROBE_UP) (-> out y))
    (set! (-> out y) (-> where y)))
  out)

(defun gauntlet-bomb-body ((body handle))
  "The manipy that draws the bomb, or #f once it is gone."
  (let ((proc (handle->process body)))
    (the-as manipy (if (and proc (type-type? (-> proc type) manipy)) proc))))

(defbehavior gauntlet-bomb-play gauntlet-bomb ((anim string) (mode symbol))
  "Have its body play anim through manipy's own events: mode 'play runs it once, 'loop runs it forever."
  (let ((body (gauntlet-bomb-body (-> self body))))
    (when body
      (send-event body 'anim-mode mode)
      (send-event body 'art-joint-anim anim 0)))
  0)

(defbehavior gauntlet-bomb-aura gauntlet-bomb ()
  "One frame of the bomb's blue eco aura at its body's joints, for as long as the body is there."
  (let ((body (gauntlet-bomb-body (-> self body))))
    (if body (gauntlet-eco-aura! body (gauntlet-eco blue))))
  0)

(defbehavior gauntlet-bomb-anim-done? gauntlet-bomb ()
  "True once the 'play anim has reached its end."
  (let ((body (gauntlet-bomb-body (-> self body))))
    (and body (send-event body 'query 'done))))

(defbehavior gauntlet-bomb-probe-rim gauntlet-bomb ()
  "Probe the ground around the landing once: each spot of a ring at *gauntlet-bomb-blast-radius* keeps its height against the
   ground under the bomb. A spot with no ground takes the bomb's own height."
  (let* ((radius *gauntlet-bomb-blast-radius*)
         (spots (gauntlet-ring-spots radius GAUNTLET_RIM_SPACING GAUNTLET_RIM_SAMPLES))
         (probe (new 'stack-no-clear 'vector))
         (ground (new 'stack-no-clear 'vector)))
    (set! (-> self rim count) spots)
    (set! (-> self rim radius) radius)
    (dotimes (i spots)
      (let ((angle (* (/ DEGREES_PER_ROT (the float spots)) (the float i))))
        (set! (-> probe x) (+ (-> self root trans x) (* radius (sin angle))))
        (set! (-> probe y) (+ (-> self ground-y) GAUNTLET_BOMB_RING_PROBE_RAISE))
        (set! (-> probe z) (+ (-> self root trans z) (* radius (cos angle))))
        (set! (-> probe w) 1.0)
        (gauntlet-ground-below probe ground)
        ;; a failed probe returns its own start
        (if (>= (-> ground y) (-> probe y))
          (set! (-> ground y) (-> self ground-y)))
        (set! (-> self rim rise i) (- (-> ground y) (-> self ground-y))))))
  0)

(defbehavior gauntlet-bomb-mark-blast gauntlet-bomb ((clock float))
  "Draw the blast area (gauntlet-ring) from the fall until it goes off, on the landing ground, following the probed heights.
   clock is the share of the countdown run: 0.0 through the fall, 1.0 at the blast."
  (let ((center (new 'stack-no-clear 'vector)))
    ;; the bomb is high while it falls; the circles sit on the ground it lands on
    (set! (-> center x) (-> self root trans x))
    (set! (-> center y) (-> self ground-y))
    (set! (-> center z) (-> self root trans z))
    (set! (-> center w) 1.0)
    (gauntlet-ring center *gauntlet-bomb-blast-radius* clock (gauntlet-seconds-since (-> self start-time)) (-> self rim)))
  0)

;; ------------------------------------------------------------------ the pull --

(defun gauntlet-jak-invulnerable? ((jak target))
  "True while Jak cannot be hurt: timed, debug or powerup invulnerability. The same test the game's hit handler
   (target-attacked) uses, so it spares him from the blast and the pull too."
  (logtest? (-> jak state-flags) (state-flags invulnerable timed-invulnerable invuln-powerup)))

(defun gauntlet-pullable? ((jak target))
  "True when Jak moves on his own (foot, air, water) and a sideways step is safe: not dying, grabbed, in a movie or on an
   edge grab, and not invulnerable, so a recent hit also frees him from the pull."
  (and (not (logtest? (-> jak state-flags) (state-flags dying grabbed)))
       (not (real-movie?))
       (not (gauntlet-jak-invulnerable? jak))
       (!= (-> jak next-state name) 'target-edge-grab)))

(defun gauntlet-jak-gripped? ((jak target))
  "True when Jak has something under his feet to push against: the ground, or the water he stands in."
  (or (logtest? (-> jak control status) (cshape-moving-flags onground))
      (logtest? (-> jak water flag) (water-flag touch-water))))

(defbehavior gauntlet-bomb-pull gauntlet-bomb ()
  "One frame of the bomb's gravity well: step Jak toward it, sideways only and never past it, within *gauntlet-bomb-pull-radius*.
   Speed is *gauntlet-bomb-ground-pull* when gripped, else grows by *gauntlet-bomb-pull* a second, times desperation. Stepped as the whirlpool does (integrate-and-collide!)."
  (let ((jak *target*))
    (when (and jak (gauntlet-pullable? jak))
      (let* ((control (-> jak control))
             (toward (vector-! (new 'stack-no-clear 'vector) (-> self root trans) (-> control trans)))
             (distance (vector-xz-length toward)))
        (cond
          ((or (>= distance *gauntlet-bomb-pull-radius*) (< distance 1.0))
           (set! (-> self pull-speed) 0.0))
          (else
           (when (not (-> self pulling))
             (set! (-> self pulling) #t))
           (if (gauntlet-jak-gripped? jak)
             (set! (-> self pull-speed) *gauntlet-bomb-ground-pull*)
             (+! (-> self pull-speed) (* *gauntlet-bomb-pull* (seconds-per-frame))))
           ;; cap the speed so one frame never carries him past the bomb
           (set! (-> toward y) 0.0)
           (vector-xz-normalize! toward (fmin (* (-> self pull-speed) (gauntlet-desperation)) (/ distance (seconds-per-frame))))
           (fill-cache-for-shape! control (+ 8192.0 (vector-xz-length toward)) (-> control root-prim collide-with))
           (let ((status (-> control status)))
             (integrate-and-collide! control toward)
             (set! (-> control status) status)))))))
  0)

(defbehavior gauntlet-bomb-init-by-other gauntlet-bomb ((where vector))
  "Appear *gauntlet-bomb-drop-height* above where and fall to the ground. Countdown and gravity are read now, so changing them mid-air does not bend this bomb."
  ;; keep ticking whatever the actors around do (the finale's bomb does the same)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self body) (the-as handle #f))
  (set! (-> self pull-speed) 0.0)
  (set! (-> self pulling) #f)
  (set! (-> self countdown) *gauntlet-bomb-countdown*)
  (set! (-> self gravity) *gauntlet-bomb-gravity*)
  (set-time! (-> self start-time))
  (set! (-> self root) (new 'process 'trsqv))
  (let ((ground (new 'stack-no-clear 'vector)))
    (gauntlet-ground-below where ground)
    (set! (-> self ground-y) (-> ground y)))
  (set! (-> self root trans quad) (-> where quad))
  ;; the landing is known now: probe the ground around it once
  (gauntlet-bomb-probe-rim)
  (+! (-> self root trans y) *gauntlet-bomb-drop-height*)
  (set! (-> self fall-from) (-> self root trans y))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  ;; no entity; the body's draw is filed under the default level (common art)
  (set! (-> self entity) #f)
  (let ((body (manipy-spawn (-> self root trans) #f *gauntlet-darkecobomb-sg* #f :to self)))
    (when body
      (set! (-> self body) (ppointer->handle body))
      (send-event (ppointer->process body) 'rot-quat (-> self root quat))
      ;; manipy-init has run, so its draw exists; the glow stays for good
      (let ((made (gauntlet-bomb-body (-> self body))))
        (if made (gauntlet-eco-glow! made (gauntlet-eco blue))))))
  (go gauntlet-bomb-fall)
  (none))

(defstate gauntlet-bomb-fall (gauntlet-bomb)
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (let ((body (gauntlet-bomb-body (-> self body))))
        ;; no body, no bomb
        (if (not body) (go gauntlet-bomb-gone))
        (gauntlet-bomb-aura)
        ;; clock not started: only the wall stands
        (gauntlet-bomb-mark-blast 0.0)
        (let* ((fallen (gauntlet-seconds-since (-> self state-time)))
               (y (- (-> self fall-from) (* 0.5 (-> self gravity) fallen fallen))))
          (set! (-> self root trans y) (fmax y (-> self ground-y)))
          (send-event body 'trans (-> self root trans))
          (if (>= (-> self ground-y) y) (go gauntlet-bomb-countdown)))))
  :code
    (behavior ()
      (gauntlet-bomb-play "darkecobomb-blast" 'play)
      ;; one frame so the body takes the new anim and 'done is asked of the right one
      (suspend)
      (until (gauntlet-bomb-anim-done?)
        (suspend))
      (gauntlet-bomb-play "darkecobomb-idle" 'loop)
      (suspend-for (seconds 0.2))
      (loop
        (suspend))))

(defstate gauntlet-bomb-countdown (gauntlet-bomb)
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self next-tick) GAUNTLET_BOMB_FIRST_TICK))
  :trans
    (behavior ()
      (gauntlet-bomb-pull)
      (gauntlet-bomb-aura)
      (let* ((elapsed (- (current-time) (-> self state-time)))
             (remaining (fmax 0.0 (/ (the float (- (-> self countdown) elapsed)) (the float (-> self countdown))))))
        ;; the growing ring is the clock: it reaches the wall on the blast frame
        (gauntlet-bomb-mark-blast (- 1.0 remaining))
        ;; finale-style warning: beep and flash each time cos drops under next-tick, which drops each beep, so they speed up
        (when (< (cos (* 16384.0 (- 1.0 remaining))) (-> self next-tick))
          (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_TICK) 150 #f #f #f (-> self root trans) :to *entity-pool*)
          (+! (-> self next-tick) (- GAUNTLET_BOMB_TICK_STEP))
          (sound-play "robo-warning"))
        (if (>= elapsed (-> self countdown)) (go gauntlet-bomb-explode))))
  :code
    (behavior ()
      (sound-play "bomb-open")
      (gauntlet-bomb-play "darkecobomb-open" 'play)
      (suspend)
      (until (gauntlet-bomb-anim-done?)
        (suspend))
      (gauntlet-bomb-play "darkecobomb-spin-cycle" 'loop)
      (suspend-for (seconds 0.2))
      (loop
        (suspend))))

(defstate gauntlet-bomb-explode (gauntlet-bomb)
  :code
    (behavior ()
      (sound-play "explosion" :position #f)
      (activate! *camera-smush-control* 819.2 37 600 1.0 0.995)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_BLAST) 900 #f #f #f (-> self root trans) :to *entity-pool*)
      (let ((body (gauntlet-bomb-body (-> self body))))
        (if body (send-event body 'draw #f)))
      ;; Jak inside the blast dies after his hit reaction. Plain 'attack, so a recent hit's invulnerability spares him
      (when (and *target* (< (vector-vector-distance (-> self root trans) (target-pos 0)) *gauntlet-bomb-blast-radius*))
        (send-event *target* 'attack #f (static-attack-info ((mode 'death)))))
      ;; his hit reaction reads the bomb's position, so it must outlive the attack
      (suspend-for (seconds 1))
      (deactivate self)))

(defstate gauntlet-bomb-gone (gauntlet-bomb)
  :code
    (behavior ()
      (deactivate self)))

;; A handle is 64 bits (address and pid) but a global symbol holds 32: `(define *x* (the-as handle ...))` loses the pid,
;; so handle->process never found the bomb alive. Keep the handle in a structure field, as the game does.
(deftype gauntlet-bomb-ref (structure)
  ((bomb handle)))

(define *gauntlet-bomb* (new 'global 'gauntlet-bomb-ref))
(set! (-> *gauntlet-bomb* bomb) (the-as handle #f))

(defun gauntlet-bomb-alive? ()
  "True while the last bomb dropped is still in the world, from the moment it appears to the end of its blast."
  (if (handle->process (-> *gauntlet-bomb* bomb)) #t #f))

(defun gauntlet-bomb-drop! ((where vector))
  "Drop the bomb on where if its art is loaded. Never held back for a live bomb: the new one becomes the bomb the spots watch."
  (when (gauntlet-art-ready? *gauntlet-darkecobomb-sg*)
    (let ((bomb (process-spawn gauntlet-bomb :init gauntlet-bomb-init-by-other where :to *entity-pool*)))
      (if bomb
        (set! (-> *gauntlet-bomb* bomb) (ppointer->handle bomb)))))
  0)

;; ------------------------------------------------------------- the drop spots --

(defun gauntlet-in-level? ((which symbol))
  "True when Jak is inside the level called which."
  (let ((lev (level-get-target-inside *level*)))
    (and lev (= (-> lev name) which))))

(defun gauntlet-in-training? ()
  "True when Jak is in Geyser Rock."
  (gauntlet-in-level? 'training))

;; Where the bomb drops on Geyser Rock (level training), one row each: (row index name enabled x y z ax az bx bz), in meters.
;; enabled is the spot's switch; (ax az)-(bx bz) is the trigger segment (a point repeats as both ends). Jak coming within
;; *gauntlet-bridge-trigger-radius* of it drops the bomb; the spot rearms past *gauntlet-bridge-rearm-range*. One bomb alive at a time.
;; This table is the only source of the spot count (GAUNTLET_DROP_SPOTS, below).
(defmacro gauntlet-drop-spot-table (join row)
  "Expand row once per spot, (row index name enabled x y z ax az bx bz), under the form join (begin, to do something for each)."
  `(,join
     ;; Row 0, the bridge: the pillar runners jump from is about 17 m away, so the pull drags that jump back. The trigger is a
     ;; gate across the bridge, 10 m to each side, square to the line from the south pad (eco-211 to eco-218, about -1307.2 922.0)
     ;; to the pillar foot (about -1322.0 958.0). A 5 m circle at the spot was easy to cross without entering.
     (,row 0 "bridge" *gauntlet-bridge-enabled* -1313.8 40.5 946.4 -1323.05 942.6 -1304.55 950.2)
     ;; Row 1, the blue eco vent before the precursor door (ecovent-245): the bomb teaches that blue eco charges Jak and the circle goes up.
     ;; The trigger is a gate 10 m to each side across the bridge to the vent, through the first orb (money-4354, -1284.76 860.26),
     ;; square to the bridge line. It is the orb's place, not its pickup: orbs stay collected in a save. Jak also crosses it running
     ;; back to the door, so the vent row fires only while he is closing on the vent (gauntlet-spot-closing?).
     (,row 1 "vent" *gauntlet-vent-enabled* -1307.98 29.55 854.21 -1287.64 869.84 -1281.88 850.68)))

;; deftype needs a literal array size: raise this when a row is added above
(defconstant GAUNTLET_DROP_SPOTS 2)
(defconstant GAUNTLET_VENT_SPOT 1) ;; the vent row, whose bomb is announced by Gol
(defconstant GAUNTLET_VENT_WARNING (seconds 1)) ;; from the gate to the bomb appearing over the vent

(deftype gauntlet-drop-world (structure)
  ((armed      symbol GAUNTLET_DROP_SPOTS) ;; false from a drop until Jak has been far away again
   (fall-at    time-frame GAUNTLET_DROP_SPOTS) ;; when an announced bomb falls, 0 for none
   (jak-range  float GAUNTLET_DROP_SPOTS))) ;; Jak's last distance to the spot, to tell if he is closing

(define *gauntlet-drop-world* (new 'global 'gauntlet-drop-world))

(dotimes (i GAUNTLET_DROP_SPOTS)
  (set! (-> *gauntlet-drop-world* armed i) #t)
  (set! (-> *gauntlet-drop-world* fall-at i) 0)
  (set! (-> *gauntlet-drop-world* jak-range i) 0.0))

(define *gauntlet-vent-gol-told* #f) ;; set once Gol has said his line, once per game session

(defmacro gauntlet-row-spot-at (index name enabled x y z ax az bx bz)
  `(if (= i ,index) (set-vector! out (meters ,x) (meters ,y) (meters ,z) 1.0)))

(defun gauntlet-drop-spot-at ((i int) (out vector))
  "Spot i of the table, written to out and handed back."
  (gauntlet-drop-spot-table begin gauntlet-row-spot-at)
  out)

(defun gauntlet-xz-segment-distance ((px float) (pz float) (ax float) (az float) (bx float) (bz float))
  "How far the point (px pz) is from the segment (ax az)-(bx bz), on the ground plane. A segment of no length is a point."
  (let* ((dx (- bx ax))
         (dz (- bz az))
         (length2 (+ (* dx dx) (* dz dz)))
         (along 0.0))
    (if (< 0.0 length2)
      (set! along (fmax 0.0 (fmin 1.0 (/ (+ (* (- px ax) dx) (* (- pz az) dz)) length2)))))
    (let ((nx (- px (+ ax (* along dx))))
          (nz (- pz (+ az (* along dz)))))
      (sqrtf (+ (* nx nx) (* nz nz))))))

(defmacro gauntlet-row-spot-reach (index name enabled x y z ax az bx bz)
  `(if (= i ,index) (set! reach (gauntlet-xz-segment-distance (-> jak x) (-> jak z) (meters ,ax) (meters ,az) (meters ,bx) (meters ,bz)))))

(defun gauntlet-drop-reach ((i int))
  "Jak's sideways distance to spot i's trigger, in units: what *gauntlet-bridge-trigger-radius* and the rearm range are measured against."
  (let ((jak (target-pos 0))
        (reach 0.0))
    (gauntlet-drop-spot-table begin gauntlet-row-spot-reach)
    reach))

(defun gauntlet-vent-gol-line! ()
  "Gol calls FIRE! (GOL-AM04) a second before the first vent bomb falls, once per game session (*gauntlet-vent-gol-told*).
   An ambient hint with no position; if another hint is playing (*hint-semaphore*) the spawn is refused and the line is lost."
  (cond
    (*gauntlet-vent-gol-told*)
    (else
     (set! *gauntlet-vent-gol-told* #t)
     (ambient-hint-spawn "GOL-AM04" (the-as vector #f) *entity-pool* 'ambient)))
  0)

(defun gauntlet-spot-bomb! ((index int) (spot vector))
  "Set off spot index. The bridge's bomb drops now; the vent's is announced (Gol's line) and dropped by
   gauntlet-spot-fall-poll! GAUNTLET_VENT_WARNING later. With no art there is no line and no drop."
  (cond
    ((!= index GAUNTLET_VENT_SPOT)
     (gauntlet-bomb-drop! spot))
    ((gauntlet-art-ready? *gauntlet-darkecobomb-sg*)
     (gauntlet-vent-gol-line!)
     (set! (-> *gauntlet-drop-world* fall-at index) (+ (current-time) GAUNTLET_VENT_WARNING))))
  0)

(defun gauntlet-spot-fall-poll! ((index int) (spot vector))
  "Per-frame for one spot: an announced bomb falls once its time is up, wherever Jak is, then nothing is pending."
  (let ((fall-at (-> *gauntlet-drop-world* fall-at index)))
    (when (and (nonzero? fall-at) (>= (current-time) fall-at))
      (set! (-> *gauntlet-drop-world* fall-at index) 0)
      (gauntlet-bomb-drop! spot)))
  0)

(defun gauntlet-spot-closing? ((index int) (spot vector))
  "True when Jak is nearer to spot than at the last call for spot index (he is heading for it). It remembers the distance,
   so ask once a frame, before anything that might return early."
  (let ((range (vector-vector-xz-distance (target-pos 0) spot))
        (before (-> *gauntlet-drop-world* jak-range index)))
    (set! (-> *gauntlet-drop-world* jak-range index) range)
    (< range before)))

(defun gauntlet-spot-poll! ((index int) (enabled symbol))
  "Per-frame for one spot while Jak is on Geyser Rock: set it off (gauntlet-spot-bomb!) when he is within *gauntlet-bridge-trigger-radius*
   of its trigger, it is armed and no bomb is alive. The vent fires only while he closes on it. With enabled off it never fires but still tracks him."
  (let* ((spot (gauntlet-drop-spot-at index (new 'stack-no-clear 'vector)))
         (reach (gauntlet-drop-reach index))
         (closing (gauntlet-spot-closing? index spot))
         (right-way (or (!= index GAUNTLET_VENT_SPOT) closing)))
    (gauntlet-spot-fall-poll! index spot)
    (cond
      ((> reach *gauntlet-bridge-rearm-range*)
       (set! (-> *gauntlet-drop-world* armed index) #t))
      (else
       (when (and enabled
                  (-> *gauntlet-drop-world* armed index)
                  (< reach *gauntlet-bridge-trigger-radius*)
                  right-way
                  (not (gauntlet-bomb-alive?)))
         (set! (-> *gauntlet-drop-world* armed index) #f)
         (gauntlet-spot-bomb! index spot)))))
  0)

(defmacro gauntlet-row-spot-poll (index name enabled x y z ax az bx bz)
  `(gauntlet-spot-poll! ,index ,enabled))

(defun gauntlet-drop-spots-poll! ()
  "Per-frame: watch every spot while Jak is on Geyser Rock. When he leaves (or dies between lives) a pending announced bomb
   is called off, so it does not fall on his next visit."
  (cond
    ((and *target* (gauntlet-in-training?))
     (gauntlet-drop-spot-table begin gauntlet-row-spot-poll))
    (else
     (dotimes (i GAUNTLET_DROP_SPOTS)
       (set! (-> *gauntlet-drop-world* fall-at i) 0))))
  0)

;; -------------------------------------------------------------- the stampede --

;; A herd of yakows charges at Jak in a straight line and runs through. Available on every level: the art is in GAME.CGO,
;; and these are new entity-less processes, not the village yakow (its code is in VI1.DGO and needs a nav mesh).
;; Three columns, rows along the heading, side columns half a row behind; slot i is row i / 3, column i mod 3, so a bigger herd only adds rows.
;; The first *gauntlet-stampede-red-count* slots are red: a heavier hit (two hits, throws Jak far). Slot 0 hits the spot dead on.

(defconstant GAUNTLET_STAMPEDE_COLUMNS 3) ;; yakows to a row
(defconstant GAUNTLET_STAMPEDE_COLUMN_SPACING (meters 6.5)) ;; between column centers, so the band is 13 m wide
(defconstant GAUNTLET_STAMPEDE_ROW_SPACING (meters 9)) ;; between rows: at 14 m/s a row arrives every 0.65 s
(defconstant GAUNTLET_STAMPEDE_APPROACH (meters 50)) ;; the lead row starts this far upstream of the spot
(defconstant GAUNTLET_STAMPEDE_EXIT (meters 30)) ;; and vanishes this far past it
(defconstant GAUNTLET_STAMPEDE_PROBE_RAISE (meters 6)) ;; ground is probed from this far above, so a rise does not bury it
(defconstant GAUNTLET_STAMPEDE_GROUND_SEEK (meters 20)) ;; max speed at which a yakow follows the ground up or down
(defconstant GAUNTLET_STAMPEDE_SHOVE_BACK (meters 3.5)) ;; about how far a hit throws Jak along the ground; height is *gauntlet-stampede-launch-up*
(defconstant GAUNTLET_STAMPEDE_RED_LAUNCH_BONUS 0.5) ;; extra launch for a red yakow, times the desperation
(defconstant GAUNTLET_YAKOW_RADIUS (meters 1.4)) ;; touch sphere, snug to the body so the lanes are as wide as they look
(defconstant GAUNTLET_YAKOW_CENTER (meters 1.3)) ;; height of the sphere above its feet
(defconstant GAUNTLET_YAKOW_RUN_PACE 1.5) ;; the village yakow's run animation speed (yakow-bank run-anim-speed, capped) at its run speed...
(defconstant GAUNTLET_YAKOW_RUN_PACE_SPEED (meters 6)) ;; ...which is this; faster legs scale with speed so the stride keeps up

;; No :shadow: the shadow mesh is unmeasured and the sage's wrapped the shadow VU1's 8-bit edge count (see
;; *gauntlet-yellowsage-sg*); 30 yakows would be 30 shadows. Sort 1 is the pris draw group, texture level 2 finds common art.
(defskelgroup *gauntlet-yakow-sg*
  yakow
  yakow-lod0-jg
  yakow-run-ja
  ((yakow-lod0-mg (meters 20)) (yakow-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 2.5 0 4.4)
  :longest-edge (meters 1.3)
  :texture-level 2
  :sort 1)

(deftype gauntlet-yakow (process-drawable)
  ((root      collide-shape :override)
   (heading   vector :inline)
   (speed     float)
   (remaining float)
   (timeout   int)
   (index     int)
   (pace      float)
   (phase     float)
   (eco       gauntlet-eco))
  (:states
   gauntlet-yakow-run
   gauntlet-yakow-gone))

(define *gauntlet-stampede-alive* 0) ;; yakows in the world, to tell when the herd is finished
(define *gauntlet-stampede-last-hit* (- 0 (seconds 3600))) ;; when a yakow last hurt Jak
(define *gauntlet-stampede-armed* #t) ;; false after Sandover's charge until Jak has been far from its spot

;; Sandover herd origin: the spot is where the player stood, 11 m from farmer-3 (village1-actors.json). The jungle is not in
;; village1, so the heading comes from the load boundary toward it (load-boundary-data.gc), centered at the point below.
;; The jungle's "jungle-start" continue point (level-info.gc) is 13 degrees off, but the boundary is the route Jak takes.
;; The herd starts GAUNTLET_STAMPEDE_APPROACH from the spot toward that point and runs back through it.
(define *gauntlet-stampede-spot* (new 'static 'vector :x (meters -4.059) :y (meters 2.299) :z (meters -55.185) :w 1.0))
(define *gauntlet-stampede-jungle* (new 'static 'vector :x (meters 99.5) :y (meters 0) :z (meters -127.1) :w 1.0))

(defun gauntlet-stampede-alive? ()
  "True while any yakow of a herd is still in the world."
  (> *gauntlet-stampede-alive* 0))

(defun gauntlet-stampede-recent-hit? ()
  "True from a yakow hitting Jak until his invulnerability runs out. Yakows leave him alone then and are not solid to him."
  (not (time-elapsed? *gauntlet-stampede-last-hit* (-> *TARGET-bank* hit-invulnerable-timeout))))

;; Height comes from target-hit-move (target-death.gc): vertical speed is 2048 + sqrt(491520 * shove-up), so shove-up is the rise.
;; Nothing clamps it, and the ground push ends at shove-back, so a higher throw does not go farther. Landing on something that hears
;; 'bonk from above fall-far (30 m) fires *target-bonk-hook*, which drops the Misty muse: a stampede throw is meant to be a fall.
(defbehavior gauntlet-yakow-trample gauntlet-yakow ((jak process) (touching touching-shapes-entry))
  "Jak touched this yakow: one plain 'attack (his invulnerability can refuse it), never a kill. It throws him
   *gauntlet-stampede-launch-up* high; a red yakow throws higher and farther by desperation and adds a second hit."
  (when (not (gauntlet-stampede-recent-hit?))
    (let* ((knock (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> self root trans)))
           (red? (= (-> self eco) (gauntlet-eco red)))
           (strength (gauntlet-desperation))
           (back (if red? (* GAUNTLET_ECO_RED_SHOVE_BACK strength) GAUNTLET_STAMPEDE_SHOVE_BACK))
           (up (if red? (* *gauntlet-stampede-launch-up* (+ 1.0 (* GAUNTLET_STAMPEDE_RED_LAUNCH_BONUS strength))) *gauntlet-stampede-launch-up*)))
      (set! (-> knock y) 0.0)
      ;; standing exactly on the yakow's center has no direction away, so use its heading
      (if (< (vector-xz-length knock) 40.96)
        (set! (-> knock quad) (-> self heading quad)))
      (vector-xz-normalize! knock back)
      (set! (-> knock y) up)
      (when (send-event jak 'attack touching (static-attack-info ((mode 'generic) (shove-back back) (shove-up up) (vector knock))))
        (set! *gauntlet-stampede-last-hit* (current-time))
        (if red? (gauntlet-eco-second-hit! jak)))))
  0)

(defbehavior gauntlet-yakow-event gauntlet-yakow ((proc process) (argc int) (message symbol) (block event-message-block))
  "The only event a yakow handles is 'touch from Jak."
  (case message
    (('touch) (gauntlet-yakow-trample proc (the-as touching-shapes-entry (-> block param 0)))))
  #f)

(defbehavior gauntlet-yakow-follow-ground gauntlet-yakow ((most float))
  "Move the yakow's height toward the ground under it by at most most; it keeps its height if none is found (see gauntlet-ground-below)."
  (let ((probe (new 'stack-no-clear 'vector))
        (ground (new 'stack-no-clear 'vector)))
    (set! (-> probe quad) (-> self root trans quad))
    (+! (-> probe y) GAUNTLET_STAMPEDE_PROBE_RAISE)
    (gauntlet-ground-below probe ground)
    (if (< (-> ground y) (-> probe y))
      (seek! (-> self root trans y) (-> ground y) most)))
  0)

(defbehavior gauntlet-yakow-step gauntlet-yakow ()
  "One frame of the charge: step along the heading, follow the ground, and go when the distance or the timeout backstop runs out."
  (let ((step (* (-> self speed) (seconds-per-frame))))
    (+! (-> self root trans x) (* (-> self heading x) step))
    (+! (-> self root trans z) (* (-> self heading z) step))
    (+! (-> self remaining) (- step))
    (gauntlet-yakow-follow-ground (* GAUNTLET_STAMPEDE_GROUND_SEEK (seconds-per-frame)))
    (set! (-> self root transv x) (* (-> self heading x) (-> self speed)))
    (set! (-> self root transv z) (* (-> self heading z) (-> self speed)))
    (set! (-> self root root-prim prim-core offense)
          (if (gauntlet-stampede-recent-hit?) (collide-offense no-offense) (collide-offense indestructible)))
    (when (or (<= (-> self remaining) 0.0) (time-elapsed? (-> self state-time) (-> self timeout)))
      (go gauntlet-yakow-gone)))
  0)

(defbehavior gauntlet-yakow-post gauntlet-yakow ()
  "The usual post, plus the yakow's eco aura, which streams out behind it as a trail."
  (transform-post)
  (gauntlet-eco-aura! self (-> self eco))
  0)

(defstate gauntlet-yakow-run (gauntlet-yakow)
  :event gauntlet-yakow-event
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (gauntlet-yakow-step))
  :code
    (behavior ()
      (ja-channel-push! 1 0)
      (ja :group! yakow-run-ja :num! min)
      ;; each yakow starts at its own point in the stride so a row does not gallop in lockstep
      (ja :num-func num-func-identity :frame-num (-> self phase))
      (loop
        (suspend)
        (ja :num! (loop! (-> self pace)))))
  :post gauntlet-yakow-post)

(defstate gauntlet-yakow-gone (gauntlet-yakow)
  :code
    (behavior ()
      (deactivate self)))

(defmethod deactivate ((this gauntlet-yakow))
  "However a yakow goes, it stops counting."
  (+! *gauntlet-stampede-alive* -1)
  ((method-of-type process-drawable deactivate) this)
  (none))

(defbehavior gauntlet-yakow-init-by-other gauntlet-yakow ((start vector) (heading vector) (run-length float) (index int) (speed float) (eco gauntlet-eco))
  "Appear at start facing heading (unit vector, ground plane), to run run-length game units at speed; eco is its charge, if any."
  (stack-size-set! (-> self main-thread) 512)
  ;; counted from the start so this matches deactivate's uncounting
  (+! *gauntlet-stampede-alive* 1)
  ;; keep running when actors pause, as the bomb does
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self index) index)
  (set! (-> self speed) speed)
  (set! (-> self eco) eco)
  (set! (-> self remaining) run-length)
  ;; backstop: twice the time the distance takes, plus five seconds
  (set! (-> self timeout) (+ (the int (* 2.0 (/ run-length speed) (the float (seconds 1)))) (seconds 5)))
  (set! (-> self heading quad) (-> heading quad))
  (set! (-> self pace) (fmax 1.0 (* GAUNTLET_YAKOW_RUN_PACE (/ speed GAUNTLET_YAKOW_RUN_PACE_SPEED))))
  (set! (-> self phase) (the float (mod (* index 5) 16)))
  ;; touch sphere only Jak's collision looks for: solid, so his move sends 'touch; indestructible so the move
  ;; reports it (see collide-offense in collide-shape-h.gc)
  (let ((shape (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-sphere shape (the uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind wall-object))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid))
      (set! (-> prim prim-core offense) (collide-offense indestructible))
      (set-vector! (-> prim local-sphere) 0.0 GAUNTLET_YAKOW_CENTER 0.0 GAUNTLET_YAKOW_RADIUS)
      (set-root-prim! shape prim))
    (backup-collide-with-as shape)
    (set! (-> self root) shape))
  (set! (-> self root trans quad) (-> start quad))
  ;; snap to the ground at once rather than climb to it
  (gauntlet-yakow-follow-ground (meters 1000))
  (quaternion-vector-angle! (-> self root quat) (new 'static 'vector :y 1.0 :w 1.0) (vector-y-angle heading))
  (vector-identity! (-> self root scale))
  (initialize-skeleton self *gauntlet-yakow-sg* '())
  (gauntlet-eco-glow! self eco)
  (update-transforms! (-> self root))
  (go gauntlet-yakow-run)
  (none))

(defun gauntlet-stampede-slot ((index int) (out vector))
  "Where slot index stands, written to out: x is the offset to the herd's right of its line, z the distance behind the lead row."
  (let* ((row (/ index GAUNTLET_STAMPEDE_COLUMNS))
         (column (- index (* row GAUNTLET_STAMPEDE_COLUMNS))))
    (set! (-> out x)
          (cond
            ((= column 0) 0.0)
            ((= column 1) (- GAUNTLET_STAMPEDE_COLUMN_SPACING))
            (else GAUNTLET_STAMPEDE_COLUMN_SPACING)))
    (set! (-> out z) (+ (* (the float row) GAUNTLET_STAMPEDE_ROW_SPACING) (if (= column 0) 0.0 (* 0.5 GAUNTLET_STAMPEDE_ROW_SPACING)))))
  out)

(defun gauntlet-stampede! ((spot vector) (heading vector))
  "Send the herd at spot along heading (unit vector): the lead row starts GAUNTLET_STAMPEDE_APPROACH upstream and all run on
   to GAUNTLET_STAMPEDE_EXIT past it. Nothing is sent without the art."
  (cond
    ((not (gauntlet-art-ready? *gauntlet-yakow-sg*)))
    (else
     (let ((size *gauntlet-stampede-herd-size*)
           (speed *gauntlet-stampede-speed*)
           (red-count (min *gauntlet-stampede-red-count* *gauntlet-stampede-herd-size*))
           (slot (new 'stack-no-clear 'vector))
           (start (new 'stack-no-clear 'vector)))
       (dotimes (i size)
         (gauntlet-stampede-slot i slot)
         ;; upstream is behind the heading; the herd's right is the heading turned a quarter, (z, -x)
         (let ((upstream (+ GAUNTLET_STAMPEDE_APPROACH (-> slot z))))
           (set! (-> start x) (+ (- (-> spot x) (* (-> heading x) upstream)) (* (-> heading z) (-> slot x))))
           (set! (-> start y) (-> spot y))
           (set! (-> start z) (- (- (-> spot z) (* (-> heading z) upstream)) (* (-> heading x) (-> slot x))))
           (process-spawn gauntlet-yakow
                          :init gauntlet-yakow-init-by-other
                          start
                          heading
                          (+ upstream GAUNTLET_STAMPEDE_EXIT)
                          i
                          speed
                          (if (< i red-count) (gauntlet-eco red) (gauntlet-eco none))
                          :to *entity-pool*))))))
  0)

(defun gauntlet-stampede-ahead! ()
  "A stampede at Jak's spot, charging from GAUNTLET_STAMPEDE_APPROACH ahead of where he faces so he sees it coming."
  (let ((heading (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> *target* control quat-for-control))))
    (set! (-> heading y) 0.0)
    ;; runs against his facing, toward him
    (vector-xz-normalize! heading -1.0)
    (gauntlet-stampede! (target-pos 0) heading))
  0)

(defun gauntlet-stampede-from-jungle! ()
  "Sandover's herd: aimed at the spot beside the farmer, charging back out of the Forbidden Jungle direction."
  (let ((heading (vector-! (new 'stack-no-clear 'vector) *gauntlet-stampede-spot* *gauntlet-stampede-jungle*)))
    (set! (-> heading y) 0.0)
    (vector-xz-normalize! heading 1.0)
    (gauntlet-stampede! *gauntlet-stampede-spot* heading))
  0)

;; how close Jak and a hit yakow must be for the heading between them to have no direction
(defconstant GAUNTLET_STAMPEDE_SAME_SPOT (meters 0.01))

(defun gauntlet-stampede-yakow-hit! ((yakow process-drawable))
  "Jak just attacked a farm yakow (yakow.gc calls this once per new attack). If enabled and no herd is running, a herd charges
   through that yakow at Jak; if he is on top of it, from ahead of him instead."
  (cond
    ((not *target*) #f)
    ((not *gauntlet-yakow-stampede-enabled*))
    ((gauntlet-stampede-alive?))
    (else
     (let* ((jak (target-pos 0))
            (hit (-> yakow root trans))
            (heading (vector-! (new 'stack-no-clear 'vector) jak hit)))
       (cond
         ((< (vector-vector-xz-distance jak hit) GAUNTLET_STAMPEDE_SAME_SPOT) (gauntlet-stampede-ahead!))
         (else
          (set! (-> heading y) 0.0)
          (vector-xz-normalize! heading 1.0)
          (gauntlet-stampede! jak heading))))))
  0)

(defun gauntlet-stampede-poll! ()
  "Per-frame: in Sandover, send the herd when Jak is within *gauntlet-stampede-trigger-radius* of the spot and none runs;
   it re-arms past *gauntlet-stampede-rearm-range* or on leaving the level."
  (cond
    ((and *target* (gauntlet-in-level? 'village1))
     (let ((distance (vector-vector-xz-distance (target-pos 0) *gauntlet-stampede-spot*)))
       (cond
         ((> distance *gauntlet-stampede-rearm-range*) (set! *gauntlet-stampede-armed* #t))
         ((and *gauntlet-stampede-enabled*
               *gauntlet-stampede-armed*
               (< distance *gauntlet-stampede-trigger-radius*)
               (not (gauntlet-stampede-alive?)))
          (set! *gauntlet-stampede-armed* #f)
          (gauntlet-stampede-from-jungle!)))))
    (else (set! *gauntlet-stampede-armed* #t)))
  0)

;; ------------------------------------------------------------------- Klaww --

;; Klaww, the ogre boss, arrives with the pelican at Sentinel Beach. When the pelican lands at its nest with the power cell
;; (pelican-wait-at-nest, pelican.gc), he falls onto it like the cannon blast, holds the cell and lobs boulders at Jak.
;; The beach buttons (one table row each, see "state") throw his boulders back at his chest; one hit per button kills him
;; and the cell drops at the nest.
;;
;; The pelican only announces (gauntlet-klaww-pelican-at-nest!) and the per-frame poll acts, so the story also plays when the
;; level loads with the pelican already there. His fall is a plain drop from GAUNTLET_KLAWW_FALL_HEIGHT with a landing ring.
;;
;; gauntlet-klaww-arrive! can call him down on any level, but the mod only does it on the beach; elsewhere there are no
;; buttons. The level he arrived in is his home, and leaving it takes him away.
;;
;; Like the bomb and the herd he is entity-less with common art (ogreboss-ag.go, generic-button-ag.go in GAME.CGO), so he
;; does not depend on the beach level. levels/ogre/ogreboss.gc is not reused (tied to the ogre level); only its art, anim
;; names and boulder lob are borrowed.
;;
;; Nest: pelican-1's entity (beach-actors.json) at -162.25 11.65 -423.03 is the nest, the shared vertex of its path-from-nest0
;; and path-to-nest0. His root is at his feet, so they go on the ground probed under the nest. At full size he is 14 m tall,
;; so he is drawn at GAUNTLET_KLAWW_SCALE (10 m).
;;
;; He draws himself like the yakow, not through a manipy: a boss that winds up, throws and flinches needs the animation
;; channels in his own hands, and his joints (claw, chest) are then plain reads of his node list.
;;
;; The buttons are basebutton subtypes (engine/common-obs/basebutton.gc) that throw a boulder back instead of sending an event.
;; basebutton already runs without an entity (spawned-by-other?). They use our own skelgroup with texture level 2 and sort 1,
;; since the stock one draws in the default sink group.
;;
;; A hit is one of GAUNTLET_KLAWW_MAX_HITS, one per button, spent once its boulder reaches him. The fight lives in globals, not
;; processes: Jak dying or a speedrun reset runs reset-actors, which kills everything in *entity-pool*, and Klaww and the
;; buttons are born again from the globals. The fight resets only when Jak leaves the level or klaww-enabled goes off.
;;
;; Fewer hits left means faster throws (his rage, below); a lurker cannon shot heals one hit and gives back a button.

(defconstant GAUNTLET_KLAWW_FALL_HEIGHT (meters 60)) ;; he starts this far above his landing ground, high enough to be seen coming
(defconstant GAUNTLET_KLAWW_FALL_GRAVITY (meters 40)) ;; per second per second: the drop takes 1.7 s
(defconstant GAUNTLET_KLAWW_LAND_RADIUS (meters 9)) ;; ring drawn where he will land
(defconstant GAUNTLET_KLAWW_QUAKE_RANGE (meters 150)) ;; Jak this close to a landing feels the camera shake
(defconstant GAUNTLET_KLAWW_SCALE 0.7) ;; size against the model: 10 m tall instead of 14, so he fits the nest rock
(defconstant GAUNTLET_KLAWW_BOULDER_SPEED (meters 30)) ;; sideways: 100 m to Jak is 3.3 s in the air
(defconstant GAUNTLET_KLAWW_BOULDER_MIN_FLIGHT 1.5) ;; seconds, so a close throw is not a blink
(defconstant GAUNTLET_KLAWW_BOULDER_GRAVITY (meters 10)) ;; per second per second: a lob, not the game's flat 5 or Jak's 60
(defconstant GAUNTLET_KLAWW_SHOVE_BACK (meters 5)) ;; about how far a landing throws Jak, away from it
(defconstant GAUNTLET_KLAWW_SHOVE_UP (meters 2))
(defconstant GAUNTLET_KLAWW_SHOT_SPEED (meters 40)) ;; sideways: 100 m to his chest in 2.5 s
(defconstant GAUNTLET_KLAWW_SHOT_GRAVITY (meters 14)) ;; per second per second: steeper than his own so the arc reads from far away
(defconstant GAUNTLET_KLAWW_SHOT_LIFT (meters 1.5)) ;; it leaves this far above the button
(defconstant GAUNTLET_KLAWW_FLINCH (seconds 0.4)) ;; the ogre's own flinch is 0.15 s, stretched so it reads across the beach
(defconstant GAUNTLET_KLAWW_PROBE_RAISE (meters 3)) ;; ground probe starts this far above the spot
(defconstant GAUNTLET_KLAWW_CHEST (meters 8.75)) ;; chest height in the bind pose, to aim at before he has been drawn
(defconstant GAUNTLET_KLAWW_BODY_HEIGHT (meters 9.5)) ;; height a cannon blast counts as his body: his head at scale
(defconstant GAUNTLET_KLAWW_BODY_RADIUS (meters 3)) ;; and its radius, a little under his arms
(defconstant GAUNTLET_PART_GROUP_KLAWW_TRAIL 1002) ;; ids this file adds to the particle tables, after the bomb's
(defconstant GAUNTLET_PART_GROUP_KLAWW_IMPACT 1003)
(defconstant GAUNTLET_PART_KLAWW_CENTER 3533)

