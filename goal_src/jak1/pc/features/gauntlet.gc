;; ogre-obs.gc's *tntbarrel-sg*, asking for the common art. Sort 1 like every other common-art prop and character.
(defskelgroup *gauntlet-tntbarrel-sg*
  tntbarrel
  tntbarrel-lod0-jg
  tntbarrel-idle-ja
  ((tntbarrel-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 2 0 4)
  :texture-level 2
  :sort 1)

;; The barrels, one table row each: (row index level x y z), the spot in meters. The y is a hint: the barrel stands on the
;; ground probed for from just above it (gauntlet-klaww-ground, which every hand-picked spot of this mod goes through), so a
;; spot read off something floating, like a power cell, still puts the barrel on the ground. A "here" request from the
;; designer adds a row. The only place that says how many barrels there are is this table; GAUNTLET_TNT_BARRELS, below,
;; is the count.
;;
;; Row 0 is the designer's pick: on Sentinel Beach, standing just below a power cell, he asked for a barrel between himself and
;; the cell. He stood at -345.70 23.50 -440.27 and the cell (fuel-cell-42) floats at -357.37 26.82 -431.18; the spot is the
;; midpoint of the two sideways, at the height of his feet.
(defmacro gauntlet-tnt-table (join row)
  "Expand row once per barrel, (row index level x y z), under the form join (begin, to do something for each)."
  `(,join
     (,row 0 beach -351.54 23.5 -435.73)))

;; The rows of the table, written out: deftype needs a literal array size. A row added above needs this raised with it.
(defconstant GAUNTLET_TNT_BARRELS 1)

(deftype gauntlet-tnt-world (structure)
  ((barrels handle GAUNTLET_TNT_BARRELS)))

(define *gauntlet-tnt-world* (new 'global 'gauntlet-tnt-world))

;; a null handle is one whose process is #f, not zero (see gauntlet-klaww-forget-all!)
(dotimes (i GAUNTLET_TNT_BARRELS)
  (set! (-> *gauntlet-tnt-world* barrels i) (the-as handle #f)))

(define *gauntlet-tnt-art-told* #f) ;; a missing art group is told about once, not every frame

(deftype gauntlet-tnt (process-drawable)
  ((root collide-shape :override)
   (row  int)
   (big  symbol)) ;; true when it was told 'die-big, which is the bigger explosion
  (:states
   gauntlet-tnt-idle
   gauntlet-tnt-die))

(defstate gauntlet-tnt-die (gauntlet-tnt)
  :code
    (behavior ()
      (format 0 "GAUNTLET TNT row ~D exploded~%" (-> self row))
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self root))
      (ja-post)
      (sound-play "dcrate-break")
      (process-spawn part-tracker
                     :init
                     part-tracker-init
                     (get-part-group (if (-> self big) GAUNTLET_PART_GROUP_TNT_BIG GAUNTLET_PART_GROUP_TNT))
                     -1
                     #f
                     #f
                     #f
                     (-> self root trans)
                     :to
                     *entity-pool*)
      (suspend)
      (cleanup-for-death self)
      (deactivate self)))

(defstate gauntlet-tnt-idle (gauntlet-tnt)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('die-big)
         (set! (-> self big) #t)
         (go gauntlet-tnt-die))
        (('die) (go gauntlet-tnt-die))
        (('attack 'touch)
         (send-event proc 'attack-invinc (-> block param 0) (static-attack-info ((mode 'death))))
         (go gauntlet-tnt-die))))
  :code
    (behavior ()
      (transform-post)
      (logior! (-> self mask) (process-mask sleep))
      (suspend)
      0))

(defbehavior gauntlet-tnt-init-by-other gauntlet-tnt ((row int) (feet vector))
  "Appear on feet, the ground under its spot, as table row row. The touch shape is the game's barrel's, a mesh prim around
   the skull that only Jak's own collision looks for."
  (stack-size-set! (-> self main-thread) 512)
  ;; keep standing whatever the actors around do, as the bomb does
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self row) row)
  (set! (-> self big) #f)
  (let ((shape (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-mesh shape (the-as uint 0) (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind crate))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid))
      (set! (-> prim prim-core offense) (collide-offense touch))
      (set! (-> prim transform-index) 3)
      (set-vector! (-> prim local-sphere) 0.0 9216.0 0.0 14336.0)
      (set-root-prim! shape prim))
    (set! (-> shape nav-radius) (* 0.75 (-> shape root-prim local-sphere w)))
    (backup-collide-with-as shape)
    (set! (-> self root) shape))
  (set! (-> self root trans quad) (-> feet quad))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (initialize-skeleton self *gauntlet-tntbarrel-sg* '())
  (set-vector! (-> self draw color-mult) 1.3 1.3 1.3 1.0)
  (go gauntlet-tnt-idle)
  (none))

(defun gauntlet-tnt-keep! ((index int) (home symbol) (x float) (y float) (z float))
  "Make sure barrel index stands at its row of the table, in meters x y z (as game units here), while Jak is inside the level called home and
   the setting is on; put it away when either stops being true. A barrel that is missing is stood again only when Jak is
   farther than GAUNTLET_TNT_REARM_RANGE from its spot."
  (let ((barrel (-> *gauntlet-tnt-world* barrels index))
        (spot (set-vector! (new 'stack-no-clear 'vector) x y z 1.0)))
    (cond
      ((or (not *gauntlet-tnt-enabled*) (not (gauntlet-in-level? home)))
       (when (handle->process barrel)
         (gauntlet-klaww-remove barrel)
         (format 0 "GAUNTLET TNT row ~D put away~%" index)))
      ((handle->process barrel))
      ((not (gauntlet-art-ready? *gauntlet-tntbarrel-sg*))
       (when (not *gauntlet-tnt-art-told*)
         (set! *gauntlet-tnt-art-told* #t)
         (format 0 "GAUNTLET TNT: the barrel's art group is not loaded, nothing spawned~%")))
      ((< GAUNTLET_TNT_REARM_RANGE (vector-vector-xz-distance (target-pos 0) spot))
       (let ((ground (new 'stack-no-clear 'vector)))
         (gauntlet-klaww-ground spot ground)
         (let ((made (process-spawn gauntlet-tnt :init gauntlet-tnt-init-by-other index ground :to *entity-pool*)))
           (when made
             (set! (-> *gauntlet-tnt-world* barrels index) (ppointer->handle made))
             (format 0 "GAUNTLET TNT spawned row ~D at (~M, ~M, ~M)~%" index (-> ground x) (-> ground y) (-> ground z))))))))
  0)

(defmacro gauntlet-row-tnt-keep (index level x y z)
  `(gauntlet-tnt-keep! ,index (quote ,level) (meters ,x) (meters ,y) (meters ,z)))

(defun gauntlet-tnt-poll! ()
  "Per-frame: every barrel of the table is kept standing (or put away) as gauntlet-tnt-keep! says. With no Jak (loading,
   dying) nothing changes."
  (when *target*
    (gauntlet-tnt-table begin gauntlet-row-tnt-keep))
  0)

;; ------------------------------------------------------------------ the horde --

;; Every enemy the level places that runs on the nav mesh (a babak, a lurker crab, a hopper, a bonelurker, an ice cube...) is
;; born with company: *gauntlet-lurker-multiplier* minus one clones, standing on a ring around it. A clone is the same
;; process, born by the same init-from-entity! from the same entity, but the entity's own process stays the original: the
;; entity system's bookkeeping (dead, complete, culled when Jak walks away) is the original's alone, and process-entity-status!
;; and entity-deactivate-handler both ignore a process that is not the one the entity names, so a clone dying or being
;; taken away never marks the entity dead and never clears the original. engine/entity/entity.gc calls *entity-born-hook*
;; after each birth; this is what answers.
;;
;; The entity system does not know the clones, so the mod ends them. Their entity is the original's, which is what makes the
;; engine itself take them away when their level unloads (deactivate-entities sweeps *entity-pool* for processes whose entity
;; is in the level). One small watcher per birth does the rest: it ends the clones when the original is culled by distance
;; (a fresh original with fresh clones is born when Jak comes back, so they do not pile up), and ends itself when no clone
;; is left. A clone outlives an original that was killed, as a lurker outlives its neighbour.
;;
;; The crowd is capped (*gauntlet-horde-max-clones*, all groups together). The count is never kept, it is taken: a recount walks
;; *entity-pool* and adds up, for each watcher standing, the clones whose handles still name a live process. A kept tally would
;; have to hear about every way a clone can end (killed by Jak, put away with its watcher by reset-actors when Jak dies or a
;; speedrun resets, swept with its level by deactivate-entities) and would drift on the one it missed; the handles cannot drift,
;; because the kernel invalidates them. The walk costs one pass over a pool of a few hundred processes, once per birth and once
;; per state write.
;;
;; Misty Island's lurkers have more company while the muse is loose (see "the muse"): *gauntlet-misty-mayhem-extra* more clones,
;; the extras. They live in slots of their own (the last GAUNTLET_HORDE_MAX_CLONES of the group's handles), so that taking them
;; away on a catch, or topping them up on a drop, never touches the normal clones, and so that the group does not have to remember
;; which are which. The watcher of a Misty group stays for as long as extras could come (until its level goes, the original is
;; put away or killed), because an original whose normal clones are all dead is still owed its extras the next time she is dropped.
;; A group tops itself up once for each time the muse has gone loose (*gauntlet-muse-episode*), so extras that Jak killed are not
;; born again while she stays loose, and a Misty lurker born in the calm gets its extras the first time she is lost.
;;
;; Nothing here keeps a string: a field of a plain process subtype that points into the process's own heap is not moved when
;; the heap compacts (engine/entity/relocate.gc adjusts only what each type's relocate method names, as nav-enemy's does for its
;; neck and rand-gen), so a copy of the actor's name would dangle. The name is read from the entity instead, which is safe while
;; the actor's level is active, and the line that is written once it is not names the level.

(defconstant GAUNTLET_HORDE_MAX_CLONES 4) ;; clones in ONE group: the console's multiplier tops out at 5, the original and four clones; and Misty's extras at four too (the cap on all groups together is the setting *gauntlet-horde-max-clones*)
(defconstant GAUNTLET_HORDE_SLOTS 8) ;; handles a group holds: slots 0 to 3 are its normal clones, 4 to 7 Misty's extras. deftype below needs this written out
(defconstant GAUNTLET_HORDE_RING_RADIUS (meters 3)) ;; clones stand this far from the original, evenly around it
(defconstant GAUNTLET_HORDE_EXTRA_RADIUS (meters 5)) ;; and Misty's extras this far, a quarter turn at a time from a diagonal, so they stand between and outside the others

(deftype gauntlet-horde (process)
  ((ent        entity-actor) ;; the actor the clones are of; its memory is its level's, so it is read only while that level is active
   (original   handle) ;; the actor's own process, the one the entity system manages
   (level-name symbol) ;; the level the actor belongs to
   (episode    int32) ;; the *gauntlet-muse-episode* this group last topped its extras up for; 0 before it has
   (clones     handle 8)) ;; GAUNTLET_HORDE_SLOTS of them, a null handle (not a zero) where there is none
  (:states
   gauntlet-horde-watch))

(defun gauntlet-horde-live-clones ((horde gauntlet-horde))
  "How many of horde's clones, normal and extra, are still alive."
  (let ((alive 0))
    (dotimes (i GAUNTLET_HORDE_SLOTS)
      (if (handle->process (-> horde clones i)) (+! alive 1)))
    alive))

(define *gauntlet-horde-groups* 0) ;; watchers standing, as of the last gauntlet-horde-recount!
(define *gauntlet-horde-clones* 0) ;; clones alive across them, as of the same recount

(defun gauntlet-horde-tally! ((proc process))
  "Add proc to the running totals if it is a watcher: one more group, and as many clones as its handles still name."
  (let ((horde (as-type proc gauntlet-horde)))
    (when horde
      (+! *gauntlet-horde-groups* 1)
      (+! *gauntlet-horde-clones* (gauntlet-horde-live-clones horde))))
  (none))

(defun gauntlet-horde-recount! ()
  "Take the census of the horde into *gauntlet-horde-groups* and *gauntlet-horde-clones*, from the watchers standing in
   *entity-pool* right now."
  (set! *gauntlet-horde-groups* 0)
  (set! *gauntlet-horde-clones* 0)
  (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-horde-tally! proc) (none)) *null-kernel-context*)
  0)

(defbehavior gauntlet-horde-remove-clones gauntlet-horde ()
  "Take away every clone still alive, the extras too."
  (dotimes (i GAUNTLET_HORDE_SLOTS)
    (let ((alive (handle->process (-> self clones i))))
      (if alive (deactivate alive))))
  0)

(defbehavior gauntlet-horde-level-left? gauntlet-horde ()
  "True once the level the actor belongs to is no longer the one running: from then on its entity is not to be read."
  (!= (level-status *level* (-> self level-name)) 'active))

(defbehavior gauntlet-horde-name gauntlet-horde ()
  "The actor's name, read from its entity: only to be called while its level is active."
  (res-lump-struct (-> self ent) 'name string))

(defbehavior gauntlet-horde-walked-away? gauntlet-horde ()
  "True once the original is gone without having been killed: the entity system culled it because Jak walked away (or a
   death reset the actors), and it will be born again, with fresh clones, when he comes back."
  (and (not (handle->process (-> self original)))
       (not (logtest? (-> self ent extra perm status) (entity-perm-status dead)))))

(define-extern gauntlet-horde-clone! (function entity-actor vector handle)) ;; below: the extras are born the way the clones are

(defun gauntlet-puff! ((where vector))
  "A puff of dust at where, from the game's own particles for Jak's landings (target-part.gc, in GAME.CGO)."
  (process-spawn part-tracker :init part-tracker-init group-land-poof-dirt 300 #f #f #f where :to *entity-pool*)
  0)

(defun gauntlet-horde-extras-alive ((horde gauntlet-horde))
  "How many of horde's Misty extras are still alive."
  (let ((alive 0))
    (dotimes (i GAUNTLET_HORDE_MAX_CLONES)
      (if (handle->process (-> horde clones (+ GAUNTLET_HORDE_MAX_CLONES i))) (+! alive 1)))
    alive))

(defun gauntlet-horde-calm! ((horde gauntlet-horde))
  "The muse is with Jak: every extra of horde still alive goes, each with a puff where it stood. Only the extras; the normal
   clones are the mod's usual and stay."
  (let ((gone 0))
    (dotimes (i GAUNTLET_HORDE_MAX_CLONES)
      (let* ((slot (+ GAUNTLET_HORDE_MAX_CLONES i))
             (alive (handle->process (-> horde clones slot)))
             (body (if alive (as-type alive process-drawable))))
        (when alive
          (if body (gauntlet-puff! (-> body root trans)))
          (deactivate alive)
          (+! gone 1))))
    (if (> gone 0)
      (format 0 "GAUNTLET HORDE ~S mayhem over, -~D extras~%" (res-lump-struct (-> horde ent) 'name string) gone)))
  0)

(defun gauntlet-horde-mayhem! ((horde gauntlet-horde))
  "The muse is loose: top horde's extras up to *gauntlet-misty-mayhem-extra* (four at most), as many as the cap on the crowd
   allows, each in the slot of its own, on a ring wider than the normal clones' around where the original was placed. This
   is done once for each time she goes loose, which the group's episode remembers, so extras Jak killed stay dead."
  (set! (-> horde episode) *gauntlet-muse-episode*)
  (gauntlet-horde-recount!)
  (let* ((ent (-> horde ent))
         (have (gauntlet-horde-extras-alive horde))
         (asked (- (min *gauntlet-misty-mayhem-extra* GAUNTLET_HORDE_MAX_CLONES) have))
         (room (max 0 (- *gauntlet-horde-max-clones* *gauntlet-horde-clones*)))
         (wanted (min asked room))
         (born 0))
    (when (> wanted 0)
      (let ((spot (new 'stack-no-clear 'vector)))
        (dotimes (i GAUNTLET_HORDE_MAX_CLONES)
          (let ((slot (+ GAUNTLET_HORDE_MAX_CLONES i)))
            (when (and (< born wanted) (not (handle->process (-> horde clones slot))))
              (let ((angle (+ (degrees 45) (* (degrees 90) (the float i)))))
                (set! (-> spot x) (+ (-> ent extra trans x) (* GAUNTLET_HORDE_EXTRA_RADIUS (sin angle))))
                (set! (-> spot y) (-> ent extra trans y))
                (set! (-> spot z) (+ (-> ent extra trans z) (* GAUNTLET_HORDE_EXTRA_RADIUS (cos angle))))
                (set! (-> spot w) 1.0))
              (let ((twin (gauntlet-horde-clone! ent spot)))
                (when (handle->process twin)
                  (set! (-> horde clones slot) twin)
                  (+! born 1))))))))
    (if (< wanted asked)
      (format 0 "GAUNTLET HORDE ~S mayhem capped: ~D of ~D extras fit (~D alive, cap ~D)~%"
              (res-lump-struct ent 'name string) wanted asked *gauntlet-horde-clones* *gauntlet-horde-max-clones*))
    (if (> born 0)
      (format 0 "GAUNTLET HORDE ~S mayhem +~D extras~%" (res-lump-struct ent 'name string) born)))
  0)

(defun gauntlet-horde-misty-watch? ((horde gauntlet-horde))
  "True when horde is Misty's and extras could still come to it: the muse is a state of the island and asks for any."
  (and (= (-> horde level-name) 'misty) *gauntlet-misty-muse-enabled* (> *gauntlet-misty-mayhem-extra* 0)))

(defun gauntlet-horde-mayhem-poll! ((horde gauntlet-horde))
  "Per-frame, for a group of Misty's: the extras go the moment the muse is with Jak, and come, once, the moment she is loose."
  (when (= (-> horde level-name) 'misty)
    (cond
      ((gauntlet-muse-loose?)
       (if (!= (-> horde episode) *gauntlet-muse-episode*) (gauntlet-horde-mayhem! horde)))
      (else (gauntlet-horde-calm! horde))))
  0)

(defstate gauntlet-horde-watch (gauntlet-horde)
  :code
    (behavior ()
      (loop
        (cond
          ((gauntlet-horde-level-left?)
           (gauntlet-horde-remove-clones)
           ;; the actor's name is in the level's memory, which is going: the level is named instead
           (format 0 "GAUNTLET HORDE ~A clones culled (level unloaded)~%" (-> self level-name))
           (deactivate self))
          ((and (zero? (gauntlet-horde-live-clones self))
                (not (and (gauntlet-horde-misty-watch? self) (handle->process (-> self original)))))
           (format 0 "GAUNTLET HORDE ~S watcher done (no clone left)~%" (gauntlet-horde-name))
           (deactivate self))
          ((gauntlet-horde-walked-away?)
           (gauntlet-horde-remove-clones)
           (format 0 "GAUNTLET HORDE ~S clones culled (the original was culled, Jak walked away)~%" (gauntlet-horde-name))
           (deactivate self))
          (else (gauntlet-horde-mayhem-poll! self)))
        (suspend))))

(defbehavior gauntlet-horde-init-by-other gauntlet-horde ((ent entity-actor) (original handle))
  "Watch over the clones of the actor ent, whose own process original names. The clones are put in by the one who spawned us."
  (set! (-> self ent) ent)
  (set! (-> self original) original)
  (set! (-> self level-name) (-> ent extra level name))
  (set! (-> self episode) 0)
  (dotimes (i GAUNTLET_HORDE_SLOTS)
    (set! (-> self clones i) (the-as handle #f)))
  (go gauntlet-horde-watch)
  (none))

(defun gauntlet-horde-lurker? ((proc process))
  "Whether proc, the process an actor was just born as, is one that gets company: anything on the nav mesh, but the few whose
   story lives in the original. The cannon babak has its cannon, the ram boss its fight, the muse and the lightning moles
   are caught for a power cell the task counts (a mole's task is counted through the actor's links), the sharkey reads the
   actor's own spot every time it comes up so a clone would rise at the original's, and the double lurker marks the actor's
   permanent record and carries a buddy of its own."
  (and (type-type? (-> proc type) nav-enemy)
       (case (-> proc type symbol)
         (('babak-with-cannon 'ram-boss 'muse 'lightning-mole 'sharkey 'double-lurker) #f)
         (else #t))))

(defun gauntlet-horde-clone! ((ent entity-actor) (spot vector))
  "Born one more process of the actor ent's type, standing at spot, and hand back a handle to it, or a null handle when there
   is no process to be had or it died in its own init. This is init-entity (engine/entity/entity.gc) without its two links:
   the process is put in *entity-pool* and given the entity, so the engine's level sweep finds it, but (-> ent extra process)
   is not set, so it stays the original.
   The actor's spot is lent: init-from-entity! reads the process's position from the entity (process-drawable-from-entity!),
   and a nav enemy finds its nav poly at init, so the position must be right then, not moved to afterward. run-now-in-process
   returns only when init is done (or has changed state, or died), and nothing else runs meanwhile, so the loan is
   given back before anyone can see it. The only other reader of the spot is the entity system's own distance test, which is
   not run in the middle of an init."
  (let* ((kind (-> ent etype))
         (info (entity-info-lookup kind))
         (fresh (get-process *default-dead-pool* kind (if info (-> info heap-size) #x4000))))
    (if (not fresh) (return (the-as handle #f)))
    (set! (-> fresh type) kind)
    (activate fresh *entity-pool* (res-lump-struct ent 'name basic) *scratch-memory-top*)
    (set! (-> fresh entity) ent)
    (let ((born (process->handle fresh))
          (home (new 'stack-no-clear 'vector)))
      (set! (-> home quad) (-> ent extra trans quad))
      (set! (-> ent extra trans quad) (-> spot quad))
      (run-now-in-process fresh (method-of-object fresh init-from-entity!) fresh ent)
      (set! (-> ent extra trans quad) (-> home quad))
      ;; whatever the actor drops is the original's: a clone drops pills as an ice cube of the beach does, and never the
      ;; actor's power cell or special pickup. The pickup is made from the actor's lumps in init-defaults!, which has run.
      (let* ((alive (handle->process born))
             (nav (if alive (as-type alive nav-enemy))))
        (when (and nav (nonzero? (-> nav enemy-info)))
          (set! (-> nav enemy-info pickup-type) (pickup-type eco-pill-random))
          (set! (-> nav enemy-info pickup-amount) (-> *FACT-bank* default-pill-inc))
          (logclear! (-> nav enemy-info options) (fact-options has-power-cell))))
      born)))

(defun gauntlet-horde-born! ((ent entity-actor))
  "The actor ent has just been born (the entity system's hook, below). If it came up as a lurker that gets company, and its
   story is not already finished (a babak that gives its power cell back is not to be multiplied), spawn the watcher and
   the clones on a ring around it, the first straight along the z axis, and say so. The multiplier asks for some clones; the
   cap on the live ones, counted afresh, says how many fit, possibly none, and then there is no watcher either."
  (let* ((original (-> ent extra process))
         (asked (min (+ *gauntlet-lurker-multiplier* -1) GAUNTLET_HORDE_MAX_CLONES))
         ;; one of Misty's, with extras possible: it gets a watcher even with no normal clones to watch
         (misty (and *gauntlet-misty-muse-enabled* (> *gauntlet-misty-mayhem-extra* 0) (= (-> ent extra level name) 'misty))))
    (when (and original
               (or (> asked 0) misty)
               (not (logtest? (-> ent extra perm status) (entity-perm-status complete)))
               (gauntlet-horde-lurker? original))
      (gauntlet-horde-recount!)
      (let* ((name (res-lump-struct ent 'name string))
             (room (max 0 (- *gauntlet-horde-max-clones* *gauntlet-horde-clones*)))
             (wanted (min asked room)))
        (if (< wanted asked)
          (format 0 "GAUNTLET HORDE ~S capped: ~D of ~D clones asked for fit (~D alive, cap ~D)~%"
                  name wanted asked *gauntlet-horde-clones* *gauntlet-horde-max-clones*))
        (when (or (> wanted 0) misty)
          (let ((watcher (process-spawn gauntlet-horde :init gauntlet-horde-init-by-other ent (process->handle original) :to *entity-pool*)))
            (when watcher
              (let ((horde (-> watcher 0))
                    (home (new 'stack-no-clear 'vector))
                    (spot (new 'stack-no-clear 'vector))
                    (step (/ (degrees 360) (the float (max wanted 1))))
                    (born 0))
                (set! (-> home quad) (-> ent extra trans quad))
                ;; a clone is tried only if every one before it was born: the first that is not ends the line
                (dotimes (i wanted)
                  (when (= born i)
                    (let ((angle (* step (the float i))))
                      (set! (-> spot x) (+ (-> home x) (* GAUNTLET_HORDE_RING_RADIUS (sin angle))))
                      (set! (-> spot y) (-> home y))
                      (set! (-> spot z) (+ (-> home z) (* GAUNTLET_HORDE_RING_RADIUS (cos angle))))
                      (set! (-> spot w) 1.0))
                    (let ((twin (gauntlet-horde-clone! ent spot)))
                      (when (handle->process twin)
                        (set! (-> horde clones born) twin)
                        (+! born 1)))))
                (if (< born wanted)
                  (format 0 "GAUNTLET HORDE ~S wanted +~D clones and no process was free for the rest~%" name wanted))
                ;; the muse loose: the extras are born with the rest, so a lurker that comes up in the mayhem arrives in it
                (if (and misty (gauntlet-muse-loose?)) (gauntlet-horde-mayhem! horde))
                (cond
                  ((> born 0) (format 0 "GAUNTLET HORDE ~S ~A +~D clones~%" name (-> original type) born))
                  (misty)
                  (else (deactivate horde))))))))))
  (none))

;; gauntlet: engine/entity/entity.gc calls this after birth! has run for an actor
(defun *entity-born-hook* ((ent entity-actor))
  (gauntlet-horde-born! ent)
  (none))

;; --------------------------------------------------------- the muse's body --

;; Catching the muse is the game's (levels/misty/muse.gc): the cell, the cutscene, and she is gone. She is not followed by anything
;; and does not stay with Jak; that she is his is shown by an icon (below) and nothing else. Dropping her makes a new muse, a
;; second process of her type from her own actor, born the way the horde's clones are (gauntlet-horde-clone!, which is why this
;; section follows "the horde"): on her path where Jak lost her (muse.gc reads *gauntlet-muse-start*), loose and not to be caught for
;; GAUNTLET_MUSE_GRACE, then the muse of the game again, chasing and run from, giving a catch that is over at once (muse-caught
;; tells a first catch, which closes the task, from the rest). The game's own muse is never the one, because by the time Jak can
;; lose her hers is gone and her actor marked dead, so no birth by the entity system will bring her back; that is the reason for
;; the new one. The same new muse is also the one that stands on the island on a later visit (or after a death, which puts every
;; process of the entity pool away, hers with them) when the actor is dead and the task closed: the mod makes her at her home.

(deftype gauntlet-muse-world (structure)
  ((muse handle) ;; the muse this mod made, until she is caught or put away
   (icon handle) ;; the process that drives the icon
   (face handle))) ;; the manipy it draws her with

(define *gauntlet-muse-world* (new 'global 'gauntlet-muse-world))
(set! (-> *gauntlet-muse-world* muse) (the-as handle #f))
(set! (-> *gauntlet-muse-world* icon) (the-as handle #f))
(set! (-> *gauntlet-muse-world* face) (the-as handle #f))

(define *gauntlet-muse-entity* (the-as entity-actor #f)) ;; her actor, found while Misty is up, forgotten when it goes (its memory is the level's)

(defun gauntlet-muse-entity-find! ()
  "Her actor, muse-2 of Misty Island, found by name when it is not known; #f when Misty is not up."
  (when (not *gauntlet-muse-entity*)
    (let ((found (entity-by-name "muse-2")))
      (if (and found (type-type? (-> found type) entity-actor))
        (set! *gauntlet-muse-entity* (the-as entity-actor found)))))
  *gauntlet-muse-entity*)

(defun gauntlet-muse-spawn! ((near-jak symbol))
  "Make a muse, loose: at her home when near-jak is #f, else on her path where Jak stands."
  (let ((ent (gauntlet-muse-entity-find!)))
    (cond
      ((not ent) (format 0 "GAUNTLET MUSE has no muse-2 actor to make a muse from~%"))
      (else
       (set! (-> *gauntlet-muse-start* w) 0.0)
       (when (and near-jak *target*)
         (set! (-> *gauntlet-muse-start* quad) (-> (target-pos 0) quad))
         (set! (-> *gauntlet-muse-start* w) 1.0))
       (let* ((born (gauntlet-horde-clone! ent (-> ent extra trans)))
              (muse (as-type (handle->process born) process-drawable)))
         (set! (-> *gauntlet-muse-start* w) 0.0)
         (set! (-> *gauntlet-muse-world* muse) born)
         (if muse
           (format 0 "GAUNTLET MUSE loose at (~M, ~M, ~M)~%" (-> muse root trans x) (-> muse root trans y) (-> muse root trans z))
           (format 0 "GAUNTLET MUSE could not be made~%"))))))
  0)

(defun gauntlet-muse-caught! ((kind symbol))
  "The muse's own state calls this as Jak catches her, kind 'first (the game's catch, the cell given) or 'again (the new muse
   the mod made after a drop, nothing given). She is his."
  (when (and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
    (format 0 "GAUNTLET MUSE caught (~A)~%" kind)
    (gauntlet-muse-flip! #t))
  (none))

(defun gauntlet-muse-drop! ((why symbol))
  "Jak has lost the muse he carries, why being 'hit, 'bonk or 'death. She pops out loose where he stands, unless he died: a death
   puts every process of the entity pool away, so the poll below makes her at her home once it has. Dropped once for a hit,
   however many frames of invulnerability follow, because the second finds her loose already."
  (when (and *gauntlet-misty-muse-enabled* *gauntlet-muse-carried* (gauntlet-misty-active?))
    (let ((where (if *target* (target-pos 0) *null-vector*)))
      (format 0 "GAUNTLET MUSE dropped (~A) at (~M, ~M, ~M)~%" why (-> where x) (-> where y) (-> where z)))
    (gauntlet-muse-flip! #f)
    (if (!= why 'death) (gauntlet-muse-spawn! #t)))
  (none))

;; gauntlet: engine/target/target-handler.gc calls this when Jak lands hard on something that hears 'bonk, which is what a bonk is:
;; he came down on a platform or an enemy with a velocity change over 4 m/s along gravity (the collision handler's own test), the
;; thing under him is told 'bonk and, from a fall beyond fall-far, he bounces off it
(defun *target-bonk-hook* ()
  (gauntlet-muse-drop! 'bonk)
  (none))

(defun gauntlet-muse-health-poll! ()
  "Per-frame, on Misty: a hit is a fall in Jak's health, or his last hit, which does not lower it (he is dying: the flag is set before
   his death begins). Every way he can lose health is a fall in it (an attack, a hit of damage mode, the red babak's second hit),
   which is why this is where hits are seen and not a hook in the hit state; invulnerable frames let no hit land, so nothing falls."
  (let ((health (if *target* (-> *target* fact health) -1.0)))
    (when (and *target* *gauntlet-muse-carried*)
      (cond
        ((or (logtest? (-> *target* state-flags) (state-flags dying)) (>= 0.0 health)) (gauntlet-muse-drop! 'death))
        ((and (<= 0.0 *gauntlet-muse-health*) (< health *gauntlet-muse-health*)) (gauntlet-muse-drop! 'hit))))
    (set! *gauntlet-muse-health* health))
  0)

(defun gauntlet-muse-body-poll! ()
  "Per-frame, on Misty, with the muse loose: if the game will not bring her back (her actor is dead and none of her is standing) and
   the mod has not made one, make her at her home. That is every visit after the first catch, and every death."
  (let ((ent (gauntlet-muse-entity-find!)))
    (when (and ent
               *target*
               (not *gauntlet-muse-carried*)
               (not (-> ent extra process))
               (logtest? (-> ent extra perm status) (entity-perm-status bit-0 dead))
               (not (handle->process (-> *gauntlet-muse-world* muse))))
      (gauntlet-muse-spawn! #f)))
  0)

;; ---------------------------------------------------------------- the icon --

;; Whether the muse is with Jak is shown on screen by her model in a corner of the hud, whenever he is on Misty: dark while she is
;; loose, lit while she is his, and it flashes at each change (gold when she is caught, red when she is lost). It is drawn the way the
;; hud draws its own counters and the pc port's battle counter (pc/hud-classes-pc.gc): a manipy of her art with the hud's draw function,
;; placed in the hud's own space (x from 0 to 512, y from 0 to 448, the middle at 256 and 224) and scaled by the video's relative
;; scales. Her art is in MIS.DGO only, so it is looked up by the symbol of her skeleton group, *muse-sg*, and only while Misty is up,
;; and the manipy is given her actor, whose level the art is loaded from (initialize-skeleton) and which has the level's unload
;; take it away. A model cannot be cut to her face, so she is drawn whole, small. The card behind her, a frame drawn the way the
;; Klaww bar is, says the same as her colour in case her colour does not show.
;; Left of the middle: the health is top left, the buzzers bottom left, the orbs top right and the eco timers bottom right, and the pc
;; port's battle counter right of the middle.
(defconstant GAUNTLET_MUSE_ICON_X 44) ;; the middle of her, in the hud's 512 wide space
(defconstant GAUNTLET_MUSE_ICON_Y 190) ;; and in its 448 high one
(defconstant GAUNTLET_MUSE_ICON_SCALE 0.016) ;; the hud scale of her art (the battle counter's bonelurker is 0.004; she is smaller)
(defconstant GAUNTLET_MUSE_ICON_LIFT 2867.0) ;; how high the middle of her figure is above her feet, in the art's units (0.7 m)
(defconstant GAUNTLET_MUSE_FRAME_HALF_W 22) ;; the frame around her: half its width in the hud's 512 wide space, undone by the aspect
(defconstant GAUNTLET_MUSE_FRAME_HALF_H 26) ;; and half its height in the 2D space of the Klaww bar (y from 0 to 224)

(defun gauntlet-muse-face ()
  "The manipy that draws the muse's face, or #f while there is none."
  (let ((proc (handle->process (-> *gauntlet-muse-world* face))))
    (the-as manipy (if (and proc (type-type? (-> proc type) manipy)) proc))))

(defun gauntlet-muse-face-make! ()
  "Make the manipy: her art, drawn by the hud's draw function, idling. It is in the entity pool with her actor as its entity, so
   Misty's unload takes it away and so does a death, after which this makes it again."
  (let ((ent (gauntlet-muse-entity-find!))
        (skel '*muse-sg*))
    (when (and ent (-> skel value))
      (let ((made (manipy-spawn (new 'static 'vector :w 1.0) ent (the-as skeleton-group (-> skel value)) #f :to *entity-pool*)))
        (when made
          (let ((icon (-> made 0)))
            (set! (-> icon draw dma-add-func) dma-add-process-drawable-hud)
            (set-vector! (-> icon root trans) 0.0 0.0 0.0 1.0)
            (set-vector! (-> icon root scale) GAUNTLET_MUSE_ICON_SCALE GAUNTLET_MUSE_ICON_SCALE GAUNTLET_MUSE_ICON_SCALE 1.0)
            (logior! (-> icon mask) (process-mask pause))
            (logclear! (-> icon mask) (process-mask menu progress))
            (send-event icon 'art-joint-anim "muse-idle" 0)
            ;; turned to the camera and a little aside, the way the battle counter turns its lurkers
            (send-event icon 'rot-quat (quaternion-axis-angle! (new-stack-quaternion0) 0.0 1.0 0.15 (degrees 200))))
          (set! (-> *gauntlet-muse-world* face) (ppointer->handle made))))))
  0)

(defun gauntlet-muse-icon-shown? ()
  "True when the icon is to be seen: Jak is inside Misty and nothing else has the screen (a cutscene, the progress menu, a fade)."
  (and *target*
       (gauntlet-in-level? 'misty)
       (not (movie?))
       (not *progress-process*)
       (time-elapsed? (-> *game-info* letterbox-time) (seconds 0.1))
       (time-elapsed? (-> *game-info* blackout-time) (seconds 0.1))))

(defun gauntlet-muse-icon-frame! ()
  "One frame of the icon: the manipy, made if it is not there, shown or hidden, put in its corner and tinted for the state (dark
   and cold while she is loose, plain while she is his, a burning gold or red for GAUNTLET_MUSE_FLASH_TIME after a flip), and the frame
   around it."
  (if (not (gauntlet-muse-face)) (gauntlet-muse-face-make!))
  (let ((face (gauntlet-muse-face))
        (shown (gauntlet-muse-icon-shown?)))
    (when face
      (send-event face 'draw shown)
      (when shown
        (let* ((since (- (current-time) *gauntlet-muse-flip-time*))
               (flash (fmax 0.0 (- 1.0 (/ (the float since) (the float GAUNTLET_MUSE_FLASH_TIME)))))
               (draw (-> face draw))
               (sx (* GAUNTLET_MUSE_ICON_SCALE (-> *video-parms* relative-x-scale)))
               (sy (* GAUNTLET_MUSE_ICON_SCALE (/ 512.0 448.0) (-> *video-parms* relative-y-scale))))
          ;; the hud's space has y running down, so her y scale is negative to stand her up, and her middle is lifted to the corner
          (set-vector! (-> face root scale) sx (- sy) sx 1.0)
          (set! (-> face root trans x) (the float (+ GAUNTLET_MUSE_ICON_X -256)))
          (set! (-> face root trans y)
                (+ (- (the float GAUNTLET_MUSE_ICON_Y) (the float (-> *video-parms* screen-sy))) (* sy GAUNTLET_MUSE_ICON_LIFT)))
          (set! (-> face root trans z) 2048.0)
          (cond
            (*gauntlet-muse-carried*
             (set-vector! (-> draw color-mult) 1.0 1.0 1.0 1.0)
             (set-vector! (-> draw color-emissive) (* 0.9 flash) (* 0.8 flash) (* 0.2 flash) 0.0))
            (else
             (set-vector! (-> draw color-mult) 0.2 0.22 0.28 1.0)
             (set-vector! (-> draw color-emissive) (* 0.9 flash) (* 0.1 flash) (* 0.1 flash) 0.0)))
          (let* ((aspect (-> *pc-settings* aspect-ratio-scale))
                 (cx GAUNTLET_MUSE_ICON_X)
                 (cy (/ GAUNTLET_MUSE_ICON_Y 2))
                 (grow (the int (* 6.0 flash)))
                 (half-w (+ grow (max 1 (the int (/ (the float GAUNTLET_MUSE_FRAME_HALF_W) aspect)))))
                 (half-h (+ grow GAUNTLET_MUSE_FRAME_HALF_H))
                 (thick-x (max 1 (the int (/ 2.0 aspect)))))
            (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
              (cond
                ((< 0.0 flash)
                 (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) (* 2 half-w) 2 (static-rgba 255 255 255 150))
                 (draw-sprite2d-xy buf (- cx half-w) (+ cy half-h) (* 2 half-w) 2 (static-rgba 255 255 255 150))
                 (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) thick-x (* 2 half-h) (static-rgba 255 255 255 150))
                 (draw-sprite2d-xy buf (+ cx half-w) (- cy half-h) thick-x (* 2 half-h) (static-rgba 255 255 255 150)))
                (*gauntlet-muse-carried*
                 (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) (* 2 half-w) 2 (static-rgba 255 190 50 110))
                 (draw-sprite2d-xy buf (- cx half-w) (+ cy half-h) (* 2 half-w) 2 (static-rgba 255 190 50 110))
                 (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) thick-x (* 2 half-h) (static-rgba 255 190 50 110))
                 (draw-sprite2d-xy buf (+ cx half-w) (- cy half-h) thick-x (* 2 half-h) (static-rgba 255 190 50 110)))
                (else
                 (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) (* 2 half-w) 2 (static-rgba 110 110 125 70))
                 (draw-sprite2d-xy buf (- cx half-w) (+ cy half-h) (* 2 half-w) 2 (static-rgba 110 110 125 70))
                 (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) thick-x (* 2 half-h) (static-rgba 110 110 125 70))
                 (draw-sprite2d-xy buf (+ cx half-w) (- cy half-h) thick-x (* 2 half-h) (static-rgba 110 110 125 70))))))))))
  0)

(defun gauntlet-muse-icon-ensure! ()
  "Keep one process alive that drives the icon for as long as Misty is up. It ends itself when Misty goes or the setting is turned
   off, and its handle lives in a structure, as the Klaww bar's does."
  (when (and *gauntlet-misty-muse-enabled*
             *target*
             (gauntlet-misty-active?)
             (not (handle->process (-> *gauntlet-muse-world* icon))))
    (set! (-> *gauntlet-muse-world* icon)
          (ppointer->handle
            (process-spawn-function process
                                    (lambda :behavior process ()
                                      (loop
                                        (if (and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
                                          (gauntlet-muse-icon-frame!)
                                          (deactivate self))
                                        (suspend)))
                                    :to *active-pool*
                                    :name 'gauntlet-muse-icon))))
  0)

(defun gauntlet-muse-poll! ()
  "Per-frame: the muse's state follows Misty. Entering it, the muse is loose; leaving it, she is loose again for the next visit,
   whatever the visit before ended with. While it is up, hits are watched for, her body is kept, and the icon is."
  (let ((here (gauntlet-misty-active?)))
    (cond
      ((and here (not *gauntlet-muse-was-here*))
       (set! *gauntlet-muse-was-here* #t)
       (set! *gauntlet-muse-carried* #f)
       (set! *gauntlet-muse-health* -1.0)
       (+! *gauntlet-muse-episode* 1)
       (format 0 "GAUNTLET MUSE Misty entered, the muse is loose~%"))
      ((and (not here) *gauntlet-muse-was-here*)
       (set! *gauntlet-muse-was-here* #f)
       (set! *gauntlet-muse-carried* #f)
       (set! *gauntlet-muse-entity* (the-as entity-actor #f))
       (format 0 "GAUNTLET MUSE Misty left, the muse is loose for the next visit~%")))
    (when (and here *gauntlet-misty-muse-enabled*)
      (gauntlet-muse-health-poll!)
      (gauntlet-muse-body-poll!)
      (gauntlet-muse-icon-ensure!)))
  0)

;; --------------------------------------------------------------- the console --

;; A local web console steers the mod while it runs, through two files in Mods/ (the contract is the console's).
;;   gauntlet-settings.gc  the console writes, the game reads: (revision N) first, then one (key value) per setting, in
;;                         human units (meters, seconds, degrees, #t / #f). Looked at every GAUNTLET_SETTINGS_POLL_FRAMES
;;                         frames, and applied only when the revision is not the one in effect. A file is the whole
;;                         truth: a key it does not name goes back to its default. Unknown keys and values that are not
;;                         numbers (or are outside the key's range) are skipped and logged, never fatal.
;;   gauntlet-state.json   the game writes, the console reads, every GAUNTLET_STATE_POLL_FRAMES frames: the settings in
;;                         effect next to the defaults, and where Jak, the bomb and the drop spots are.
;; Every setting is one row of gauntlet-setting-table, which names it, says what unit the file speaks, which global holds
;; it, what its default is and what range it may take; applying, resetting and publishing it are all generated from that
;; row, so a setting cannot be added to one and forgotten in another.

(defconstant GAUNTLET_SETTINGS_POLL_FRAMES 30) ;; how often the settings file is looked at
(defconstant GAUNTLET_STATE_POLL_FRAMES 15) ;; how often the state file is written

(defmacro gauntlet-setting-table (row)
  "Expand row once per setting: (row name unit global default lowest highest). The unit is how the file speaks and
   how the global holds it: seconds (file: seconds, global: ticks), meters (file: meters, global: game units, which
   also covers meters per second and per second squared), degrees (file: degrees, global: rotation units), count
   (both a whole number), ratio (both a plain float: a chance, a multiplier), flag (#t or #f). The range is in file
   units and is ignored for a flag."
  `(begin
     (,row "bomb-countdown" seconds *gauntlet-bomb-countdown* GAUNTLET_BOMB_COUNTDOWN_DEFAULT 0.5 120.0)
     (,row "bomb-blast-radius" meters *gauntlet-bomb-blast-radius* GAUNTLET_BOMB_BLAST_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull-radius" meters *gauntlet-bomb-pull-radius* GAUNTLET_BOMB_PULL_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull" meters *gauntlet-bomb-pull* GAUNTLET_BOMB_PULL_DEFAULT 0.0 500.0)
     (,row "bomb-ground-pull" meters *gauntlet-bomb-ground-pull* GAUNTLET_BOMB_GROUND_PULL_DEFAULT 0.0 50.0)
     (,row "bomb-drop-height" meters *gauntlet-bomb-drop-height* GAUNTLET_BOMB_DROP_HEIGHT_DEFAULT 0.0 200.0)
     (,row "bomb-gravity" meters *gauntlet-bomb-gravity* GAUNTLET_BOMB_GRAVITY_DEFAULT 1.0 500.0)
     (,row "bridge-enabled" flag *gauntlet-bridge-enabled* GAUNTLET_BRIDGE_ENABLED_DEFAULT 0 0)
     (,row "vent-enabled" flag *gauntlet-vent-enabled* GAUNTLET_VENT_ENABLED_DEFAULT 0 0)
     (,row "bridge-trigger-radius" meters *gauntlet-bridge-trigger-radius* GAUNTLET_BRIDGE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "bridge-rearm-range" meters *gauntlet-bridge-rearm-range* GAUNTLET_BRIDGE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "dummies-enabled" flag *gauntlet-dummies-enabled* GAUNTLET_DUMMIES_ENABLED_DEFAULT 0 0)
     (,row "dummy-volley-interval" seconds *gauntlet-dummy-volley-interval* GAUNTLET_DUMMY_VOLLEY_INTERVAL_DEFAULT 0.1 120.0)
     (,row "dummy-volley-gap" seconds *gauntlet-dummy-volley-gap* GAUNTLET_DUMMY_VOLLEY_GAP_DEFAULT 0.05 60.0)
     (,row "dummy-volley-size" count *gauntlet-dummy-volley-size* GAUNTLET_DUMMY_VOLLEY_SIZE_DEFAULT 1.0 50.0)
     (,row "dummy-volley-spread" degrees *gauntlet-dummy-volley-spread* GAUNTLET_DUMMY_VOLLEY_SPREAD_DEFAULT 0.0 90.0)
     (,row "dummy-range" meters *gauntlet-dummy-range* GAUNTLET_DUMMY_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-leave-range" meters *gauntlet-dummy-leave-range* GAUNTLET_SAGE_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-range" meters *gauntlet-herald-range* GAUNTLET_HERALD_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-leave-range" meters *gauntlet-herald-leave-range* GAUNTLET_HERALD_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-shot-speed" meters *gauntlet-dummy-shot-speed* GAUNTLET_DUMMY_SHOT_SPEED_DEFAULT 0.0 500.0)
     (,row "stampede-enabled" flag *gauntlet-stampede-enabled* GAUNTLET_STAMPEDE_ENABLED_DEFAULT 0 0)
     (,row "stampede-herd-size" count *gauntlet-stampede-herd-size* GAUNTLET_STAMPEDE_HERD_SIZE_DEFAULT 1.0 30.0)
     (,row "stampede-speed" meters *gauntlet-stampede-speed* GAUNTLET_STAMPEDE_SPEED_DEFAULT 4.0 30.0)
     (,row "stampede-trigger-radius" meters *gauntlet-stampede-trigger-radius* GAUNTLET_STAMPEDE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "stampede-rearm-range" meters *gauntlet-stampede-rearm-range* GAUNTLET_STAMPEDE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "stampede-red-count" count *gauntlet-stampede-red-count* GAUNTLET_STAMPEDE_RED_COUNT_DEFAULT 0.0 30.0)
     (,row "yakow-stampede-enabled" flag *gauntlet-yakow-stampede-enabled* GAUNTLET_YAKOW_STAMPEDE_ENABLED_DEFAULT 0 0)
     (,row "babak-charge-enabled" flag *gauntlet-babak-charge-enabled* GAUNTLET_BABAK_CHARGE_ENABLED_DEFAULT 0 0)
     (,row "babak-charge-chance" ratio *gauntlet-babak-charge-chance* GAUNTLET_BABAK_CHARGE_CHANCE_DEFAULT 0.0 1.0)
     (,row "babak-blue-speed" ratio *gauntlet-babak-blue-speed* GAUNTLET_BABAK_BLUE_SPEED_DEFAULT 1.0 4.0)
     (,row "desperation-max" ratio *gauntlet-desperation-max* GAUNTLET_DESPERATION_MAX_DEFAULT 1.0 5.0)
     (,row "cell-heal-enabled" flag *gauntlet-cell-heal-enabled* GAUNTLET_CELL_HEAL_ENABLED_DEFAULT 0 0)
     (,row "misty-muse-enabled" flag *gauntlet-misty-muse-enabled* GAUNTLET_MISTY_MUSE_ENABLED_DEFAULT 0 0)
     (,row "misty-mayhem-extra" count *gauntlet-misty-mayhem-extra* GAUNTLET_MISTY_MAYHEM_EXTRA_DEFAULT 0.0 4.0)
     (,row "misty-mayhem-speed" ratio *gauntlet-misty-mayhem-speed* GAUNTLET_MISTY_MAYHEM_SPEED_DEFAULT 1.0 4.0)
     (,row "misty-mayhem-charge-chance" ratio *gauntlet-misty-mayhem-charge-chance* GAUNTLET_MISTY_MAYHEM_CHARGE_CHANCE_DEFAULT 0.0 1.0)
     (,row "worm-cubes-enabled" flag *gauntlet-worm-cubes-enabled* GAUNTLET_WORM_CUBES_ENABLED_DEFAULT 0 0)
     (,row "worm-cube-count" count *gauntlet-worm-cube-count* GAUNTLET_WORM_CUBE_COUNT_DEFAULT 0.0 8.0)
     (,row "lurker-multiplier" count *gauntlet-lurker-multiplier* GAUNTLET_LURKER_MULTIPLIER_DEFAULT 1.0 5.0)
     (,row "horde-max-clones" count *gauntlet-horde-max-clones* GAUNTLET_HORDE_MAX_CLONES_DEFAULT 0.0 300.0)
     (,row "klaww-enabled" flag *gauntlet-klaww-enabled* GAUNTLET_KLAWW_ENABLED_DEFAULT 0 0)
     (,row "klaww-throw-interval" seconds *gauntlet-klaww-throw-interval* GAUNTLET_KLAWW_THROW_INTERVAL_DEFAULT 0.5 60.0)
     (,row "klaww-rage-max" ratio *gauntlet-klaww-rage-max* GAUNTLET_KLAWW_RAGE_MAX_DEFAULT 1.0 5.0)
     (,row "klaww-radius-max" ratio *gauntlet-klaww-radius-max* GAUNTLET_KLAWW_RADIUS_MAX_DEFAULT 1.0 5.0)
     (,row "klaww-range" meters *gauntlet-klaww-range* GAUNTLET_KLAWW_RANGE_DEFAULT 10.0 500.0)
     (,row "klaww-boulder-radius" meters *gauntlet-klaww-boulder-radius* GAUNTLET_KLAWW_BOULDER_RADIUS_DEFAULT 0.5 30.0)
     (,row "tnt-enabled" flag *gauntlet-tnt-enabled* GAUNTLET_TNT_ENABLED_DEFAULT 0 0)))

;; ---- the settings file

(define *gauntlet-settings-revision* 0) ;; the revision in effect: 0 until a file has been applied
(define *gauntlet-settings-countdown* 0)
(define *gauntlet-settings-applied* 0) ;; keys the file being applied has set so far
(define *gauntlet-settings-bad-revision-told* #f) ;; a file with no revision is told about once, not every poll
(define *gauntlet-setting-key* (new 'global 'string 64 ""))
(define *gauntlet-setting-number* 0.0) ;; what gauntlet-read-number! last read
(define *gauntlet-setting-flag* #f) ;; what gauntlet-read-flag! last read

(defmacro gauntlet-row-reset (name unit global default lo hi)
  "One setting back to its default."
  `(set! ,global ,(if (eq? unit 'seconds) `(the int ,default) default)))

(defmacro gauntlet-row-apply (name unit global default lo hi)
  "If key is this setting, read its value from the file and set the global, or skip the key."
  (if (eq? unit 'flag)
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-flag! file)
         (begin
           (set! ,global *gauntlet-setting-flag*)
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-number! file ,lo ,hi)
         (begin
           (set! ,global
                 ,(cond
                    ((eq? unit 'seconds) '(the int (+ (* *gauntlet-setting-number* 300.0) 0.5)))
                    ((eq? unit 'meters) '(* *gauntlet-setting-number* METER_LENGTH))
                    ((eq? unit 'degrees) '(* *gauntlet-setting-number* (/ DEGREES_PER_ROT 360.0)))
                    ((eq? unit 'ratio) '*gauntlet-setting-number*)
                    (#t '(the int (+ *gauntlet-setting-number* 0.5)))))
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))))

(defun gauntlet-settings-reset! ()
  "Every setting back to its default."
  (gauntlet-setting-table gauntlet-row-reset)
  0)

(defun gauntlet-setting-skip! ((name string))
  "A key whose value is not usable: it keeps its default."
  (format 0 "GAUNTLET SETTINGS ~S skipped, its value is not a usable one~%" name)
  0)

(defun gauntlet-number-word? ((word string))
  "True when word is a plain decimal number: digits, one dot, and a minus sign in front. The game's own string->float
   reads anything as a number (garbage as 0.0), so a value is only trusted after this."
  (let ((digits 0)
        (dots 0)
        (clean #t))
    (dotimes (i (length word))
      (let ((c (-> word data i)))
        (cond
          ((and (>= c #\0) (<= c #\9)) (+! digits 1))
          ((= c #\.) (+! dots 1))
          ((and (= c #\-) (zero? i)))
          (else (set! clean #f)))))
    (and clean (> digits 0) (<= dots 1))))

(defun gauntlet-read-word! ((file file-stream))
  "The next word of the file in *pc-temp-string*, which is empty when the file has no more."
  (set! (-> *pc-temp-string* data 0) 0)
  (file-stream-seek-past-whitespace file)
  (file-stream-read-word file)
  *pc-temp-string*)

(defun gauntlet-read-number! ((file file-stream) (lowest float) (highest float))
  "Read the next word as a number in [lowest, highest] into *gauntlet-setting-number*. False when it is not one."
  (let ((word (gauntlet-read-word! file)))
    (when (gauntlet-number-word? word)
      (let ((value (string->float word)))
        (when (and (>= value lowest) (<= value highest))
          (set! *gauntlet-setting-number* value)
          (return #t)))))
  #f)

(defun gauntlet-read-flag! ((file file-stream))
  "Read the next word as #t or #f into *gauntlet-setting-flag*. False when it is neither."
  (let ((word (gauntlet-read-word! file)))
    (cond
      ((string= word "#t") (set! *gauntlet-setting-flag* #t) #t)
      ((string= word "#f") (set! *gauntlet-setting-flag* #f) #t)
      (else #f))))

(defun gauntlet-skip-past-close ((file file-stream))
  "Read on through the closing bracket of the form being read, whatever is left in it, nested forms included."
  (let ((depth 1))
    (while (> depth 0)
      (let ((c (file-stream-getc file)))
        (cond
          ((= c #x28) (+! depth 1))
          ((= c #x29) (+! depth -1))
          ((= c 255) (set! depth 0))))))
  0)

(defun gauntlet-form-open? ((file file-stream))
  "True when the next thing in the file is an opening bracket, which is read."
  (file-stream-seek-past-whitespace file)
  (= #x28 (file-stream-getc file)))

(defun gauntlet-settings-apply-key! ((file file-stream) (key string))
  "Apply the setting key names, reading its value from the file; an unknown key is skipped."
  (let ((handled #f))
    (gauntlet-setting-table gauntlet-row-apply)
    (when (not handled)
      (format 0 "GAUNTLET SETTINGS ~S skipped, it is not a setting this build knows~%" key)))
  0)

(defun gauntlet-settings-read-revision ((file file-stream))
  "The revision the file opens with, or -1 when its first form is not (revision N)."
  (when (gauntlet-form-open? file)
    (gauntlet-read-word! file)
    (when (string= *pc-temp-string* "revision")
      (let ((word (gauntlet-read-word! file)))
        (when (gauntlet-number-word? word)
          (let ((revision (the int (string->float word))))
            (gauntlet-skip-past-close file)
            (return revision))))))
  -1)

(defun gauntlet-settings-poll! ()
  "Every GAUNTLET_SETTINGS_POLL_FRAMES frames, and on the first look of a boot: read Mods/gauntlet-settings.gc if it is
   there, and if its revision is not the one in effect, put every setting back to its default and apply the file's keys over
   them. A file that has gone away takes the settings it had set with it."
  (+! *gauntlet-settings-countdown* -1)
  (when (>= 0 *gauntlet-settings-countdown*)
    (set! *gauntlet-settings-countdown* GAUNTLET_SETTINGS_POLL_FRAMES)
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-settings.gc" *pc-settings-folder*)
    (cond
      ((not (pc-filepath-exists? *pc-temp-string-1*))
       (when (nonzero? *gauntlet-settings-revision*)
         (gauntlet-settings-reset!)
         (format 0 "GAUNTLET SETTINGS file is gone, defaults restored (was revision ~D)~%" *gauntlet-settings-revision*)
         (set! *gauntlet-settings-revision* 0)))
      (else
       (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
         (when (file-stream-valid? file)
           (let ((revision (gauntlet-settings-read-revision file)))
             (cond
               ((< revision 0)
                (when (not *gauntlet-settings-bad-revision-told*)
                  (set! *gauntlet-settings-bad-revision-told* #t)
                  (format 0 "GAUNTLET SETTINGS file does not open with (revision N), ignored~%")))
               ((= revision *gauntlet-settings-revision*))
               (else
                (set! *gauntlet-settings-bad-revision-told* #f)
                (gauntlet-settings-reset!)
                (set! *gauntlet-settings-applied* 0)
                ;; every form after the revision: its key, then the key's own reader takes the value
                (while (gauntlet-form-open? file)
                  (gauntlet-read-word! file)
                  (format (clear *gauntlet-setting-key*) "~S" *pc-temp-string*)
                  (gauntlet-settings-apply-key! file *gauntlet-setting-key*)
                  (gauntlet-skip-past-close file))
                (set! *gauntlet-settings-revision* revision)
                (format 0 "GAUNTLET SETTINGS revision ~D applied, ~D keys~%" revision *gauntlet-settings-applied*))))
           (file-stream-close file))))))
  0)

;; ---- the state file

(define *gauntlet-frame* 0) ;; polls so far, which is what the state file's frame counts
(define *gauntlet-state-countdown* 0)
(define *gauntlet-state-text* (new 'global 'string 8192 "")) ;; the file is built here and written in one go, so a reader catches as little of it half-written as possible; the settings are in it twice (in effect, and their defaults), about sixty of them, so it needs room
(define *gauntlet-json-first* #t) ;; true until the object being written has a member, so the next one needs no comma

(defun gauntlet-json-key ((out string) (name string))
  "Start the next member of the object being written: its comma if it needs one, and its name."
  (format out "~S\"~S\":" (if *gauntlet-json-first* "" ",") name)
  (set! *gauntlet-json-first* #f)
  0)

(defun gauntlet-json-open ((out string))
  (format out "{")
  (set! *gauntlet-json-first* #t)
  0)

(defun gauntlet-json-close ((out string))
  (format out "}")
  (set! *gauntlet-json-first* #f)
  0)

(defun gauntlet-json-fixed ((out string) (value float))
  "Append value with three decimals, rounded. format's own ~F cuts digits off instead of rounding them, which would
   turn a 15.0 that went through rotation units and back into 14.9999."
  (let* ((scaled (the int (if (< value 0.0) (- (* value 1000.0) 0.5) (+ (* value 1000.0) 0.5))))
         (magnitude (if (< scaled 0) (- scaled) scaled))
         (whole (/ magnitude 1000))
         (fraction (- magnitude (* whole 1000)))
         (hundreds (/ fraction 100))
         (tens (/ (- fraction (* hundreds 100)) 10))
         (ones (- fraction (* hundreds 100) (* tens 10))))
    (format out "~S~D.~D~D~D" (if (< scaled 0) "-" "") whole hundreds tens ones))
  0)

(defmacro gauntlet-json-row (name unit source)
  "Write one setting, from source (its global or its default), as the member name in the file's own units."
  (cond
    ((eq? unit 'flag) `(begin (gauntlet-json-key out ,name) (format out "~S" (if ,source "true" "false"))))
    ((eq? unit 'count) `(begin (gauntlet-json-key out ,name) (format out "~D" ,source)))
    ((eq? unit 'ratio) `(begin (gauntlet-json-key out ,name) (gauntlet-json-fixed out ,source)))
    (#t
     `(begin
        (gauntlet-json-key out ,name)
        (gauntlet-json-fixed out
                             ,(cond
                                ((eq? unit 'seconds) `(/ (the float ,source) 300.0))
                                ((eq? unit 'meters) `(/ ,source METER_LENGTH))
                                (#t `(/ ,source (/ DEGREES_PER_ROT 360.0)))))))))

(defmacro gauntlet-row-write-now (name unit global default lo hi)
  `(gauntlet-json-row ,name ,unit ,global))

(defmacro gauntlet-row-write-default (name unit global default lo hi)
  `(gauntlet-json-row ,name ,unit ,default))

(defun gauntlet-json-meters ((out string) (name string) (units float))
  "The member name, a length given in game units, written in meters."
  (gauntlet-json-key out name)
  (gauntlet-json-fixed out (/ units METER_LENGTH))
  0)

(defun gauntlet-bomb-process ()
  "The bomb last dropped, if it is still in the world."
  (let ((proc (handle->process *gauntlet-bomb*)))
    (the-as gauntlet-bomb (if (and proc (type-type? (-> proc type) gauntlet-bomb)) proc))))

(defun gauntlet-bomb-state-name ((bomb gauntlet-bomb))
  "What the state file calls the bomb's state, or #f for one that is only waiting to be cleaned up."
  (let ((state (-> bomb next-state)))
    (if state
      (case (-> state name)
        (('gauntlet-bomb-fall) 'falling)
        (('gauntlet-bomb-countdown) 'countdown)
        (('gauntlet-bomb-explode) 'exploding)
        (else #f))
      #f)))

(defun gauntlet-klaww-state-name ()
  "What the state file calls the fight: waiting for the pelican, falling, landing, fighting, or over."
  (let* ((klaww (gauntlet-klaww-process))
         (state (if klaww (-> klaww next-state))))
    (cond
      (*gauntlet-klaww-defeated* "defeated")
      ((not state) "waiting")
      (else
       (case (-> state name)
         (('gauntlet-klaww-fall) "falling")
         (('gauntlet-klaww-land) "landing")
         (else "fighting"))))))

(defun gauntlet-bomb-remaining ((bomb gauntlet-bomb) (state-name symbol))
  "Seconds the bomb has left on its clock: all of it while it falls, none once it has gone off."
  (cond
    ((= state-name 'falling) (/ (the float (-> bomb countdown)) 300.0))
    ((= state-name 'countdown)
     (/ (the float (max 0 (- (-> bomb countdown) (- (current-time) (-> bomb state-time))))) 300.0))
    (else 0.0)))

(defmacro gauntlet-row-spot-state (index name enabled x y z)
  `(begin
     (gauntlet-json-key out ,name)
     (cond
       (in-training
        (gauntlet-json-open out)
        (gauntlet-json-key out "armed")
        (format out "~S" (if (-> *gauntlet-drop-world* armed ,index) "true" "false"))
        (gauntlet-json-key out "distance")
        (gauntlet-json-fixed out (/ (vector-vector-xz-distance (target-pos 0) (gauntlet-drop-spot-at ,index (new 'stack-no-clear 'vector))) METER_LENGTH))
        (gauntlet-json-close out))
       (else (format out "null")))))

(defun gauntlet-state-write-world! ((out string))
  "Level, Jak, the bomb, the drop spots, Klaww and the horde: the members of the state file that are not settings."
  (let ((in-training (and *target* (gauntlet-in-training?))))
    (gauntlet-json-key out "level")
    (format out "\"~A\"" (if *target* (aif (level-get-target-inside *level*) (-> it name) 'none) 'none))
    (gauntlet-json-key out "jak")
    (cond
      (*target*
       (gauntlet-json-open out)
       (gauntlet-json-meters out "x" (-> (target-pos 0) x))
       (gauntlet-json-meters out "y" (-> (target-pos 0) y))
       (gauntlet-json-meters out "z" (-> (target-pos 0) z))
       (gauntlet-json-key out "onGround")
       (format out "~S" (if (logtest? (-> *target* control status) (cshape-moving-flags onground onsurf)) "true" "false"))
       (gauntlet-json-close out))
      (else (format out "null")))
    ;; what the eco is doing to Jak now: the multiplier on every effect, and the health it comes from
    (gauntlet-json-key out "desperation")
    (gauntlet-json-open out)
    (gauntlet-json-key out "value")
    (gauntlet-json-fixed out (gauntlet-desperation))
    (gauntlet-json-key out "health")
    (if *target* (gauntlet-json-fixed out (-> *target* fact health)) (format out "null"))
    (gauntlet-json-key out "healthMax")
    (if *target* (gauntlet-json-fixed out (-> *target* fact health-max)) (format out "null"))
    (gauntlet-json-close out)
    ;; whether the muse is with Jak: "carried" or "loose" while Misty is up, null anywhere else (and with the setting off)
    (gauntlet-json-key out "muse")
    (cond
      ((and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
       (format out "\"~A\"" (if *gauntlet-muse-carried* "carried" "loose")))
      (else (format out "null")))
    (gauntlet-json-key out "bomb")
    (let* ((bomb (gauntlet-bomb-process))
           (state-name (if bomb (gauntlet-bomb-state-name bomb) #f)))
      (cond
        (state-name
         (gauntlet-json-open out)
         (gauntlet-json-key out "state")
         (format out "\"~A\"" state-name)
         (gauntlet-json-meters out "x" (-> bomb root trans x))
         (gauntlet-json-meters out "y" (-> bomb root trans y))
         (gauntlet-json-meters out "z" (-> bomb root trans z))
         (gauntlet-json-key out "remaining")
         (gauntlet-json-fixed out (gauntlet-bomb-remaining bomb state-name))
         (gauntlet-json-key out "jakDistance")
         (if *target*
           (gauntlet-json-fixed out (/ (vector-vector-distance (-> bomb root trans) (target-pos 0)) METER_LENGTH))
           (format out "null"))
         (gauntlet-json-close out))
        (else (format out "null"))))
    ;; one member per drop spot of the table, named for it ("bridge", "vent"): armed and how far Jak is, null off Geyser Rock
    (gauntlet-drop-spot-table begin gauntlet-row-spot-state)
    (gauntlet-json-key out "klaww")
    (cond
      ((and *target* (or (gauntlet-in-level? 'beach) *gauntlet-klaww-home*))
       (gauntlet-json-open out)
       (gauntlet-json-key out "state")
       (format out "\"~A\"" (gauntlet-klaww-state-name))
       (gauntlet-json-key out "hits")
       (format out "~D" (gauntlet-klaww-hit-count))
       (gauntlet-json-key out "max")
       (format out "~D" GAUNTLET_KLAWW_MAX_HITS)
       (gauntlet-json-key out "alive")
       (format out "~S" (if (gauntlet-klaww-alive?) "true" "false"))
       (gauntlet-json-key out "buttonsPressed")
       (format out "~D" (gauntlet-klaww-hit-count))
       (gauntlet-json-key out "buttons")
       (format out "~D" GAUNTLET_KLAWW_BUTTONS)
       ;; his rage now, and how often that makes him throw, in seconds
       (gauntlet-json-key out "rage")
       (gauntlet-json-fixed out (gauntlet-klaww-rage))
       (gauntlet-json-key out "throwEvery")
       (gauntlet-json-fixed out (/ (the float (gauntlet-klaww-throw-gap)) (the float (seconds 1))))
       ;; how wide a boulder thrown now would blast, in meters: the console's radius widened by his fury
       (gauntlet-json-meters out "radius" (gauntlet-klaww-boulder-radius))
       (gauntlet-json-close out))
      (else (format out "null")))
    ;; always there, on every level: the census is taken now, so the numbers are this frame's
    (gauntlet-json-key out "horde")
    (gauntlet-horde-recount!)
    (gauntlet-json-open out)
    (gauntlet-json-key out "groups")
    (format out "~D" *gauntlet-horde-groups*)
    (gauntlet-json-key out "clones")
    (format out "~D" *gauntlet-horde-clones*)
    (gauntlet-json-key out "max")
    (format out "~D" *gauntlet-horde-max-clones*)
    (gauntlet-json-key out "multiplier")
    (format out "~D" *gauntlet-lurker-multiplier*)
    (gauntlet-json-close out)
    (gauntlet-json-key out "effects")
    (gauntlet-json-open out)
    (gauntlet-json-key out "enabled")
    (format out "~S" (if (-> *pc-settings* twitch-effects?) "true" "false"))
    (gauntlet-json-close out))
  0)

(defun gauntlet-state-write! ()
  "Write Mods/gauntlet-state.json."
  (let ((out (clear *gauntlet-state-text*)))
    (gauntlet-json-open out)
    (gauntlet-json-key out "frame")
    (format out "~D" *gauntlet-frame*)
    (gauntlet-json-key out "revision")
    (format out "~D" *gauntlet-settings-revision*)
    (gauntlet-json-key out "settings")
    (gauntlet-json-open out)
    (gauntlet-setting-table gauntlet-row-write-now)
    (gauntlet-json-close out)
    (gauntlet-json-key out "defaults")
    (gauntlet-json-open out)
    (gauntlet-setting-table gauntlet-row-write-default)
    (gauntlet-json-close out)
    (gauntlet-state-write-world! out)
    (gauntlet-json-close out)
    (format out "~%")
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-state.json" *pc-settings-folder*)
    (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'write)))
      (when (file-stream-valid? file)
        (file-stream-write file (-> out data) (the-as uint (length out)))
        (file-stream-close file))))
  0)

(defun gauntlet-state-poll! ()
  "Every GAUNTLET_STATE_POLL_FRAMES frames, publish the state."
  (+! *gauntlet-state-countdown* -1)
  (when (>= 0 *gauntlet-state-countdown*)
    (set! *gauntlet-state-countdown* GAUNTLET_STATE_POLL_FRAMES)
    (gauntlet-state-write!))
  0)

;; ------------------------------------------------------------------ the poll --

(define *gauntlet-drop-countdown* 0)
(define *gauntlet-drop-seen* (new 'global 'string 64 ""))
;; The request file outlives the game, so the first look of a fresh boot only
;; records where its counter is, as the snapshot poll does: a request made
;; before the game started must not go off the moment it does. A boot that
;; finds no file counts as the first look too, so the first request ever
;; made, which creates the file, is not swallowed.
(define *gauntlet-drop-primed* #f)

(defun gauntlet-drop! ((kind string))
  "Drop what kind names at Jak's spot."
  (cond
    ((not *target*) (format 0 "GAUNTLET DROP: ~S asked for with no Jak in the world~%" kind))
    ((string= kind "bomb") (gauntlet-bomb-drop! (target-pos 0)))
    ;; the console's bomb on a drop spot (rows 0 and 1 of gauntlet-drop-spot-table): the spot itself, whatever the trigger radius or the arming say
    ((string= kind "bomb-bridge") (gauntlet-drop-on-spot! 0 kind))
    ((string= kind "bomb-vent") (gauntlet-drop-on-spot! 1 kind))
    ;; the herd, aimed at Jak's spot from where he faces
    ((string= kind "stampede") (gauntlet-stampede-ahead!))
    ;; Klaww falls: onto the pelican's nest on the beach, ahead of Jak anywhere else
    ((string= kind "klaww") (gauntlet-klaww-drop!))
    (else (format 0 "GAUNTLET DROP: do not know how to drop ~S~%" kind)))
  0)

(defun gauntlet-drop-poll! ()
  "Per-frame hook: the console's settings are looked at first, so what they say holds for this frame; Jak's health, for the desperation; the drop spots, the
   Sandover spot, the beach and the TNT barrels are watched every frame; every GAUNTLET_DROP_POLL_FRAMES frames look at the request counter, and drop once when it has changed since
   the last look; last, the state file, which then describes this frame."
  (+! *gauntlet-frame* 1)
  (gauntlet-settings-poll!)
  (gauntlet-desperation-poll!)
  (gauntlet-muse-poll!)
  (gauntlet-drop-spots-poll!)
  (gauntlet-stampede-poll!)
  (gauntlet-klaww-poll!)
  (gauntlet-tnt-poll!)
  (+! *gauntlet-drop-countdown* -1)
  (when (>= 0 *gauntlet-drop-countdown*)
    (set! *gauntlet-drop-countdown* GAUNTLET_DROP_POLL_FRAMES)
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-drop-request.txt" *pc-settings-folder*)
    (when (pc-filepath-exists? *pc-temp-string-1*)
      (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
        (when (file-stream-valid? file)
          (file-stream-seek-past-whitespace file)
          (file-stream-read-word file)
          ;; the first word is the counter: an unchanged one means nothing new
          (when (not (string= *pc-temp-string* *gauntlet-drop-seen*))
            ;; counters count up by one a request, so a jump of more than one is requests made within one look: only the
            ;; last is in the file to be read, and the rest would go unremarked
            (when (and *gauntlet-drop-primed* (gauntlet-number-word? *pc-temp-string*) (gauntlet-number-word? *gauntlet-drop-seen*))
              (let ((skipped (+ (the int (- (string->float *pc-temp-string*) (string->float *gauntlet-drop-seen*))) -1)))
                (if (< 0 skipped)
                  (format 0 "GAUNTLET DROP: ~D earlier requests arrived within one look and are not dropped, only the last one is~%" skipped))))
            (format (clear *gauntlet-drop-seen*) "~S" *pc-temp-string*)
            (when *gauntlet-drop-primed*
              ;; the second word names what to drop
              (file-stream-seek-past-whitespace file)
              (file-stream-read-word file)
              (gauntlet-drop! *pc-temp-string*)))
          (file-stream-close file))))
    (set! *gauntlet-drop-primed* #t))
  (gauntlet-state-poll!)
  (none))
