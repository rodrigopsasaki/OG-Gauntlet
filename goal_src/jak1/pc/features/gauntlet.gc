   (:a 64.0 64.0)
   (:vel-y (meters 0.08) (meters 0.04))
   (:scalevel-x (meters 0.02))
   (:rotvel-z (degrees -0.6) (degrees 1.2))
   (:scalevel-y :copy scalevel-x)
   (:fade-a -0.28444445)
   (:accel-y (meters 0.00016666666) (meters 0.00016666666))
   (:friction 0.8)
   (:timer (seconds 1.7))
   (:flags (bit2 bit14))
   (:next-time (seconds 0.14))
   (:next-launcher 3527)
   (:conerot-x (degrees 0) (degrees 120))
   (:conerot-y (degrees 0) (degrees 360))
   (:conerot-radius (meters 0) (meters 3))))

(defpart 3527
  :init-specs ((:fade-r -1.0666667) (:fade-g -1.0666667) (:fade-b -2.1166666) (:next-time (seconds 0.2)) (:next-launcher 3528)))

(defpart 3528
  :init-specs
  ((:fade-r -0.5688889)
   (:fade-g -0.28444445)
   (:fade-b 0.0)
   (:fade-a -0.21333334)
   (:next-time (seconds 0.75))
   (:next-launcher 3529)))

(defpart 3529
  :init-specs ((:fade-r 0.0) (:fade-g 0.0) (:fade-b 0.0)))

;; The glow in the middle of where a boulder, or Klaww, will land, launched every frame it is in the air.
(defpart 3533
  :init-specs
  ((:texture (starflash effects))
   (:num 1.0)
   (:scale-x (meters 4))
   (:scale-y :copy scale-x)
   (:r 255.0)
   (:g 60.0)
   (:b 16.0)
   (:a 48.0)
   (:timer (seconds 0.08))
   (:flags (bit2 bit3 bit14))))

;; ------------------------------------------------------------------ the art --

;; ogreboss-ag's skeleton as the boss himself: the game's *ogreboss-sg*, drawn from the common art (texture level 2) in the
;; character sink group. No shadow, as for the sage and the yakows: his shadow mesh has not been measured, and the shadow VU1
;; wraps at 252 silhouette edges.
(defskelgroup *gauntlet-klaww-sg*
  ogreboss
  ogreboss-lod0-jg
  ogreboss-idle-ja
  ((ogreboss-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 20)
  :texture-level 2
  :sort 1)

;; ogreboss-shoot-boulder, which the boss throws, minus the game's 300 m bounds and its shadow
(defskelgroup *gauntlet-klaww-boulder-sg*
  ogreboss
  ogreboss-shoot-boulder-lod0-jg
  ogreboss-shoot-boulder-idle-ja
  ((ogreboss-shoot-boulder-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 6)
  :texture-level 2
  :sort 1)

;; ogreboss-shoot-boulder-break, the boulder bursting into pieces that the ogre's own boulders do on impact
;; (ogreboss-rock-explosion-effect), played once by a manipy
(defskelgroup *gauntlet-klaww-boulder-break-sg*
  ogreboss
  ogreboss-shoot-boulder-break-lod0-jg
  ogreboss-shoot-boulder-break-idle-ja
  ((ogreboss-shoot-boulder-break-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 15)
  :texture-level 2
  :sort 1)

;; basebutton.gc's *generic-button-sg*, asking for the common art
(defskelgroup *gauntlet-button-sg*
  generic-button
  generic-button-lod0-jg
  generic-button-idle-ja
  ((generic-button-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3)
  :texture-level 2
  :sort 1)

;; ------------------------------------------------------------------- state --

;; The buttons, one table row each: (row index x y z), in meters. The y is a hint, the ground is probed for from just above
;; it, and the button stands on whatever is found. The table is the only place that says how many buttons there are: that
;; many is also the number of hits it takes (GAUNTLET_KLAWW_BUTTONS, below, is their count).
;;
;; The first three spots were picked in game by the mod's author, standing where each button should be (their own positions,
;; 2026-10-27). Distances are from the nest, pelican-1, at (-162.25 11.65 -423.03).
;; Row 0 is the teaching button: on the sand about 74 m south of the nest, an obviously out of place button that the player
;; meets first. Pushing it sends a boulder at Klaww, which teaches that the out of place buttons are how he dies.
;; Row 1 is on the high ground east of the nest, about 108 m from it.
;; Row 2 is far west, about 242 m from the nest, beyond his 140 m throwing range (klaww-range), so on the way there he stops
;; throwing; the boulder it sends back flies about 6 s.
;; Rows 3 and 4 are the designer's two later picks.
(defmacro gauntlet-klaww-button-table (join row)
  "Expand row once per button, (row index x y z), under the form join (begin, to do something for each)."
  `(,join
     (,row 0 -157.1 4.6 -348.7)
     (,row 1 -64.6 16.7 -377.3)
     (,row 2 -381.7 7.3 -526.1)
     (,row 3 -82.0 15.9 -329.9)
     (,row 4 -241.8 28.6 -388.3)))

;; The rows of the table, written out: deftype needs a literal array size, and goalc does not fold a macro-expanded sum
;; into one. A row added above needs this raised with it.
(defconstant GAUNTLET_KLAWW_BUTTONS 5)
(defconstant GAUNTLET_KLAWW_MAX_HITS GAUNTLET_KLAWW_BUTTONS) ;; boulders it takes to bring him down: one per button, every button counts

(deftype gauntlet-klaww-world (structure)
  ((klaww   handle)
   (pelican handle) ;; the pelican that said it is at its nest with the cell, until Klaww has been sent for
   (bar     handle) ;; the process that draws the health bar: never forgotten with the fight, it outlives it
   (buttons handle GAUNTLET_KLAWW_BUTTONS)))

(define *gauntlet-klaww-world* (new 'global 'gauntlet-klaww-world))

(defun gauntlet-klaww-forget-all! ()
  "Every handle of the fight points at no process. A null handle is one whose process is #f, not zero: handle->process asks
   `(if (-> handle process) ...)` and zero is true in GOAL, so a zeroed handle is read through address 0. The bar's is left
   alone: its process is not the fight's."
  (set! (-> *gauntlet-klaww-world* klaww) (the-as handle #f))
  (set! (-> *gauntlet-klaww-world* pelican) (the-as handle #f))
  (dotimes (i GAUNTLET_KLAWW_BUTTONS)
    (set! (-> *gauntlet-klaww-world* buttons i) (the-as handle #f)))
  0)

(gauntlet-klaww-forget-all!)
(set! (-> *gauntlet-klaww-world* bar) (the-as handle #f))

;; The fight, in globals: the processes (Klaww, the buttons) are born from this and die without it, and it outlives Jak's
;; deaths. See "A hit" above.
(define *gauntlet-klaww-spent* 0) ;; bit i is set once the boulder button i threw has reached him: the hits, and the buttons that stand down
(define *gauntlet-klaww-throws* 0) ;; boulders thrown since the fight began, which also numbers them in the log
(define *gauntlet-klaww-defeated* #f) ;; true from the last hit until Jak leaves the level
(define *gauntlet-klaww-cell-given* #f) ;; true once the cell has been handed back, so that it is never handed back twice
(define *gauntlet-klaww-story* #f) ;; how he arrived: 'pelican (crushing it, and back when it reports in again) or 'console (back where he landed), or #f
(define *gauntlet-klaww-art-told* #f) ;; a missing art group is told about once, not every frame
(define *gauntlet-klaww-home* #f) ;; the level the fight is in (a symbol), or #f before Klaww has been dropped: leaving it ends the fight
;; where his feet last landed, for the console's Klaww to come back to
(define *gauntlet-klaww-feet* (new 'global 'vector))
;; the pelican's nest (see above): the pelican's own entity, in meters
(define *gauntlet-klaww-nest* (new 'static 'vector :x (meters -162.25) :y (meters 11.65) :z (meters -423.03) :w 1.0))

(defun gauntlet-klaww-button-spent? ((index int))
  "True when the boulder button index threw has reached him."
  (logtest? *gauntlet-klaww-spent* (ash 1 index)))

(defun gauntlet-klaww-hit-count ()
  "How many hits he has taken: the spent buttons."
  (let ((count 0))
    (dotimes (i GAUNTLET_KLAWW_BUTTONS)
      (if (gauntlet-klaww-button-spent? i) (+! count 1)))
    count))

;; His fury. The fewer hits he has left the angrier he is: one fraction, 0.0 with no hit taken and 1.0 with one hit left, linear between
;; (hits taken over the most he can take before the last, so with five buttons 0 to 4 hits taken is 0, 0.25, 0.5, 0.75, 1), read from
;; the hits, which the spent buttons are, every time it is asked, so a heal calms him at once. Two things grow with it, both between
;; 1.0 and a console maximum by the same line:
;;   his rage, *gauntlet-klaww-rage-max*: how many times as often he throws. It divides the target gap between one release and the next,
;;                and the throw animations play fast enough to make that gap real (gauntlet-klaww-throw-rate), wind-up and follow-through
;;                alike, so a faster Klaww winds up faster too: the boulder's warning is shorter, which is what being angrier costs the player;
;;   the radius, *gauntlet-klaww-radius-max*: how many times as wide his boulders blast, frozen for each boulder as it leaves his hand.
(defun gauntlet-klaww-fury ()
  "How angry he is for the hits he has taken: 0.0 with none, 1.0 with one hit left (and with none left)."
  (fmin 1.0 (/ (the float (gauntlet-klaww-hit-count)) (the float (+ GAUNTLET_KLAWW_MAX_HITS -1)))))

(defun gauntlet-klaww-rage ()
  "How many times as often he throws for his fury: 1.0 with none, *gauntlet-klaww-rage-max* with one hit left."
  (+ 1.0 (* (+ *gauntlet-klaww-rage-max* -1.0) (gauntlet-klaww-fury))))

(defun gauntlet-klaww-radius-multiplier ()
  "How many times as wide a boulder blasts for his fury: 1.0 with none, *gauntlet-klaww-radius-max* with one hit left."
  (+ 1.0 (* (+ *gauntlet-klaww-radius-max* -1.0) (gauntlet-klaww-fury))))

(defun gauntlet-klaww-boulder-radius ()
  "The radius, in game units, a boulder thrown now will blast: the console's radius widened by his fury."
  (* *gauntlet-klaww-boulder-radius* (gauntlet-klaww-radius-multiplier)))

(defun gauntlet-klaww-throw-gap ()
  "The target time from one boulder leaving his hand to the next, in ticks, as it is now: the console's interval shortened by the rage."
  (the int (/ (the float *gauntlet-klaww-throw-interval*) (gauntlet-klaww-rage))))

(defconstant GAUNTLET_KLAWW_MAX_THROW_RATE 4.0) ;; the throw animations never play more than this many times faster, however short the gap asked for

(defun gauntlet-klaww-throw-rate ()
  "How many times faster than they naturally are the throw animations play, so that a throw from the start of its wind-up to the end
   of its follow-through takes the target gap: the natural cycle over the gap, never slower than natural (a longer gap is rested,
   not played slowly) and never more than GAUNTLET_KLAWW_MAX_THROW_RATE."
  (fmin GAUNTLET_KLAWW_MAX_THROW_RATE
        (fmax 1.0 (/ (the float GAUNTLET_KLAWW_THROW_CYCLE) (the float (max 1 (gauntlet-klaww-throw-gap)))))))

(deftype gauntlet-klaww (process-drawable)
  ((windup     time-frame)
   (last-throw time-frame)
   (landing    vector :inline) ;; the ground he falls to, where his feet will be
   (pelican    handle)) ;; the pelican he crushed, and so the holder of its cell: no process when he crushed none
  (:states
   gauntlet-klaww-fall
   gauntlet-klaww-land
   gauntlet-klaww-idle
   gauntlet-klaww-throw
   gauntlet-klaww-hit
   gauntlet-klaww-die
   gauntlet-klaww-gone))

(deftype gauntlet-boulder (process-drawable)
  ((trajectory trajectory :inline)
   (land       vector :inline)
   (tumble     quaternion :inline)
   (start-time time-frame)
   (flight     float)
   (radius     float)
   (index      int)
   (klaww      handle) ;; the Klaww a returned boulder is for, no process for his own
   (returned   symbol)) ;; true for a boulder a button threw back at him, which is not a danger to Jak
  (:states
   gauntlet-boulder-fly
   gauntlet-boulder-land
   gauntlet-boulder-break
   gauntlet-boulder-gone))

(deftype gauntlet-button (basebutton)
  ())

(defun gauntlet-klaww-of ((who handle))
  "The Klaww that who names, or #f once he is gone."
  (let ((proc (handle->process who)))
    (the-as gauntlet-klaww (if (and proc (type-type? (-> proc type) gauntlet-klaww)) proc))))

(defun gauntlet-klaww-process ()
  "Klaww, while he is in the world, or #f."
  (gauntlet-klaww-of (-> *gauntlet-klaww-world* klaww)))

(defun gauntlet-klaww-alive? ()
  "True while he is in the world and not yet beaten."
  (and (gauntlet-klaww-process) (not *gauntlet-klaww-defeated*)))

(defun gauntlet-pelican-at-nest? ((pelican process))
  "True while the pelican sits in the nest in pelican-wait-at-nest, the one state the cannon's explosion, and so Klaww's
   crush, finds it in."
  (let ((state (-> pelican next-state)))
    (and state (= (-> state name) 'pelican-wait-at-nest))))

(defun gauntlet-klaww-pelican-handle ((pelican process))
  "The handle of pelican if it is waiting at its nest, otherwise no process."
  (if (and pelican (gauntlet-pelican-at-nest? pelican))
    (process->handle pelican)
    (the-as handle #f)))

(defun gauntlet-klaww-chest ((klaww gauntlet-klaww) (out vector))
  "Where his chest is in the world, written to out. His skeleton's chest joint once it has been drawn at least once; his
   feet plus the chest's height in the bind pose before that."
  (set! (-> out quad) (-> klaww root trans quad))
  (+! (-> out y) (* GAUNTLET_KLAWW_SCALE GAUNTLET_KLAWW_CHEST))
  (let ((nodes (-> klaww node-list)))
    (when (and nodes (nonzero? nodes) (< (joint-node-index ogreboss-lod0-jg chest) (-> nodes length)))
      (vector<-cspace! out (-> nodes data (joint-node-index ogreboss-lod0-jg chest)))))
  out)

;; ---------------------------------------------------------------- a boulder --

(defbehavior gauntlet-boulder-mark-landing gauntlet-boulder ()
  "Draw where it will land, from the moment it leaves his hand, in the mod's one language for an area that will hurt
   (gauntlet-ring): a red wall at the radius that will hurt, a ring that grows from the middle as the boulder falls and
   reaches the wall at the instant of the landing, and a glow in the middle. The player learns the pattern: get out before
   the inner ring reaches you."
  (let* ((elapsed (the float (- (current-time) (-> self start-time))))
         (progress (fmin 1.0 (/ elapsed (-> self flight)))))
    (gauntlet-ring (-> self land) (-> self radius) progress (/ elapsed (the float (seconds 1))) *gauntlet-flat-rim*)
    (launch-particles (-> *part-id-table* GAUNTLET_PART_KLAWW_CENTER) (-> self land)))
  0)

;; What a boulder does to the world where it lands, besides Jak: everything breakable and killable within its radius is hit, the way the
;; misty cannon's shot hits what its blast overlaps (levels/misty/mistycannon.gc, mistycannon-missile-explode): an 'attack of mode
;; 'explode, which a crate of any defense takes as its break (even an iron or steel one, which a plain attack does not break) and a nav
;; enemy takes as its death (nav-enemy's attack-handler, and the bonelurker's own, which dies to an explode before it looks at anything
;; else). Only crates and nav enemies are reached: those are the handlers read for it. Every other process, Jak, Klaww, the buttons,
;; the bomb, the yakows, the barrels and every pickup are not enemies or crates, and the muse, which is a nav enemy, is not hit, or a
;; boulder would catch her. An enemy and a crate are found by walking the entity pool, which holds them all (the horde's clones too),
;; and kept by the distance of the process's own position from where the boulder landed.
(define *gauntlet-blast-center* (new 'global 'vector)) ;; where the blast in hand is, for the walk to read
(define *gauntlet-blast-radius* 0.0)
(define *gauntlet-blast-from* (the-as process #f)) ;; who is the blast: the boulder, named as the sender of each 'attack
(define *gauntlet-blast-crates* 0) ;; crates this pass has hit
(define *gauntlet-blast-enemies* 0) ;; and enemies

(defun gauntlet-blast-send! ((to process))
  "Send to the process an 'attack of mode 'explode from the blast in hand, with an attack id of its own."
  (let ((msg (new 'stack-no-clear 'event-message-block)))
    (set! (-> msg from) *gauntlet-blast-from*)
    (set! (-> msg num-params) 4)
    (set! (-> msg message) 'attack)
    (set! (-> msg param 0) (the-as uint #f))
    (set! (-> msg param 1) (the-as uint 'explode))
    (let ((id (+ *global-attack-id* 1)))
      (set! *global-attack-id* id)
      (set! (-> msg param 2) (the-as uint id)))
    (set! (-> msg param 3) (the-as uint 0))
    (send-event-function to msg))
  0)

(defun gauntlet-blast-tally! ((proc process))
  "One process of the entity pool in the walk: hit, and counted, if it is a crate or a nav enemy (not the muse) within the blast's radius."
  (let* ((pd (as-type proc process-drawable))
         (crate? (type-type? (-> proc type) crate))
         (enemy? (and (type-type? (-> proc type) nav-enemy) (!= (-> proc type symbol) 'muse))))
    (when (and pd
               (or crate? enemy?)
               (>= *gauntlet-blast-radius* (vector-vector-distance (-> pd root trans) *gauntlet-blast-center*)))
      (if crate? (+! *gauntlet-blast-crates* 1) (+! *gauntlet-blast-enemies* 1))
      (gauntlet-blast-send! proc)))
  (none))

(defun gauntlet-blast! ((from process) (center vector) (radius float) (index int))
  "Hit every crate and every enemy within radius of center, as the boulder from does, and say how many."
  (set! (-> *gauntlet-blast-center* quad) (-> center quad))
  (set! *gauntlet-blast-radius* radius)
  (set! *gauntlet-blast-from* from)
  (set! *gauntlet-blast-crates* 0)
  (set! *gauntlet-blast-enemies* 0)
  (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-blast-tally! proc) (none)) *null-kernel-context*)
  (format 0 "GAUNTLET KLAWW boulder ~D hit ~D crates and ~D enemies~%" index *gauntlet-blast-crates* *gauntlet-blast-enemies*)
  0)

(defbehavior gauntlet-boulder-hurt-jak gauntlet-boulder ()
  "It has landed. If Jak is within its radius of the spot, one plain 'attack: his own invulnerability can refuse it, and it
   is never a kill by itself (a Jak with one hit left dies the way any hit would take him). It throws him off away from the
   landing, the way the herd throws him off a yakow."
  (cond
    ((not *target*) (format 0 "GAUNTLET KLAWW landing ~D: MISS, there is no Jak~%" (-> self index)))
    (else
     (let ((distance (vector-vector-distance (-> self land) (target-pos 0))))
       (cond
         ((< distance (-> self radius))
          (let ((away (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> self land))))
            (set! (-> away y) 0.0)
            ;; standing exactly on the spot has no direction away from it, so use the way the boulder was flying
            (if (< (vector-xz-length away) 40.96)
              (set! (-> away quad) (-> self trajectory initial-velocity quad)))
            (set! (-> away y) 0.0)
            (vector-xz-normalize! away GAUNTLET_KLAWW_SHOVE_BACK)
            (set! (-> away y) GAUNTLET_KLAWW_SHOVE_UP)
            (let ((hurt (send-event *target*
                                    'attack
                                    #f
                                    (static-attack-info ((mode 'generic) (shove-back GAUNTLET_KLAWW_SHOVE_BACK) (shove-up GAUNTLET_KLAWW_SHOVE_UP) (vector away))))))
              (format 0 "GAUNTLET KLAWW landing ~D: ~S, Jak ~M m from the impact (radius ~M m)~%"
                      (-> self index) (if hurt "HIT" "SPARED, invulnerable") distance (-> self radius)))))
         (else
          (format 0 "GAUNTLET KLAWW landing ~D: MISS, Jak ~M m from the impact (radius ~M m)~%"
                  (-> self index) distance (-> self radius)))))))
  0)

(defbehavior gauntlet-boulder-post gauntlet-boulder ()
  "Tumble it, as the ogre's own boulders do, and draw it."
  (quaternion*! (-> self root quat) (-> self root quat) (-> self tumble))
  (ja-post)
  0)

(defstate gauntlet-boulder-fly (gauntlet-boulder)
  :trans
    (behavior ()
      (let ((elapsed (the float (- (current-time) (-> self start-time)))))
        ;; no Klaww to reach any more (he was taken away mid-flight): a returned boulder is gone with him
        (if (and (-> self returned) (not (gauntlet-klaww-of (-> self klaww))))
          (go gauntlet-boulder-gone))
        ;; the whole arc is fixed at the throw: where it is now is only a function of the time since
        (eval-position! (-> self trajectory) (fmin elapsed (-> self flight)) (-> self root trans))
        ;; his own boulders mark where they will land; a returned one is no danger to Jak and marks nothing
        (if (not (-> self returned)) (gauntlet-boulder-mark-landing))
        (spawn (-> self part) (-> self root trans))
        (when (>= elapsed (-> self flight))
          (if (-> self returned)
            (go gauntlet-boulder-break)
            (go gauntlet-boulder-land)))))
  :code
    (behavior ()
      (loop
        (suspend)))
  :post gauntlet-boulder-post)

(defstate gauntlet-boulder-land (gauntlet-boulder)
  :code
    (behavior ()
      (set! (-> self root trans quad) (-> self land quad))
      (sound-play "explosion" :position #f)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f (-> self land) :to *entity-pool*)
      (when (and *target* (< (vector-vector-distance (-> self land) (target-pos 0)) (meters 80)))
        (activate! *camera-smush-control* 819.2 37 600 1.0 0.995))
      (gauntlet-blast! self (-> self land) (-> self radius) (-> self index))
      (gauntlet-boulder-hurt-jak)
      (ja-channel-set! 0)
      (suspend-for (seconds 0.5))
      (deactivate self))
  :post ja-post)

(defstate gauntlet-boulder-gone (gauntlet-boulder)
  :code
    (behavior ()
      (deactivate self)))

(defstate gauntlet-boulder-break (gauntlet-boulder)
  :code
    (behavior ()
      (set! (-> self root trans quad) (-> self land quad))
      (format 0 "GAUNTLET KLAWW boulder ~D hit his chest~%" (-> self index))
      (sound-play "explosion" :position #f)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f (-> self land) :to *entity-pool*)
      (activate! *camera-smush-control* 819.2 37 600 1.0 0.995)
      (let ((klaww (gauntlet-klaww-of (-> self klaww))))
        (if klaww (send-event klaww 'hit (-> self index))))
      ;; the ogre's own boulder bursts into pieces (ogreboss-rock-explosion-effect): a manipy plays the break once, turned at random
      (let ((pieces (manipy-spawn (-> self land) #f *gauntlet-klaww-boulder-break-sg* #f :to self)))
        (ja-channel-set! 0)
        (when pieces
          (let ((pieces-handle (ppointer->handle pieces))
                (turn (new 'stack-no-clear 'quaternion)))
            (quaternion-axis-angle! turn 0.0 1.0 0.0 (* 65536.0 (rand-vu)))
            (send-event (handle->process pieces-handle) 'rot-quat turn)
            (send-event (handle->process pieces-handle) 'anim-mode 'play1)
            (set-time! (-> self state-time))
            ;; the pieces end themselves when the break is over; a stuck one is not waited for
            (suspend)
            (while (and (handle->process pieces-handle) (not (time-elapsed? (-> self state-time) (seconds 4))))
              (suspend)))))
      (deactivate self))
  :post ja-post)

(defbehavior gauntlet-boulder-setup gauntlet-boulder ((src vector) (dest vector) (index int) (speed float) (gravity float) (klaww handle))
  "Appear at src and fly to dest on a fixed ballistic arc: gravity and flight time are taken now, the flight time from the
   distance at speed sideways, and nothing about the arc ever changes again. Nothing steers it, nothing tracks anyone, and
   it collides with nothing on the way: the landing is what it is about. klaww is the Klaww a boulder thrown back at him
   is for, and no process for one he throws; the flight and what happens at the end differ by that."
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self index) index)
  (set! (-> self klaww) klaww)
  (set! (-> self returned) (if (handle->process klaww) #t #f))
  (set! (-> self radius) (gauntlet-klaww-boulder-radius))
  (set! (-> self land quad) (-> dest quad))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> src quad))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (let* ((distance (vector-vector-xz-distance src dest))
         (seconds-in-air (fmax GAUNTLET_KLAWW_BOULDER_MIN_FLIGHT (/ distance speed)))
         (ticks-per-second (the float (seconds 1)))
         (per-tick (- (/ gravity (* ticks-per-second ticks-per-second)))))
    (set! (-> self flight) (* seconds-in-air ticks-per-second))
    ;; the trajectory is evaluated in ticks, as the ogre's missile does
    (setup-from-to-duration! (-> self trajectory) src dest (-> self flight) per-tick)
    (format 0 "GAUNTLET KLAWW ~A ~D: boulder from ~M ~M ~M" (if (-> self returned) "shot" "throw") index (-> src x) (-> src y) (-> src z))
    (format 0 " aimed at ~M ~M ~M, ~M m away, ~F s in the air~%" (-> dest x) (-> dest y) (-> dest z) distance seconds-in-air))
  (let ((spin (* DEGREES_PER_ROT (rand-vu))))
    (quaternion-axis-angle! (-> self tumble) (cos spin) 0.0 (sin spin) 2730.6667))
  (initialize-skeleton self *gauntlet-klaww-boulder-sg* '())
  (set-vector! (-> self draw color-emissive) 0.125 0.0625 0.0 0.0)
  (set! (-> self part) (create-launch-control (get-part-group GAUNTLET_PART_GROUP_KLAWW_TRAIL) self))
  (set-time! (-> self start-time))
  (go gauntlet-boulder-fly)
  (none))

(defbehavior gauntlet-boulder-init-by-other gauntlet-boulder ((src vector) (dest vector) (index int))
  "One of his own, from src, his claw, to dest, the ground under where Jak stood."
  (gauntlet-boulder-setup src dest index GAUNTLET_KLAWW_BOULDER_SPEED GAUNTLET_KLAWW_BOULDER_GRAVITY (the-as handle #f))
  (none))

(defbehavior gauntlet-boulder-return-init-by-other gauntlet-boulder ((src vector) (dest vector) (index int) (klaww handle))
  "One a button threw back, from src, just above the button, to dest, his chest as it was at the throw."
  (gauntlet-boulder-setup src dest index GAUNTLET_KLAWW_SHOT_SPEED GAUNTLET_KLAWW_SHOT_GRAVITY klaww)
  (none))

;; ------------------------------------------------------------------- Klaww --

(defbehavior gauntlet-klaww-face-jak gauntlet-klaww ()
  "Turn toward Jak, the way the sage does."
  (if *target*
    (seek-to-point-toward-point! (-> self root) (target-pos 0) 524288.0 (seconds 0.1)))
  0)

(defbehavior gauntlet-klaww-ready? gauntlet-klaww ()
  "True when it is time for the next throw: he is on, Jak is within range and in a state worth throwing at (not dying, not
   in a cutscene), and the interval, shortened by his rage, has passed since the last boulder left his hand. The wind-up
   is part of the interval: the next wind-up starts early by as long as the last one took (as it actually took, at the rate it
   was played). A throw's animations are played fast enough to fill the gap (gauntlet-klaww-throw-rate), so by the time the
   last one is over the next is due the same frame, and release to release is the gap."
  (and *gauntlet-klaww-enabled*
       *target*
       (not (logtest? (-> *target* state-flags) (state-flags dying grabbed)))
       (>= *gauntlet-klaww-range* (vector-vector-xz-distance (-> self root trans) (target-pos 0)))
       (time-elapsed? (-> self last-throw) (max 0 (- (gauntlet-klaww-throw-gap) (-> self windup))))))

(defbehavior gauntlet-klaww-release gauntlet-klaww ()
  "The boulder leaves his claw, aimed at the ground under where Jak stands right now: that is the whole aim. How long the
   wind-up took is remembered, so the interval can count it."
  (set! (-> self windup) (- (current-time) (-> self state-time)))
  (+! *gauntlet-klaww-throws* 1)
  (format 0 "GAUNTLET KLAWW release ~D: ~F s after the last, wind-up ~F s, throwing every ~F s, animations x ~F, boulder radius ~M m~%"
          *gauntlet-klaww-throws* (gauntlet-seconds-since (-> self last-throw)) (/ (the float (-> self windup)) (the float (seconds 1)))
          (/ (the float (gauntlet-klaww-throw-gap)) (the float (seconds 1))) (gauntlet-klaww-throw-rate) (gauntlet-klaww-boulder-radius))
  (set-time! (-> self last-throw))
  (when *target*
    (let ((aim (new 'stack-no-clear 'vector))
          (claw (new 'stack-no-clear 'vector)))
      (gauntlet-ground-below (target-pos 0) aim)
      (vector<-cspace! claw (-> self node-list data (joint-node-index ogreboss-lod0-jg Rclaw_topC)))
      (process-spawn gauntlet-boulder :init gauntlet-boulder-init-by-other claw aim *gauntlet-klaww-throws* :to self)))
  0)

(defbehavior gauntlet-klaww-take-hit gauntlet-klaww ((button int))
  "The boulder button threw has reached his chest: one more of GAUNTLET_KLAWW_MAX_HITS, and that button is spent for the rest
   of the fight, however many times Jak dies. He flinches, and the last hit brings him down."
  (when (not (gauntlet-klaww-button-spent? button))
    (logior! *gauntlet-klaww-spent* (ash 1 button))
    (format 0 "GAUNTLET KLAWW hit ~D of ~D, button ~D~%" (gauntlet-klaww-hit-count) GAUNTLET_KLAWW_MAX_HITS button)
    (if (>= (gauntlet-klaww-hit-count) GAUNTLET_KLAWW_MAX_HITS)
      (go gauntlet-klaww-die)
      (go gauntlet-klaww-hit)))
  0)

(defbehavior gauntlet-klaww-event gauntlet-klaww ((proc process) (argc int) (message symbol) (block event-message-block))
  "The only thing he listens to is a boulder reaching his chest, which says which button threw it."
  (case message
    (('hit) (gauntlet-klaww-take-hit (the-as int (-> block param 0))) #t)
    (else #f)))

(defstate gauntlet-klaww-fall (gauntlet-klaww)
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (format 0 "GAUNTLET KLAWW fall starts, ~M m above ~M ~M ~M~%"
              GAUNTLET_KLAWW_FALL_HEIGHT (-> self landing x) (-> self landing y) (-> self landing z)))
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak)
      ;; the whole drop is a function of the time since it began: plain gravity from rest, no steering
      (let* ((fallen (gauntlet-seconds-since (-> self state-time)))
             (above (- GAUNTLET_KLAWW_FALL_HEIGHT (* 0.5 GAUNTLET_KLAWW_FALL_GRAVITY fallen fallen))))
        (set! (-> self root trans y) (+ (-> self landing y) (fmax 0.0 above)))
        ;; where he will land, drawn the way a boulder's landing is: a wall, and a ring that grows to meet it as he nears the ground
        (gauntlet-ring (-> self landing) GAUNTLET_KLAWW_LAND_RADIUS (- 1.0 (/ (fmax 0.0 above) GAUNTLET_KLAWW_FALL_HEIGHT)) fallen *gauntlet-flat-rim*)
        (launch-particles (-> *part-id-table* GAUNTLET_PART_KLAWW_CENTER) (-> self landing))
        (if (>= 0.0 above) (go gauntlet-klaww-land))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.2))
      (loop
        (ja-no-eval :group! ogreboss-idle-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!)))))
  :post ja-post)

(defbehavior gauntlet-klaww-crush-pelican gauntlet-klaww ()
  "He has landed: if the pelican is still in the nest under him, it is blown up, with the cannon's explosion but without the
   cell, which he now holds. If it is not there (it was spit at, the console dropped him with it away, he landed off the
   beach) he keeps no pelican and so has no cell to give up."
  (let ((pelican (handle->process (-> self pelican))))
    (cond
      ((and pelican (gauntlet-pelican-at-nest? pelican))
       (format 0 "GAUNTLET KLAWW pelican crushed~%")
       (send-event pelican 'gauntlet-crush))
      (else
       (set! (-> self pelican) (the-as handle #f))
       (format 0 "GAUNTLET KLAWW lands with no pelican to crush~%"))))
  0)

(defstate gauntlet-klaww-land (gauntlet-klaww)
  :event gauntlet-klaww-event
  :code
    (behavior ()
      (set! (-> self root trans quad) (-> self landing quad))
      (format 0 "GAUNTLET KLAWW landed at ~M ~M ~M~%" (-> self landing x) (-> self landing y) (-> self landing z))
      (sound-play "explosion" :position #f)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f (-> self landing) :to *entity-pool*)
      (when (and *target* (< (vector-vector-distance (-> self landing) (target-pos 0)) GAUNTLET_KLAWW_QUAKE_RANGE))
        (activate! *camera-smush-control* 819.2 37 600 1.0 0.995))
      (gauntlet-klaww-crush-pelican)
      ;; the ogre's own roar, which it opens its fight with
      (ja-channel-push! 1 (seconds 0.1))
      (ja-no-eval :group! ogreboss-roar-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (gauntlet-klaww-face-jak)
        (suspend)
        (ja :num! (seek!)))
      ;; the first throw waits one interval from the end of the roar
      (set-time! (-> self last-throw))
      (go gauntlet-klaww-idle))
  :post ja-post)

(defstate gauntlet-klaww-idle (gauntlet-klaww)
  :event gauntlet-klaww-event
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak)
      (if (gauntlet-klaww-ready?) (go gauntlet-klaww-throw)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.2))
      (loop
        (ja-no-eval :group! ogreboss-idle-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!)))))
  :post ja-post)

;; The three animations the ogre's own attack uses, in its order: attack2-start raises the arm (the wind-up, and the warning
;; to a player watching him), the boulder leaves his claw as attack2-loop begins, and attack2-last brings the arm back.
;; Played at their own speed they take 158 frames from the start of the wind-up to the end of the follow-through (56 and 102, 5.2667 s:
;; GAUNTLET_KLAWW_THROW_CYCLE), which was why his rage never changed anything: the gap between boulders could not go under it. Each is
;; now played at gauntlet-klaww-throw-rate, read every frame (the ogre's own fight plays them at a rate the same way), which is
;; the cycle over the target gap, so the whole throw takes the gap and the next wind-up starts the moment this one is over.
(defstate gauntlet-klaww-throw (gauntlet-klaww)
  :event gauntlet-klaww-event
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.1))
      (ja-no-eval :group! ogreboss-attack2-start-ja :num! (seek! max (gauntlet-klaww-throw-rate)) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek! max (gauntlet-klaww-throw-rate))))
      (gauntlet-klaww-release)
      (ja-no-eval :group! ogreboss-attack2-loop-ja :num! (seek! max (gauntlet-klaww-throw-rate)) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek! max (gauntlet-klaww-throw-rate))))
      (ja-no-eval :group! ogreboss-attack2-last-ja :num! (seek! max (gauntlet-klaww-throw-rate)) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek! max (gauntlet-klaww-throw-rate))))
      (go gauntlet-klaww-idle))
  :post ja-post)

;; The flinch, the way the original fight shows a boulder landing on him (ogreboss-blend-hit-anim in levels/ogre/ogreboss.gc): the
;; hit-chest animation's first eight frames blended over whatever he is doing, strongly (0.9) for the middle of the flinch and
;; eased in and out, with the base animation carrying on underneath. Hits one and two are this; the last hit is the full
;; ogreboss-hit animation, which the original plays for the boulder that finishes a stage.
(defbehavior gauntlet-klaww-blend-flinch gauntlet-klaww ()
  "Set the hit-chest channel for this moment of the flinch: how far through it (phase, 0 to 1) picks the frame, and the
   weight rises over the first sixth, holds, and falls away over the second half."
  (let* ((phase (fmin 1.0 (/ (the float (- (current-time) (-> self state-time))) (the float GAUNTLET_KLAWW_FLINCH))))
         (weight (cond
                   ((< phase 0.16666667) (* 5.4 phase))
                   ((< phase 0.5) 0.9)
                   (else (* 1.8 (- 1.0 phase)))))
         (first-frame (ja-aframe 0.0 1)))
    (ja :chan 1
        :frame-interp weight
        :num-func num-func-identity
        :frame-num (+ first-frame (* phase (- (ja-aframe 8.0 1) first-frame)))))
  0)

;; A hit during a wind-up cancels the throw, which is a reward for the button.
(defstate gauntlet-klaww-hit (gauntlet-klaww)
  :event gauntlet-klaww-event
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak))
  :code
    (behavior ()
      ;; the base animation carries on in channel 0; the flinch is laid over it in channel 1
      (ja-channel-push! 2 (seconds 0.05))
      (ja-no-eval :group! ogreboss-idle-ja :num! (seek!) :frame-num 0.0)
      (ja :chan 1 :group! ogreboss-hit-chest-ja :num! min :frame-interp 0.0)
      (until (time-elapsed? (-> self state-time) GAUNTLET_KLAWW_FLINCH)
        (gauntlet-klaww-blend-flinch)
        (suspend)
        (ja :num! (seek!)))
      (go gauntlet-klaww-idle))
  :post ja-post)

(defstate gauntlet-klaww-die (gauntlet-klaww)
  :enter
    (behavior ()
      (set! *gauntlet-klaww-defeated* #t)
      (format 0 "GAUNTLET KLAWW defeated: ~D hits, ~D boulders thrown~%"
              (gauntlet-klaww-hit-count) *gauntlet-klaww-throws*))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.2))
      (ja-no-eval :group! ogreboss-hit-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!)))
      (go gauntlet-klaww-gone))
  :post ja-post)

(defbehavior gauntlet-klaww-give-up-cell gauntlet-klaww ()
  "He has fallen: the cell he took from the pelican falls out of him at the nest. The pelican, blown up and waiting in the
   nest, births it the way its explosion does (pelican-release-cell), including the check that Jak has not got it already.
   Once: the fight remembers that it has been given, so no later route hands it over a second time."
  (set! *gauntlet-klaww-cell-given* #t)
  (let ((pelican (handle->process (-> self pelican))))
    (cond
      (pelican (send-event pelican 'gauntlet-release))
      (else (format 0 "GAUNTLET KLAWW had no cell to give up~%"))))
  0)

(defstate gauntlet-klaww-gone (gauntlet-klaww)
  :code
    (behavior ()
      (let ((chest (gauntlet-klaww-chest self (new 'stack-no-clear 'vector))))
        (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f chest :to *entity-pool*))
      (sound-play "explosion" :position #f)
      (gauntlet-klaww-give-up-cell)
      (deactivate self)))

(defbehavior gauntlet-klaww-init-by-other gauntlet-klaww ((feet vector) (pelican handle))
  "Appear GAUNTLET_KLAWW_FALL_HEIGHT above feet, where his feet will land, facing Jak, and fall. pelican is the one he is to
   crush on landing, or no process. Scaled down to GAUNTLET_KLAWW_SCALE, culled and lit around his chest as the ogre is."
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self pelican) pelican)
  (set! (-> self landing quad) (-> feet quad))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> feet quad))
  (+! (-> self root trans y) GAUNTLET_KLAWW_FALL_HEIGHT)
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) GAUNTLET_KLAWW_SCALE GAUNTLET_KLAWW_SCALE GAUNTLET_KLAWW_SCALE 1.0)
  (if *target*
    (point-toward-point! (-> self root) (target-pos 0)))
  (initialize-skeleton self *gauntlet-klaww-sg* '())
  (set! (-> self draw origin-joint-index) (the uint (joint-node-index ogreboss-lod0-jg chest)))
  ;; the first throw waits one interval, so Jak arriving on the beach is not met with a boulder
  (set! (-> self windup) (seconds 1))
  (set-time! (-> self last-throw))
  (format 0 "GAUNTLET KLAWW spawned to land at ~M ~M ~M, scale ~F~%" (-> feet x) (-> feet y) (-> feet z) GAUNTLET_KLAWW_SCALE)
  (go gauntlet-klaww-fall)
  (none))

;; ----------------------------------------------------------------- a button --

(defun gauntlet-button-fire ((button gauntlet-button))
  "The button has been pressed: one of Klaww's own boulders flies from the button to his chest, if there is a Klaww to hit.
   The arc is fixed from the chest as it is at this moment. A button is pressed once (it stays down), so a press is a shot
   that can never be taken twice. It is spent only when its boulder arrives (gauntlet-klaww-take-hit): a boulder lost in the
   air to Jak's death was no hit, and its button comes back up."
  (format 0 "GAUNTLET KLAWW button ~D pressed~%" (-> button button-id))
  (let ((klaww (gauntlet-klaww-process)))
    (cond
      ((or (not klaww) *gauntlet-klaww-defeated*)
       (format 0 "GAUNTLET KLAWW button ~D: there is no Klaww to hit~%" (-> button button-id)))
      (else
       (let ((src (new 'stack-no-clear 'vector))
             (chest (new 'stack-no-clear 'vector)))
         (set! (-> src quad) (-> button root trans quad))
         (+! (-> src y) GAUNTLET_KLAWW_SHOT_LIFT)
         (gauntlet-klaww-chest klaww chest)
         (process-spawn gauntlet-boulder
                        :init gauntlet-boulder-return-init-by-other
                        src
                        chest
                        (-> button button-id)
                        (process->handle klaww)
                        :to *entity-pool*)))))
  0)

(defmethod basebutton-method-29 ((this gauntlet-button) (event symbol) (notify entity))
  "What the button announces when it goes down. The engine's button calls this with 'trigger as it starts to go down (that is
   what arm-trigger-event! sets) and with #f when it arrives, which is not a press. The stock method sends the event to an
   actor or an actor link, of which this button has neither."
  (if (= event 'trigger) (gauntlet-button-fire this))
  (none))

(defbehavior gauntlet-button-init-by-other gauntlet-button ((index int) (ground vector))
  "A button, numbered index, standing on ground. What basebutton-init-by-other does for the game's own spawned buttons (no
   entity, no actor to notify, never resets), with the skeleton asked for from the common art. One whose boulder has already
   reached him is born down, and the engine's button in the down state ignores a flop."
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause))
  (reset! self)
  (set! (-> self spawned-by-other?) #t)
  (set! (-> self button-id) index)
  (set! (-> self down?) (gauntlet-klaww-button-spent? index))
  (set! (-> self notify-actor) #f)
  (set! (-> self timeout) 0.0)
  (set! (-> self entity) #f)
  (basebutton-method-27 self)
  (set! (-> self root trans quad) (-> ground quad))
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (arm-trigger-event! self)
  ;; basebutton-method-26, with our skelgroup: the up pose on the first frame of the idle animation, the down pose on the last
  (initialize-skeleton self *gauntlet-button-sg* '())
  (logior! (-> self skel status) (janim-status inited))
  (ja-channel-set! 1)
  (if (-> self down?)
    (ja :group! generic-button-idle-ja :num! max)
    (ja :group! generic-button-idle-ja :num! min))
  (set! (-> self anim-speed) 2.0)
  (update-transforms! (-> self root))
  (ja-post)
  (go-virtual basebutton-startup)
  (none))

;; ------------------------------------------------------------ the fight --

(defun gauntlet-klaww-ground ((spot vector) (out vector))
  "The ground under spot, a height picked by hand from an actor list, written to out: probed for from
   GAUNTLET_KLAWW_PROBE_RAISE above it, and spot's own height when there is none to be found."
  (let ((probe (new 'stack-no-clear 'vector)))
    (set! (-> probe quad) (-> spot quad))
    (+! (-> probe y) GAUNTLET_KLAWW_PROBE_RAISE)
    (gauntlet-ground-below probe out)
    ;; a probe that found nothing hands back its own start
    (if (>= (-> out y) (-> probe y))
      (set! (-> out y) (-> spot y))))
  out)

(defun gauntlet-klaww-arrive! ((feet vector) (home symbol) (pelican handle))
  "Drop Klaww onto feet, in the level called home, to crush pelican (or no process) as he lands. The pelican that announced
   itself is spoken for from here. Who brought him is remembered, for when the game puts him away with Jak's death: a
   Klaww that came for a pelican comes back when the pelican, born again, reports in, and one that did not comes back
   to feet."
  (set! *gauntlet-klaww-home* home)
  (set! *gauntlet-klaww-story* (if (handle->process pelican) 'pelican 'console))
  (set! (-> *gauntlet-klaww-feet* quad) (-> feet quad))
  (set! (-> *gauntlet-klaww-world* pelican) (the-as handle #f))
  (let ((klaww (process-spawn gauntlet-klaww :init gauntlet-klaww-init-by-other feet pelican :to *entity-pool*)))
    (when klaww
      (set! (-> *gauntlet-klaww-world* klaww) (ppointer->handle klaww))))
  0)

(defun gauntlet-klaww-landed? ()
  "True once he has landed: any state of his but the fall."
  (let* ((klaww (gauntlet-klaww-process))
         (state (if klaww (-> klaww next-state))))
    (and state (!= (-> state name) 'gauntlet-klaww-fall))))

(defun gauntlet-level-name ()
  "The name of the level Jak is inside, or none between levels."
  (let ((lev (level-get-target-inside *level*)))
    (if lev (-> lev name) 'none)))

;; The cannon's easter egg. The lurker cannon on top of the sentinel at Sentinel Beach (mistycannon, levels/misty/mistycannon.gc,
;; the same object as Misty Island's, which the beach's BEA.DGO carries) lobs sacks (mistycannon-missile). One that lands
;; blows up with a blast radius of 5 m, or 10 m when Jak fired it himself from the periscope, and the blast sends 'attack
;; with mode 'explode to whatever its sphere overlaps: that is how it blows up the pelican (pelican-wait-at-nest) and what
;; gives up the power cell. Klaww has no collision shape (his root is a bare trsqv, so that boulders, Jak and the camera have
;; nothing to bump into), so a blast never overlaps him and the event cannot reach him. The shot calls this instead as it goes
;; off (once per shot, so one shot heals at most once), and a blast whose sphere touches his body heals him one hit: green
;; eco, the colour of health, and one of the buttons he has lost to is back up, random among the ones that are down, to be
;; pressed again. Heals come out of the same bitmask hits go into, so the health bar, the rage and the persistence through a
;; death follow without anything else knowing.

(defun gauntlet-klaww-heal-pick ()
  "A random button that is spent, as its index, or -1 when none is."
  (let ((skip (rand-vu-int-count (gauntlet-klaww-hit-count))) ;; which of the spent buttons, counting from the first
        (found -1))
    (dotimes (i GAUNTLET_KLAWW_BUTTONS)
      (when (and (< found 0) (gauntlet-klaww-button-spent? i))
        (if (zero? skip) (set! found i) (+! skip -1))))
    found))

(defun gauntlet-klaww-blast-reaches? ((klaww gauntlet-klaww) (blast vector) (radius float))
  "True when a blast of radius around blast touches his body: the nearest point of the column from his feet up
   GAUNTLET_KLAWW_BODY_HEIGHT is no farther from the middle of the blast than radius plus GAUNTLET_KLAWW_BODY_RADIUS."
  (let ((nearest (new 'stack-no-clear 'vector)))
    (set! (-> nearest quad) (-> klaww root trans quad))
    (+! (-> nearest y) (fmax 0.0 (fmin GAUNTLET_KLAWW_BODY_HEIGHT (- (-> blast y) (-> nearest y)))))
    (>= (+ radius GAUNTLET_KLAWW_BODY_RADIUS) (vector-vector-distance nearest blast))))

(defun gauntlet-klaww-heal! ((klaww gauntlet-klaww))
  "One cannon shot has hit him. With a hit taken, one of the spent buttons is picked at random and given back: its bit is
   cleared, which is the heal (the bar, the rage and the buttons that stand after a death all read it), and if its button
   is standing it is told to come back up, the way the engine's own button is (basebutton-down-idle, 'untrigger), with a
   puff of green eco at his chest. With none taken he is at full health already, and that is all it does."
  (let ((button (gauntlet-klaww-heal-pick)))
    (cond
      ((< button 0) (format 0 "GAUNTLET KLAWW cannon shot hit him at full health~%"))
      (else
       (logclear! *gauntlet-klaww-spent* (ash 1 button))
       (let ((standing (handle->process (-> *gauntlet-klaww-world* buttons button))))
         (if standing (send-event standing 'untrigger)))
       (let ((chest (gauntlet-klaww-chest klaww (new 'stack-no-clear 'vector))))
         (process-spawn part-tracker :init part-tracker-init group-green-collect 300 #f #f #f chest :to *entity-pool*)
         (process-spawn part-tracker :init part-tracker-init group-eco-green-collect 300 #f #f #f chest :to *entity-pool*))
       (sound-play "g-eco-pickup" :position #f)
       (format 0 "GAUNTLET KLAWW cannon shot healed him, button ~D is back (hits ~D of ~D)~%"
               button (gauntlet-klaww-hit-count) GAUNTLET_KLAWW_MAX_HITS))))
  0)

(defun gauntlet-klaww-cannon-blast! ((blast vector) (radius float))
  "A cannon shot has gone off at blast with a blast radius of radius. Heals him if he is standing (landed, not beaten) and
   it touches his body. Called from mistycannon-missile-explode, on every level the cannon is loaded in."
  (let ((klaww (gauntlet-klaww-process)))
    (when (and klaww (not *gauntlet-klaww-defeated*) (gauntlet-klaww-landed?) (gauntlet-klaww-blast-reaches? klaww blast radius))
      (gauntlet-klaww-heal! klaww)))
  (none))

(defun gauntlet-klaww-keep-button! ((index int) (x float) (y float) (z float))
  "Make sure button index is standing at its row of the table, in meters x y z (as game units here), on whatever ground is
   found under the y it was given."
  (when (and (< index GAUNTLET_KLAWW_BUTTONS) (not (handle->process (-> *gauntlet-klaww-world* buttons index))))
    (let ((spot (new 'stack-no-clear 'vector))
          (ground (new 'stack-no-clear 'vector)))
      (set-vector! spot x y z 1.0)
      (gauntlet-klaww-ground spot ground)
      (let ((button (process-spawn gauntlet-button :init gauntlet-button-init-by-other index ground :to *entity-pool*)))
        (when button
          (set! (-> *gauntlet-klaww-world* buttons index) (ppointer->handle button))
          (format 0 "GAUNTLET KLAWW button ~D stands at ~M ~M ~M (the table said ~M high)~%"
                  index (-> ground x) (-> ground y) (-> ground z) y)))))
  0)

(defmacro gauntlet-row-button-keep (index x y z)
  `(gauntlet-klaww-keep-button! ,index (meters ,x) (meters ,y) (meters ,z)))

(defun gauntlet-klaww-art-ready? ()
  "True when everything that is drawn is in the common art."
  (and (gauntlet-art-ready? *gauntlet-klaww-sg*)
       (gauntlet-art-ready? *gauntlet-klaww-boulder-sg*)
       (gauntlet-art-ready? *gauntlet-klaww-boulder-break-sg*)
       (gauntlet-art-ready? *gauntlet-button-sg*)))

(defun gauntlet-klaww-recover-cell! ()
  "He is beaten but the cell never fell out of him: Jak died between the last hit and his going, and the game put the
   pelican back holding it (its counter is still 2) and reports in at its nest. The end of the fight is finished here, as
   his going would have: the pelican is blown up and, once it is in the explosion, hands the cell over. Once only, and only
   for a fight the pelican started: a console Klaww never held a cell."
  (when (and (= *gauntlet-klaww-story* 'pelican) (not *gauntlet-klaww-cell-given*))
    (let* ((pelican (handle->process (-> *gauntlet-klaww-world* pelican)))
           (state (if pelican (-> pelican next-state))))
      (when state
        (case (-> state name)
          (('pelican-wait-at-nest) (send-event pelican 'gauntlet-crush))
          (('pelican-explode)
           (set! *gauntlet-klaww-cell-given* #t)
           (format 0 "GAUNTLET KLAWW cell handed over after a reset~%")
           (send-event pelican 'gauntlet-release))))))
  0)

(defun gauntlet-klaww-keep! ()
  "Jak is on the beach. Klaww falls when the pelican has said it is at its nest with the cell and he has not been dropped
   yet (or has been put away by a death); once he has landed the buttons stand on their spots, the spent ones down, until he
   is beaten. A beaten Klaww is not dropped again, and the buttons, all down by then, are stood back up as they were if a
   death put them away, until Jak leaves. The buttons wait for the landing so that no press is spent on a Klaww who is not
   there to be hit."
  (cond
    ((not (gauntlet-klaww-art-ready?))
     (when (not *gauntlet-klaww-art-told*)
       (set! *gauntlet-klaww-art-told* #t)
       (format 0 "GAUNTLET KLAWW: the art for him or the button is not loaded, nothing spawned~%")))
    (*gauntlet-klaww-defeated*
     (gauntlet-klaww-button-table begin gauntlet-row-button-keep)
     (gauntlet-klaww-recover-cell!))
    ((gauntlet-klaww-process)
     (if (gauntlet-klaww-landed?) (gauntlet-klaww-button-table begin gauntlet-row-button-keep)))
    ((handle->process (-> *gauntlet-klaww-world* pelican))
     (let ((pelican (gauntlet-klaww-pelican-handle (handle->process (-> *gauntlet-klaww-world* pelican))))
           (feet (new 'stack-no-clear 'vector)))
       ;; the pelican may have left the nest again since it announced itself (it was spit at): then there is nothing to fall on
       (cond
         ((handle->process pelican)
          (gauntlet-klaww-ground *gauntlet-klaww-nest* feet)
          (gauntlet-klaww-arrive! feet 'beach pelican))
         (else (set! (-> *gauntlet-klaww-world* pelican) (the-as handle #f)))))))
  0)

(defun gauntlet-klaww-pelican-at-nest! ((pelican process))
  "The pelican has landed at its nest with the stolen cell (or the level has loaded with it there). Only a note is made
   here: the poll sends Klaww when Jak is on the beach and everything he draws is loaded."
  (format 0 "GAUNTLET KLAWW pelican at its nest with the cell~%")
  (set! (-> *gauntlet-klaww-world* pelican) (process->handle pelican))
  (none))

(defun gauntlet-klaww-any-button? ()
  "True while any button is in the world."
  (dotimes (i GAUNTLET_KLAWW_BUTTONS)
    (if (handle->process (-> *gauntlet-klaww-world* buttons i)) (return #t)))
  #f)

(defun gauntlet-klaww-remove ((who handle))
  "Take a process out of the world, if it is still there."
  (let ((proc (handle->process who)))
    (if proc (deactivate proc)))
  0)

(defun gauntlet-klaww-reset! ((why string))
  "Back to before Jak came: Klaww, the buttons, the spent buttons and the beaten flag all gone. This is the one end of a
   fight (Jak leaving its level, the setting off, or a fresh one asked for): his dying does not come through here. Boulders
   in the air are his children, so they go with him; boulders thrown back at him vanish in the air, with nothing to reach.
   Says so only when there was something to reset."
  (when (or (gauntlet-klaww-process) (gauntlet-klaww-any-button?) (nonzero? *gauntlet-klaww-spent*) *gauntlet-klaww-defeated* *gauntlet-klaww-home*)
    (gauntlet-klaww-remove (-> *gauntlet-klaww-world* klaww))
    (dotimes (i GAUNTLET_KLAWW_BUTTONS)
      (gauntlet-klaww-remove (-> *gauntlet-klaww-world* buttons i)))
    (gauntlet-klaww-forget-all!)
    (set! *gauntlet-klaww-spent* 0)
    (set! *gauntlet-klaww-throws* 0)
    (set! *gauntlet-klaww-defeated* #f)
    (set! *gauntlet-klaww-cell-given* #f)
    (set! *gauntlet-klaww-story* #f)
    (set! *gauntlet-klaww-home* #f)
    (format 0 "GAUNTLET KLAWW reset: ~S~%" why))
  (set! *gauntlet-klaww-art-told* #f)
  0)

(defun gauntlet-klaww-left-home? ()
  "True when there is a fight and Jak is inside a level that is not its home. Between levels he is inside none, which is
   not leaving."
  (let ((lev (level-get-target-inside *level*)))
    (and *gauntlet-klaww-home* lev (!= (-> lev name) *gauntlet-klaww-home*))))

(defun gauntlet-klaww-drop! ()
  "The console's Klaww, on any level: he falls and fights. On the beach it is the pelican's story, onto the nest, crushing
   the pelican if it is at its nest and otherwise just landing. Anywhere else he falls GAUNTLET_KLAWW_AHEAD in front of where
   Jak faces, and there is no pelican and no cell. Buttons only exist at the beach, so off it he throws until Jak leaves the
   level or the console turns him off. A Klaww already there, or beaten, is taken away first: asking again is a fresh fight."
  (cond
    ((not *target*) (format 0 "GAUNTLET DROP: Klaww asked for with no Jak in the world~%"))
    ((not *gauntlet-klaww-enabled*) (format 0 "GAUNTLET DROP: Klaww asked for while he is turned off, ignored~%"))
    ((not (gauntlet-klaww-art-ready?)) (format 0 "GAUNTLET DROP: Klaww's art or the button is not loaded, nothing dropped~%"))
    (else
     (gauntlet-klaww-reset! "asked for again")
     (let ((feet (new 'stack-no-clear 'vector)))
       (cond
         ((gauntlet-in-level? 'beach)
          (gauntlet-klaww-ground *gauntlet-klaww-nest* feet)
          (gauntlet-klaww-arrive! feet 'beach (gauntlet-klaww-pelican-handle (process-by-ename "pelican-1"))))
         (else
          (let ((heading (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> *target* control quat-for-control)))
                (spot (new 'stack-no-clear 'vector)))
            (set! (-> heading y) 0.0)
            (vector-xz-normalize! heading GAUNTLET_KLAWW_AHEAD)
            (vector+! spot (target-pos 0) heading)
            (gauntlet-klaww-ground spot feet)
            (gauntlet-klaww-arrive! feet (gauntlet-level-name) (the-as handle #f))))))))
  0)

(defun gauntlet-klaww-stale? ((who handle))
  "True when who names a process that has gone, as opposed to naming none."
  (and (-> who process) (not (handle->process who))))

(defun gauntlet-klaww-process-gone? ()
  "True when something of the fight that was standing has been put away without the fight saying so. Klaww going on his own
   after the last hit is not that, and neither is a reset (it forgets the handles first): what is left is the game putting
   away the whole entity pool, which is what Jak dying and a speedrun reset both do."
  (or (and (not *gauntlet-klaww-defeated*) (gauntlet-klaww-stale? (-> *gauntlet-klaww-world* klaww)))
      (let ((gone #f))
        (dotimes (i GAUNTLET_KLAWW_BUTTONS)
          (if (gauntlet-klaww-stale? (-> *gauntlet-klaww-world* buttons i)) (set! gone #t)))
        gone)))

(defun gauntlet-klaww-notice-reset! ()
  "If the game has just put the fight's processes away, say that the fight is kept and forget their handles, so it is said
   once. The fight is in the globals (hits as the spent buttons, the beaten flag, the story): Klaww and the buttons are born
   again from them as the poll and the pelican find their way back, and nothing about the fight is reset."
  (when (gauntlet-klaww-process-gone?)
    (format 0 "GAUNTLET KLAWW Jak died or the scene was reset, fight kept: ~D of ~D hits, buttons pressed"
            (gauntlet-klaww-hit-count) GAUNTLET_KLAWW_MAX_HITS)
    (if (zero? *gauntlet-klaww-spent*) (format 0 " none"))
    (dotimes (i GAUNTLET_KLAWW_BUTTONS)
      (if (gauntlet-klaww-button-spent? i) (format 0 " ~D" i)))
    (format 0 "~S~%" (if *gauntlet-klaww-defeated* ", Klaww stays defeated" ""))
    (gauntlet-klaww-forget-all!))
  0)

(defun gauntlet-klaww-revive! ()
  "A Klaww the console dropped and a death put away comes back, falling onto where he first landed, with the hits he had.
   Not while Jak is dying (the reset has not happened yet, or the respawn is under way: he would be put away again), and
   only for the console's: a pelican's Klaww comes back when the pelican, born again, reports in (gauntlet-klaww-keep!)."
  (when (and (= *gauntlet-klaww-story* 'console)
             (not *gauntlet-klaww-defeated*)
             (not (gauntlet-klaww-process))
             (gauntlet-in-level? *gauntlet-klaww-home*)
             (not (logtest? (-> *target* state-flags) (state-flags dying)))
             (gauntlet-klaww-art-ready?))
    (format 0 "GAUNTLET KLAWW back at ~M ~M ~M, with his ~D of ~D hits~%"
            (-> *gauntlet-klaww-feet* x) (-> *gauntlet-klaww-feet* y) (-> *gauntlet-klaww-feet* z)
            (gauntlet-klaww-hit-count) GAUNTLET_KLAWW_MAX_HITS)
    (gauntlet-klaww-arrive! *gauntlet-klaww-feet* *gauntlet-klaww-home* (the-as handle #f)))
  0)

;; ----------------------------------------------------------------- the health bar --

;; Top centre of the screen once Klaww has landed, until he is beaten (it comes up with the buttons, so his fall is not given
;; away): the label and one notch per hit he has left, the ones he has lost left in the frame, dim. It is drawn the way
;; twitch.gc draws its log (a process in *active-pool* that draws every frame into the debug-no-zbuf bucket, with
;; draw-string-xy-scaled for the text and draw-sprite2d-xy for the notches), because text added
;; from the per-frame hook the poll runs in puts nothing on screen, and because those are the game's own 2D drawing, on
;; in normal play with no debug flag. The space is the 2D one: x from 0 to 512, y from 0 to about 224; notch widths are
;; divided by the aspect ratio scale, as pc-debug-common.gc does, so they are not stretched on a wide screen.
(defconstant GAUNTLET_KLAWW_BAR_CENTER 256) ;; x of the middle of the screen in that space
(defconstant GAUNTLET_KLAWW_BAR_LABEL_Y 8)
(defconstant GAUNTLET_KLAWW_BAR_LABEL_SCALE 0.5)
(defconstant GAUNTLET_KLAWW_BAR_NOTCH_Y 21)
(defconstant GAUNTLET_KLAWW_BAR_NOTCH_W 14)
(defconstant GAUNTLET_KLAWW_BAR_NOTCH_H 5)
(defconstant GAUNTLET_KLAWW_BAR_GAP 3)
(defconstant GAUNTLET_KLAWW_BAR_PAD 3) ;; the dark frame around the notches

(defun gauntlet-klaww-bar-shown? ()
  "True while the bar is up: Klaww is in the world, not beaten, and has landed (the very condition that stands the buttons
   up, so bar and buttons appear together and his drop stays a surprise), and Jak is in the level the fight is in. While he
   falls or lands, and while a death has put him away, it is down; once he is back and landed it is up again."
  (and *target*
       *gauntlet-klaww-home*
       (gauntlet-klaww-alive?)
       (gauntlet-klaww-landed?)
       (gauntlet-in-level? *gauntlet-klaww-home*)))

(defun gauntlet-klaww-bar-draw ()
  "Draw this frame's bar, if Klaww has landed and the fight is to be shown."
  (when (gauntlet-klaww-bar-shown?)
    (let* ((aspect (-> *pc-settings* aspect-ratio-scale))
           (notch-w (max 1 (the int (/ (the float GAUNTLET_KLAWW_BAR_NOTCH_W) aspect))))
           (gap (max 1 (the int (/ (the float GAUNTLET_KLAWW_BAR_GAP) aspect))))
           (pad (max 1 (the int (/ (the float GAUNTLET_KLAWW_BAR_PAD) aspect))))
           (bar-w (+ (* GAUNTLET_KLAWW_MAX_HITS notch-w) (* (+ GAUNTLET_KLAWW_MAX_HITS -1) gap)))
           (left (- GAUNTLET_KLAWW_BAR_CENTER (/ bar-w 2)))
           (remaining (- GAUNTLET_KLAWW_MAX_HITS (gauntlet-klaww-hit-count)))
           (font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags shadow kerning large)))
           (label-w (the int (* (get-string-length "KLAWW" font) GAUNTLET_KLAWW_BAR_LABEL_SCALE))))
      (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
        (draw-string-xy-scaled "KLAWW" buf (- GAUNTLET_KLAWW_BAR_CENTER (/ label-w 2)) GAUNTLET_KLAWW_BAR_LABEL_Y
                               (font-color red) (font-flags shadow kerning large) GAUNTLET_KLAWW_BAR_LABEL_SCALE)
        (draw-sprite2d-xy buf (- left pad) (- GAUNTLET_KLAWW_BAR_NOTCH_Y pad) (+ bar-w (* 2 pad)) (+ GAUNTLET_KLAWW_BAR_NOTCH_H (* 2 pad))
                          (static-rgba 0 0 0 64))
        (dotimes (i GAUNTLET_KLAWW_MAX_HITS)
          (draw-sprite2d-xy buf (+ left (* i (+ notch-w gap))) GAUNTLET_KLAWW_BAR_NOTCH_Y notch-w GAUNTLET_KLAWW_BAR_NOTCH_H
                            (if (< i remaining) (static-rgba 230 50 40 128) (static-rgba 90 90 90 64)))))))
  (none))

(defun gauntlet-klaww-bar-ensure! ()
  "Keep one process alive that draws the bar. A reset can put it away, so this looks every frame; its handle lives in a
   structure, because a handle in a bare global loses its pid."
  (when (not (handle->process (-> *gauntlet-klaww-world* bar)))
    (set! (-> *gauntlet-klaww-world* bar)
          (ppointer->handle
            (process-spawn-function process
                                    (lambda :behavior process ()
                                      (loop
                                        (gauntlet-klaww-bar-draw)
                                        (suspend)))
                                    :to *active-pool*
                                    :name 'gauntlet-klaww-bar))))
  0)

(define *gauntlet-klaww-rage-told* -1.0) ;; his rage the last time the poll looked, -1 with no fight on, so a change is told once

(defun gauntlet-klaww-rage-poll! ()
  "Per-frame: say when his rage has changed while he is in the world and not beaten, and how often he throws now. A fight
   that is off (or a Klaww a death has put away) forgets it, so the one that comes back says it again."
  (let ((rage (if (gauntlet-klaww-alive?) (gauntlet-klaww-rage) -1.0)))
    (when (!= rage *gauntlet-klaww-rage-told*)
      (set! *gauntlet-klaww-rage-told* rage)
      (if (< 0.0 rage)
        (format 0 "GAUNTLET KLAWW rage x ~F (hits ~D of ~D), throwing every ~F s, boulders blast ~M m~%"
                rage (gauntlet-klaww-hit-count) GAUNTLET_KLAWW_MAX_HITS (/ (the float (gauntlet-klaww-throw-gap)) (the float (seconds 1)))
                (gauntlet-klaww-boulder-radius)))))
  0)

(defun gauntlet-klaww-poll! ()
  "Per-frame: a fight ends when Jak leaves the level it is in (or the setting goes off), and is forgotten; and nothing else
   ends it, Jak's death included. When the game puts Klaww and the buttons away with a death, the fight is kept, and they
   come back from it: on the beach the pelican's arrival sends Klaww again and, once he has landed, the buttons; the
   console's Klaww is sent back where he was. With no Jak (loading) nothing changes."
  (gauntlet-klaww-bar-ensure!)
  (gauntlet-klaww-rage-poll!)
  (cond
    ((not *target*))
    ((not *gauntlet-klaww-enabled*) (gauntlet-klaww-reset! "turned off"))
    ((gauntlet-klaww-left-home?) (gauntlet-klaww-reset! "Jak left the level"))
    (else
     (gauntlet-klaww-notice-reset!)
     (if (gauntlet-in-level? 'beach) (gauntlet-klaww-keep!))
     (gauntlet-klaww-revive!)))
  0)

;; --------------------------------------------------------------- the TNT barrels --

;; The skull TNT barrels of Mountain Pass (tntbarrel, levels/ogre/ogre-obs.gc), stood wherever the table below says, on any
;; level. Behaviour is the original's: Jak touching one or attacking it is killed outright (an 'attack-invinc of mode 'death,
;; which ignores his invulnerability), and the barrel explodes and is gone. It listens to the same two other events too, 'die
;; and 'die-big, so a later set piece can blow one up, the way the game's flying lurker does.
;;
;; Like the bomb and the herd it is entity-less and its art is common (tntbarrel-ag.go in GAME.CGO, common_art_groups in the
;; decompiler config; no tpage, the merc renderer binds its textures from the fr3). The explosion is the barrel's own, ported
;; here under new ids: ogre-obs.gc only loads with OGR.DGO, and a particle id the level's code defines would point into its
;; freed heap once the level unloads. The textures are all the common "effects" page (tpage 2, in GAME.CGO), and "dcrate-break"
;; is in COMMON.SBK, which is always loaded.
;;
;; Barrels are a table of spots, like Klaww's buttons, each naming the level it stands in. A barrel exists only while Jak is
;; inside that level, and is put away when he leaves it, so a spot picked on the beach can never hang in the air of another
;; level. A barrel that is missing, because it went off or because Jak's death put it away with every other process of the
;; entity pool, is stood again as soon as Jak is more than GAUNTLET_TNT_REARM_RANGE from its spot: he never meets it
;; spawning, and respawning at a checkpoint beside it does not put a fresh one in his face.

(defconstant GAUNTLET_TNT_REARM_RANGE (meters 30)) ;; a missing barrel is stood again when Jak is farther than this from its spot, sideways
(defconstant GAUNTLET_PART_GROUP_TNT 1004) ;; ids this file adds to the particle tables, after Klaww's: groups 1004 and 1005, parts 3534 to 3550
(defconstant GAUNTLET_PART_GROUP_TNT_BIG 1005)

;; group-tntbarrel-explosion (474) as group 1004, parts 2079-2086 as 3534-3541
(defpartgroup group-gauntlet-tnt
  :id 1004
  :duration (seconds 2)
  :flags (use-local-clock)
  :bounds (static-bspherem 0 0 0 12)
  :parts
  ((sp-item 3534 :period (seconds 2) :length (seconds 0.017))
   (sp-item 3535 :period (seconds 2) :length (seconds 0.135))
   (sp-item 3536 :period (seconds 2) :length (seconds 0.067))
