;; ogre-obs.gc's *tntbarrel-sg*, asking for the common art. Sort 1 like every other common-art prop and character.
(defskelgroup *gauntlet-tntbarrel-sg*
  tntbarrel
  tntbarrel-lod0-jg
  tntbarrel-idle-ja
  ((tntbarrel-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 2 0 4)
  :texture-level 2
  :sort 1)

;; The barrels, one table row each: (row index level x y z), the spot in meters. The y is a hint: the barrel stands on the
;; ground probed for from just above it (gauntlet-klaww-ground, which every hand-picked spot of this mod goes through), so a
;; spot read off something floating, like a power cell, still puts the barrel on the ground. A "here" request from the
;; designer adds a row. The only place that says how many barrels there are is this table; GAUNTLET_TNT_BARRELS, below,
;; is the count.
;;
;; Row 0 is the designer's pick: on Sentinel Beach, standing just below a power cell, he asked for a barrel between himself and
;; the cell. He stood at -345.70 23.50 -440.27 and the cell (fuel-cell-42) floats at -357.37 26.82 -431.18; the spot is the
;; midpoint of the two sideways, at the height of his feet.
(defmacro gauntlet-tnt-table (join row)
  "Expand row once per barrel, (row index level x y z), under the form join (begin, to do something for each)."
  `(,join
     (,row 0 beach -351.54 23.5 -435.73)))

;; The rows of the table, written out: deftype needs a literal array size. A row added above needs this raised with it.
(defconstant GAUNTLET_TNT_BARRELS 1)

(deftype gauntlet-tnt-world (structure)
  ((barrels handle GAUNTLET_TNT_BARRELS)))

(define *gauntlet-tnt-world* (new 'global 'gauntlet-tnt-world))

;; a null handle is one whose process is #f, not zero (see gauntlet-klaww-forget-all!)
(dotimes (i GAUNTLET_TNT_BARRELS)
  (set! (-> *gauntlet-tnt-world* barrels i) (the-as handle #f)))

(define *gauntlet-tnt-art-told* #f) ;; a missing art group is told about once, not every frame

(deftype gauntlet-tnt (process-drawable)
  ((root collide-shape :override)
   (row  int)
   (big  symbol)) ;; true when it was told 'die-big, which is the bigger explosion
  (:states
   gauntlet-tnt-idle
   gauntlet-tnt-die))

(defstate gauntlet-tnt-die (gauntlet-tnt)
  :code
    (behavior ()
      (format 0 "GAUNTLET TNT row ~D exploded~%" (-> self row))
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self root))
      (ja-post)
      (sound-play "dcrate-break")
      (process-spawn part-tracker
                     :init
                     part-tracker-init
                     (get-part-group (if (-> self big) GAUNTLET_PART_GROUP_TNT_BIG GAUNTLET_PART_GROUP_TNT))
                     -1
                     #f
                     #f
                     #f
                     (-> self root trans)
                     :to
                     *entity-pool*)
      (suspend)
      (cleanup-for-death self)
      (deactivate self)))

(defstate gauntlet-tnt-idle (gauntlet-tnt)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('die-big)
         (set! (-> self big) #t)
         (go gauntlet-tnt-die))
        (('die) (go gauntlet-tnt-die))
        (('attack 'touch)
         (send-event proc 'attack-invinc (-> block param 0) (static-attack-info ((mode 'death))))
         (go gauntlet-tnt-die))))
  :code
    (behavior ()
      (transform-post)
      (logior! (-> self mask) (process-mask sleep))
      (suspend)
      0))

(defbehavior gauntlet-tnt-init-by-other gauntlet-tnt ((row int) (feet vector))
  "Appear on feet, the ground under its spot, as table row row. The touch shape is the game's barrel's, a mesh prim around
   the skull that only Jak's own collision looks for."
  (stack-size-set! (-> self main-thread) 512)
  ;; keep standing whatever the actors around do, as the bomb does
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self row) row)
  (set! (-> self big) #f)
  (let ((shape (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-mesh shape (the-as uint 0) (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind crate))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid))
      (set! (-> prim prim-core offense) (collide-offense touch))
      (set! (-> prim transform-index) 3)
      (set-vector! (-> prim local-sphere) 0.0 9216.0 0.0 14336.0)
      (set-root-prim! shape prim))
    (set! (-> shape nav-radius) (* 0.75 (-> shape root-prim local-sphere w)))
    (backup-collide-with-as shape)
    (set! (-> self root) shape))
  (set! (-> self root trans quad) (-> feet quad))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (initialize-skeleton self *gauntlet-tntbarrel-sg* '())
  (set-vector! (-> self draw color-mult) 1.3 1.3 1.3 1.0)
  (go gauntlet-tnt-idle)
  (none))

(defun gauntlet-tnt-keep! ((index int) (home symbol) (x float) (y float) (z float))
  "Make sure barrel index stands at its row of the table, in meters x y z (as game units here), while Jak is inside the level called home and
   the setting is on; put it away when either stops being true. A barrel that is missing is stood again only when Jak is
   farther than GAUNTLET_TNT_REARM_RANGE from its spot."
  (let ((barrel (-> *gauntlet-tnt-world* barrels index))
        (spot (set-vector! (new 'stack-no-clear 'vector) x y z 1.0)))
    (cond
      ((or (not *gauntlet-tnt-enabled*) (not (gauntlet-in-level? home)))
       (when (handle->process barrel)
         (gauntlet-klaww-remove barrel)
         (format 0 "GAUNTLET TNT row ~D put away~%" index)))
      ((handle->process barrel))
      ((not (gauntlet-art-ready? *gauntlet-tntbarrel-sg*))
       (when (not *gauntlet-tnt-art-told*)
         (set! *gauntlet-tnt-art-told* #t)
         (format 0 "GAUNTLET TNT: the barrel's art group is not loaded, nothing spawned~%")))
      ((< GAUNTLET_TNT_REARM_RANGE (vector-vector-xz-distance (target-pos 0) spot))
       (let ((ground (new 'stack-no-clear 'vector)))
         (gauntlet-klaww-ground spot ground)
         (let ((made (process-spawn gauntlet-tnt :init gauntlet-tnt-init-by-other index ground :to *entity-pool*)))
           (when made
             (set! (-> *gauntlet-tnt-world* barrels index) (ppointer->handle made))
             (format 0 "GAUNTLET TNT spawned row ~D at (~M, ~M, ~M)~%" index (-> ground x) (-> ground y) (-> ground z))))))))
  0)

(defmacro gauntlet-row-tnt-keep (index level x y z)
  `(gauntlet-tnt-keep! ,index (quote ,level) (meters ,x) (meters ,y) (meters ,z)))

(defun gauntlet-tnt-poll! ()
  "Per-frame: every barrel of the table is kept standing (or put away) as gauntlet-tnt-keep! says. With no Jak (loading,
   dying) nothing changes."
  (when *target*
    (gauntlet-tnt-table begin gauntlet-row-tnt-keep))
  0)

;; ------------------------------------------------------------------ the horde --

;; Every enemy the level places that runs on the nav mesh (a babak, a lurker crab, a hopper, a bonelurker, an ice cube...) is
;; born with company: *gauntlet-lurker-multiplier* minus one clones, standing on a ring around it. A clone is the same
;; process, born by the same init-from-entity! from the same entity, but the entity's own process stays the original: the
;; entity system's bookkeeping (dead, complete, culled when Jak walks away) is the original's alone, and process-entity-status!
;; and entity-deactivate-handler both ignore a process that is not the one the entity names, so a clone dying or being
;; taken away never marks the entity dead and never clears the original. engine/entity/entity.gc calls *entity-born-hook*
;; after each birth; this is what answers.
;;
;; The entity system does not know the clones, so the mod ends them. Their entity is the original's, which is what makes the
;; engine itself take them away when their level unloads (deactivate-entities sweeps *entity-pool* for processes whose entity
;; is in the level). One small watcher per birth does the rest: it ends the clones when the original is culled by distance
;; (a fresh original with fresh clones is born when Jak comes back, so they do not pile up), and ends itself when no clone
;; is left. A clone outlives an original that was killed, as a lurker outlives its neighbour.
;;
;; The crowd is capped (*gauntlet-horde-max-clones*, all groups together). The count is never kept, it is taken: a recount walks
;; *entity-pool* and adds up, for each watcher standing, the clones whose handles still name a live process. A kept tally would
;; have to hear about every way a clone can end (killed by Jak, put away with its watcher by reset-actors when Jak dies or a
;; speedrun resets, swept with its level by deactivate-entities) and would drift on the one it missed; the handles cannot drift,
;; because the kernel invalidates them. The walk costs one pass over a pool of a few hundred processes, once per birth and once
;; per state write.
;;
;; Misty Island's lurkers have company only while the muse is loose (see "the muse"): their normal clones, and *gauntlet-misty-mayhem-extra*
;; more, the extras. With her caught Misty is calm: the lurkers it places and nothing else, so a lurker born then has no company, and
;; catching her takes the whole of it away, each clone with a puff. (With the muse setting off Misty is a level like any other, and only
;; the extras, which need her, go.) The normal clones live in the first GAUNTLET_HORDE_MAX_CLONES slots of the group's handles and the
;; extras in the last, each at the angle of its slot, so a top-up on a drop puts each where a birth would have, and the group does not
;; have to remember which are which. The watcher of a Misty group stays for as long as company could come (until its level goes, the
;; original is put away or killed), because a lurker born or standing in the calm is owed all of it the next time she is dropped. A
;; group is brought its company once for each time the muse has gone loose (*gauntlet-muse-episode*), so clones that Jak killed are not
;; born again while she stays loose. A Misty lurker born while she is loose has its company from its birth, by the same
;; gauntlet-horde-mayhem!, and not from the multiplier's ring below.
;;
;; Nothing here keeps a string: a field of a plain process subtype that points into the process's own heap is not moved when
;; the heap compacts (engine/entity/relocate.gc adjusts only what each type's relocate method names, as nav-enemy's does for its
;; neck and rand-gen), so a copy of the actor's name would dangle. The name is read from the entity instead, which is safe while
;; the actor's level is active, and the line that is written once it is not names the level.

(defconstant GAUNTLET_HORDE_MAX_CLONES 4) ;; clones in ONE group: the console's multiplier tops out at 5, the original and four clones; and Misty's extras at four too (the cap on all groups together is the setting *gauntlet-horde-max-clones*)
(defconstant GAUNTLET_HORDE_SLOTS 8) ;; handles a group holds: slots 0 to 3 are its normal clones, 4 to 7 Misty's extras. deftype below needs this written out
(defconstant GAUNTLET_HORDE_RING_RADIUS (meters 3)) ;; clones stand this far from the original, evenly around it
(defconstant GAUNTLET_HORDE_EXTRA_RADIUS (meters 5)) ;; and Misty's extras this far, a quarter turn at a time from a diagonal, so they stand between and outside the others

(deftype gauntlet-horde (process)
  ((ent        entity-actor) ;; the actor the clones are of; its memory is its level's, so it is read only while that level is active
   (original   handle) ;; the actor's own process, the one the entity system manages
   (level-name symbol) ;; the level the actor belongs to
   (episode    int32) ;; the *gauntlet-muse-episode* this group last topped its extras up for; 0 before it has
   (clones     handle 8)) ;; GAUNTLET_HORDE_SLOTS of them, a null handle (not a zero) where there is none
  (:states
   gauntlet-horde-watch))

(defun gauntlet-horde-live-clones ((horde gauntlet-horde))
  "How many of horde's clones, normal and extra, are still alive."
  (let ((alive 0))
    (dotimes (i GAUNTLET_HORDE_SLOTS)
      (if (handle->process (-> horde clones i)) (+! alive 1)))
    alive))

(define *gauntlet-horde-groups* 0) ;; watchers standing, as of the last gauntlet-horde-recount!
(define *gauntlet-horde-clones* 0) ;; clones alive across them, as of the same recount

(defun gauntlet-horde-tally! ((proc process))
  "Add proc to the running totals if it is a watcher: one more group, and as many clones as its handles still name."
  (let ((horde (as-type proc gauntlet-horde)))
    (when horde
      (+! *gauntlet-horde-groups* 1)
      (+! *gauntlet-horde-clones* (gauntlet-horde-live-clones horde))))
  (none))

(defun gauntlet-horde-recount! ()
  "Take the census of the horde into *gauntlet-horde-groups* and *gauntlet-horde-clones*, from the watchers standing in
   *entity-pool* right now."
  (set! *gauntlet-horde-groups* 0)
  (set! *gauntlet-horde-clones* 0)
  (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-horde-tally! proc) (none)) *null-kernel-context*)
  0)

(defbehavior gauntlet-horde-remove-clones gauntlet-horde ()
  "Take away every clone still alive, the extras too."
  (dotimes (i GAUNTLET_HORDE_SLOTS)
    (let ((alive (handle->process (-> self clones i))))
      (if alive (deactivate alive))))
  0)

(defbehavior gauntlet-horde-level-left? gauntlet-horde ()
  "True once the level the actor belongs to is no longer the one running: from then on its entity is not to be read."
  (!= (level-status *level* (-> self level-name)) 'active))

(defbehavior gauntlet-horde-name gauntlet-horde ()
  "The actor's name, read from its entity: only to be called while its level is active."
  (res-lump-struct (-> self ent) 'name string))

(defbehavior gauntlet-horde-walked-away? gauntlet-horde ()
  "True once the original is gone without having been killed: the entity system culled it because Jak walked away (or a
   death reset the actors), and it will be born again, with fresh clones, when he comes back."
  (and (not (handle->process (-> self original)))
       (not (logtest? (-> self ent extra perm status) (entity-perm-status dead)))))

(define-extern gauntlet-horde-clone! (function entity-actor vector handle)) ;; below: the extras are born the way the clones are

(defun gauntlet-puff! ((where vector))
  "A puff of dust at where, from the game's own particles for Jak's landings (target-part.gc, in GAME.CGO)."
  (process-spawn part-tracker :init part-tracker-init group-land-poof-dirt 300 #f #f #f where :to *entity-pool*)
  0)

(defun gauntlet-horde-base-asked ()
  "How many normal clones a lurker is owed: lurker-multiplier minus one, at most GAUNTLET_HORDE_MAX_CLONES. The slots 0 up to this are its."
  (min (+ *gauntlet-lurker-multiplier* -1) GAUNTLET_HORDE_MAX_CLONES))

(defun gauntlet-horde-extras-asked ()
  "How many extras a Misty lurker is owed while the muse is loose: misty-mayhem-extra, at most GAUNTLET_HORDE_MAX_CLONES. Slots 4 and up."
  (min *gauntlet-misty-mayhem-extra* GAUNTLET_HORDE_MAX_CLONES))

(defun gauntlet-horde-calm! ((horde gauntlet-horde) (all symbol))
  "Take away horde's clones still alive, each with a puff where it stood: all of them (the muse is with Jak, and Misty's lurkers are the
   originals and nothing more) when all is true, or only the extras (the muse setting was turned off, and Misty is a level like the rest)
   when it is false."
  (let ((gone 0)
        (first-slot (if all 0 GAUNTLET_HORDE_MAX_CLONES)))
    (let ((slot first-slot))
      (while (< slot GAUNTLET_HORDE_SLOTS)
        (let* ((alive (handle->process (-> horde clones slot)))
               (body (if alive (as-type alive process-drawable))))
          (when alive
            (if body (gauntlet-puff! (-> body root trans)))
            (deactivate alive)
            (+! gone 1)))
        (+! slot 1)))
    (if (> gone 0)
      (format 0 "GAUNTLET HORDE ~S calm, -~D clones~%" (res-lump-struct (-> horde ent) 'name string) gone)))
  0)

(defun gauntlet-horde-slot-born! ((horde gauntlet-horde) (slot int) (centre vector) (angle float) (radius float))
  "Born the clone of horde's slot slot standing radius from centre, angle round from +z towards +x, in a burst of dark eco, the colour of the
   mayhem. True when one came; false when no process was free for it."
  (let ((spot (new 'stack-no-clear 'vector)))
    (set! (-> spot x) (+ (-> centre x) (* radius (sin angle))))
    (set! (-> spot y) (-> centre y))
    (set! (-> spot z) (+ (-> centre z) (* radius (cos angle))))
    (set! (-> spot w) 1.0)
    (let ((twin (gauntlet-horde-clone! (-> horde ent) spot)))
      (when (handle->process twin)
        (set! (-> horde clones slot) twin)
        (process-spawn part-tracker :init part-tracker-init group-dark-eco-box-explosion -1 #f #f #f spot :to *entity-pool*)
        #t))))

(defun gauntlet-horde-mayhem! ((horde gauntlet-horde))
  "The muse is loose: bring horde's company back up to what it is owed, the normal clones (lurker-multiplier minus one, on the ring of 3 m
   they are born on, each at the angle of its slot) and then the extras (*gauntlet-misty-mayhem-extra*, on the wider ring), as many as the
   cap on the crowd allows, each in the slot of its own, round the original where it stands NOW (where it was placed when it is gone: a
   culled or killed one), so the company arrives at the lurker that is in front of Jak and not at a home he may never have seen, each with a
   burst of dark eco. While the muse was with Jak there was none (gauntlet-horde-calm!), so on a drop all of it comes, and a lurker born in the
   mayhem is brought its company by this too. This is done once for each time she goes loose, which the group's episode remembers, so clones
   Jak killed stay dead."
  (set! (-> horde episode) *gauntlet-muse-episode*)
  (gauntlet-horde-recount!)
  (let* ((ent (-> horde ent))
         (proc (handle->process (-> horde original)))
         (live (if proc (as-type proc process-drawable)))
         (centre (new 'stack-no-clear 'vector))
         (base-total (gauntlet-horde-base-asked))
         (extras-total (gauntlet-horde-extras-asked))
         (room (max 0 (- *gauntlet-horde-max-clones* *gauntlet-horde-clones*)))
         (missing 0)
         (born-base 0)
         (born-extras 0))
    (set! (-> centre quad) (-> (if live (-> live root trans) (-> ent extra trans)) quad))
    (dotimes (i base-total)
      (when (not (handle->process (-> horde clones i)))
        (cond
          ((<= room 0) (+! missing 1))
          ((gauntlet-horde-slot-born! horde i centre (* (/ (degrees 360) (the float base-total)) (the float i)) GAUNTLET_HORDE_RING_RADIUS)
           (+! born-base 1)
           (+! room -1))
          (else (+! missing 1)))))
    (dotimes (i extras-total)
      (let ((slot (+ GAUNTLET_HORDE_MAX_CLONES i)))
        (when (not (handle->process (-> horde clones slot)))
          (cond
            ((<= room 0) (+! missing 1))
            ((gauntlet-horde-slot-born! horde slot centre (+ (degrees 45) (* (degrees 90) (the float i))) GAUNTLET_HORDE_EXTRA_RADIUS)
             (+! born-extras 1)
             (+! room -1))
            (else (+! missing 1))))))
    (if (> missing 0)
      (format 0 "GAUNTLET HORDE ~S mayhem capped: ~D clones did not fit (~D alive, cap ~D)~%"
              (res-lump-struct ent 'name string) missing *gauntlet-horde-clones* *gauntlet-horde-max-clones*))
    (if (> (+ born-base born-extras) 0)
      (begin
        (format 0 "GAUNTLET HORDE ~S mayhem +~D clones +~D extras" (res-lump-struct ent 'name string) born-base born-extras)
        (format 0 " around (~M, ~M, ~M), where the ~A stands~%" (-> centre x) (-> centre y) (-> centre z) (if live "live one" "original was placed")))))
  0)

(defun gauntlet-horde-misty-watch? ((horde gauntlet-horde))
  "True when horde is Misty's and clones could still come to it: the muse is a state of the island, and with her loose a lurker is owed its
   normal clones and the extras (with her caught it is owed none)."
  (and (= (-> horde level-name) 'misty)
       *gauntlet-misty-muse-enabled*
       (or (> (gauntlet-horde-base-asked) 0) (> (gauntlet-horde-extras-asked) 0))))

(defun gauntlet-horde-mayhem-poll! ((horde gauntlet-horde))
  "Per-frame, for a group of Misty's. With the muse setting on: all its clones go the moment the muse is with Jak, and come, once, the moment
   she is loose. With it off Misty is a level like the rest, and only the extras go."
  (when (= (-> horde level-name) 'misty)
    (cond
      ((not *gauntlet-misty-muse-enabled*) (gauntlet-horde-calm! horde #f))
      ((gauntlet-muse-loose?)
       (if (!= (-> horde episode) *gauntlet-muse-episode*) (gauntlet-horde-mayhem! horde)))
      (else (gauntlet-horde-calm! horde #t))))
  0)

(defstate gauntlet-horde-watch (gauntlet-horde)
  :code
    (behavior ()
      (loop
        (cond
          ((gauntlet-horde-level-left?)
           (gauntlet-horde-remove-clones)
           ;; the actor's name is in the level's memory, which is going: the level is named instead
           (format 0 "GAUNTLET HORDE ~A clones culled (level unloaded)~%" (-> self level-name))
           (deactivate self))
          ((and (zero? (gauntlet-horde-live-clones self))
                (not (and (gauntlet-horde-misty-watch? self) (handle->process (-> self original)))))
           (format 0 "GAUNTLET HORDE ~S watcher done (no clone left)~%" (gauntlet-horde-name))
           (deactivate self))
          ((gauntlet-horde-walked-away?)
           (gauntlet-horde-remove-clones)
           (format 0 "GAUNTLET HORDE ~S clones culled (the original was culled, Jak walked away)~%" (gauntlet-horde-name))
           (deactivate self))
          (else (gauntlet-horde-mayhem-poll! self)))
        (suspend))))

(defbehavior gauntlet-horde-init-by-other gauntlet-horde ((ent entity-actor) (original handle))
  "Watch over the clones of the actor ent, whose own process original names. The clones are put in by the one who spawned us."
  (set! (-> self ent) ent)
  (set! (-> self original) original)
  (set! (-> self level-name) (-> ent extra level name))
  (set! (-> self episode) 0)
  (dotimes (i GAUNTLET_HORDE_SLOTS)
    (set! (-> self clones i) (the-as handle #f)))
  (go gauntlet-horde-watch)
  (none))

(defun gauntlet-horde-lurker? ((proc process))
  "Whether proc, the process an actor was just born as, is one that gets company: anything on the nav mesh, but the few whose
   story lives in the original. The cannon babak has its cannon, the ram boss its fight, the muse and the lightning moles
   are caught for a power cell the task counts (a mole's task is counted through the actor's links), the sharkey reads the
   actor's own spot every time it comes up so a clone would rise at the original's, and the double lurker marks the actor's
   permanent record and carries a buddy of its own."
  (and (type-type? (-> proc type) nav-enemy)
       (case (-> proc type symbol)
         (('babak-with-cannon 'ram-boss 'muse 'lightning-mole 'sharkey 'double-lurker) #f)
         (else #t))))

(defun gauntlet-horde-clone! ((ent entity-actor) (spot vector))
  "Born one more process of the actor ent's type, standing at spot, and hand back a handle to it, or a null handle when there
   is no process to be had or it died in its own init. This is init-entity (engine/entity/entity.gc) without its two links:
   the process is put in *entity-pool* and given the entity, so the engine's level sweep finds it, but (-> ent extra process)
   is not set, so it stays the original.
   The actor's spot is lent: init-from-entity! reads the process's position from the entity (process-drawable-from-entity!),
   and a nav enemy finds its nav poly at init, so the position must be right then, not moved to afterward. run-now-in-process
   returns only when init is done (or has changed state, or died), and nothing else runs meanwhile, so the loan is
   given back before anyone can see it. The only other reader of the spot is the entity system's own distance test, which is
   not run in the middle of an init."
  (let* ((kind (-> ent etype))
         (info (entity-info-lookup kind))
         (fresh (get-process *default-dead-pool* kind (if info (-> info heap-size) #x4000))))
    (if (not fresh) (return (the-as handle #f)))
    (set! (-> fresh type) kind)
    (activate fresh *entity-pool* (res-lump-struct ent 'name basic) *scratch-memory-top*)
    (set! (-> fresh entity) ent)
    (let ((born (process->handle fresh))
          (home (new 'stack-no-clear 'vector)))
      (set! (-> home quad) (-> ent extra trans quad))
      (set! (-> ent extra trans quad) (-> spot quad))
      (run-now-in-process fresh (method-of-object fresh init-from-entity!) fresh ent)
      (set! (-> ent extra trans quad) (-> home quad))
      ;; whatever the actor drops is the original's: a clone drops pills as an ice cube of the beach does, and never the
      ;; actor's power cell or special pickup. The pickup is made from the actor's lumps in init-defaults!, which has run.
      (let* ((alive (handle->process born))
             (nav (if alive (as-type alive nav-enemy))))
        (when (and nav (nonzero? (-> nav enemy-info)))
          (set! (-> nav enemy-info pickup-type) (pickup-type eco-pill-random))
          (set! (-> nav enemy-info pickup-amount) (-> *FACT-bank* default-pill-inc))
          (logclear! (-> nav enemy-info options) (fact-options has-power-cell))))
      born)))

(defun gauntlet-horde-born! ((ent entity-actor))
  "The actor ent has just been born (the entity system's hook, below). If it came up as a lurker that gets company, and its
   story is not already finished (a babak that gives its power cell back is not to be multiplied), spawn the watcher and
   the clones on a ring around it, the first straight along the z axis, and say so. The multiplier asks for some clones; the
   cap on the live ones, counted afresh, says how many fit, possibly none, and then there is no watcher either.
   One of Misty's, with the muse setting on, is owed its company by the muse and not by the multiplier alone: it gets a watcher whether or
   not any clone is due, and the watcher brings the company when she is loose (at birth too, here) and takes it away when she is with Jak."
  (let* ((original (-> ent extra process))
         (asked (gauntlet-horde-base-asked))
         (misty (and *gauntlet-misty-muse-enabled*
                     (= (-> ent extra level name) 'misty)
                     (or (> asked 0) (> (gauntlet-horde-extras-asked) 0)))))
    (when (and original
               (or (> asked 0) misty)
               (not (logtest? (-> ent extra perm status) (entity-perm-status complete)))
               (gauntlet-horde-lurker? original))
      (gauntlet-horde-recount!)
      (let* ((name (res-lump-struct ent 'name string))
             (room (max 0 (- *gauntlet-horde-max-clones* *gauntlet-horde-clones*)))
             ;; Misty's normal clones are the muse's to bring (gauntlet-horde-mayhem!), not born here
             (wanted (if misty 0 (min asked room))))
        (if (and (not misty) (< wanted asked))
          (format 0 "GAUNTLET HORDE ~S capped: ~D of ~D clones asked for fit (~D alive, cap ~D)~%"
                  name wanted asked *gauntlet-horde-clones* *gauntlet-horde-max-clones*))
        (when (or (> wanted 0) misty)
          (let ((watcher (process-spawn gauntlet-horde :init gauntlet-horde-init-by-other ent (process->handle original) :to *entity-pool*)))
            (when watcher
              (let ((horde (-> watcher 0))
                    (home (new 'stack-no-clear 'vector))
                    (spot (new 'stack-no-clear 'vector))
                    (step (/ (degrees 360) (the float (max wanted 1))))
                    (born 0))
                (set! (-> home quad) (-> ent extra trans quad))
                ;; a clone is tried only if every one before it was born: the first that is not ends the line
                (dotimes (i wanted)
                  (when (= born i)
                    (let ((angle (* step (the float i))))
                      (set! (-> spot x) (+ (-> home x) (* GAUNTLET_HORDE_RING_RADIUS (sin angle))))
                      (set! (-> spot y) (-> home y))
                      (set! (-> spot z) (+ (-> home z) (* GAUNTLET_HORDE_RING_RADIUS (cos angle))))
                      (set! (-> spot w) 1.0))
                    (let ((twin (gauntlet-horde-clone! ent spot)))
                      (when (handle->process twin)
                        (set! (-> horde clones born) twin)
                        (+! born 1)))))
                (if (< born wanted)
                  (format 0 "GAUNTLET HORDE ~S wanted +~D clones and no process was free for the rest~%" name wanted))
                ;; the muse loose: the company is born with the lurker, so one that comes up in the mayhem arrives in it
                (if (and misty (gauntlet-muse-loose?)) (gauntlet-horde-mayhem! horde))
                (cond
                  ((> born 0) (format 0 "GAUNTLET HORDE ~S ~A +~D clones~%" name (-> original type) born))
                  (misty)
                  (else (deactivate horde))))))))))
  (none))

;; ------------------------------------------------------- the scout fly boxes --

;; The scout fly boxes (crate-buzzer, engine/common-obs/crates.gc) that the table names each want an eco to open, in the mod's
;; language: the box wears the colour of the eco it wants, and a plain attack on it does nothing it did not do before. A box the table
;; does not name is an ordinary scout fly box, opened as the game made it. A named box opens only when Jak breaks it
;; (the attacks the game already lets break an iron crate, so a steel box would still need its steel attack) while he carries that
;; eco:
;;   blue, red, green  Jak carries that eco (his fact's eco type and an eco level above 0: the same test as the crates' own blue-eco query)
;;   yellow      the same, or the attack is a yellow eco shot, which counts as the eco it is made of
;; Green is carried only on the zoomer, and only after a green vent: on foot green eco is health and is never carried, but while Jak races
;; pickup-collectable! of fact-info-target sends a green vent's eco down the same path as the other three (game-info.gc, "green eco vents
;; power-up when racing"), so his fact reads green with a timer. The basin (rolling) has one green vent (ecovent-242), which is why green
;; boxes are there and nowhere else.
;; Wrong eco, or none: the box refuses. It does not break, bounces as it does for an attack it cannot break, throws Jak back a
;; little (a 'shove, which costs no health, the game's own bounce off a wall) and flashes a burst of its own colour, so the player
;; learns the rule from the box. Only Jak's own attacks and yellow shots are asked: a boulder of Klaww's, a cannon sack or a bomb
;; breaks it as it always did. Blue eco already pulls crates open (notice-blue, crates.gc): that is kept for a blue box, and a box
;; of another colour is simply not pulled, so a blue-charged Jak walking by does not break it. The game asks through
;; *crate-attack-gate-hook* (crates.gc), only on the paths that would break the crate, so nothing else about a crate changes.
;; Nothing here may have a side effect on a path the 'query 'pickup of pckernel.gc reaches (it calls pickup-collectable! with an
;; amount of 0 every frame): the gate reads Jak's fact directly and never asks him anything.
;;
;; Where the eco comes from: free eco the game itself placed in the level (a vent, a cluster of pickups, a crate with eco in it) or a
;; carrier, a lurker. The mod places none of its own. The second table names the carriers of a box: the crabs, puppies, bunnies, hoppers, rats and bonelurkers placed nearest to it,
;; at most two. A carrier glows its colour and trails the aura of Jak's eco of it, and when it dies it spills a pickup of that eco
;; where it fell. A carrier only looks and spills: the babak's blue pace and red shove live in fields of its type and a copy of its
;; enemy info (babak.gc), which the others do not have and would need each their own surgery, and for the same reason babaks, already
;; charged in their own right, are never carriers. The eco Jak picks up times out, which is why a source must be near its box.
;;
;; The spill is one-off: the pickup is made with fact-options one-off, which the eco's die state (collectables.gc) reads, so that it is
;; gone for good once picked up. Without it the game brings an eco pickup born again at the spot it fell as soon as Jak's own eco of
;; that kind has run out (so that a placed vent or cluster can never strand a player), and a spill would have come back each time
;; its charge ended. The stranding that would otherwise be left (a wasted spill, and a carrier that stays dead until the level loads,
;; like every lurker) is answered by bringing the carrier back instead: *gauntlet-carrier-return* after it died, while its box is still
;; closed, a charged clone of it is born at the spot it was placed at, with a puff of its colour, and it spills again when it dies. A
;; clone and not the entity's own return, because the entity system would bring the original back with a fresh horde of company and
;; only when Jak is near, and the delay would be the entity's to keep; a clone is gauntlet-horde-clone!, which the mod already trusts,
;; and is the watcher's own to time. Once the box is open nothing returns.
;;
;; Both tables are keyed by level and entity name, and generated offline from the decompiler's actor lists by a script
;; (decompiler_out/jak1/entities/*-actors.json: a buzzer crate is a crate whose eco-info lump has type 8). The rules it applied:
;;   - Geyser Rock (training): every box is blue, from the game's own blue eco there (the vent before the door and the blue singles on the
;;     way); the model of reach below is only a report on Geyser Rock and excludes nothing.
;;   - Elsewhere a box takes a colour only if it has a source near it. A source is free eco of that colour (an unblocked vent, a cluster of
;;     singles, a crate with eco in it) or a carrier. "Near" comes from how long eco lasts (*FACT-bank*: a single lasts 5 s, the most any
;;     pickups add up to is 20 s, which a vent gives at once) and Jak's run speed (10 m/s, *walk-mods*), taking 8 m/s of it and keeping
;;     1.5 s back to line up the attack: a vent reaches 148 m, two singles 68 m, one single 28 m, and free eco counts only within 85
;;     percent of that. A carrier's spill is one single, so its placed spot may be that 28 m away plus the distance at which it notices Jak
;;     and can be led to the box (25 m for a crab, 30 m for the others): 53 or 58 m, box to carrier, placed spot. Green has no carriers: a
;;     carrier's spill is a pickup, and a green pickup on foot is health, so green is the basin's green vent alone.
;;   - Zoomer levels (rolling, firecanyon, ogre, lavatube): the zoomer breaks a box through this same path (the crate's 'racer
;;     attack, sent by Jak's own process, so the gate is asked), and his fact is set there for yellow, red and green; but blue eco is
;;     turned into a boost by the zoomer's event handler and never carried, so those levels have no blue box.
;;   - The colours of a level are dealt so that the most boxes get one with a source, then as evenly as the sources allow, then the nearer
;;     sources first. Sentinel Beach keeps the hand-made rows of the first version for its five boxes that were not green.
;;   - A box that no colour reaches has no row and is an ordinary scout fly box: the game's own rule opens it.
;; Every buzzer crate that is born is logged with its name and place, whatever its level, so that a table row is easy to check.

(defconstant GAUNTLET_FLYBOX_LIFT (meters 0.75)) ;; the middle of a box, above its base
(defconstant GAUNTLET_FLYBOX_SHOVE_UP (meters 1.5)) ;; how high a refusal throws Jak
(defconstant GAUNTLET_FLYBOX_REFUSE_BURSTS 8) ;; bursts of a box's colour when it refuses
(defconstant GAUNTLET_FLYBOX_SPILL_BURSTS 10) ;; and of a carrier's when it spills
(defconstant GAUNTLET_FLYBOX_SCATTER (meters 1.2)) ;; the bursts of a box or a spill are scattered this far around its middle

(defmacro gauntlet-flybox-table (join row)
  "Expand row once per box, (row level name eco): the buzzer crate named name of level wants eco (red, blue, yellow or green). A box with no row is an
   ordinary scout fly box."
  `(,join
     ;; beach
     (,row beach "crate-213" blue)
     (,row beach "crate-2467" blue)
     (,row beach "crate-646" yellow)
     (,row beach "crate-647" red)
     (,row beach "crate-648" blue)
     (,row beach "crate-649" yellow)
     (,row beach "crate-651" red)
     ;; citadel
     ;; crate-2996: no eco in reach, an ordinary scout fly box
     (,row citadel "crate-2997" red)
     ;; crate-2998: no eco in reach, an ordinary scout fly box
     (,row citadel "crate-2999" blue)
     (,row citadel "crate-3000" blue)
     (,row citadel "crate-3001" blue)
     (,row citadel "crate-3002" yellow)
     ;; darkcave
     ;; crate-3022: no eco in reach, an ordinary scout fly box
     ;; firecanyon
     ;; crate-1019: no eco in reach, an ordinary scout fly box
     ;; crate-1027: no eco in reach, an ordinary scout fly box
     ;; crate-1028: no eco in reach, an ordinary scout fly box
     ;; crate-1029: no eco in reach, an ordinary scout fly box
     ;; crate-1030: no eco in reach, an ordinary scout fly box
     ;; crate-1032: no eco in reach, an ordinary scout fly box
     ;; crate-1033: no eco in reach, an ordinary scout fly box
     ;; jungle
     (,row jungle "crate-1844" blue)
     (,row jungle "crate-28" blue)
     (,row jungle "crate-3" blue)
     (,row jungle "crate-47" blue)
     (,row jungle "crate-58" blue)
     (,row jungle "crate-688" yellow)
     (,row jungle "crate-689" red)
     ;; lavatube
     ;; crate-3025: no eco in reach, an ordinary scout fly box
     ;; crate-3026: no eco in reach, an ordinary scout fly box
     (,row lavatube "crate-3027" yellow)
     ;; crate-3028: no eco in reach, an ordinary scout fly box
     ;; crate-3029: no eco in reach, an ordinary scout fly box
     (,row lavatube "crate-3117" yellow)
     ;; crate-3118: no eco in reach, an ordinary scout fly box
     ;; maincave
     (,row maincave "crate-2685" yellow)
     (,row maincave "crate-2689" yellow)
     (,row maincave "crate-2697" yellow)
     (,row maincave "crate-3018" yellow)
     ;; misty
     ;; crate-2560: no eco in reach, an ordinary scout fly box
     ;; crate-2561: no eco in reach, an ordinary scout fly box
     (,row misty "crate-659" yellow)
     ;; crate-672: no eco in reach, an ordinary scout fly box
     (,row misty "crate-673" blue)
     (,row misty "crate-684" red)
     ;; crate-747: no eco in reach, an ordinary scout fly box
     ;; ogre
     ;; crate-2430: no eco in reach, an ordinary scout fly box
     ;; crate-2989: no eco in reach, an ordinary scout fly box
     ;; crate-2990: no eco in reach, an ordinary scout fly box
     ;; crate-2991: no eco in reach, an ordinary scout fly box
     ;; crate-2992: no eco in reach, an ordinary scout fly box
     ;; crate-2993: no eco in reach, an ordinary scout fly box
     ;; crate-2994: no eco in reach, an ordinary scout fly box
     ;; robocave
     (,row robocave "crate-2779" yellow)
     (,row robocave "crate-2985" blue)
     ;; rolling
     (,row rolling "crate-2176" green)
     ;; crate-2187: no eco in reach, an ordinary scout fly box
     ;; crate-2188: no eco in reach, an ordinary scout fly box
     ;; crate-2194: no eco in reach, an ordinary scout fly box
     ;; crate-2199: no eco in reach, an ordinary scout fly box
     (,row rolling "crate-2209" green)
     ;; crate-2289: no eco in reach, an ordinary scout fly box
     ;; snow
     (,row snow "crate-1132" yellow)
     (,row snow "crate-1133" red)
     (,row snow "crate-1138" red)
     (,row snow "crate-3134" red)
     (,row snow "crate-975" blue)
     (,row snow "crate-976" blue)
     (,row snow "crate-980" yellow)
     ;; sunken
     (,row sunken "crate-917" blue)
     ;; crate-923: no eco in reach, an ordinary scout fly box
     ;; crate-925: no eco in reach, an ordinary scout fly box
     ;; crate-926: no eco in reach, an ordinary scout fly box
     ;; sunkenb
     (,row sunkenb "crate-2705" blue)
     ;; swamp
     (,row swamp "crate-2936" yellow)
     (,row swamp "crate-748" red)
     (,row swamp "crate-762" yellow)
     (,row swamp "crate-786" blue)
     (,row swamp "crate-787" blue)
