     (,row beach "lurkercrab-5" "crate-649" 39.3)
     (,row beach "lurkercrab-7" "crate-651" 47.3)
     (,row jungle "hopper-34" "crate-688" 32.6)
     (,row jungle "hopper-33" "crate-689" 39.0)
     (,row misty "bonelurker-21" "crate-659" 53.4)
     (,row misty "bonelurker-15" "crate-673" 18.9)
     (,row misty "bonelurker-26" "crate-684" 49.6)
     (,row misty "bonelurker-24" "crate-684" 51.6)
     (,row snow "snow-bunny-64" "crate-1132" 30.4)
     (,row snow "snow-bunny-63" "crate-1132" 39.4)
     (,row snow "snow-bunny-69" "crate-1133" 41.5)
     (,row snow "snow-bunny-68" "crate-1133" 46.9)
     (,row snow "snow-bunny-71" "crate-1138" 41.2)
     (,row snow "snow-bunny-114" "crate-3134" 51.3)
     (,row snow "snow-bunny-110" "crate-3134" 51.8)
