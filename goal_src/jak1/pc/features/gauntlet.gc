     (,row swamp "swamp-rat-24" "crate-843" 30.8)
     ))

(defmacro gauntlet-row-flybox-eco (level name eco)
  `(when (and (= at-level (quote ,level)) (string= at-name ,name))
     (return (gauntlet-eco ,eco))))

(defun gauntlet-flybox-eco ((at-level symbol) (at-name string))
  "The eco the box named at-name of level at-level wants, or none when the table does not know it."
  (gauntlet-flybox-table begin gauntlet-row-flybox-eco)
  (gauntlet-eco none))

(defmacro gauntlet-row-carrier-box (level lurker box distance)
  `(when (and (= at-level (quote ,level)) (string= at-name ,lurker))
     (return ,box)))

(defun gauntlet-carrier-box ((at-level symbol) (at-name string))
  "The name of the box the lurker named at-name of level at-level carries the eco of, or #f when it carries nothing."
  (gauntlet-carrier-table begin gauntlet-row-carrier-box)
  (the-as string #f))

(defun gauntlet-eco-pickup ((eco gauntlet-eco))
  "The pickup the game makes of an eco."
  (case eco
    (((gauntlet-eco red)) (pickup-type eco-red))
    (((gauntlet-eco blue)) (pickup-type eco-blue))
    (((gauntlet-eco yellow)) (pickup-type eco-yellow))
    (((gauntlet-eco green)) (pickup-type eco-green))
    (else (pickup-type none))))

(defun gauntlet-flybox-met? ((eco gauntlet-eco) (mode symbol))
  "True when Jak meets what a box wanting eco asks: he carries it (green only on the zoomer), or a yellow shot hits a yellow box.
   Reads his fact, asks nothing."
  (let ((fact (-> *target* fact)))
    (cond
      ((and (= eco (gauntlet-eco yellow)) (= mode 'eco-yellow)) #t)
      (else (and (= (-> fact eco-type) (gauntlet-eco-pickup eco)) (< 0.0 (-> fact eco-level)))))))

(defun gauntlet-flybox-eco-of ((box crate))
  "The eco box wants: its table row when it is a scout fly box with an entity, else none."
  (if (and (-> box entity) (type-type? (-> box type) crate-buzzer))
    (gauntlet-flybox-eco (-> box entity extra level name) (res-lump-struct (-> box entity) 'name string))
    (gauntlet-eco none)))

(defun gauntlet-eco-scatter! ((centre vector) (kind gauntlet-eco))
  "One burst of kind's eco, the flash and the spark each at a random spot around centre."
  (let ((flash (new 'stack-no-clear 'vector))
        (spark (new 'stack-no-clear 'vector)))
    (set-vector! flash
                 (+ (-> centre x) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre y) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre z) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 1.0)
    (set-vector! spark
                 (+ (-> centre x) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre y) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre z) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 1.0)
    (gauntlet-eco-burst-at! kind flash spark))
  (none))

(defun gauntlet-flybox-bounce! ((box crate) (jak process))
  "Throw Jak back off the box with a 'shove (no damage), away along the ground, or backwards from his facing when right over it."
  (let ((away (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> box root trans))))
    (set! (-> away y) 0.0)
    (when (< (vector-xz-length away) 40.96)
      (vector-z-quaternion! away (-> *target* control quat-for-control))
      (vector-negate! away away)
      (set! (-> away y) 0.0))
    (vector-xz-normalize! away *gauntlet-flybox-bounce*)
    (set! (-> away y) GAUNTLET_FLYBOX_SHOVE_UP)
    (send-event jak 'shove #f (static-attack-info ((shove-up GAUNTLET_FLYBOX_SHOVE_UP) (shove-back *gauntlet-flybox-bounce*) (vector away)))))
  0)

(defconstant GAUNTLET_FLYBOX_RACER_GAP (seconds 0.75)) ;; the zoomer is told a box refuses it at most this often
(define *gauntlet-racer-refused* (the-as time-frame 0)) ;; when a box last refused the zoomer

(defun gauntlet-flybox-fresh-refusal? ((box crate) (mode symbol) (id uint))
  "True when this refusal is news. A spin or flop hits a crate on several frames under one attack id; the zoomer's ram sends id 0
   every frame, so it is rate-limited by GAUNTLET_FLYBOX_RACER_GAP across all boxes."
  (cond
    ((= mode 'racer)
     (when (time-elapsed? *gauntlet-racer-refused* GAUNTLET_FLYBOX_RACER_GAP)
       (set-time! *gauntlet-racer-refused*)
       #t))
    (else (!= id (-> box incomming-attack-id)))))

(defun gauntlet-flybox-refuse! ((box crate) (eco gauntlet-eco) (attacker process) (mode symbol) (id uint))
  "The box refuses an attack that would break it: a burst of its colour and, for Jak on foot, a bounce. Once per attack.
   No bounce for the zoomer: a 'shove sent to a racing Jak is not the walking one."
  (when (gauntlet-flybox-fresh-refusal? box mode id)
    (let ((middle (new 'stack-no-clear 'vector)))
      (set! (-> middle quad) (-> box root trans quad))
      (+! (-> middle y) GAUNTLET_FLYBOX_LIFT)
      (dotimes (i GAUNTLET_FLYBOX_REFUSE_BURSTS)
        (gauntlet-eco-scatter! middle eco)))
    (if (and (= (-> attacker type) target) (!= mode 'racer)) (gauntlet-flybox-bounce! box attacker)))
  (none))

(defun *crate-attack-gate-hook* ((box crate) (attacker process) (mode symbol) (id uint))
  "The game is about to let attacker break box with mode (or let Jak's blue eco pull it open): true if it may.
   Only table boxes ask, and only of Jak's attacks and yellow shots."
  (let ((eco (if (and *gauntlet-flybox-enabled* *target*) (gauntlet-flybox-eco-of box) (gauntlet-eco none))))
    (cond
      ((= eco (gauntlet-eco none)) #t)
      ((= mode 'eco-blue) (= eco (gauntlet-eco blue)))
      ((not (or (= (-> attacker type) target) (= mode 'eco-yellow))) #t)
      ((gauntlet-flybox-met? eco mode)
       #t)
      (else
       (gauntlet-flybox-refuse! box eco attacker mode id)
       #f))))

;; One watcher per box and per carrier: keeps the colour on and, for a carrier, spills when the lurker dies (state nav-enemy-die).
;; A carrier that is simply gone (culled when Jak walked away, or a death cleared the pool) spilled nothing and is born again
;; with a new watcher by the same hook. Like the horde's watcher, it reads the entity's name only while its level is running.
(deftype gauntlet-eco-watch (process)
  ((ent         entity-actor)
   (subject     handle) ;; the box or the lurker; null while a dead carrier waits to come back
   (eco         gauntlet-eco)
   (carrier     symbol) ;; true for a lurker, false for a box
   (level-name  symbol)
   (back-at     time-frame)) ;; carrier only: when it comes back; 0 while it is here
  (:states
   gauntlet-eco-watch-run))

(defbehavior gauntlet-eco-watch-name gauntlet-eco-watch ()
  "The subject's name from its entity; only call while its level is active."
  (res-lump-struct (-> self ent) 'name string))

(defbehavior gauntlet-eco-watch-show! gauntlet-eco-watch ((pd process-drawable))
  "One frame of colour: a carrier gets the eco aura; a box glows and flares at random about its middle."
  (cond
    ((-> self carrier) (gauntlet-eco-aura! pd (-> self eco)))
    ((not (logtest? (-> pd draw status) (draw-status hidden no-anim)))
     (gauntlet-eco-glow! pd (-> self eco))
     (when (rand-vu-percent? 0.5)
       (let ((middle (new 'stack-no-clear 'vector)))
         (set! (-> middle quad) (-> pd root trans quad))
         (+! (-> middle y) GAUNTLET_FLYBOX_LIFT)
         (gauntlet-eco-scatter! middle (-> self eco))))))
  0)

(defbehavior gauntlet-eco-watch-calm! gauntlet-eco-watch ((pd process-drawable))
  "The setting is off: the subject is plain again."
  (when pd
    (set-vector! (-> pd draw color-mult) 1.0 1.0 1.0 1.0)
    (set-vector! (-> pd draw color-emissive) 0.0 0.0 0.0 0.0))
  0)

(defbehavior gauntlet-eco-watch-spill! gauntlet-eco-watch ((pd process-drawable))
  "The carrier is dying: its eco spills as a pickup where it fell, with a flare. (Red also triggers the red eco hint once.)"
  (let ((where (new 'stack-no-clear 'vector)))
    (set! (-> where quad) (-> pd root trans quad))
    (+! (-> where y) GAUNTLET_FLYBOX_LIFT)
    (dotimes (i GAUNTLET_FLYBOX_SPILL_BURSTS)
      (gauntlet-eco-scatter! where (-> self eco)))
    ;; the fact-info only carries the option; birth-pickup-at-point copies it into the pickup, which the die state reads
    (birth-pickup-at-point where (gauntlet-eco-pickup (-> self eco)) (-> *FACT-bank* eco-single-inc) #t *entity-pool*
                           (new 'static 'fact-info :options (fact-options one-off))))
  0)

(defbehavior gauntlet-eco-watch-box-closed? gauntlet-eco-watch ()
  "True when the box this carrier carries the eco of is still closed (user-int8 0 of its entity, set by crates.gc on break).
   A box the level does not know counts as open."
  (let* ((box (gauntlet-carrier-box (-> self level-name) (gauntlet-eco-watch-name)))
         (ent (if box (entity-by-name box))))
    (and ent (zero? (-> ent extra perm user-int8 0)))))

(defbehavior gauntlet-eco-watch-await-return! gauntlet-eco-watch ()
  "The carrier just died and spilled. If its box is closed and the setting allows, wait *gauntlet-carrier-return* for it to come back; else finish."
  (cond
    ((and (< 0 *gauntlet-carrier-return*) (gauntlet-eco-watch-box-closed?))
     (set! (-> self subject) (the-as handle #f))
     (set! (-> self back-at) (+ (current-time) *gauntlet-carrier-return*)))
    (else
     (deactivate self)))
  0)

(defbehavior gauntlet-eco-watch-return! gauntlet-eco-watch ()
  "The dead carrier's time is up and its box is closed: a charged clone is born where it was placed, with a puff.
   Tries again in a second when no process is free."
  (let ((home (new 'stack-no-clear 'vector)))
    (set! (-> home quad) (-> self ent extra trans quad))
    (set! (-> home w) 1.0)
    (let* ((twin (gauntlet-horde-clone! (-> self ent) home))
           (born (handle->process twin))
           (pd (if born (as-type born process-drawable))))
      (cond
        (pd
         (gauntlet-eco-glow! pd (-> self eco))
         (+! (-> home y) GAUNTLET_FLYBOX_LIFT)
         (dotimes (i GAUNTLET_FLYBOX_SPILL_BURSTS)
           (gauntlet-eco-scatter! home (-> self eco)))
         (set! (-> self subject) twin)
         (set! (-> self back-at) 0))
        (else
         (set! (-> self back-at) (+ (current-time) (seconds 1)))))))
  0)

(defstate gauntlet-eco-watch-run (gauntlet-eco-watch)
  :code
    (behavior ()
      (loop
        (let* ((proc (handle->process (-> self subject)))
               (pd (if proc (as-type proc process-drawable))))
          (cond
            ((!= (level-status *level* (-> self level-name)) 'active)
             (deactivate self))
            ((not *gauntlet-flybox-enabled*)
             (gauntlet-eco-watch-calm! pd)
             (if (not pd) (deactivate self)))
            ((nonzero? (-> self back-at))
             (cond
               ((not (gauntlet-eco-watch-box-closed?))
                (deactivate self))
               ((>= (current-time) (-> self back-at)) (gauntlet-eco-watch-return!))))
            ((not pd)
             (deactivate self))
            ((and (-> self carrier)
                  (-> pd next-state)
                  (= (-> pd next-state name) 'nav-enemy-die))
             (gauntlet-eco-watch-spill! pd)
             (gauntlet-eco-watch-await-return!))
            (else (gauntlet-eco-watch-show! pd))))
        (suspend))))

(defbehavior gauntlet-eco-watch-init-by-other gauntlet-eco-watch ((ent entity-actor) (subject handle) (eco gauntlet-eco) (carrier symbol))
  "Watch subject, the process ent was just born as, keeping it wearing eco."
  (set! (-> self ent) ent)
  (set! (-> self subject) subject)
  (set! (-> self eco) eco)
  (set! (-> self carrier) carrier)
  (set! (-> self back-at) 0)
  (set! (-> self level-name) (-> ent extra level name))
  (go gauntlet-eco-watch-run)
  (none))

(defun gauntlet-flybox-box-born! ((ent entity-actor) (proc process-drawable) (level-name symbol))
  "A buzzer crate was born: if the table gives it an eco and it is not open, colour and watch it."
  (let* ((name (res-lump-struct ent 'name string))
         (eco (gauntlet-flybox-eco level-name name)))
    (when (and (!= eco (gauntlet-eco none)) (zero? (-> ent extra perm user-int8 0)))
      (gauntlet-eco-glow! proc eco)
      (process-spawn gauntlet-eco-watch :init gauntlet-eco-watch-init-by-other ent (process->handle proc) eco #f :to *entity-pool*)))
  0)

(defun gauntlet-flybox-carrier-born! ((ent entity-actor) (proc process-drawable) (level-name symbol))
  "A nav enemy was born: if the table names it a carrier and it is not dead, colour it with its box's eco and watch it."
  (let* ((name (res-lump-struct ent 'name string))
         (box (gauntlet-carrier-box level-name name)))
    (when box
      (let ((eco (gauntlet-flybox-eco level-name box)))
        (when (and (!= eco (gauntlet-eco none)) (not (logtest? (-> ent extra perm status) (entity-perm-status complete))))
          (gauntlet-eco-glow! proc eco)
          (process-spawn gauntlet-eco-watch :init gauntlet-eco-watch-init-by-other ent (process->handle proc) eco #t :to *entity-pool*)))))
  0)

(defun gauntlet-flybox-born! ((ent entity-actor))
  "Called for each born actor (the hook below): a buzzer crate is a box, a nav enemy may be a carrier. Names are read only for those."
  (let* ((proc (-> ent extra process))
         (pd (if proc (as-type proc process-drawable))))
    (when pd
      (cond
        ((type-type? (-> pd type) crate-buzzer) (gauntlet-flybox-box-born! ent pd (-> ent extra level name)))
        ((type-type? (-> pd type) nav-enemy) (gauntlet-flybox-carrier-born! ent pd (-> ent extra level name))))))
  (none))

;; ------------------------------------------------------------------ the temple --

;; The floating platforms of the Forbidden Jungle temple (level jungleb) are removed: the temple is crossed on boosted and roll jumps.
;; They are listed in a table and refused at birth by *entity-birth-veto-hook* (entity.gc), so no process is made. The actors stay,
;; so actor-link-info loses no neighbour, and the veto is asked again at each birth. plat-flip, launchers and the elevator stay.
(defmacro gauntlet-temple-table (join row)
  "Expand row once per platform, (row level name): that actor of level is not born."
  `(,join
     (,row jungleb "plat-77")
     (,row jungleb "plat-79")
     (,row jungleb "plat-80")
     (,row jungleb "plat-81")
     (,row jungleb "plat-82")
     (,row jungleb "plat-83")
     (,row jungleb "plat-84")
     (,row jungleb "plat-85")
     (,row jungleb "plat-86")
     (,row jungleb "plat-87")))

(defmacro gauntlet-row-temple-platform (level name)
  `(when (and (= at-level (quote ,level)) (string= at-name ,name))
     (return #t)))

(defun gauntlet-temple-platform? ((at-level symbol) (at-name string))
  "Whether the actor named at-name of level at-level is one of the temple's floating platforms."
  (gauntlet-temple-table begin gauntlet-row-temple-platform)
  #f)

(defun *entity-birth-veto-hook* ((ent entity-actor))
  "Asked before each actor is born: true for a temple platform while the setting removes them. The level is checked first,
   since every actor of every level comes through here."
  (let ((level-name (-> ent extra level name)))
    (when (and *gauntlet-fj-temple-platforms-removed* (= level-name 'jungleb))
      (let ((name (res-lump-struct ent 'name string)))
        (when (gauntlet-temple-platform? level-name name)
          (return #t)))))
  #f)

;; entity.gc calls this after birth! has run for an actor
(defun *entity-born-hook* ((ent entity-actor))
  (gauntlet-horde-born! ent)
  (gauntlet-flybox-born! ent)
  (none))

(defconstant GAUNTLET_LURKER_TINT_FRAMES 6) ;; frames between tint renewals while the world is turning (5 times a second)

;; Mayhem lurkers: while the blend is up, a sweep of the entity pool every few frames pushes each Misty nav enemy toward violet
;; through its color-mult and color-emissive. Skipped: charged babaks (babak.gc), carriers (their box glows with them), the muse
;; and the sharkey. When the blend returns to nothing one last sweep makes them plain. The callback reads globals because a
;; lambda has no captures.
(define *gauntlet-lurker-tint* 0.0) ;; the blend the sweep paints with
(define *gauntlet-lurker-tint-countdown* 0)
(define *gauntlet-lurker-tint-lit* #f) ;; the last sweep painted a tint, so one that paints none is owed

(defun gauntlet-lurker-tint-one! ((proc process))
  "Paint proc with *gauntlet-lurker-tint* of violet if it is a Misty lurker wearing no eco."
  (let ((nav (as-type proc nav-enemy)))
    (when (and nav
               (-> nav entity)
               (= (-> nav entity extra level name) 'misty)
               (!= (-> nav type symbol) 'muse)
               (!= (-> nav type symbol) 'sharkey)
               (not (gauntlet-babak-charged? nav))
               (not (gauntlet-carrier-box 'misty (res-lump-struct (-> nav entity) 'name string))))
      (let ((b *gauntlet-lurker-tint*))
        (set-vector! (-> nav draw color-mult) (lerp 1.0 0.75 b) (lerp 1.0 0.45 b) (lerp 1.0 0.85 b) 1.0)
        (set-vector! (-> nav draw color-emissive) (* 0.2 b) 0.0 (* 0.12 b) 0.0))))
  (none))

(defun gauntlet-lurker-tint-poll! ()
  "Per-frame: while the mood is tinted, renew the lurkers' violet every GAUNTLET_LURKER_TINT_FRAMES; when it ends, take it away in one
   last sweep (not while Misty is going: its entities are not to be read)."
  (let ((blend (* *gauntlet-mayhem-blend* *gauntlet-misty-mayhem-atmosphere*)))
    (cond
      ((< 0.001 blend)
       (+! *gauntlet-lurker-tint-countdown* -1)
       (when (>= 0 *gauntlet-lurker-tint-countdown*)
         (set! *gauntlet-lurker-tint-countdown* GAUNTLET_LURKER_TINT_FRAMES)
         (set! *gauntlet-lurker-tint* blend)
         (set! *gauntlet-lurker-tint-lit* #t)
         (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-lurker-tint-one! proc) (none)) *null-kernel-context*)))
      (*gauntlet-lurker-tint-lit*
       (set! *gauntlet-lurker-tint-lit* #f)
       (set! *gauntlet-lurker-tint-countdown* 0)
       (when (gauntlet-misty-active?)
         (set! *gauntlet-lurker-tint* 0.0)
         (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-lurker-tint-one! proc) (none)) *null-kernel-context*)))))
  0)

;; --------------------------------------------------------- the muse's body --

;; Catching the muse is the game's (muse.gc: cell, cutscene, gone); an icon (below) shows she is Jak's. Dropping her makes a new muse
;; with gauntlet-horde-clone!, on her path where Jak lost her (*gauntlet-muse-start*), loose for GAUNTLET_MUSE_GRACE, then catchable
;; again (muse-caught tells the first catch, which closes the task, from later ones). The game's muse is gone by then and her actor
;; dead, so the entity system never brings her back. The new muse also stands at her home after a death on the first-catch visit.

(deftype gauntlet-muse-world (structure)
  ((muse handle) ;; the muse this mod made, until she is caught or put away
   (icon handle))) ;; the process that drives the icon and owns its picture

(define *gauntlet-muse-world* (new 'global 'gauntlet-muse-world))
(set! (-> *gauntlet-muse-world* muse) (the-as handle #f))
(set! (-> *gauntlet-muse-world* icon) (the-as handle #f))

(define *gauntlet-muse-entity* (the-as entity-actor #f)) ;; her actor, found while Misty is up, forgotten when it goes (its memory is the level's)

(defun gauntlet-muse-entity-find! ()
  "Her actor, muse-2 of Misty Island, found by name; #f when Misty is not up."
  (when (not *gauntlet-muse-entity*)
    (let ((found (entity-by-name "muse-2")))
      (if (and found (type-type? (-> found type) entity-actor))
        (set! *gauntlet-muse-entity* (the-as entity-actor found)))))
  *gauntlet-muse-entity*)

(defun gauntlet-muse-spawn! ((near-jak symbol))
  "Make a muse, loose: at her home when near-jak is #f, else on her path where Jak stands."
  (let ((ent (gauntlet-muse-entity-find!)))
    (cond
      ((not ent))
      (else
       (set! (-> *gauntlet-muse-start* w) 0.0)
       (when (and near-jak *target*)
         (set! (-> *gauntlet-muse-start* quad) (-> (target-pos 0) quad))
         (set! (-> *gauntlet-muse-start* w) 1.0))
       (let ((born (gauntlet-horde-clone! ent (-> ent extra trans))))
         (set! (-> *gauntlet-muse-start* w) 0.0)
         (set! (-> *gauntlet-muse-world* muse) born)))))
  0)

(defun gauntlet-muse-caught! ((kind symbol))
  "Called from the muse's state as Jak catches her: kind is 'first (the game's catch, the cell given) or 'again (the mod's new muse, nothing given)."
  (when (and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
    (gauntlet-muse-flip! #t))
  (none))

(defun gauntlet-muse-drop! ((why symbol))
  "Jak lost the muse: why is 'hit, 'death or a bonk name (*target-bonk-hook*). She pops out where he stands, unless he died:
   the poll below makes her at home. A second call in the same hit finds her loose already."
  (when (and *gauntlet-misty-muse-enabled* (gauntlet-muse-carried?) (gauntlet-misty-active?))
    (gauntlet-muse-flip! #f)
    (if (!= why 'death) (gauntlet-muse-spawn! #t)))
  (none))

;; The engine calls this with the bonk's name on each knock-back (target-handler.gc, target.gc, target2.gc): 'bonk-landing, 'bonk-fall,
;; 'bonk-wall-lunge, 'bonk-wall-roll and 'bonk-wall-roll-jump. Never an ordinary landing or a hop onto a platform.
(defun *target-bonk-hook* ((which symbol))
  (gauntlet-muse-drop! which)
  (none))

(defun gauntlet-muse-health-poll! ()
  "Per-frame, on Misty: a hit is a fall in Jak's health, or his last hit (the dying flag is set before death begins).
   Watching health sees every loss, which a hook in the hit state would not; invulnerable frames land no hit."
  (let ((health (if *target* (-> *target* fact health) -1.0)))
    (when (and *target* (gauntlet-muse-carried?))
      (cond
        ((or (logtest? (-> *target* state-flags) (state-flags dying)) (>= 0.0 health)) (gauntlet-muse-drop! 'death))
        ((and (<= 0.0 *gauntlet-muse-health*) (< health *gauntlet-muse-health*)) (gauntlet-muse-drop! 'hit))))
    (set! *gauntlet-muse-health* health))
  0)

(defun gauntlet-muse-body-poll! ()
  "Per-frame, on Misty, with the muse loose: if the game will not bring her back (actor dead, none standing) and the mod made none,
   make her at home. Never on a delivered visit: the game's muse was caught before Jak came."
  (let ((ent (gauntlet-muse-entity-find!)))
    (when (and ent
               *target*
               (not (gauntlet-muse-carried?))
               (not (gauntlet-muse-delivered?))
               (not (-> ent extra process))
               (logtest? (-> ent extra perm status) (entity-perm-status bit-0 dead))
               (not (handle->process (-> *gauntlet-muse-world* muse))))
      (gauntlet-muse-spawn! #f)))
  0)

;; ----------------------------------------------------------- the checkbox --

;; The hud shows MUSE and a box, only on Misty and only on a visit where she can still be caught: empty while she is loose,
;; checked while Jak has her. A flip pops it bigger. Drawn like the Klaww bar (game font and 2D sprites, from a process in *active-pool*).
(defconstant GAUNTLET_MUSE_ICON_X 44) ;; left edge of the box, in the Klaww bar's 2D space (x 0 to 512, y 0 to 224)
(defconstant GAUNTLET_MUSE_ICON_Y 100) ;; the middle of the box and the word
(defconstant GAUNTLET_MUSE_TEXT_SCALE 0.5) ;; the word's scale, the Klaww label's
(defconstant GAUNTLET_MUSE_TEXT_H 12) ;; the word's height at that scale
(defconstant GAUNTLET_MUSE_BOX_H 10) ;; the box's height; its width is twice that (square on screen)
(defconstant GAUNTLET_MUSE_BOX_GAP 5) ;; between the box and the word
(defconstant GAUNTLET_MUSE_ICON_POP 0.4) ;; how much bigger it is at a flip
(defconstant GAUNTLET_MUSE_PULSE_PERIOD (seconds 0.5)) ;; the loose box's pulse

;; what the last drawn frame showed, for the tests
(define *gauntlet-muse-checkbox-drawn-at* (- 0 (seconds 3600)))
(define *gauntlet-muse-checkbox-checked* #f)
(define *gauntlet-muse-checkbox-pop* 1.0) ;; its size multiplier then

(deftype gauntlet-muse-checkbox (process)
  ()
  (:states
   gauntlet-muse-checkbox-run))

(defun gauntlet-muse-phase ((period int))
  "Where the clock is in a cycle of period ticks, 0.0 to 1.0. Uses the tick remainder so it stays exact however long the game runs."
  (/ (the float (mod (current-time) period)) (the float period)))

(defun gauntlet-muse-wave ((period int))
  "A wave of period ticks, from 0.0 to 1.0 and back."
  (+ 0.5 (* 0.5 (sin (* (degrees 360) (gauntlet-muse-phase period))))))

(defun gauntlet-muse-rgba ((r int) (g int) (b int) (a int))
  "A colour with a non-constant alpha (static-rgba needs constants). Alpha 128 is fully opaque."
  (the-as rgba (logior (shl a 24) (shl b 16) (shl g 8) r)))

(defun gauntlet-muse-frame-draw! ((buf dma-buffer) (cx int) (cy int) (half-w int) (half-h int) (thick-x int) (color rgba))
  "The four sides of a card of half-sizes half-w and half-h around (cx, cy), the vertical ones thick-x wide."
  (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) (* 2 half-w) 2 color)
  (draw-sprite2d-xy buf (- cx half-w) (+ cy half-h) (* 2 half-w) 2 color)
  (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) thick-x (* 2 half-h) color)
  (draw-sprite2d-xy buf (+ cx half-w) (- cy half-h) thick-x (* 2 half-h) color)
  0)

(defun gauntlet-muse-icon-shown? ()
  "True when the checkbox is to show: Jak in Misty, on a visit with a muse to catch, and nothing else owns the screen (cutscene, progress menu, fade)."
  (and *target*
       (gauntlet-in-level? 'misty)
       (not (gauntlet-muse-delivered?))
       (not (movie?))
       (not *progress-process*)
       (time-elapsed? (-> *game-info* letterbox-time) (seconds 0.1))
       (time-elapsed? (-> *game-info* blackout-time) (seconds 0.1))))

(defun gauntlet-muse-checkbox-draw! ((buf dma-buffer) (carried symbol) (flash float))
  "Draw the box and word: loose is an empty box with a pulsing violet frame and dim text, carried a filled gold frame and lit text.
   Both pop white at a flip; flash is how much of that is left."
  (let* ((pop (* *gauntlet-misty-muse-icon-scale* (+ 1.0 (* GAUNTLET_MUSE_ICON_POP flash))))
         (aspect (-> *pc-settings* aspect-ratio-scale))
         (box-h (max 4 (the int (* (the float GAUNTLET_MUSE_BOX_H) pop))))
         (half-h (/ box-h 2))
         (half-w (max 2 (the int (/ (the float box-h) aspect))))
         (thick-x (max 1 (the int (/ 2.0 aspect))))
         (cx (+ GAUNTLET_MUSE_ICON_X half-w))
         (cy GAUNTLET_MUSE_ICON_Y))
    (gauntlet-muse-frame-draw!
      buf cx cy half-w half-h thick-x
      (cond
        ((< 0.0 flash) (static-rgba 255 255 255 150))
        (carried (static-rgba 255 190 50 110))
        (else (gauntlet-muse-rgba 200 40 120 (+ 45 (the int (* 80.0 (gauntlet-muse-wave GAUNTLET_MUSE_PULSE_PERIOD))))))))
    (when carried
      (draw-sprite2d-xy buf (+ (- cx half-w) thick-x 2) (+ (- cy half-h) 3)
                        (max 1 (- (* 2 half-w) (* 2 thick-x) 4)) (max 1 (- (* 2 half-h) 5))
                        (static-rgba 255 190 50 128)))
    (draw-string-xy-scaled "MUSE" buf
                           (+ GAUNTLET_MUSE_ICON_X (* 2 half-w) (the int (/ (* (the float GAUNTLET_MUSE_BOX_GAP) pop) aspect)))
                           (- cy (the int (* 0.5 (the float GAUNTLET_MUSE_TEXT_H) pop)))
                           (cond
                             ((< 0.0 flash) (font-color white))
                             (carried (font-color yellow))
                             (else (font-color transparent)))
                           (font-flags shadow kerning large)
                           (* GAUNTLET_MUSE_TEXT_SCALE pop))
    (set-time! *gauntlet-muse-checkbox-drawn-at*)
    (set! *gauntlet-muse-checkbox-checked* carried)
    (set! *gauntlet-muse-checkbox-pop* pop))
  0)

(defun gauntlet-muse-icon-frame! ()
  "One frame of the checkbox, when shown. A loss also flashes the screen violet, fading with the checkbox flash (scaled by *gauntlet-misty-mayhem-atmosphere*)."
  (when (gauntlet-muse-icon-shown?)
    (let* ((since (- (current-time) *gauntlet-muse-flip-time*))
           (flash (fmax 0.0 (- 1.0 (/ (the float since) (the float GAUNTLET_MUSE_FLASH_TIME)))))
           (carried (gauntlet-muse-carried?)))
      (gauntlet-mayhem-roar-poll!)
      (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
        (when (and (not carried) (< 0.0 flash))
          (draw-sprite2d-xy buf 0 0 512 224
                            (gauntlet-muse-rgba 150 20 170 (the int (* GAUNTLET_MAYHEM_FLASH_ALPHA flash *gauntlet-misty-mayhem-atmosphere*)))))
        (gauntlet-muse-checkbox-draw! buf carried flash))))
  0)

(defstate gauntlet-muse-checkbox-run (gauntlet-muse-checkbox)
  :code
    (behavior ()
      (loop
        (cond
          ((and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
           (gauntlet-muse-icon-frame!)
           (gauntlet-mayhem-music-poll!))
          (else
           (gauntlet-mayhem-music-off!)
           (deactivate self)))
        (suspend))))

(defbehavior gauntlet-muse-checkbox-init-by-other gauntlet-muse-checkbox ()
  (go gauntlet-muse-checkbox-run)
  (none))

(defun gauntlet-muse-icon-ensure! ()
  "Keep one process alive that drives the icon while Misty is up; it ends when Misty goes or the setting is off.
   Its handle lives in a structure, as the Klaww bar's does."
  (when (and *gauntlet-misty-muse-enabled*
             *target*
             (gauntlet-misty-active?)
             (not (handle->process (-> *gauntlet-muse-world* icon))))
    (set! *gauntlet-mayhem-music* #f) ;; a process that is gone took its settings with it
    (set! (-> *gauntlet-muse-world* icon)
          (ppointer->handle
            (process-spawn gauntlet-muse-checkbox :init gauntlet-muse-checkbox-init-by-other :to *active-pool*))))
  0)

(defun gauntlet-muse-caught-before-arrival? ()
  "True when the game's muse is caught: her actor's dead status, which the game sets on catch and saves with her cell.
   Asked on arrival to tell a delivered visit; her perms are already copied in by then."
  (let ((ent (gauntlet-muse-entity-find!)))
    (and ent (logtest? (-> ent extra perm status) (entity-perm-status dead)))))

(defun gauntlet-muse-poll! ()
  "Per-frame: the muse state follows Misty. On entry she is delivered if the game's muse was caught before Jak came, else loose; on leaving she is loose again.
   While Misty is up: watch hits, keep her body and the icon."
  (let ((here (gauntlet-misty-active?)))
    (cond
      ((and here (not *gauntlet-muse-was-here*))
       (set! *gauntlet-muse-was-here* #t)
       (set! *gauntlet-muse-state*
             (if (gauntlet-muse-caught-before-arrival?) (gauntlet-muse-state delivered) (gauntlet-muse-state loose)))
       (set! *gauntlet-muse-health* -1.0)
       (+! *gauntlet-muse-episode* 1))
      ((and (not here) *gauntlet-muse-was-here*)
       (set! *gauntlet-muse-was-here* #f)
       (set! *gauntlet-muse-state* (gauntlet-muse-state loose))
       (set! *gauntlet-muse-entity* (the-as entity-actor #f))))
    (gauntlet-mayhem-blend-poll!)
    (gauntlet-lurker-tint-poll!)
    (when (and here *gauntlet-misty-muse-enabled*)
      (gauntlet-muse-health-poll!)
      (gauntlet-muse-body-poll!)
      (gauntlet-muse-icon-ensure!)))
  0)

;; ----------------------------------------------------------- the flying fish --

;; The jungle fishing game (fisher.gc) gets a second catch: now and then a big fish riding a zoomer flies down the river above the water.
;; Holding X lifts the net to its height and the fish is caught if lined up, for GAUNTLET_FISHER_FLYER_POUNDS pounds. With the net up,
;; river fish pass it and count as missed. Missing the flyer loses the game like too many misses do (fisher-fish-die); a setting makes it free.

;; Sometimes the rider is an eel instead (a setting sets the chance), the same catch-fishc as the river's eels: letting it by costs
;; nothing, netting it ends the game as an eel does (fisher-fish-caught).

;; River fish also leap, with a setting's chance, once on the way down, in an arc at the raised net's height over the net's line.
;; A fish is caught by the net where it is (lowered in the water, raised in the air), so a leaper is a miss for a net that stayed down.

;; fisher.gc owns the river, net and score and calls in here (gauntlet-fisher-*, gauntlet-h.gc): begin, end, update each frame, and
;; net-low? from each fish's catch test. This file owns the lift, the schedule and the two processes. catch-fishb is in JUN.DGO and
;; racer-ag is common (GAME.CGO), so a flyer is only made in the jungle, where both exist.

;; Two processes, since one process has one skeleton: the zoomer (gauntlet-flyer) flies the lane and decides; the rider
;; (gauntlet-flyer-rider) is the fish. Both are children of the fisher, so fisher-done puts them away. A lane uses the formulas of fisher-fish-move.

;; Speed is *gauntlet-fisher-flyer-speed*, in path positions a second (about 3.6 m each); river fish cross at 2.6 to 4.1. The catch
;; test looks at everywhere the zoomer went in a frame, so no allowed speed carries it over the net unseen.
;; A river fish starts at path position 1, about 29 m from the camera, as a small dim speck; a whole zoomer there looked like it
;; appeared next to the net. So it starts at GAUNTLET_FLYER_START_POS, crosses that at GAUNTLET_FLYER_LEAD_SPEED and grows until GAUNTLET_FLYER_GROW_END_POS.
(defconstant GAUNTLET_FLYER_START_POS -2.0) ;; where it starts: 6.6 m upstream of a river fish's start, about 36 m from the camera
(defconstant GAUNTLET_FLYER_RIVER_POS 1.0) ;; where a river fish starts, and where the zoomer slows to the setting's speed
(defconstant GAUNTLET_FLYER_LEAD_SPEED 4.0) ;; positions a second until then
(defconstant GAUNTLET_FLYER_LEAD_UNIT (meters 3.3)) ;; meters per position upstream of the path's first point (what the first one is worth on it)
(defconstant GAUNTLET_FLYER_GROW_END_POS 4.5) ;; whole size from here on, about 18 m from the camera
(defconstant GAUNTLET_FLYER_GROW_MIN 0.03) ;; never quite nothing: a zero scale is a matrix that cannot be inverted
(defconstant GAUNTLET_FLYER_END_POS 7.2) ;; where it is gone (fisher-fish-fall)
(defconstant GAUNTLET_FLYER_SIZE (meters 1.0)) ;; added to the net's radius, as a river fish adds its own size: 1.7 m in all, a lane 6.6 m across
(defconstant GAUNTLET_FLYER_REACH 0.2) ;; the net counts as up or down within this fraction of its rise from the top or bottom
(defconstant GAUNTLET_FLYER_RISE_PER_SECOND 4.0) ;; the net rises fully in a quarter of a second...
(defconstant GAUNTLET_FLYER_FALL_PER_SECOND 5.0) ;; ...and falls in a fifth, so letting go catches river fish again at once
(defconstant GAUNTLET_FLYER_BOB (meters 0.25)) ;; the zoomer bobs up and down by this much...
(defconstant GAUNTLET_FLYER_BOB_PER_POS (degrees 200)) ;; ...once every 1.8 positions of the path, about 1.6 s
(defconstant GAUNTLET_FLYER_LANE_MIN 0.15) ;; lane across the river, a river fish's offset: 0 and 1 are the banks
(defconstant GAUNTLET_FLYER_LANE_MAX 0.85)
(defconstant GAUNTLET_FLYER_ZOOMER_SCALE 0.7) ;; the bike (a big one) and the fish on it
(defconstant GAUNTLET_FLYER_FISH_SCALE 0.45)
(defconstant GAUNTLET_FLYER_EEL_SCALE 1.0) ;; the eel, in the same proportion to the river's eel as the fish is to the big one
(defconstant GAUNTLET_FLYER_EEL_LENGTH 0.8)
(defconstant GAUNTLET_FLYER_SEAT (meters 0.9)) ;; how far above the zoomer's origin the fish sits
(defconstant GAUNTLET_FLYER_INTERVAL_SPREAD 0.25) ;; the interval varies by up to this fraction either way
(defconstant GAUNTLET_FLYER_FIRST_SHARE 0.5) ;; the first flying fish comes after this share of an interval
(defconstant GAUNTLET_FLYER_BUSY_RETRY (seconds 1)) ;; when one is due while the last still flies, ask again after this long
;; A leaping river fish (fisher.gc) follows one arc along the river, centred on the net's line, so it is highest at the net.
(defconstant GAUNTLET_FISHER_JUMP_HALF_LENGTH (meters 6)) ;; the arc runs this far each side of the net's line (12 m in all)
(defconstant GAUNTLET_FISHER_JUMP_AIR_SHARE 0.5) ;; above this share of the net's rise a fish is in the air (for a raised net); below, in the water
(defconstant GAUNTLET_FISHER_JUMP_MAX_PITCH (degrees 55)) ;; the nose never turns further up or down than this
(defconstant GAUNTLET_PART_GROUP_BADFISH 177) ;; the eel's puffs, group-bad-fish (defined in fisher.gc)
(defconstant GAUNTLET_PART_GROUP_FISHCATCH 179) ;; the catch burst, group-fish-collect (fisher.gc; the jungle is loaded whenever a flyer is)

;; State of the fishing game between frames. The net's rise is the one number the lift is made of; its eased value is drawn and read by both catch tests.
(deftype gauntlet-fisher-world (structure)
  ((flyer      handle) ;; the flying fish in the air, if any: one at a time
   (next-flyer time-frame) ;; when the next one is due
   (net        vector :inline) ;; the net on the river, at the water (the fisher's paddle-pos), set every frame
   (width      float) ;; the river's lane width and the net's radius, owned by fisher.gc
   (net-radius float)
   (missed     int) ;; pounds that got past the net, and how many the game allows (fisher.gc), set every frame
   (max-missed int)
   (rise       float))) ;; 0 net down, 1 net up; linear in time, see gauntlet-fisher-ease

(define *gauntlet-fisher* (new 'global 'gauntlet-fisher-world))
(set! (-> *gauntlet-fisher* flyer) (the-as handle #f))
(set! (-> *gauntlet-fisher* next-flyer) 0)
(set! (-> *gauntlet-fisher* rise) 0.0)
(set! (-> *gauntlet-fisher* missed) 0)
(set! (-> *gauntlet-fisher* max-missed) 0)

;; The racer's exploded model (the whole bike in pieces, see *racer-explode-sg* in racer.gc), not racer-geo: the disc's racer-ag has
;; elements 3 to 21 stripped to #f, so racer-geo's idle animation (element 3) sent initialize-skeleton to process-drawable-art-error.
;; The explode group's idle animation (element 24) exists and is the one animation the draw needs.
(defskelgroup *gauntlet-flyer-zoomer-sg*
  racer
  racer-explode-lod0-jg
  racer-explode-idle-ja
  ((racer-explode-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3.5)
  :texture-level 2
  :sort 1)

(defskelgroup *gauntlet-flyer-fish-sg*
  catch-fishb
  catch-fishb-lod0-jg
  catch-fishb-idle-ja
  ((catch-fishb-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

;; the river's eel (*catch-fishc-sg* in fisher.gc), copied for the same reason as the fish
(defskelgroup *gauntlet-flyer-eel-sg*
  catch-fishc
  catch-fishc-lod0-jg
  catch-fishc-idle-ja
  ((catch-fishc-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defun gauntlet-fisher-ease ()
  "How far up the net is, 0 to 1: the smoothstep of the linear rise, so it starts and arrives gently."
  (let ((r (-> *gauntlet-fisher* rise)))
    (* r r (- 3.0 (* 2.0 r)))))

(defun gauntlet-fisher-net-rise ()
  "How far the net is raised right now, in game units."
  (* (gauntlet-fisher-ease) *gauntlet-fisher-flyer-height*))

(defun gauntlet-fisher-net-low? ()
  "True while the net is down far enough to catch the river's fish. Always true with nothing lifting it."
  (< (gauntlet-fisher-ease) GAUNTLET_FLYER_REACH))

(defun gauntlet-fisher-net-up? ()
  "True while the net is up far enough to catch the flying fish."
  (>= (gauntlet-fisher-ease) (- 1.0 GAUNTLET_FLYER_REACH)))

(defun gauntlet-fisher-net-catches? ((lift float))
  "True when the net catches a river fish lifted lift units off its line: a fish in the water is for a lowered net, one above
   GAUNTLET_FISHER_JUMP_AIR_SHARE of the rise for a raised one. Between the two nothing, so tapping X cannot catch both."
  (if (< lift (* GAUNTLET_FISHER_JUMP_AIR_SHARE *gauntlet-fisher-flyer-height*))
    (gauntlet-fisher-net-low?)
    (gauntlet-fisher-net-up?)))

(defun gauntlet-fisher-jump-roll! ()
  "Whether a river fish being born leaps once on its way down. Never when there is no flying fish to raise the net for."
  (and *gauntlet-fisher-flyer-enabled*
       (> *gauntlet-fisher-jump-chance* 0)
       (rand-vu-percent? (* 0.01 (the float *gauntlet-fisher-jump-chance*)))))

(defun gauntlet-fisher-jump-along ((trans vector) (dir vector))
  "How far upstream of the net's line a fish at trans, swimming along dir, is: positive before the line, 0 on it, negative after.
   A very large number when dir has no direction."
  (let ((run (vector-xz-length dir)))
    (if (< run 0.001)
      4096000.0
      (/ (+ (* (- (-> *gauntlet-fisher* net x) (-> trans x)) (-> dir x))
            (* (- (-> *gauntlet-fisher* net z) (-> trans z)) (-> dir z)))
         run))))

(defun gauntlet-fisher-jump-lift ((trans vector) (dir vector))
  "How far above its line a leaping fish at trans is: a parabola along the river, the raised net's height at the net's line
   and 0 at GAUNTLET_FISHER_JUMP_HALF_LENGTH either side."
  (let ((ratio (/ (gauntlet-fisher-jump-along trans dir) GAUNTLET_FISHER_JUMP_HALF_LENGTH)))
    (if (< (fabs ratio) 1.0)
      (* *gauntlet-fisher-flyer-height* (- 1.0 (* ratio ratio)))
      0.0)))

(defun gauntlet-fisher-jump-pitch ((trans vector) (dir vector))
  "How far a leaping fish's nose is turned up, in rotation units: the arc's slope, up before the net's line and down after. 0 outside the arc."
  (let ((along (gauntlet-fisher-jump-along trans dir)))
    (if (< (fabs along) GAUNTLET_FISHER_JUMP_HALF_LENGTH)
      (fmax (- GAUNTLET_FISHER_JUMP_MAX_PITCH)
            (fmin GAUNTLET_FISHER_JUMP_MAX_PITCH
                  (atan (/ (* 2.0 *gauntlet-fisher-flyer-height* along) (* GAUNTLET_FISHER_JUMP_HALF_LENGTH GAUNTLET_FISHER_JUMP_HALF_LENGTH))
                        1.0)))
      0.0)))

(defun gauntlet-fisher-net-cspace! ((dest cspace) (hand cspace) (quat quaternion))
  "The fish net's root joint. The game puts it in Jak's right hand (cspace<-cspace+quaternion!); this then lifts it straight up
   by the net's rise, pole and all."
  (let ((placed (cspace<-cspace+quaternion! dest hand quat)))
    (+! (-> dest bone transform vector 3 y) (gauntlet-fisher-net-rise))
    placed))

(defun gauntlet-fisher-net-point ((out vector))
  "Where the net's catching part is now, written to out: its place on the river, raised."
  (set! (-> out quad) (-> *gauntlet-fisher* net quad))
  (+! (-> out y) (gauntlet-fisher-net-rise))
  out)

(defun gauntlet-flyer-pause-time ((share float))
  "How long until a flying fish that is share of an interval away, varied by the spread either way."
  (the int (* share
              (the float *gauntlet-fisher-flyer-interval*)
              (rand-vu-float-range (- 1.0 GAUNTLET_FLYER_INTERVAL_SPREAD) (+ 1.0 GAUNTLET_FLYER_INTERVAL_SPREAD)))))

;; ---- the zoomer

(defun gauntlet-flyer-eel-roll! ()
  "True when the new flying fish carries an eel instead of the big fish."
  (and (> *gauntlet-fisher-flyer-eel-chance* 0)
       (rand-vu-percent? (* 0.01 (the float *gauntlet-fisher-flyer-eel-chance*)))))

(defun gauntlet-flyer-grown ((pos float))
  "Size fraction of the flying fish at pos: a speck at the start, full at GAUNTLET_FLYER_GROW_END_POS, growing with the square of progress."
  (let ((along (fmax 0.0 (fmin 1.0 (/ (- pos GAUNTLET_FLYER_START_POS) (- GAUNTLET_FLYER_GROW_END_POS GAUNTLET_FLYER_START_POS))))))
    (fmax GAUNTLET_FLYER_GROW_MIN (* along along))))

(deftype gauntlet-flyer (process-drawable)
  ((rider  handle) ;; the rider process
   (kind   symbol) ;; 'fish (catch) or 'eel (dodge)
   (prev-x float) ;; last frame's ground position, for the swept catch test
   (prev-z float)
   (pos    float) ;; position along the fisher's path
   (offset float) ;; lane across the river, 0 to 1
   (phase  float)) ;; bob start phase, rotation units
  (:states
   gauntlet-flyer-fly
   gauntlet-flyer-gone))

(deftype gauntlet-flyer-rider (process-drawable)
  ((kind symbol)) ;; same kind as the zoomer
  (:states
   gauntlet-flyer-rider-ride
   gauntlet-flyer-rider-netted
   gauntlet-flyer-rider-gone))

;; ---- the fish on it

(defbehavior gauntlet-flyer-rider-event gauntlet-flyer-rider ((proc process) (argc int) (message symbol) (block event-message-block))
  "The zoomer sends 'caught when the net gets it."
  (case message
    (('caught) (go gauntlet-flyer-rider-netted)))
  #f)

(defstate gauntlet-flyer-rider-ride (gauntlet-flyer-rider)
  :event gauntlet-flyer-rider-event
  :trans
    (behavior ()
      ;; follows the zoomer; gone when the zoomer is
      (let ((zoomer (handle->process (-> *gauntlet-fisher* flyer))))
        (cond
          (zoomer
           (set! (-> self root trans quad) (-> (the-as gauntlet-flyer zoomer) root trans quad))
           (+! (-> self root trans y) GAUNTLET_FLYER_SEAT)
           (let ((grown (gauntlet-flyer-grown (-> (the-as gauntlet-flyer zoomer) pos))))
             (if (= (-> self kind) 'eel)
               (set-vector! (-> self root scale) (* GAUNTLET_FLYER_EEL_SCALE grown) (* GAUNTLET_FLYER_EEL_SCALE grown) (* GAUNTLET_FLYER_EEL_LENGTH grown) 1.0)
               (set-vector! (-> self root scale) (* GAUNTLET_FLYER_FISH_SCALE grown) (* GAUNTLET_FLYER_FISH_SCALE grown) (* GAUNTLET_FLYER_FISH_SCALE grown) 1.0)))
           (quaternion-copy! (-> self root quat) (-> (the-as gauntlet-flyer zoomer) root quat))
           ;; eels puff like the river's
           (if (and (= (-> self kind) 'eel) (nonzero? (-> self part))) (spawn (-> self part) (-> self root trans))))
          (else (go gauntlet-flyer-rider-gone))))
      (none))
  :code
    (behavior ()
      (ja-channel-push! 1 0)
      (if (= (-> self kind) 'eel)
        (ja :group! catch-fishc-idle-ja :num! min)
        (ja :group! catch-fishb-idle-ja :num! min))
      (loop
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

(defstate gauntlet-flyer-rider-netted (gauntlet-flyer-rider)
  :trans
    (behavior ()
      ;; shrink into the net, as in fisher-fish-caught
      (let ((net (gauntlet-fisher-net-point (new 'stack-no-clear 'vector))))
        (vector-lerp! (-> self root trans) (-> self root trans) net 0.3))
      (vector-float*! (-> self root scale) (-> self root scale) 0.93)
      (if (< (-> self root scale x) 0.05) (go gauntlet-flyer-rider-gone))
      (none))
  :code
    (behavior ()
      (loop
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

(defstate gauntlet-flyer-rider-gone (gauntlet-flyer-rider)
  :code
    (behavior ()
      (deactivate self)))

(defbehavior gauntlet-flyer-rider-init-by-other gauntlet-flyer-rider ((kind symbol))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self kind) kind)
  (cond
    ((= kind 'eel)
     (set-vector! (-> self root scale) GAUNTLET_FLYER_EEL_SCALE GAUNTLET_FLYER_EEL_SCALE GAUNTLET_FLYER_EEL_LENGTH 1.0)
     (set! (-> self part) (create-launch-control (get-part-group GAUNTLET_PART_GROUP_BADFISH) self))
     (initialize-skeleton self *gauntlet-flyer-eel-sg* '()))
    (else
     (set-vector! (-> self root scale) GAUNTLET_FLYER_FISH_SCALE GAUNTLET_FLYER_FISH_SCALE GAUNTLET_FLYER_FISH_SCALE 1.0)
     (initialize-skeleton self *gauntlet-flyer-fish-sg* '())))
  ;; dimmer, like fisher-fish-init-by-other
  (set-vector! (-> self draw color-mult) 0.6 0.6 0.6 1.0)
  (set-vector! (-> self draw color-emissive) 0.6 0.6 0.6 0.0)
  (go gauntlet-flyer-rider-ride)
  (none))

;; ---- the zoomer, flying

(defbehavior gauntlet-flyer-place gauntlet-flyer ()
  "Place the zoomer on its lane at pos: net height plus lift plus bob, facing downstream."
  (let* ((fisher (the-as process-drawable (-> self parent 0)))
         (dir (new 'stack-no-clear 'vector))
         (side (new 'stack-no-clear 'vector)))
    (eval-path-curve-div! (-> fisher path) (-> self root trans) (fmax 0.0 (-> self pos)) 'interp)
    (path-control-method-12 (-> fisher path) dir (-> self pos))
    ;; before the path's first point (negative pos): extend the first segment backwards
    (when (< (-> self pos) 0.0)
      (vector-normalize! dir 1.0)
      (vector-float*! dir dir (* (-> self pos) GAUNTLET_FLYER_LEAD_UNIT))
      (vector+! (-> self root trans) (-> self root trans) dir)
      (path-control-method-12 (-> fisher path) dir (-> self pos)))
    (let ((turn (+ 16384.0 (vector-y-angle dir))))
      (set! (-> side x) (sin turn))
      (set! (-> side y) 0.0)
      (set! (-> side z) (cos turn))
      (set! (-> side w) 1.0))
    (vector-normalize! side (* 2.0 (+ -0.5 (-> self offset)) (-> *gauntlet-fisher* width)))
    (vector+! (-> self root trans) (-> self root trans) side)
    (set! (-> self root trans y)
          (+ (-> *gauntlet-fisher* net y)
             *gauntlet-fisher-flyer-height*
             (* GAUNTLET_FLYER_BOB (sin (+ (-> self phase) (* (-> self pos) GAUNTLET_FLYER_BOB_PER_POS))))))
    (quaternion-vector-angle! (-> self root quat) (new 'static 'vector :y 1.0 :w 1.0) (vector-y-angle dir))
    (let ((grown (gauntlet-flyer-grown (-> self pos))))
      (set-vector! (-> self root scale)
                   (* GAUNTLET_FLYER_ZOOMER_SCALE grown)
                   (* GAUNTLET_FLYER_ZOOMER_SCALE grown)
                   (* GAUNTLET_FLYER_ZOOMER_SCALE grown)
                   1.0)))
  0)

(defun gauntlet-flyer-poof! ((at vector))
  "A small puff where part of the flying fish leaves."
  (process-spawn part-tracker :init part-tracker-init group-punch-hit -1 #f #f #f at :to *entity-pool*)
  0)

(defun gauntlet-flyer-near-net? ((from-x float) (from-z float) (to-x float) (to-z float))
  "True when the net is within reach of the zoomer anywhere on this frame's path, so a fast zoomer cannot skip over it."
  (let* ((net-x (-> *gauntlet-fisher* net x))
         (net-z (-> *gauntlet-fisher* net z))
         (run-x (- to-x from-x))
         (run-z (- to-z from-z))
         (run-squared (+ (* run-x run-x) (* run-z run-z)))
         ;; 0 to 1: where on the stretch the point nearest the net lies
         (along (if (< run-squared 0.001)
                  0.0
                  (fmax 0.0 (fmin 1.0 (/ (+ (* (- net-x from-x) run-x) (* (- net-z from-z) run-z)) run-squared)))))
         (off-x (- net-x (+ from-x (* along run-x))))
         (off-z (- net-z (+ from-z (* along run-z)))))
    (< (sqrtf (+ (* off-x off-x) (* off-z off-z)))
       (+ (-> *gauntlet-fisher* net-radius) GAUNTLET_FLYER_SIZE))))

(defstate gauntlet-flyer-fly (gauntlet-flyer)
  :trans
    (behavior ()
      (set! (-> self prev-x) (-> self root trans x))
      (set! (-> self prev-z) (-> self root trans z))
      (+! (-> self pos)
          (* (if (< (-> self pos) GAUNTLET_FLYER_RIVER_POS) GAUNTLET_FLYER_LEAD_SPEED *gauntlet-fisher-flyer-speed*) (seconds-per-frame)))
      (gauntlet-flyer-place)
      (cond
        ;; net up and under it: caught
        ((and (gauntlet-fisher-net-up?)
              (gauntlet-flyer-near-net? (-> self prev-x) (-> self prev-z) (-> self root trans x) (-> self root trans z)))
         (let ((pounds *gauntlet-fisher-flyer-pounds*)
               (rider (handle->process (-> self rider))))
           (cond
             ((= (-> self kind) 'eel)
              ;; as netting a river eel (fisher-fish-caught): sound, hint, then 'deadly ends the game
              (gauntlet-flyer-poof! (-> self root trans))
              (sound-play "caught-eel")
              (ambient-hint-spawn "sksp0a42" (-> self root trans) *entity-pool* 'ambient)
              (send-event (ppointer->process (-> self parent)) 'deadly)
              (go gauntlet-flyer-gone))
             (else
              (send-event (ppointer->process (-> self parent)) 'fisher-fish-caught pounds)
              (sound-play "get-big-fish")
              (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_FISHCATCH) -1 #f #f #f (-> self root trans) :to *entity-pool*)
              (gauntlet-flyer-poof! (-> self root trans))
              ;; fish goes into the net
              (if rider (send-event rider 'caught))
              (go gauntlet-flyer-gone)))))
        ;; past the end: a dodged eel is free; a missed fish counts as losses unless the setting is off
        ((and (>= (-> self pos) GAUNTLET_FLYER_END_POS) (= (-> self kind) 'eel))
         (gauntlet-flyer-poof! (-> self root trans))
         (go gauntlet-flyer-gone))
        ((>= (-> self pos) GAUNTLET_FLYER_END_POS)
         (cond
           (*gauntlet-fisher-flyer-miss-loses*
            ;; sends enough misses to reach max-missed, which ends the game
            (send-event (ppointer->process (-> self parent))
                        'fisher-fish-die
                        (max 1 (- (-> *gauntlet-fisher* max-missed) (-> *gauntlet-fisher* missed))))))
         (gauntlet-flyer-poof! (-> self root trans))
         (go gauntlet-flyer-gone)))
      (none))
  :code
    (behavior ()
      (ja-channel-push! 1 0)
      (ja :group! racer-explode-idle-ja :num! min)
      (loop
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

(defstate gauntlet-flyer-gone (gauntlet-flyer)
  :code
    (behavior ()
      (deactivate self)))

(defbehavior gauntlet-flyer-init-by-other gauntlet-flyer ()
  "Appear at the upstream end on a random lane, with its rider."
  (logclear! (-> self mask) (process-mask actor-pause))
  ;; no entity needed: texture level 2 finds the art in level-default, as for the yakow
  (set! (-> self entity) #f)
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self rider) (the-as handle #f))
  (set! (-> self kind) (if (gauntlet-flyer-eel-roll!) 'eel 'fish))
  (set! (-> self pos) GAUNTLET_FLYER_START_POS)
  (set! (-> self offset) (rand-vu-float-range GAUNTLET_FLYER_LANE_MIN GAUNTLET_FLYER_LANE_MAX))
  (set! (-> self phase) (rand-vu-float-range 0.0 (degrees 360)))
  (set-vector! (-> self root scale) GAUNTLET_FLYER_ZOOMER_SCALE GAUNTLET_FLYER_ZOOMER_SCALE GAUNTLET_FLYER_ZOOMER_SCALE 1.0)
  (initialize-skeleton self *gauntlet-flyer-zoomer-sg* '())
  (gauntlet-flyer-place)
  (set! (-> self prev-x) (-> self root trans x))
  (set! (-> self prev-z) (-> self root trans z))
  (set! (-> *gauntlet-fisher* flyer) (process->handle self))
  (set! (-> self rider)
        (ppointer->handle (process-spawn gauntlet-flyer-rider (-> self kind) :init gauntlet-flyer-rider-init-by-other :to (ppointer->process (-> self parent)))))
  (go gauntlet-flyer-fly)
  (none))

;; ---- the game

(defun gauntlet-fisher-begin! ()
  "A fishing game starts: net down, nothing flying, first flyer scheduled."
  (let ((world *gauntlet-fisher*))
    (set! (-> world flyer) (the-as handle #f))
    (set! (-> world rise) 0.0)
    (set! (-> world next-flyer) (+ (current-time) (gauntlet-flyer-pause-time GAUNTLET_FLYER_FIRST_SHARE))))
  0)

(defun gauntlet-fisher-end! ()
  "The fishing game is over: net down; the flyer dies with the fisher's children."
  (set! (-> *gauntlet-fisher* flyer) (the-as handle #f))
  (set! (-> *gauntlet-fisher* rise) 0.0)
  0)

(defun gauntlet-fisher-update! ((fisher process-drawable) (net vector) (width float) (net-radius float) (missed int) (max-missed int))
  "One frame: X held lifts the net, releasing lowers it, and a flyer is sent when due."
  (let ((world *gauntlet-fisher*))
    (set! (-> world net quad) (-> net quad))
    (set! (-> world width) width)
    (set! (-> world net-radius) net-radius)
    (set! (-> world missed) missed)
    (set! (-> world max-missed) max-missed)
    (let ((held (and *gauntlet-fisher-flyer-enabled* (cpad-hold? 0 x))))
      (set! (-> world rise)
            (seek (-> world rise) (if held 1.0 0.0)
                  (* (seconds-per-frame) (if held GAUNTLET_FLYER_RISE_PER_SECOND GAUNTLET_FLYER_FALL_PER_SECOND)))))
    (when (and *gauntlet-fisher-flyer-enabled* (>= (current-time) (-> world next-flyer)))
      (cond
        ((handle->process (-> world flyer))
         (set! (-> world next-flyer) (+ (current-time) GAUNTLET_FLYER_BUSY_RETRY)))
        ((not (gauntlet-art-ready? *gauntlet-flyer-zoomer-sg*))
         (set! (-> world next-flyer) (+ (current-time) (gauntlet-flyer-pause-time 1.0))))
        (else
         (process-spawn gauntlet-flyer :init gauntlet-flyer-init-by-other :to fisher)
         (set! (-> world next-flyer) (+ (current-time) (gauntlet-flyer-pause-time 1.0)))))))
  (none))

;; ----------------------------------------------------------- eco mastery --

;; Clearing Geyser Rock earns Jak a mastery of eco, paid for in orbs (goggles) and health (R2 blast), never a new meter.
;; Unlock: every scarecrow broken in one visit. A scarecrow's break calls gauntlet-scarecrow-broken! (training-obs.gc). The check must run
;; at that moment: leaving the level drops the scarecrows' dead status, since only actors with a task are saved to *game-info*.
;; Record: one synthetic entry in *game-info*'s perm-list (what game-save writes), with an aid no actor has and a nonzero task. The task
;; is only there so reset-actors on death leaves the dead bit alone; a new game empties the list. A save without the entry has no mastery.

(defconstant GAUNTLET_ECO_MASTERY_AID #x6761756e) ;; "gaun"; no actor has an aid above 24579
(defconstant GAUNTLET_ECO_BLAST_COOLDOWN (seconds 0.5)) ;; R2 is read from a 15-frame pad history, so one press must not fire twice
(defconstant GAUNTLET_ECO_BLAST_RING_TIME (seconds 0.45)) ;; ring growth time, feet to full radius
(defconstant GAUNTLET_DRY_CLICK_GAP (seconds 0.4)) ;; min gap between empty-goggles clicks
(defconstant GAUNTLET_MASTERY_BANNER_TIME (seconds 6)) ;; how long the unlock banner shows
(defconstant GAUNTLET_MASTERY_BANNER_X 256) ;; banner center, in the Klaww bar's 512-wide 2D space
(defconstant GAUNTLET_MASTERY_BANNER_Y 52) ;; top of the first line
(defconstant GAUNTLET_MASTERY_BANNER_SCALE 0.7)

(define *gauntlet-eco-blast-time* (- 0 (seconds 3600))) ;; last R2 blast time
(define *gauntlet-goggles-click-time* (- 0 (seconds 3600))) ;; last empty-goggles click
(define *gauntlet-mastery-time* (- 0 (seconds 3600))) ;; when the mastery was earned, for the banner
(define *gauntlet-eco-blast-center* (new 'global 'vector)) ;; blast center, read by the entity-pool walk and the ring

(defun gauntlet-eco-mastery-perm ()
  "The perm-list entry that records the mastery, or #f."
  (lookup-entity-perm-by-aid *game-info* (the-as actor-id GAUNTLET_ECO_MASTERY_AID)))

(defun gauntlet-eco-mastery-recorded? ()
  "True when the save holds the mastery, whatever the setting."
  (let ((perm (gauntlet-eco-mastery-perm)))
    (and perm (logtest? (-> perm status) (entity-perm-status dead)))))

(defun gauntlet-eco-mastered? ()
  "True when the mastery is earned and the setting is on."
  (and *gauntlet-eco-mastery-enabled* (gauntlet-eco-mastery-recorded?)))

(defun gauntlet-eco-mastery-record! ()
  "Add the mastery entry to the perm-list, once (the list has 4096 slots)."
  (let ((perms (-> *game-info* perm-list)))
    (when (and (not (gauntlet-eco-mastery-perm)) (< (-> perms length) (-> perms allocated-length)))
      (let ((perm (-> perms data (-> perms length))))
        (set! (-> perm quad) (the-as uint128 0))
        (set! (-> perm aid) (the-as actor-id GAUNTLET_ECO_MASTERY_AID))
        (set! (-> perm task) (game-task training-gimmie))
        (set! (-> perm status) (entity-perm-status dead)))
      (+! (-> perms length) 1)))
  0)

(defun gauntlet-geyser-cleared? ()
  "True when Geyser Rock is loaded and no scarecrow actor (scarecrow-a, scarecrow-b) is still standing, by dead status."
  (let ((seen 0)
        (standing 0))
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (and (= (-> lev status) 'active) (= (-> lev name) 'training) (nonzero? (-> lev bsp actors)))
          (let ((actors (-> lev bsp actors)))
            (dotimes (j (-> actors length))
              (let* ((ent (-> actors data j actor))
                     (kind (-> ent etype)))
                (when (and (nonzero? kind) (or (= (-> kind symbol) 'scarecrow-a) (= (-> kind symbol) 'scarecrow-b)))
                  (+! seen 1)
                  (if (not (logtest? (-> ent extra perm status) (entity-perm-status dead)))
                    (+! standing 1)))))))))
    (and (< 0 seen) (= 0 standing))))

(defun gauntlet-mastery-banner-draw ()
  "Draw the unlock banner for GAUNTLET_MASTERY_BANNER_TIME after the unlock."
  (when (not (time-elapsed? *gauntlet-mastery-time* GAUNTLET_MASTERY_BANNER_TIME))
    (let* ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags shadow kerning large)))
           (title "GEYSER ROCK CLEARED")
           (words "ECO MASTERY: R2 BLASTS FOR A HIT, THE GOGGLES SHOOT FOR ORBS")
           (title-w (the int (* (get-string-length title font) GAUNTLET_MASTERY_BANNER_SCALE)))
           (words-w (the int (* (get-string-length words font) GAUNTLET_MASTERY_BANNER_SCALE))))
      (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
        (draw-string-xy-scaled title buf (- GAUNTLET_MASTERY_BANNER_X (/ title-w 2)) GAUNTLET_MASTERY_BANNER_Y
                               (font-color yellow) (font-flags shadow kerning large) GAUNTLET_MASTERY_BANNER_SCALE)
        (draw-string-xy-scaled words buf (- GAUNTLET_MASTERY_BANNER_X (/ words-w 2)) (+ GAUNTLET_MASTERY_BANNER_Y 18)
                               (font-color white) (font-flags shadow kerning large) GAUNTLET_MASTERY_BANNER_SCALE))))
  (none))

(defun gauntlet-eco-mastery-cue! ()
  "On unlock: yellow eco chime, eco burst around Jak, and the banner (drawn by a process in *active-pool*, like the Klaww bar)."
  (sound-play "y-eco-pickup" :position #f)
  (when *target*
    (dotimes (i 8)
      (gauntlet-eco-burst! *target* (gauntlet-eco yellow))))
  (set-time! *gauntlet-mastery-time*)
  (process-spawn-function process
                          (lambda :behavior process ()
                            (until (time-elapsed? *gauntlet-mastery-time* GAUNTLET_MASTERY_BANNER_TIME)
                              (gauntlet-mastery-banner-draw)
                              (suspend)))
                          :to *active-pool*
                          :name 'gauntlet-mastery-banner)
  0)

(defun gauntlet-scarecrow-broken! ((dummy process-drawable))
  "Called by training-obs.gc after each scarecrow's break; earns the mastery when it was the last one standing."
  (when (and *gauntlet-eco-mastery-enabled* (not (gauntlet-eco-mastery-recorded?)) (gauntlet-geyser-cleared?))
    (gauntlet-eco-mastery-record!)
    (gauntlet-eco-mastery-cue!))
  (none))

;; Goggles: with the mastery, the first-person view fires a yellow shot for GAUNTLET_GOGGLES_ORB_COST orbs (setting goggles-orb-cost)
;; when Jak has no yellow eco. With too few orbs it clicks; with yellow eco it is free. The third-person blast still needs a charge.
(defun *target-goggles-shot-paid-hook* ()
  "Asked by target-look-around when Jak has no yellow charge: pay and #t with mastery and orbs; click and #f without orbs; #f without mastery."
  (cond
    ((not (gauntlet-eco-mastered?)) #f)
    ((>= (-> *game-info* money) (the float *gauntlet-goggles-orb-cost*))
     (set! (-> *game-info* money) (- (-> *game-info* money) (the float *gauntlet-goggles-orb-cost*)))
     ;; The goggles hide the hud (disable-hud) and a disabled hud does not update on its own (tally-value, hud.gc), so send 'show to the
     ;; orb count; each paid shot restarts its two seconds on screen.
     (when (-> *hud-parts* money) (send-event (ppointer->process (-> *hud-parts* money)) 'show))
     #t)
    (else
     ;; a press stays 15 frames in the pad history and the goggles ask each frame: click once
     (when (time-elapsed? *gauntlet-goggles-click-time* GAUNTLET_DRY_CLICK_GAP)
       (set-time! *gauntlet-goggles-click-time*)
       (sound-play "cursor-options" :position #f))
     #f)))

;; Blast: with the mastery, R2 sets off a ring of yellow eco around Jak. Nav enemies within *gauntlet-eco-blast-radius* in an ordinary
;; state are thrown *gauntlet-eco-blast-push* away and stunned for *gauntlet-eco-blast-stun* (nav-enemy-stunned). Others are left alone
;; (dying, jumping, bosses, the muse, non-nav things, the mod's hazards). Nothing is killed.
;; It always costs one hit: 'attack of mode 'damage, which target-attacked takes without flinch or knockback. Jak at one hit dies.
;; It is not allowed while he is invulnerable, which also stops free blasts.
;; The window also escapes the bomb's gravity (gauntlet-pullable?).

(defun gauntlet-jak-can-blast? ((jak target))
  "True when Jak is in a normal control state and can take the blast's hit: not dying, grabbed, hit, first-person (R2 fires there), in a vehicle, nor in a movie, pause or menu."
  (and (not (logtest? (-> jak state-flags) (state-flags dying grabbed first-person-mode being-attacked)))
       (not (gauntlet-jak-invulnerable? jak))
       (not (logtest? (-> jak control root-prim prim-core action) (collide-action racer snowball tube flut)))
       (not (movie?))
       (not *pause-lock*)
       (not *progress-process*)
       (!= (-> jak next-state name) 'target-look-around)))

(defun gauntlet-nav-enemy-stunnable? ((nav nav-enemy))
  "True when nav is in an ordinary nav-enemy state and is not the muse."
  (and (!= (-> nav type symbol) 'muse)
       (case (-> nav next-state name)
         (('nav-enemy-idle 'nav-enemy-patrol 'nav-enemy-notice 'nav-enemy-chase 'nav-enemy-stop-chase 'nav-enemy-stare
           'nav-enemy-give-up 'nav-enemy-attack 'nav-enemy-victory 'nav-enemy-stunned)
          #t)
         (else #f))))

(defun gauntlet-nav-enemy-stun! ((nav nav-enemy) (center vector))
  "Throw nav away from center and stun it. The push slows to zero over NAV_ENEMY_STUN_PUSH_TIME, so initial speed is twice the average.
   Velocity (xyz) and stun ticks (w) go in event-param-point."
  (let ((away (new 'stack-no-clear 'vector)))
    (vector-! away (-> nav collide-info trans) center)
    (set! (-> away y) 0.0)
    (if (< (vector-xz-length away) 1.0)
      (set-vector! away 1.0 0.0 0.0 0.0))
    (vector-xz-normalize! away (/ (* 2.0 *gauntlet-eco-blast-push*) (/ (the float NAV_ENEMY_STUN_PUSH_TIME) (the float (seconds 1)))))
    (set! (-> away w) (the float *gauntlet-eco-blast-stun*))
    (set! (-> nav event-param-point quad) (-> away quad))
    (go-process nav nav-enemy-stunned))
  0)

(defun gauntlet-eco-blast-tally! ((proc process))
  "Entity-pool walk step: stun and throw proc if it is a stunnable nav enemy within *gauntlet-eco-blast-radius*."
  (let ((nav (as-type proc nav-enemy)))
    (when (and nav
               (gauntlet-nav-enemy-stunnable? nav)
               (>= *gauntlet-eco-blast-radius* (vector-vector-distance (-> nav collide-info trans) *gauntlet-eco-blast-center*)))
      (gauntlet-nav-enemy-stun! nav *gauntlet-eco-blast-center*)))
  (none))

(defun gauntlet-eco-blast-show! ()
  "Blast feedback: yellow shot sound, eco puff, camera shake, and a ground ring (the bomb clock's ring) growing to the radius in GAUNTLET_ECO_BLAST_RING_TIME."
  (sound-play "yellow-fire" :position #f)
  (activate! *camera-smush-control* 307.0 37 600 1.0 0.995)
  (when *target*
    (dotimes (i 6)
      (gauntlet-eco-burst! *target* (gauntlet-eco yellow))))
  (process-spawn-function process
                          (lambda :behavior process ()
                            (let ((began (current-time))
                                  (radius *gauntlet-eco-blast-radius*))
                              (until (time-elapsed? began GAUNTLET_ECO_BLAST_RING_TIME)
                                (let ((reached (* radius (/ (the float (- (current-time) began)) (the float GAUNTLET_ECO_BLAST_RING_TIME)))))
                                  (when (< (meters 1) reached)
                                    (gauntlet-ring-circle *gauntlet-eco-blast-center*
                                                          reached
                                                          (gauntlet-ring-spots reached GAUNTLET_RING_CLOCK_SPACING GAUNTLET_RING_MAX_SPOTS)
                                                          GAUNTLET_PART_RING_CLOCK
                                                          *gauntlet-flat-rim*)))
                                (suspend))))
                          :to *active-pool*
                          :name 'gauntlet-eco-blast-ring)
  0)

(defun gauntlet-eco-blast! ()
  "R2 blast: take the hit first, then show it and stun nearby nav enemies, even if the hit kills Jak."
  (set! (-> *gauntlet-eco-blast-center* quad) (-> (target-pos 0) quad))
  (send-event *target* 'attack #f (static-attack-info ((mode 'damage))))
  (gauntlet-eco-blast-show!)
  (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-eco-blast-tally! proc) (none)) *null-kernel-context*)
  0)

(defun gauntlet-eco-blast-poll! ()
  "Per-frame: R2 with the mastery in a normal state sets off the blast; the cooldown stops one press being read on every frame of the pad history."
  (when (and *target*
             (gauntlet-eco-mastered?)
             (recently-pressed? :pad-idx 0 r2)
             (time-elapsed? *gauntlet-eco-blast-time* GAUNTLET_ECO_BLAST_COOLDOWN)
             (gauntlet-jak-can-blast? *target*))
    (set-time! *gauntlet-eco-blast-time*)
    (gauntlet-eco-blast!))
  0)

;; ------------------------------------------------------------------ the settings --

;; Settings come from Mods/gauntlet-settings.gc: (revision N) first, then one (key value) per setting in human units (meters, seconds,
;; degrees, #t/#f). The file is polled every GAUNTLET_SETTINGS_POLL_FRAMES frames and applied only when the revision changes. The file is
;; the whole truth: keys it omits go back to default; unknown keys and bad or out-of-range values are skipped.
;; Each setting is one row of gauntlet-setting-table, and apply and reset are both generated from it, so none can be missed in one.

(defconstant GAUNTLET_SETTINGS_POLL_FRAMES 30) ;; frames between settings file checks

(defmacro gauntlet-setting-table (row)
  "Expand row per setting: (row name unit global default lowest highest). Units: seconds (global in ticks), meters (game units),
   degrees (rotation units), count (whole number), ratio (float), flag. The range is in file units, ignored for a flag."
  `(begin
     (,row "bomb-countdown" seconds *gauntlet-bomb-countdown* GAUNTLET_BOMB_COUNTDOWN_DEFAULT 0.5 120.0)
     (,row "bomb-blast-radius" meters *gauntlet-bomb-blast-radius* GAUNTLET_BOMB_BLAST_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull-radius" meters *gauntlet-bomb-pull-radius* GAUNTLET_BOMB_PULL_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull" meters *gauntlet-bomb-pull* GAUNTLET_BOMB_PULL_DEFAULT 0.0 500.0)
     (,row "bomb-ground-pull" meters *gauntlet-bomb-ground-pull* GAUNTLET_BOMB_GROUND_PULL_DEFAULT 0.0 50.0)
     (,row "bomb-drop-height" meters *gauntlet-bomb-drop-height* GAUNTLET_BOMB_DROP_HEIGHT_DEFAULT 0.0 200.0)
     (,row "bomb-gravity" meters *gauntlet-bomb-gravity* GAUNTLET_BOMB_GRAVITY_DEFAULT 1.0 500.0)
     (,row "bridge-enabled" flag *gauntlet-bridge-enabled* GAUNTLET_BRIDGE_ENABLED_DEFAULT 0 0)
     (,row "vent-enabled" flag *gauntlet-vent-enabled* GAUNTLET_VENT_ENABLED_DEFAULT 0 0)
     (,row "bridge-trigger-radius" meters *gauntlet-bridge-trigger-radius* GAUNTLET_BRIDGE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "bridge-rearm-range" meters *gauntlet-bridge-rearm-range* GAUNTLET_BRIDGE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "dummies-enabled" flag *gauntlet-dummies-enabled* GAUNTLET_DUMMIES_ENABLED_DEFAULT 0 0)
     (,row "dummy-volley-interval" seconds *gauntlet-dummy-volley-interval* GAUNTLET_DUMMY_VOLLEY_INTERVAL_DEFAULT 0.1 120.0)
     (,row "dummy-volley-gap" seconds *gauntlet-dummy-volley-gap* GAUNTLET_DUMMY_VOLLEY_GAP_DEFAULT 0.05 60.0)
     (,row "dummy-volley-size" count *gauntlet-dummy-volley-size* GAUNTLET_DUMMY_VOLLEY_SIZE_DEFAULT 1.0 50.0)
     (,row "dummy-volley-spread" degrees *gauntlet-dummy-volley-spread* GAUNTLET_DUMMY_VOLLEY_SPREAD_DEFAULT 0.0 90.0)
     (,row "dummy-range" meters *gauntlet-dummy-range* GAUNTLET_DUMMY_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-leave-range" meters *gauntlet-dummy-leave-range* GAUNTLET_SAGE_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-range" meters *gauntlet-herald-range* GAUNTLET_HERALD_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-leave-range" meters *gauntlet-herald-leave-range* GAUNTLET_HERALD_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-shot-speed" meters *gauntlet-dummy-shot-speed* GAUNTLET_DUMMY_SHOT_SPEED_DEFAULT 0.0 500.0)
     (,row "stampede-enabled" flag *gauntlet-stampede-enabled* GAUNTLET_STAMPEDE_ENABLED_DEFAULT 0 0)
     (,row "stampede-herd-size" count *gauntlet-stampede-herd-size* GAUNTLET_STAMPEDE_HERD_SIZE_DEFAULT 1.0 30.0)
     (,row "stampede-speed" meters *gauntlet-stampede-speed* GAUNTLET_STAMPEDE_SPEED_DEFAULT 4.0 30.0)
     (,row "stampede-trigger-radius" meters *gauntlet-stampede-trigger-radius* GAUNTLET_STAMPEDE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "stampede-rearm-range" meters *gauntlet-stampede-rearm-range* GAUNTLET_STAMPEDE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "stampede-launch-up" meters *gauntlet-stampede-launch-up* GAUNTLET_STAMPEDE_LAUNCH_UP_DEFAULT 0.0 100.0)
     (,row "stampede-red-count" count *gauntlet-stampede-red-count* GAUNTLET_STAMPEDE_RED_COUNT_DEFAULT 0.0 30.0)
     (,row "yakow-stampede-enabled" flag *gauntlet-yakow-stampede-enabled* GAUNTLET_YAKOW_STAMPEDE_ENABLED_DEFAULT 0 0)
     (,row "babak-charge-enabled" flag *gauntlet-babak-charge-enabled* GAUNTLET_BABAK_CHARGE_ENABLED_DEFAULT 0 0)
     (,row "babak-charge-chance" ratio *gauntlet-babak-charge-chance* GAUNTLET_BABAK_CHARGE_CHANCE_DEFAULT 0.0 1.0)
     (,row "babak-blue-speed" ratio *gauntlet-babak-blue-speed* GAUNTLET_BABAK_BLUE_SPEED_DEFAULT 1.0 4.0)
     (,row "desperation-max" ratio *gauntlet-desperation-max* GAUNTLET_DESPERATION_MAX_DEFAULT 1.0 5.0)
     (,row "cell-heal-enabled" flag *gauntlet-cell-heal-enabled* GAUNTLET_CELL_HEAL_ENABLED_DEFAULT 0 0)
     (,row "misty-muse-enabled" flag *gauntlet-misty-muse-enabled* GAUNTLET_MISTY_MUSE_ENABLED_DEFAULT 0 0)
     (,row "misty-mayhem-extra" count *gauntlet-misty-mayhem-extra* GAUNTLET_MISTY_MAYHEM_EXTRA_DEFAULT 0.0 4.0)
     (,row "misty-mayhem-speed" ratio *gauntlet-misty-mayhem-speed* GAUNTLET_MISTY_MAYHEM_SPEED_DEFAULT 1.0 4.0)
     (,row "misty-mayhem-charge-chance" ratio *gauntlet-misty-mayhem-charge-chance* GAUNTLET_MISTY_MAYHEM_CHARGE_CHANCE_DEFAULT 0.0 1.0)
     (,row "misty-mayhem-music" flag *gauntlet-misty-mayhem-music* GAUNTLET_MISTY_MAYHEM_MUSIC_DEFAULT 0 0)
     (,row "misty-mayhem-voice" flag *gauntlet-misty-mayhem-voice* GAUNTLET_MISTY_MAYHEM_VOICE_DEFAULT 0 0)
     (,row "misty-mayhem-atmosphere" ratio *gauntlet-misty-mayhem-atmosphere* GAUNTLET_MISTY_MAYHEM_ATMOSPHERE_DEFAULT 0.0 1.0)
     (,row "misty-muse-icon-scale" ratio *gauntlet-misty-muse-icon-scale* GAUNTLET_MUSE_ICON_SCALE_DEFAULT 0.5 3.0)
     (,row "worm-cubes-enabled" flag *gauntlet-worm-cubes-enabled* GAUNTLET_WORM_CUBES_ENABLED_DEFAULT 0 0)
     (,row "worm-cube-count" count *gauntlet-worm-cube-count* GAUNTLET_WORM_CUBE_COUNT_DEFAULT 0.0 8.0)
     (,row "lurker-multiplier" count *gauntlet-lurker-multiplier* GAUNTLET_LURKER_MULTIPLIER_DEFAULT 1.0 5.0)
     (,row "horde-max-clones" count *gauntlet-horde-max-clones* GAUNTLET_HORDE_MAX_CLONES_DEFAULT 0.0 300.0)
     (,row "klaww-enabled" flag *gauntlet-klaww-enabled* GAUNTLET_KLAWW_ENABLED_DEFAULT 0 0)
     (,row "klaww-throw-interval" seconds *gauntlet-klaww-throw-interval* GAUNTLET_KLAWW_THROW_INTERVAL_DEFAULT 0.5 60.0)
     (,row "klaww-rage-max" ratio *gauntlet-klaww-rage-max* GAUNTLET_KLAWW_RAGE_MAX_DEFAULT 1.0 5.0)
     (,row "klaww-radius-max" ratio *gauntlet-klaww-radius-max* GAUNTLET_KLAWW_RADIUS_MAX_DEFAULT 1.0 5.0)
     (,row "klaww-range" meters *gauntlet-klaww-range* GAUNTLET_KLAWW_RANGE_DEFAULT 10.0 500.0)
     (,row "klaww-boulder-radius" meters *gauntlet-klaww-boulder-radius* GAUNTLET_KLAWW_BOULDER_RADIUS_DEFAULT 0.5 30.0)
     (,row "flybox-enabled" flag *gauntlet-flybox-enabled* GAUNTLET_FLYBOX_ENABLED_DEFAULT 0 0)
     (,row "flybox-bounce" meters *gauntlet-flybox-bounce* GAUNTLET_FLYBOX_BOUNCE_DEFAULT 0.0 20.0)
     (,row "flybox-carrier-return" seconds *gauntlet-carrier-return* GAUNTLET_CARRIER_RETURN_DEFAULT 0.0 600.0)
     (,row "tnt-enabled" flag *gauntlet-tnt-enabled* GAUNTLET_TNT_ENABLED_DEFAULT 0 0)
     (,row "fj-temple-platforms-removed" flag *gauntlet-fj-temple-platforms-removed* GAUNTLET_FJ_TEMPLE_PLATFORMS_REMOVED_DEFAULT 0 0)
     (,row "plant-boss-rework" flag *gauntlet-plant-boss-rework* GAUNTLET_PLANT_BOSS_REWORK_DEFAULT 0 0)
     (,row "fisher-flyer-enabled" flag *gauntlet-fisher-flyer-enabled* GAUNTLET_FISHER_FLYER_ENABLED_DEFAULT 0 0)
     (,row "fisher-flyer-interval" seconds *gauntlet-fisher-flyer-interval* GAUNTLET_FISHER_FLYER_INTERVAL_DEFAULT 5.0 120.0)
     (,row "fisher-flyer-pounds" count *gauntlet-fisher-flyer-pounds* GAUNTLET_FISHER_FLYER_POUNDS_DEFAULT 1.0 100.0)
     (,row "fisher-flyer-speed" ratio *gauntlet-fisher-flyer-speed* GAUNTLET_FISHER_FLYER_SPEED_DEFAULT 0.5 6.0)
     (,row "fisher-flyer-eel-chance" count *gauntlet-fisher-flyer-eel-chance* GAUNTLET_FISHER_FLYER_EEL_CHANCE_DEFAULT 0.0 100.0)
     (,row "fisher-flyer-miss-loses" flag *gauntlet-fisher-flyer-miss-loses* GAUNTLET_FISHER_FLYER_MISS_LOSES_DEFAULT 0 0)
     (,row "fisher-jump-chance" count *gauntlet-fisher-jump-chance* GAUNTLET_FISHER_JUMP_CHANCE_DEFAULT 0.0 100.0)
     (,row "fisher-flyer-height" meters *gauntlet-fisher-flyer-height* GAUNTLET_FISHER_FLYER_HEIGHT_DEFAULT 1.0 8.0)
     (,row "eco-mastery-enabled" flag *gauntlet-eco-mastery-enabled* GAUNTLET_ECO_MASTERY_ENABLED_DEFAULT 0 0)
     (,row "eco-blast-radius" meters *gauntlet-eco-blast-radius* GAUNTLET_ECO_BLAST_RADIUS_DEFAULT 1.0 60.0)
     (,row "eco-blast-stun" seconds *gauntlet-eco-blast-stun* GAUNTLET_ECO_BLAST_STUN_DEFAULT 0.5 30.0)
     (,row "eco-blast-push" meters *gauntlet-eco-blast-push* GAUNTLET_ECO_BLAST_PUSH_DEFAULT 0.0 30.0)
     (,row "goggles-orb-cost" count *gauntlet-goggles-orb-cost* GAUNTLET_GOGGLES_ORB_COST_DEFAULT 0.0 100.0)))

;; ---- the settings file

(define *gauntlet-settings-revision* 0) ;; revision in effect, 0 until a file is applied
(define *gauntlet-settings-countdown* 0)
(define *gauntlet-settings-applied* 0) ;; keys set by the file being applied
(define *gauntlet-settings-bad-revision-told* #f) ;; log a missing revision once, not every poll
(define *gauntlet-setting-key* (new 'global 'string 64 ""))
(define *gauntlet-setting-number* 0.0) ;; what gauntlet-read-number! last read
(define *gauntlet-setting-flag* #f) ;; what gauntlet-read-flag! last read

(defmacro gauntlet-row-reset (name unit global default lo hi)
  "Reset one setting to its default."
  `(set! ,global ,(if (eq? unit 'seconds) `(the int ,default) default)))

(defmacro gauntlet-row-apply (name unit global default lo hi)
  "If key is this setting, read and set its value, or skip the key."
  (if (eq? unit 'flag)
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-flag! file)
         (begin
           (set! ,global *gauntlet-setting-flag*)
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-number! file ,lo ,hi)
         (begin
           (set! ,global
                 ,(cond
                    ((eq? unit 'seconds) '(the int (+ (* *gauntlet-setting-number* 300.0) 0.5)))
                    ((eq? unit 'meters) '(* *gauntlet-setting-number* METER_LENGTH))
                    ((eq? unit 'degrees) '(* *gauntlet-setting-number* (/ DEGREES_PER_ROT 360.0)))
                    ((eq? unit 'ratio) '*gauntlet-setting-number*)
                    (#t '(the int (+ *gauntlet-setting-number* 0.5)))))
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))))

(defun gauntlet-settings-reset! ()
  "Reset every setting to its default."
  (gauntlet-setting-table gauntlet-row-reset)
  0)

(defun gauntlet-setting-skip! ((name string))
  "Log a key whose value is unusable; it keeps its default."
  (format 0 "GAUNTLET SETTINGS ~S skipped, its value is not a usable one~%" name)
  0)

(defun gauntlet-number-word? ((word string))
  "True when word is a plain decimal number. string->float reads garbage as 0.0, so check first."
  (let ((digits 0)
        (dots 0)
        (clean #t))
    (dotimes (i (length word))
      (let ((c (-> word data i)))
        (cond
          ((and (>= c #\0) (<= c #\9)) (+! digits 1))
          ((= c #\.) (+! dots 1))
          ((and (= c #\-) (zero? i)))
          (else (set! clean #f)))))
    (and clean (> digits 0) (<= dots 1))))

(defun gauntlet-read-word! ((file file-stream))
  "Next word of the file in *pc-temp-string*; empty at the end."
  (set! (-> *pc-temp-string* data 0) 0)
  (file-stream-seek-past-whitespace file)
  (file-stream-read-word file)
  *pc-temp-string*)

(defun gauntlet-read-number! ((file file-stream) (lowest float) (highest float))
  "Read the next word into *gauntlet-setting-number* if it is a number in [lowest, highest]."
  (let ((word (gauntlet-read-word! file)))
    (when (gauntlet-number-word? word)
      (let ((value (string->float word)))
        (when (and (>= value lowest) (<= value highest))
          (set! *gauntlet-setting-number* value)
          (return #t)))))
  #f)

(defun gauntlet-read-flag! ((file file-stream))
  "Read the next word into *gauntlet-setting-flag* if it is #t or #f."
  (let ((word (gauntlet-read-word! file)))
    (cond
      ((string= word "#t") (set! *gauntlet-setting-flag* #t) #t)
      ((string= word "#f") (set! *gauntlet-setting-flag* #f) #t)
      (else #f))))

(defun gauntlet-skip-past-close ((file file-stream))
  "Skip to the closing bracket of the current form, nested forms included."
  (let ((depth 1))
    (while (> depth 0)
      (let ((c (file-stream-getc file)))
        (cond
          ((= c #x28) (+! depth 1))
          ((= c #x29) (+! depth -1))
          ((= c 255) (set! depth 0))))))
  0)

(defun gauntlet-form-open? ((file file-stream))
  "True when the next character is an opening bracket (consumed)."
  (file-stream-seek-past-whitespace file)
  (= #x28 (file-stream-getc file)))

(defun gauntlet-settings-apply-key! ((file file-stream) (key string))
  "Apply the setting named key from the file; unknown keys are skipped."
  (let ((handled #f))
    (gauntlet-setting-table gauntlet-row-apply)
    (when (not handled)
      (format 0 "GAUNTLET SETTINGS ~S skipped, it is not a setting this build knows~%" key)))
  0)

(defun gauntlet-settings-read-revision ((file file-stream))
  "The file's revision, or -1 when it does not open with (revision N)."
  (when (gauntlet-form-open? file)
    (gauntlet-read-word! file)
    (when (string= *pc-temp-string* "revision")
      (let ((word (gauntlet-read-word! file)))
        (when (gauntlet-number-word? word)
          (let ((revision (the int (string->float word))))
            (gauntlet-skip-past-close file)
            (return revision))))))
  -1)

(defun gauntlet-settings-poll! ()
  "Every GAUNTLET_SETTINGS_POLL_FRAMES frames: on a new revision, reset to defaults and apply the file. A deleted file restores defaults."
  (+! *gauntlet-settings-countdown* -1)
  (when (>= 0 *gauntlet-settings-countdown*)
    (set! *gauntlet-settings-countdown* GAUNTLET_SETTINGS_POLL_FRAMES)
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-settings.gc" *pc-settings-folder*)
    (cond
      ((not (pc-filepath-exists? *pc-temp-string-1*))
       (when (nonzero? *gauntlet-settings-revision*)
         (gauntlet-settings-reset!)
         (format 0 "GAUNTLET SETTINGS file is gone, defaults restored (was revision ~D)~%" *gauntlet-settings-revision*)
         (set! *gauntlet-settings-revision* 0)))
      (else
       (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
         (when (file-stream-valid? file)
           (let ((revision (gauntlet-settings-read-revision file)))
             (cond
               ((< revision 0)
                (when (not *gauntlet-settings-bad-revision-told*)
                  (set! *gauntlet-settings-bad-revision-told* #t)
                  (format 0 "GAUNTLET SETTINGS file does not open with (revision N), ignored~%")))
               ((= revision *gauntlet-settings-revision*))
               (else
                (set! *gauntlet-settings-bad-revision-told* #f)
                (gauntlet-settings-reset!)
                (set! *gauntlet-settings-applied* 0)
                ;; each form: its key, then the key's reader takes the value
                (while (gauntlet-form-open? file)
                  (gauntlet-read-word! file)
                  (format (clear *gauntlet-setting-key*) "~S" *pc-temp-string*)
                  (gauntlet-settings-apply-key! file *gauntlet-setting-key*)
                  (gauntlet-skip-past-close file))
                (set! *gauntlet-settings-revision* revision)
                (format 0 "GAUNTLET SETTINGS revision ~D applied, ~D keys~%" revision *gauntlet-settings-applied*))))
           (file-stream-close file))))))
  0)

;; ------------------------------------------------------------------ the poll --

;; Every "last happened" stamp is a reading of (current-time), but loading a save sets that clock back to the save's base-time
;; (game-save.gc), mending only the game's own stamps. A mod stamp taken later is then in the future: "since" goes negative (the muse icon
;; flash drew huge) and cooldowns and the banner stick. A stamp ahead of the clock goes back to long ago.
(defmacro gauntlet-stamp-unrewind! (stamp)
  `(if (< (current-time) ,stamp) (set! ,stamp (- 0 (seconds 3600)))))

(defun gauntlet-clock-rewound-poll! ()
  "Per-frame, first: reset any stamp ahead of the clock (after a save load) before anything reads it."
  (gauntlet-stamp-unrewind! *gauntlet-muse-flip-time*)
  (gauntlet-stamp-unrewind! *gauntlet-mayhem-voice-time*)
  (gauntlet-stamp-unrewind! *gauntlet-eco-blast-time*)
  (gauntlet-stamp-unrewind! *gauntlet-goggles-click-time*)
  (gauntlet-stamp-unrewind! *gauntlet-mastery-time*)
  0)

(defun gauntlet-poll! ()
  "Per-frame hook: fix stamps, read settings first so they hold this frame, then poll each feature."
  (gauntlet-clock-rewound-poll!)
  (gauntlet-settings-poll!)
  (gauntlet-muse-poll!)
  (gauntlet-drop-spots-poll!)
  (gauntlet-stampede-poll!)
  (gauntlet-klaww-poll!)
  (gauntlet-tnt-poll!)
  (gauntlet-eco-blast-poll!)
  (none))
