;; ------------------------------------------------------------------ the art --

;; ogreboss-ag's skeleton as the boss himself: the game's *ogreboss-sg*, drawn from the common art (texture level 2) in the
;; character sink group. No shadow, as for the sage and the yakows: his shadow mesh has not been measured, and the shadow VU1
;; wraps at 252 silhouette edges.
(defskelgroup *gauntlet-klaww-sg*
  ogreboss
  ogreboss-lod0-jg
  ogreboss-idle-ja
  ((ogreboss-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 20)
  :texture-level 2
  :sort 1)

;; ogreboss-shoot-boulder, which the boss throws, minus the game's 300 m bounds and its shadow
(defskelgroup *gauntlet-klaww-boulder-sg*
  ogreboss
  ogreboss-shoot-boulder-lod0-jg
  ogreboss-shoot-boulder-idle-ja
  ((ogreboss-shoot-boulder-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 6)
  :texture-level 2
  :sort 1)

;; ogreboss-shoot-boulder-break, the boulder bursting into pieces that the ogre's own boulders do on impact
;; (ogreboss-rock-explosion-effect), played once by a manipy
(defskelgroup *gauntlet-klaww-boulder-break-sg*
  ogreboss
  ogreboss-shoot-boulder-break-lod0-jg
  ogreboss-shoot-boulder-break-idle-ja
  ((ogreboss-shoot-boulder-break-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 15)
  :texture-level 2
  :sort 1)

;; basebutton.gc's *generic-button-sg*, asking for the common art
(defskelgroup *gauntlet-button-sg*
  generic-button
  generic-button-lod0-jg
  generic-button-idle-ja
  ((generic-button-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3)
  :texture-level 2
  :sort 1)

;; ------------------------------------------------------------------- state --

;; The buttons, one table row each: (row index x y z), in meters. The y is a hint, the ground is probed for from just above
;; it, and the button stands on whatever is found.
;;
;; The three spots were picked in game by the mod's author, standing where each button should be (their own positions,
;; 2026-10-27). Distances are from the nest, pelican-1, at (-162.25 11.65 -423.03).
;; Row 0 is the teaching button: on the sand about 74 m south of the nest, an obviously out of place button that the player
;; meets first. Pushing it sends a boulder at Klaww, which teaches that the out of place buttons are how he dies.
;; Row 1 is on the high ground east of the nest, about 108 m from it.
;; Row 2 is far west, about 242 m from the nest, beyond his 140 m throwing range (klaww-range), so on the way there he stops
;; throwing; the boulder it sends back flies about 6 s.
(defmacro gauntlet-klaww-button-table (row)
  "Expand row once per button: (row index x y z)."
  `(begin
     (,row 0 -157.1 4.6 -348.7)
     (,row 1 -64.6 16.7 -377.3)
     (,row 2 -381.7 7.3 -526.1)))

(deftype gauntlet-klaww-world (structure)
  ((klaww   handle)
   (pelican handle) ;; the pelican that said it is at its nest with the cell, until Klaww has been sent for
   (buttons handle 3)))

(define *gauntlet-klaww-world* (new 'global 'gauntlet-klaww-world))

(defun gauntlet-klaww-forget-all! ()
  "Every handle in the world points at no process. A null handle is one whose process is #f, not zero: handle->process asks
   `(if (-> handle process) ...)` and zero is true in GOAL, so a zeroed handle is read through address 0."
  (set! (-> *gauntlet-klaww-world* klaww) (the-as handle #f))
  (set! (-> *gauntlet-klaww-world* pelican) (the-as handle #f))
  (dotimes (i GAUNTLET_KLAWW_BUTTONS)
    (set! (-> *gauntlet-klaww-world* buttons i) (the-as handle #f)))
  0)

(gauntlet-klaww-forget-all!)
(define *gauntlet-klaww-hits* 0) ;; boulders that have reached him since this fight began
(define *gauntlet-klaww-presses* 0) ;; buttons pressed since then
(define *gauntlet-klaww-throws* 0) ;; boulders thrown since then, which also numbers them in the log
(define *gauntlet-klaww-defeated* #f) ;; true from the third hit until Jak leaves the beach
(define *gauntlet-klaww-art-told* #f) ;; a missing art group is told about once, not every frame
(define *gauntlet-klaww-home* #f) ;; the level the fight is in (a symbol), or #f before Klaww has been dropped: leaving it ends the fight
;; the pelican's nest (see above): the pelican's own entity, in meters
(define *gauntlet-klaww-nest* (new 'static 'vector :x (meters -162.25) :y (meters 11.65) :z (meters -423.03) :w 1.0))

(defmacro gauntlet-row-button-count (index x y z)
  `(+! count 1))

(defun gauntlet-klaww-button-count ()
  "How many buttons the table has."
  (let ((count 0))
    (gauntlet-klaww-button-table gauntlet-row-button-count)
    count))

(deftype gauntlet-klaww (process-drawable)
  ((windup     time-frame)
   (last-throw time-frame)
   (landing    vector :inline) ;; the ground he falls to, where his feet will be
   (pelican    handle)) ;; the pelican he crushed, and so the holder of its cell: no process when he crushed none
  (:states
   gauntlet-klaww-fall
   gauntlet-klaww-land
   gauntlet-klaww-idle
   gauntlet-klaww-throw
   gauntlet-klaww-hit
   gauntlet-klaww-die
   gauntlet-klaww-gone))

(deftype gauntlet-boulder (process-drawable)
  ((trajectory trajectory :inline)
   (land       vector :inline)
   (tumble     quaternion :inline)
   (start-time time-frame)
   (flight     float)
   (radius     float)
   (index      int)
   (klaww      handle) ;; the Klaww a returned boulder is for, no process for his own
   (returned   symbol)) ;; true for a boulder a button threw back at him, which is not a danger to Jak
  (:states
   gauntlet-boulder-fly
   gauntlet-boulder-land
   gauntlet-boulder-break
   gauntlet-boulder-gone))

(deftype gauntlet-button (basebutton)
  ())

(defun gauntlet-klaww-of ((who handle))
  "The Klaww that who names, or #f once he is gone."
  (let ((proc (handle->process who)))
    (the-as gauntlet-klaww (if (and proc (type-type? (-> proc type) gauntlet-klaww)) proc))))

(defun gauntlet-klaww-process ()
  "Klaww, while he is in the world, or #f."
  (gauntlet-klaww-of (-> *gauntlet-klaww-world* klaww)))

(defun gauntlet-klaww-alive? ()
  "True while he is in the world and not yet beaten."
  (and (gauntlet-klaww-process) (not *gauntlet-klaww-defeated*)))

(defun gauntlet-pelican-at-nest? ((pelican process))
  "True while the pelican sits in the nest in pelican-wait-at-nest, the one state the cannon's explosion, and so Klaww's
   crush, finds it in."
  (let ((state (-> pelican next-state)))
    (and state (= (-> state name) 'pelican-wait-at-nest))))

(defun gauntlet-klaww-pelican-handle ((pelican process))
  "The handle of pelican if it is waiting at its nest, otherwise no process."
  (if (and pelican (gauntlet-pelican-at-nest? pelican))
    (process->handle pelican)
    (the-as handle #f)))

(defun gauntlet-klaww-chest ((klaww gauntlet-klaww) (out vector))
  "Where his chest is in the world, written to out. His skeleton's chest joint once it has been drawn at least once; his
   feet plus the chest's height in the bind pose before that."
  (set! (-> out quad) (-> klaww root trans quad))
  (+! (-> out y) (* GAUNTLET_KLAWW_SCALE GAUNTLET_KLAWW_CHEST))
  (let ((nodes (-> klaww node-list)))
    (when (and nodes (nonzero? nodes) (< (joint-node-index ogreboss-lod0-jg chest) (-> nodes length)))
      (vector<-cspace! out (-> nodes data (joint-node-index ogreboss-lod0-jg chest)))))
  out)

;; ---------------------------------------------------------------- a boulder --

(defbehavior gauntlet-boulder-mark-landing gauntlet-boulder ()
  "Draw where it will land, from the moment it leaves his hand: a steady ring at the radius that will hurt, a second ring that
   closes in on it as the boulder falls and meets it at the instant of the landing, and a glow in the middle. The player
   learns the pattern: step out of the ring before the inner one arrives."
  (let* ((elapsed (the float (- (current-time) (-> self start-time))))
         (progress (fmin 1.0 (/ elapsed (-> self flight)))))
    (gauntlet-ring (-> self land) (-> self radius) 16 (* 40.0 elapsed) *gauntlet-flat-rim*)
    (gauntlet-ring (-> self land) (* (-> self radius) (- 1.0 progress)) 8 (* -80.0 elapsed) *gauntlet-flat-rim*)
    (launch-particles (-> *part-id-table* GAUNTLET_PART_KLAWW_CENTER) (-> self land)))
  0)

(defbehavior gauntlet-boulder-hurt-jak gauntlet-boulder ()
  "It has landed. If Jak is within its radius of the spot, one plain 'attack: his own invulnerability can refuse it, and it
   is never a kill by itself (a Jak with one hit left dies the way any hit would take him). It throws him off away from the
   landing, the way the herd throws him off a yakow."
  (cond
    ((not *target*) (format 0 "GAUNTLET KLAWW landing ~D: MISS, there is no Jak~%" (-> self index)))
    (else
     (let ((distance (vector-vector-distance (-> self land) (target-pos 0))))
       (cond
         ((< distance (-> self radius))
          (let ((away (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> self land))))
            (set! (-> away y) 0.0)
            ;; standing exactly on the spot has no direction away from it, so use the way the boulder was flying
            (if (< (vector-xz-length away) 40.96)
              (set! (-> away quad) (-> self trajectory initial-velocity quad)))
            (set! (-> away y) 0.0)
            (vector-xz-normalize! away GAUNTLET_KLAWW_SHOVE_BACK)
            (set! (-> away y) GAUNTLET_KLAWW_SHOVE_UP)
            (let ((hurt (send-event *target*
                                    'attack
                                    #f
                                    (static-attack-info ((mode 'generic) (shove-back GAUNTLET_KLAWW_SHOVE_BACK) (shove-up GAUNTLET_KLAWW_SHOVE_UP) (vector away))))))
              (format 0 "GAUNTLET KLAWW landing ~D: ~S, Jak ~M m from the impact (radius ~M m)~%"
                      (-> self index) (if hurt "HIT" "SPARED, invulnerable") distance (-> self radius)))))
         (else
          (format 0 "GAUNTLET KLAWW landing ~D: MISS, Jak ~M m from the impact (radius ~M m)~%"
                  (-> self index) distance (-> self radius)))))))
  0)

(defbehavior gauntlet-boulder-post gauntlet-boulder ()
  "Tumble it, as the ogre's own boulders do, and draw it."
  (quaternion*! (-> self root quat) (-> self root quat) (-> self tumble))
  (ja-post)
  0)

(defstate gauntlet-boulder-fly (gauntlet-boulder)
  :trans
    (behavior ()
      (let ((elapsed (the float (- (current-time) (-> self start-time)))))
        ;; no Klaww to reach any more (he was taken away mid-flight): a returned boulder is gone with him
        (if (and (-> self returned) (not (gauntlet-klaww-of (-> self klaww))))
          (go gauntlet-boulder-gone))
        ;; the whole arc is fixed at the throw: where it is now is only a function of the time since
        (eval-position! (-> self trajectory) (fmin elapsed (-> self flight)) (-> self root trans))
        ;; his own boulders mark where they will land; a returned one is no danger to Jak and marks nothing
        (if (not (-> self returned)) (gauntlet-boulder-mark-landing))
        (spawn (-> self part) (-> self root trans))
        (when (>= elapsed (-> self flight))
          (if (-> self returned)
            (go gauntlet-boulder-break)
            (go gauntlet-boulder-land)))))
  :code
    (behavior ()
      (loop
        (suspend)))
  :post gauntlet-boulder-post)

(defstate gauntlet-boulder-land (gauntlet-boulder)
  :code
    (behavior ()
      (set! (-> self root trans quad) (-> self land quad))
      (sound-play "explosion" :position #f)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f (-> self land) :to *entity-pool*)
      (when (and *target* (< (vector-vector-distance (-> self land) (target-pos 0)) (meters 80)))
        (activate! *camera-smush-control* 819.2 37 600 1.0 0.995))
      (gauntlet-boulder-hurt-jak)
      (ja-channel-set! 0)
      (suspend-for (seconds 0.5))
      (deactivate self))
  :post ja-post)

(defstate gauntlet-boulder-gone (gauntlet-boulder)
  :code
    (behavior ()
      (deactivate self)))

(defstate gauntlet-boulder-break (gauntlet-boulder)
  :code
    (behavior ()
      (set! (-> self root trans quad) (-> self land quad))
      (format 0 "GAUNTLET KLAWW boulder ~D hit his chest~%" (-> self index))
      (sound-play "explosion" :position #f)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f (-> self land) :to *entity-pool*)
      (activate! *camera-smush-control* 819.2 37 600 1.0 0.995)
      (let ((klaww (gauntlet-klaww-of (-> self klaww))))
        (if klaww (send-event klaww 'hit)))
      ;; the ogre's own boulder bursts into pieces (ogreboss-rock-explosion-effect): a manipy plays the break once, turned at random
      (let ((pieces (manipy-spawn (-> self land) #f *gauntlet-klaww-boulder-break-sg* #f :to self)))
        (ja-channel-set! 0)
        (when pieces
          (let ((pieces-handle (ppointer->handle pieces))
                (turn (new 'stack-no-clear 'quaternion)))
            (quaternion-axis-angle! turn 0.0 1.0 0.0 (* 65536.0 (rand-vu)))
            (send-event (handle->process pieces-handle) 'rot-quat turn)
            (send-event (handle->process pieces-handle) 'anim-mode 'play1)
            (set-time! (-> self state-time))
            ;; the pieces end themselves when the break is over; a stuck one is not waited for
            (suspend)
            (while (and (handle->process pieces-handle) (not (time-elapsed? (-> self state-time) (seconds 4))))
              (suspend)))))
      (deactivate self))
  :post ja-post)

(defbehavior gauntlet-boulder-setup gauntlet-boulder ((src vector) (dest vector) (index int) (speed float) (gravity float) (klaww handle))
  "Appear at src and fly to dest on a fixed ballistic arc: gravity and flight time are taken now, the flight time from the
   distance at speed sideways, and nothing about the arc ever changes again. Nothing steers it, nothing tracks anyone, and
   it collides with nothing on the way: the landing is what it is about. klaww is the Klaww a boulder thrown back at him
   is for, and no process for one he throws; the flight and what happens at the end differ by that."
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self index) index)
  (set! (-> self klaww) klaww)
  (set! (-> self returned) (if (handle->process klaww) #t #f))
  (set! (-> self radius) *gauntlet-klaww-boulder-radius*)
  (set! (-> self land quad) (-> dest quad))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> src quad))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (let* ((distance (vector-vector-xz-distance src dest))
         (seconds-in-air (fmax GAUNTLET_KLAWW_BOULDER_MIN_FLIGHT (/ distance speed)))
         (ticks-per-second (the float (seconds 1)))
         (per-tick (- (/ gravity (* ticks-per-second ticks-per-second)))))
    (set! (-> self flight) (* seconds-in-air ticks-per-second))
    ;; the trajectory is evaluated in ticks, as the ogre's missile does
    (setup-from-to-duration! (-> self trajectory) src dest (-> self flight) per-tick)
    (format 0 "GAUNTLET KLAWW ~A ~D: boulder from ~M ~M ~M" (if (-> self returned) "shot" "throw") index (-> src x) (-> src y) (-> src z))
    (format 0 " aimed at ~M ~M ~M, ~M m away, ~F s in the air~%" (-> dest x) (-> dest y) (-> dest z) distance seconds-in-air))
  (let ((spin (* DEGREES_PER_ROT (rand-vu))))
    (quaternion-axis-angle! (-> self tumble) (cos spin) 0.0 (sin spin) 2730.6667))
  (initialize-skeleton self *gauntlet-klaww-boulder-sg* '())
  (set-vector! (-> self draw color-emissive) 0.125 0.0625 0.0 0.0)
  (set! (-> self part) (create-launch-control (get-part-group GAUNTLET_PART_GROUP_KLAWW_TRAIL) self))
  (set-time! (-> self start-time))
  (go gauntlet-boulder-fly)
  (none))

(defbehavior gauntlet-boulder-init-by-other gauntlet-boulder ((src vector) (dest vector) (index int))
  "One of his own, from src, his claw, to dest, the ground under where Jak stood."
  (gauntlet-boulder-setup src dest index GAUNTLET_KLAWW_BOULDER_SPEED GAUNTLET_KLAWW_BOULDER_GRAVITY (the-as handle #f))
  (none))

(defbehavior gauntlet-boulder-return-init-by-other gauntlet-boulder ((src vector) (dest vector) (index int) (klaww handle))
  "One a button threw back, from src, just above the button, to dest, his chest as it was at the throw."
  (gauntlet-boulder-setup src dest index GAUNTLET_KLAWW_SHOT_SPEED GAUNTLET_KLAWW_SHOT_GRAVITY klaww)
  (none))

;; ------------------------------------------------------------------- Klaww --

(defbehavior gauntlet-klaww-face-jak gauntlet-klaww ()
  "Turn toward Jak, the way the sage does."
  (if *target*
    (seek-to-point-toward-point! (-> self root) (target-pos 0) 524288.0 (seconds 0.1)))
  0)

(defbehavior gauntlet-klaww-ready? gauntlet-klaww ()
  "True when it is time for the next throw: he is on, Jak is within range and in a state worth throwing at (not dying, not
   in a cutscene), and the interval has passed since the last boulder left his hand. The wind-up is part of the interval:
   the next wind-up starts early by as long as the last one took."
  (and *gauntlet-klaww-enabled*
       *target*
       (not (logtest? (-> *target* state-flags) (state-flags dying grabbed)))
       (>= *gauntlet-klaww-range* (vector-vector-xz-distance (-> self root trans) (target-pos 0)))
       (time-elapsed? (-> self last-throw) (max 0 (- *gauntlet-klaww-throw-interval* (-> self windup))))))

(defbehavior gauntlet-klaww-release gauntlet-klaww ()
  "The boulder leaves his claw, aimed at the ground under where Jak stands right now: that is the whole aim. How long the
   wind-up took is remembered, so the interval can count it."
  (set! (-> self windup) (- (current-time) (-> self state-time)))
  (set-time! (-> self last-throw))
  (+! *gauntlet-klaww-throws* 1)
  (when *target*
    (let ((aim (new 'stack-no-clear 'vector))
          (claw (new 'stack-no-clear 'vector)))
      (gauntlet-ground-below (target-pos 0) aim)
      (vector<-cspace! claw (-> self node-list data (joint-node-index ogreboss-lod0-jg Rclaw_topC)))
      (process-spawn gauntlet-boulder :init gauntlet-boulder-init-by-other claw aim *gauntlet-klaww-throws* :to self)))
  0)

(defbehavior gauntlet-klaww-take-hit gauntlet-klaww ()
  "A boulder has reached his chest: one more of GAUNTLET_KLAWW_MAX_HITS. He flinches, and the third hit brings him down."
  (when (< *gauntlet-klaww-hits* GAUNTLET_KLAWW_MAX_HITS)
    (+! *gauntlet-klaww-hits* 1)
    (format 0 "GAUNTLET KLAWW hit ~D of ~D~%" *gauntlet-klaww-hits* GAUNTLET_KLAWW_MAX_HITS)
    (if (>= *gauntlet-klaww-hits* GAUNTLET_KLAWW_MAX_HITS)
      (go gauntlet-klaww-die)
      (go gauntlet-klaww-hit)))
  0)

(defbehavior gauntlet-klaww-event gauntlet-klaww ((proc process) (argc int) (message symbol) (block event-message-block))
  "The only thing he listens to is a boulder reaching his chest."
  (case message
    (('hit) (gauntlet-klaww-take-hit) #t)
    (else #f)))

(defstate gauntlet-klaww-fall (gauntlet-klaww)
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (format 0 "GAUNTLET KLAWW fall starts, ~M m above ~M ~M ~M~%"
              GAUNTLET_KLAWW_FALL_HEIGHT (-> self landing x) (-> self landing y) (-> self landing z)))
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak)
      ;; the whole drop is a function of the time since it began: plain gravity from rest, no steering
      (let* ((fallen (gauntlet-seconds-since (-> self state-time)))
             (above (- GAUNTLET_KLAWW_FALL_HEIGHT (* 0.5 GAUNTLET_KLAWW_FALL_GRAVITY fallen fallen))))
        (set! (-> self root trans y) (+ (-> self landing y) (fmax 0.0 above)))
        ;; where he will land, drawn the way a boulder's landing is: a steady ring and one that closes in as he nears the ground
        (gauntlet-ring (-> self landing) GAUNTLET_KLAWW_LAND_RADIUS 16 (* 40.0 fallen) *gauntlet-flat-rim*)
        (gauntlet-ring (-> self landing) (* GAUNTLET_KLAWW_LAND_RADIUS (/ (fmax 0.0 above) GAUNTLET_KLAWW_FALL_HEIGHT)) 8 (* -80.0 fallen) *gauntlet-flat-rim*)
        (launch-particles (-> *part-id-table* GAUNTLET_PART_KLAWW_CENTER) (-> self landing))
        (if (>= 0.0 above) (go gauntlet-klaww-land))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.2))
      (loop
        (ja-no-eval :group! ogreboss-idle-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!)))))
  :post ja-post)

(defbehavior gauntlet-klaww-crush-pelican gauntlet-klaww ()
  "He has landed: if the pelican is still in the nest under him, it is blown up, with the cannon's explosion but without the
   cell, which he now holds. If it is not there (it was spit at, the console dropped him with it away, he landed off the
   beach) he keeps no pelican and so has no cell to give up."
  (let ((pelican (handle->process (-> self pelican))))
    (cond
      ((and pelican (gauntlet-pelican-at-nest? pelican))
       (format 0 "GAUNTLET KLAWW pelican crushed~%")
       (send-event pelican 'gauntlet-crush))
      (else
       (set! (-> self pelican) (the-as handle #f))
       (format 0 "GAUNTLET KLAWW lands with no pelican to crush~%"))))
  0)

(defstate gauntlet-klaww-land (gauntlet-klaww)
  :event gauntlet-klaww-event
  :code
    (behavior ()
      (set! (-> self root trans quad) (-> self landing quad))
      (format 0 "GAUNTLET KLAWW landed at ~M ~M ~M~%" (-> self landing x) (-> self landing y) (-> self landing z))
      (sound-play "explosion" :position #f)
      (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f (-> self landing) :to *entity-pool*)
      (when (and *target* (< (vector-vector-distance (-> self landing) (target-pos 0)) GAUNTLET_KLAWW_QUAKE_RANGE))
        (activate! *camera-smush-control* 819.2 37 600 1.0 0.995))
      (gauntlet-klaww-crush-pelican)
      ;; the ogre's own roar, which it opens its fight with
      (ja-channel-push! 1 (seconds 0.1))
      (ja-no-eval :group! ogreboss-roar-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (gauntlet-klaww-face-jak)
        (suspend)
        (ja :num! (seek!)))
      ;; the first throw waits one interval from the end of the roar
      (set-time! (-> self last-throw))
      (go gauntlet-klaww-idle))
  :post ja-post)

(defstate gauntlet-klaww-idle (gauntlet-klaww)
  :event gauntlet-klaww-event
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak)
      (if (gauntlet-klaww-ready?) (go gauntlet-klaww-throw)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.2))
      (loop
        (ja-no-eval :group! ogreboss-idle-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!)))))
  :post ja-post)

;; The three animations the ogre's own attack uses, in its order: attack2-start raises the arm (the wind-up, and the warning
;; to a player watching him), the boulder leaves his claw as attack2-loop begins, and attack2-last brings the arm back.
(defstate gauntlet-klaww-throw (gauntlet-klaww)
  :event gauntlet-klaww-event
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.1))
      (ja-no-eval :group! ogreboss-attack2-start-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!)))
      (gauntlet-klaww-release)
      (ja-no-eval :group! ogreboss-attack2-loop-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!)))
      (ja-no-eval :group! ogreboss-attack2-last-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!)))
      (go gauntlet-klaww-idle))
  :post ja-post)

;; The flinch, the way the original fight shows a boulder landing on him (ogreboss-blend-hit-anim in levels/ogre/ogreboss.gc): the
;; hit-chest animation's first eight frames blended over whatever he is doing, strongly (0.9) for the middle of the flinch and
;; eased in and out, with the base animation carrying on underneath. Hits one and two are this; the last hit is the full
;; ogreboss-hit animation, which the original plays for the boulder that finishes a stage.
(defbehavior gauntlet-klaww-blend-flinch gauntlet-klaww ()
  "Set the hit-chest channel for this moment of the flinch: how far through it (phase, 0 to 1) picks the frame, and the
   weight rises over the first sixth, holds, and falls away over the second half."
  (let* ((phase (fmin 1.0 (/ (the float (- (current-time) (-> self state-time))) (the float GAUNTLET_KLAWW_FLINCH))))
         (weight (cond
                   ((< phase 0.16666667) (* 5.4 phase))
                   ((< phase 0.5) 0.9)
                   (else (* 1.8 (- 1.0 phase)))))
         (first-frame (ja-aframe 0.0 1)))
    (ja :chan 1
        :frame-interp weight
        :num-func num-func-identity
        :frame-num (+ first-frame (* phase (- (ja-aframe 8.0 1) first-frame)))))
  0)

;; A hit during a wind-up cancels the throw, which is a reward for the button.
(defstate gauntlet-klaww-hit (gauntlet-klaww)
  :event gauntlet-klaww-event
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (gauntlet-klaww-face-jak))
  :code
    (behavior ()
      ;; the base animation carries on in channel 0; the flinch is laid over it in channel 1
      (ja-channel-push! 2 (seconds 0.05))
      (ja-no-eval :group! ogreboss-idle-ja :num! (seek!) :frame-num 0.0)
      (ja :chan 1 :group! ogreboss-hit-chest-ja :num! min :frame-interp 0.0)
      (until (time-elapsed? (-> self state-time) GAUNTLET_KLAWW_FLINCH)
        (gauntlet-klaww-blend-flinch)
        (suspend)
        (ja :num! (seek!)))
      (go gauntlet-klaww-idle))
  :post ja-post)

(defstate gauntlet-klaww-die (gauntlet-klaww)
  :enter
    (behavior ()
      (set! *gauntlet-klaww-defeated* #t)
      (format 0 "GAUNTLET KLAWW defeated: ~D hits, ~D boulders thrown, ~D buttons pressed~%"
              *gauntlet-klaww-hits* *gauntlet-klaww-throws* *gauntlet-klaww-presses*))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.2))
      (ja-no-eval :group! ogreboss-hit-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!)))
      (go gauntlet-klaww-gone))
  :post ja-post)

(defbehavior gauntlet-klaww-give-up-cell gauntlet-klaww ()
  "He has fallen: the cell he took from the pelican falls out of him at the nest. The pelican, blown up and waiting in the
   nest, births it the way its explosion does (pelican-release-cell), including the check that Jak has not got it already."
  (let ((pelican (handle->process (-> self pelican))))
    (cond
      (pelican (send-event pelican 'gauntlet-release))
      (else (format 0 "GAUNTLET KLAWW had no cell to give up~%"))))
  0)

(defstate gauntlet-klaww-gone (gauntlet-klaww)
  :code
    (behavior ()
      (let ((chest (gauntlet-klaww-chest self (new 'stack-no-clear 'vector))))
        (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_KLAWW_IMPACT) 300 #f #f #f chest :to *entity-pool*))
      (sound-play "explosion" :position #f)
      (gauntlet-klaww-give-up-cell)
      (deactivate self)))

(defbehavior gauntlet-klaww-init-by-other gauntlet-klaww ((feet vector) (pelican handle))
  "Appear GAUNTLET_KLAWW_FALL_HEIGHT above feet, where his feet will land, facing Jak, and fall. pelican is the one he is to
   crush on landing, or no process. Scaled down to GAUNTLET_KLAWW_SCALE, culled and lit around his chest as the ogre is."
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) #f)
  (set! (-> self pelican) pelican)
  (set! (-> self landing quad) (-> feet quad))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> feet quad))
  (+! (-> self root trans y) GAUNTLET_KLAWW_FALL_HEIGHT)
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) GAUNTLET_KLAWW_SCALE GAUNTLET_KLAWW_SCALE GAUNTLET_KLAWW_SCALE 1.0)
  (if *target*
    (point-toward-point! (-> self root) (target-pos 0)))
  (initialize-skeleton self *gauntlet-klaww-sg* '())
  (set! (-> self draw origin-joint-index) (the uint (joint-node-index ogreboss-lod0-jg chest)))
  ;; the first throw waits one interval, so Jak arriving on the beach is not met with a boulder
  (set! (-> self windup) (seconds 1))
  (set-time! (-> self last-throw))
  (format 0 "GAUNTLET KLAWW spawned to land at ~M ~M ~M, scale ~F~%" (-> feet x) (-> feet y) (-> feet z) GAUNTLET_KLAWW_SCALE)
  (go gauntlet-klaww-fall)
  (none))

;; ----------------------------------------------------------------- a button --

(defun gauntlet-button-fire ((button gauntlet-button))
  "The button has been pressed: one of Klaww's own boulders flies from the button to his chest, if there is a Klaww to hit.
   The arc is fixed from the chest as it is at this moment. A button is pressed once (it stays down), so a press is a shot
   that can never be taken back or taken twice."
  (+! *gauntlet-klaww-presses* 1)
  (format 0 "GAUNTLET KLAWW button ~D pressed, ~D of ~D~%" (-> button button-id) *gauntlet-klaww-presses* (gauntlet-klaww-button-count))
  (let ((klaww (gauntlet-klaww-process)))
    (cond
      ((or (not klaww) *gauntlet-klaww-defeated*)
       (format 0 "GAUNTLET KLAWW button ~D: there is no Klaww to hit~%" (-> button button-id)))
      (else
       (let ((src (new 'stack-no-clear 'vector))
             (chest (new 'stack-no-clear 'vector)))
         (set! (-> src quad) (-> button root trans quad))
         (+! (-> src y) GAUNTLET_KLAWW_SHOT_LIFT)
         (gauntlet-klaww-chest klaww chest)
         (process-spawn gauntlet-boulder
                        :init gauntlet-boulder-return-init-by-other
                        src
                        chest
                        (-> button button-id)
                        (process->handle klaww)
                        :to *entity-pool*)))))
  0)

(defmethod basebutton-method-29 ((this gauntlet-button) (event symbol) (notify entity))
  "What the button announces when it goes down. The engine's button calls this with 'trigger as it starts to go down (that is
   what arm-trigger-event! sets) and with #f when it arrives, which is not a press. The stock method sends the event to an
   actor or an actor link, of which this button has neither."
  (if (= event 'trigger) (gauntlet-button-fire this))
  (none))

(defbehavior gauntlet-button-init-by-other gauntlet-button ((index int) (ground vector))
  "A button, numbered index, standing on ground. What basebutton-init-by-other does for the game's own spawned buttons (no
   entity, no actor to notify, never resets), with the skeleton asked for from the common art."
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause))
  (reset! self)
  (set! (-> self spawned-by-other?) #t)
  (set! (-> self button-id) index)
  (set! (-> self down?) #f)
  (set! (-> self notify-actor) #f)
  (set! (-> self timeout) 0.0)
  (set! (-> self entity) #f)
  (basebutton-method-27 self)
  (set! (-> self root trans quad) (-> ground quad))
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (arm-trigger-event! self)
  ;; basebutton-method-26, with our skelgroup: the up pose on the first frame of the idle animation
  (initialize-skeleton self *gauntlet-button-sg* '())
  (logior! (-> self skel status) (janim-status inited))
  (ja-channel-set! 1)
  (ja :group! generic-button-idle-ja :num! min)
  (set! (-> self anim-speed) 2.0)
  (update-transforms! (-> self root))
  (ja-post)
  (go-virtual basebutton-startup)
  (none))

;; ------------------------------------------------------------ the fight --

(defun gauntlet-klaww-ground ((spot vector) (out vector))
  "The ground under spot, a height picked by hand from an actor list, written to out: probed for from
   GAUNTLET_KLAWW_PROBE_RAISE above it, and spot's own height when there is none to be found."
  (let ((probe (new 'stack-no-clear 'vector)))
    (set! (-> probe quad) (-> spot quad))
    (+! (-> probe y) GAUNTLET_KLAWW_PROBE_RAISE)
    (gauntlet-ground-below probe out)
    ;; a probe that found nothing hands back its own start
    (if (>= (-> out y) (-> probe y))
      (set! (-> out y) (-> spot y))))
  out)

(defun gauntlet-klaww-arrive! ((feet vector) (home symbol) (pelican handle))
  "Drop Klaww onto feet, in the level called home, to crush pelican (or no process) as he lands. The pelican that announced
   itself is spoken for from here."
  (set! *gauntlet-klaww-home* home)
  (set! (-> *gauntlet-klaww-world* pelican) (the-as handle #f))
  (let ((klaww (process-spawn gauntlet-klaww :init gauntlet-klaww-init-by-other feet pelican :to *entity-pool*)))
    (when klaww
      (set! (-> *gauntlet-klaww-world* klaww) (ppointer->handle klaww))))
  0)

(defun gauntlet-klaww-landed? ()
  "True once he has landed: any state of his but the fall."
  (let* ((klaww (gauntlet-klaww-process))
         (state (if klaww (-> klaww next-state))))
    (and state (!= (-> state name) 'gauntlet-klaww-fall))))

(defun gauntlet-level-name ()
  "The name of the level Jak is inside, or none between levels."
  (let ((lev (level-get-target-inside *level*)))
    (if lev (-> lev name) 'none)))

(defun gauntlet-klaww-keep-button! ((index int) (x float) (y float) (z float))
  "Make sure button index is standing at its row of the table, in meters x y z (as game units here), on whatever ground is
   found under the y it was given."
  (when (and (< index GAUNTLET_KLAWW_BUTTONS) (not (handle->process (-> *gauntlet-klaww-world* buttons index))))
    (let ((spot (new 'stack-no-clear 'vector))
          (ground (new 'stack-no-clear 'vector)))
      (set-vector! spot x y z 1.0)
      (gauntlet-klaww-ground spot ground)
      (let ((button (process-spawn gauntlet-button :init gauntlet-button-init-by-other index ground :to *entity-pool*)))
        (when button
          (set! (-> *gauntlet-klaww-world* buttons index) (ppointer->handle button))
          (format 0 "GAUNTLET KLAWW button ~D stands at ~M ~M ~M (the table said ~M high)~%"
                  index (-> ground x) (-> ground y) (-> ground z) y)))))
  0)

(defmacro gauntlet-row-button-keep (index x y z)
  `(gauntlet-klaww-keep-button! ,index (meters ,x) (meters ,y) (meters ,z)))

(defun gauntlet-klaww-art-ready? ()
  "True when everything that is drawn is in the common art."
  (and (gauntlet-art-ready? *gauntlet-klaww-sg*)
       (gauntlet-art-ready? *gauntlet-klaww-boulder-sg*)
       (gauntlet-art-ready? *gauntlet-klaww-boulder-break-sg*)
       (gauntlet-art-ready? *gauntlet-button-sg*)))

(defun gauntlet-klaww-keep! ()
  "Jak is on the beach. Klaww falls when the pelican has said it is at its nest with the cell and he has not been dropped
   yet; once he has landed the buttons stand on their spots, until he is beaten. A beaten Klaww is not dropped again, and the
   buttons that are down stay down, until Jak leaves. The buttons wait for the landing so that no press is spent on a Klaww
   who is not there to be hit."
  (when (not *gauntlet-klaww-defeated*)
    (cond
      ((not (gauntlet-klaww-art-ready?))
       (when (not *gauntlet-klaww-art-told*)
         (set! *gauntlet-klaww-art-told* #t)
         (format 0 "GAUNTLET KLAWW: the art for him or the button is not loaded, nothing spawned~%")))
      ((gauntlet-klaww-process)
       (if (gauntlet-klaww-landed?) (gauntlet-klaww-button-table gauntlet-row-button-keep)))
      ((handle->process (-> *gauntlet-klaww-world* pelican))
       (let ((pelican (gauntlet-klaww-pelican-handle (handle->process (-> *gauntlet-klaww-world* pelican))))
             (feet (new 'stack-no-clear 'vector)))
         ;; the pelican may have left the nest again since it announced itself (it was spit at): then there is nothing to fall on
         (cond
           ((handle->process pelican)
            (gauntlet-klaww-ground *gauntlet-klaww-nest* feet)
            (gauntlet-klaww-arrive! feet 'beach pelican))
           (else (set! (-> *gauntlet-klaww-world* pelican) (the-as handle #f))))))))
  0)

(defun gauntlet-klaww-pelican-at-nest! ((pelican process))
  "The pelican has landed at its nest with the stolen cell (or the level has loaded with it there). Only a note is made
   here: the poll sends Klaww when Jak is on the beach and everything he draws is loaded."
  (format 0 "GAUNTLET KLAWW pelican at its nest with the cell~%")
  (set! (-> *gauntlet-klaww-world* pelican) (process->handle pelican))
  (none))

(defun gauntlet-klaww-any-button? ()
  "True while any button is in the world."
  (dotimes (i GAUNTLET_KLAWW_BUTTONS)
    (if (handle->process (-> *gauntlet-klaww-world* buttons i)) (return #t)))
  #f)

(defun gauntlet-klaww-remove ((who handle))
  "Take a process out of the world, if it is still there."
  (let ((proc (handle->process who)))
    (if proc (deactivate proc)))
  0)

(defun gauntlet-klaww-reset! ((why string))
  "Back to before Jak came: Klaww, the buttons, the count of hits and the beaten flag all gone. Boulders in the air are his
   children, so they go with him; boulders thrown back at him vanish in the air, with nothing to reach. Says so only when there was
   something to reset."
  (when (or (gauntlet-klaww-process) (gauntlet-klaww-any-button?) (> *gauntlet-klaww-hits* 0) (> *gauntlet-klaww-presses* 0) *gauntlet-klaww-defeated* *gauntlet-klaww-home*)
    (gauntlet-klaww-remove (-> *gauntlet-klaww-world* klaww))
    (dotimes (i GAUNTLET_KLAWW_BUTTONS)
      (gauntlet-klaww-remove (-> *gauntlet-klaww-world* buttons i)))
    (gauntlet-klaww-forget-all!)
    (set! *gauntlet-klaww-hits* 0)
    (set! *gauntlet-klaww-presses* 0)
    (set! *gauntlet-klaww-throws* 0)
    (set! *gauntlet-klaww-defeated* #f)
    (set! *gauntlet-klaww-home* #f)
    (format 0 "GAUNTLET KLAWW reset: ~S~%" why))
  (set! *gauntlet-klaww-art-told* #f)
  0)

(defun gauntlet-klaww-left-home? ()
  "True when there is a fight and Jak is inside a level that is not its home. Between levels he is inside none, which is
   not leaving."
  (let ((lev (level-get-target-inside *level*)))
    (and *gauntlet-klaww-home* lev (!= (-> lev name) *gauntlet-klaww-home*))))

(defun gauntlet-klaww-drop! ()
  "The console's Klaww, on any level: he falls and fights. On the beach it is the pelican's story, onto the nest, crushing
   the pelican if it is at its nest and otherwise just landing. Anywhere else he falls GAUNTLET_KLAWW_AHEAD in front of where
   Jak faces, and there is no pelican and no cell. Buttons only exist at the beach, so off it he throws until Jak leaves the
   level or the console turns him off. A Klaww already there, or beaten, is taken away first: asking again is a fresh fight."
  (cond
    ((not *target*) (format 0 "GAUNTLET DROP: Klaww asked for with no Jak in the world~%"))
    ((not *gauntlet-klaww-enabled*) (format 0 "GAUNTLET DROP: Klaww asked for while he is turned off, ignored~%"))
    ((not (gauntlet-klaww-art-ready?)) (format 0 "GAUNTLET DROP: Klaww's art or the button is not loaded, nothing dropped~%"))
    (else
     (gauntlet-klaww-reset! "asked for again")
     (let ((feet (new 'stack-no-clear 'vector)))
       (cond
         ((gauntlet-in-level? 'beach)
          (gauntlet-klaww-ground *gauntlet-klaww-nest* feet)
          (gauntlet-klaww-arrive! feet 'beach (gauntlet-klaww-pelican-handle (process-by-ename "pelican-1"))))
         (else
          (let ((heading (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> *target* control quat-for-control)))
                (spot (new 'stack-no-clear 'vector)))
            (set! (-> heading y) 0.0)
            (vector-xz-normalize! heading GAUNTLET_KLAWW_AHEAD)
            (vector+! spot (target-pos 0) heading)
            (gauntlet-klaww-ground spot feet)
            (gauntlet-klaww-arrive! feet (gauntlet-level-name) (the-as handle #f))))))))
  0)

(defun gauntlet-klaww-poll! ()
  "Per-frame: a fight ends when Jak leaves the level it is in (or the setting goes off), and is forgotten; on the beach the
   pelican's arrival sends Klaww and, once he has landed, the buttons. With no Jak (dying, loading) nothing changes, so a
   death on the beach does not reset the fight."
  (cond
    ((not *target*))
    ((not *gauntlet-klaww-enabled*) (gauntlet-klaww-reset! "turned off"))
    ((gauntlet-klaww-left-home?) (gauntlet-klaww-reset! "Jak left the level"))
    ((gauntlet-in-level? 'beach) (gauntlet-klaww-keep!)))
  0)

;; ------------------------------------------------------------------ the horde --

;; Every enemy the level places that runs on the nav mesh (a babak, a lurker crab, a hopper, a bonelurker, an ice cube...) is
;; born with company: *gauntlet-lurker-multiplier* minus one clones, standing on a ring around it. A clone is the same
;; process, born by the same init-from-entity! from the same entity, but the entity's own process stays the original: the
;; entity system's bookkeeping (dead, complete, culled when Jak walks away) is the original's alone, and process-entity-status!
;; and entity-deactivate-handler both ignore a process that is not the one the entity names, so a clone dying or being
;; taken away never marks the entity dead and never clears the original. engine/entity/entity.gc calls *entity-born-hook*
;; after each birth; this is what answers.
;;
;; The entity system does not know the clones, so the mod ends them. Their entity is the original's, which is what makes the
;; engine itself take them away when their level unloads (deactivate-entities sweeps *entity-pool* for processes whose entity
;; is in the level). One small watcher per birth does the rest: it ends the clones when the original is culled by distance
;; (a fresh original with fresh clones is born when Jak comes back, so they do not pile up), and ends itself when no clone
;; is left. A clone outlives an original that was killed, as a lurker outlives its neighbour.

(defconstant GAUNTLET_HORDE_MAX_CLONES 4) ;; the console's multiplier tops out at 5: the original and four clones. gauntlet-horde holds this many handles
(defconstant GAUNTLET_HORDE_RING_RADIUS (meters 3)) ;; clones stand this far from the original, evenly around it

(deftype gauntlet-horde (process)
  ((ent        entity-actor) ;; the actor the clones are of; its memory is its level's, so it is read only while that level is active
   (original   handle) ;; the actor's own process, the one the entity system manages
   (level-name symbol) ;; the level the actor belongs to
   (label      string) ;; the actor's name, copied: the entity's own is in the level's memory, which is gone when the level is
   (clones     handle 4)) ;; GAUNTLET_HORDE_MAX_CLONES of them, a null handle (not a zero) where there is none
  (:states
   gauntlet-horde-watch))

(defbehavior gauntlet-horde-clones-alive gauntlet-horde ()
  "How many of the clones are still alive."
  (let ((alive 0))
    (dotimes (i GAUNTLET_HORDE_MAX_CLONES)
      (if (handle->process (-> self clones i)) (+! alive 1)))
    alive))

(defbehavior gauntlet-horde-remove-clones gauntlet-horde ()
  "Take away every clone still alive."
  (dotimes (i GAUNTLET_HORDE_MAX_CLONES)
    (let ((alive (handle->process (-> self clones i))))
      (if alive (deactivate alive))))
  0)

(defbehavior gauntlet-horde-level-left? gauntlet-horde ()
  "True once the level the actor belongs to is no longer the one running: from then on its entity is not to be read."
  (!= (level-status *level* (-> self level-name)) 'active))

(defbehavior gauntlet-horde-walked-away? gauntlet-horde ()
  "True once the original is gone without having been killed: the entity system culled it because Jak walked away (or a
   death reset the actors), and it will be born again, with fresh clones, when he comes back."
  (and (not (handle->process (-> self original)))
       (not (logtest? (-> self ent extra perm status) (entity-perm-status dead)))))

(defstate gauntlet-horde-watch (gauntlet-horde)
  :code
    (behavior ()
      (loop
        (cond
          ((gauntlet-horde-level-left?)
           (gauntlet-horde-remove-clones)
           (format 0 "GAUNTLET HORDE ~S clones culled (level unloaded)~%" (-> self label))
           (deactivate self))
          ((zero? (gauntlet-horde-clones-alive)) (deactivate self))
          ((gauntlet-horde-walked-away?)
           (gauntlet-horde-remove-clones)
           (format 0 "GAUNTLET HORDE ~S clones culled (the original was culled, Jak walked away)~%" (-> self label))
           (deactivate self)))
        (suspend))))

(defbehavior gauntlet-horde-init-by-other gauntlet-horde ((ent entity-actor) (original handle))
  "Watch over the clones of the actor ent, whose own process original names. The clones are put in by the one who spawned us."
  (set! (-> self ent) ent)
  (set! (-> self original) original)
  (set! (-> self level-name) (-> ent extra level name))
  ;; the size must be the name's length: string's new records the size it is given as allocated-length, not the size it
  ;; allocated, and the process relocator walks the heap by asize-of, so a 0 here sent it into the name's characters
  (let ((name (res-lump-struct ent 'name string)))
    (set! (-> self label) (new 'process 'string (length name) name)))
  (dotimes (i GAUNTLET_HORDE_MAX_CLONES)
    (set! (-> self clones i) (the-as handle #f)))
  (go gauntlet-horde-watch)
  (none))

(defun gauntlet-horde-lurker? ((proc process))
  "Whether proc, the process an actor was just born as, is one that gets company: anything on the nav mesh, but the few whose
   story lives in the original. The cannon babak has its cannon, the ram boss its fight, the muse and the lightning moles
   are caught for a power cell the task counts (a mole's task is counted through the actor's links), the sharkey reads the
   actor's own spot every time it comes up so a clone would rise at the original's, and the double lurker marks the actor's
   permanent record and carries a buddy of its own."
  (and (type-type? (-> proc type) nav-enemy)
       (case (-> proc type symbol)
         (('babak-with-cannon 'ram-boss 'muse 'lightning-mole 'sharkey 'double-lurker) #f)
         (else #t))))

(defun gauntlet-horde-clone! ((ent entity-actor) (spot vector))
  "Born one more process of the actor ent's type, standing at spot, and hand back a handle to it, or a null handle when there
   is no process to be had or it died in its own init. This is init-entity (engine/entity/entity.gc) without its two links:
   the process is put in *entity-pool* and given the entity, so the engine's level sweep finds it, but (-> ent extra process)
   is not set, so it stays the original.
   The actor's spot is lent: init-from-entity! reads the process's position from the entity (process-drawable-from-entity!),
   and a nav enemy finds its nav poly at init, so the position must be right then, not moved to afterward. run-now-in-process
   returns only when init is done (or has changed state, or died), and nothing else runs meanwhile, so the loan is
   given back before anyone can see it. The only other reader of the spot is the entity system's own distance test, which is
   not run in the middle of an init."
  (let* ((kind (-> ent etype))
         (info (entity-info-lookup kind))
         (fresh (get-process *default-dead-pool* kind (if info (-> info heap-size) #x4000))))
    (if (not fresh) (return (the-as handle #f)))
    (set! (-> fresh type) kind)
    (activate fresh *entity-pool* (res-lump-struct ent 'name basic) *scratch-memory-top*)
    (set! (-> fresh entity) ent)
    (let ((born (process->handle fresh))
          (home (new 'stack-no-clear 'vector)))
      (set! (-> home quad) (-> ent extra trans quad))
      (set! (-> ent extra trans quad) (-> spot quad))
      (run-now-in-process fresh (method-of-object fresh init-from-entity!) fresh ent)
      (set! (-> ent extra trans quad) (-> home quad))
      ;; whatever the actor drops is the original's: a clone drops pills as an ice cube of the beach does, and never the
      ;; actor's power cell or special pickup. The pickup is made from the actor's lumps in init-defaults!, which has run.
      (let* ((alive (handle->process born))
             (nav (if alive (as-type alive nav-enemy))))
        (when (and nav (nonzero? (-> nav enemy-info)))
          (set! (-> nav enemy-info pickup-type) (pickup-type eco-pill-random))
          (set! (-> nav enemy-info pickup-amount) (-> *FACT-bank* default-pill-inc))
          (logclear! (-> nav enemy-info options) (fact-options has-power-cell))))
      born)))

(defun gauntlet-horde-born! ((ent entity-actor))
  "The actor ent has just been born (the entity system's hook, below). If it came up as a lurker that gets company, and its
   story is not already finished (a babak that gives its power cell back is not to be multiplied), spawn the watcher and
   the clones on a ring around it, the first straight along the z axis, and say so."
  (let* ((original (-> ent extra process))
         (wanted (min (+ *gauntlet-lurker-multiplier* -1) GAUNTLET_HORDE_MAX_CLONES)))
    (when (and original
               (> wanted 0)
               (not (logtest? (-> ent extra perm status) (entity-perm-status complete)))
               (gauntlet-horde-lurker? original))
      (let ((watcher (process-spawn gauntlet-horde :init gauntlet-horde-init-by-other ent (process->handle original) :to *entity-pool*)))
        (when watcher
          (let ((horde (-> watcher 0))
                (home (new 'stack-no-clear 'vector))
                (spot (new 'stack-no-clear 'vector))
                (step (/ (degrees 360) (the float wanted)))
                (born 0))
            (set! (-> home quad) (-> ent extra trans quad))
            ;; a clone is tried only if every one before it was born: the first that is not ends the line
            (dotimes (i wanted)
              (when (= born i)
                (let ((angle (* step (the float i))))
                  (set! (-> spot x) (+ (-> home x) (* GAUNTLET_HORDE_RING_RADIUS (sin angle))))
                  (set! (-> spot y) (-> home y))
                  (set! (-> spot z) (+ (-> home z) (* GAUNTLET_HORDE_RING_RADIUS (cos angle))))
                  (set! (-> spot w) 1.0))
                (let ((twin (gauntlet-horde-clone! ent spot)))
                  (when (handle->process twin)
                    (set! (-> horde clones born) twin)
                    (+! born 1)))))
            (if (< born wanted)
              (format 0 "GAUNTLET HORDE ~S wanted +~D clones and no process was free for the rest~%" (-> horde label) wanted))
            (cond
              ((> born 0) (format 0 "GAUNTLET HORDE ~S ~A +~D clones~%" (-> horde label) (-> original type) born))
              (else (deactivate horde))))))))
  (none))

;; gauntlet: engine/entity/entity.gc calls this after birth! has run for an actor
(defun *entity-born-hook* ((ent entity-actor))
  (gauntlet-horde-born! ent)
  (none))

;; --------------------------------------------------------------- the console --

;; A local web console steers the mod while it runs, through two files in Mods/ (the contract is the console's).
;;   gauntlet-settings.gc  the console writes, the game reads: (revision N) first, then one (key value) per setting, in
;;                         human units (meters, seconds, degrees, #t / #f). Looked at every GAUNTLET_SETTINGS_POLL_FRAMES
;;                         frames, and applied only when the revision is not the one in effect. A file is the whole
;;                         truth: a key it does not name goes back to its default. Unknown keys and values that are not
;;                         numbers (or are outside the key's range) are skipped and logged, never fatal.
;;   gauntlet-state.json   the game writes, the console reads, every GAUNTLET_STATE_POLL_FRAMES frames: the settings in
;;                         effect next to the defaults, and where Jak, the bomb and the bridge are.
;; Every setting is one row of gauntlet-setting-table, which names it, says what unit the file speaks, which global holds
;; it, what its default is and what range it may take; applying, resetting and publishing it are all generated from that
;; row, so a setting cannot be added to one and forgotten in another.

(defconstant GAUNTLET_SETTINGS_POLL_FRAMES 30) ;; how often the settings file is looked at
(defconstant GAUNTLET_STATE_POLL_FRAMES 15) ;; how often the state file is written

(defmacro gauntlet-setting-table (row)
  "Expand row once per setting: (row name unit global default lowest highest). The unit is how the file speaks and
   how the global holds it: seconds (file: seconds, global: ticks), meters (file: meters, global: game units, which
   also covers meters per second and per second squared), degrees (file: degrees, global: rotation units), count
   (both a whole number), ratio (both a plain float: a chance, a multiplier), flag (#t or #f). The range is in file
   units and is ignored for a flag."
  `(begin
     (,row "bomb-countdown" seconds *gauntlet-bomb-countdown* GAUNTLET_BOMB_COUNTDOWN_DEFAULT 0.5 120.0)
     (,row "bomb-blast-radius" meters *gauntlet-bomb-blast-radius* GAUNTLET_BOMB_BLAST_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull-radius" meters *gauntlet-bomb-pull-radius* GAUNTLET_BOMB_PULL_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull" meters *gauntlet-bomb-pull* GAUNTLET_BOMB_PULL_DEFAULT 0.0 500.0)
     (,row "bomb-ground-pull" meters *gauntlet-bomb-ground-pull* GAUNTLET_BOMB_GROUND_PULL_DEFAULT 0.0 50.0)
     (,row "bomb-drop-height" meters *gauntlet-bomb-drop-height* GAUNTLET_BOMB_DROP_HEIGHT_DEFAULT 0.0 200.0)
     (,row "bomb-gravity" meters *gauntlet-bomb-gravity* GAUNTLET_BOMB_GRAVITY_DEFAULT 1.0 500.0)
     (,row "bridge-enabled" flag *gauntlet-bridge-enabled* GAUNTLET_BRIDGE_ENABLED_DEFAULT 0 0)
     (,row "bridge-trigger-radius" meters *gauntlet-bridge-trigger-radius* GAUNTLET_BRIDGE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "bridge-rearm-range" meters *gauntlet-bridge-rearm-range* GAUNTLET_BRIDGE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "dummies-enabled" flag *gauntlet-dummies-enabled* GAUNTLET_DUMMIES_ENABLED_DEFAULT 0 0)
     (,row "dummy-volley-interval" seconds *gauntlet-dummy-volley-interval* GAUNTLET_DUMMY_VOLLEY_INTERVAL_DEFAULT 0.1 120.0)
     (,row "dummy-volley-gap" seconds *gauntlet-dummy-volley-gap* GAUNTLET_DUMMY_VOLLEY_GAP_DEFAULT 0.05 60.0)
     (,row "dummy-volley-size" count *gauntlet-dummy-volley-size* GAUNTLET_DUMMY_VOLLEY_SIZE_DEFAULT 1.0 50.0)
     (,row "dummy-volley-spread" degrees *gauntlet-dummy-volley-spread* GAUNTLET_DUMMY_VOLLEY_SPREAD_DEFAULT 0.0 90.0)
     (,row "dummy-range" meters *gauntlet-dummy-range* GAUNTLET_DUMMY_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-leave-range" meters *gauntlet-dummy-leave-range* GAUNTLET_SAGE_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-range" meters *gauntlet-herald-range* GAUNTLET_HERALD_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-leave-range" meters *gauntlet-herald-leave-range* GAUNTLET_HERALD_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-shot-speed" meters *gauntlet-dummy-shot-speed* GAUNTLET_DUMMY_SHOT_SPEED_DEFAULT 0.0 500.0)
     (,row "stampede-enabled" flag *gauntlet-stampede-enabled* GAUNTLET_STAMPEDE_ENABLED_DEFAULT 0 0)
     (,row "stampede-herd-size" count *gauntlet-stampede-herd-size* GAUNTLET_STAMPEDE_HERD_SIZE_DEFAULT 1.0 30.0)
     (,row "stampede-speed" meters *gauntlet-stampede-speed* GAUNTLET_STAMPEDE_SPEED_DEFAULT 4.0 30.0)
     (,row "stampede-trigger-radius" meters *gauntlet-stampede-trigger-radius* GAUNTLET_STAMPEDE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "stampede-rearm-range" meters *gauntlet-stampede-rearm-range* GAUNTLET_STAMPEDE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "stampede-red-count" count *gauntlet-stampede-red-count* GAUNTLET_STAMPEDE_RED_COUNT_DEFAULT 0.0 30.0)
     (,row "babak-charge-enabled" flag *gauntlet-babak-charge-enabled* GAUNTLET_BABAK_CHARGE_ENABLED_DEFAULT 0 0)
     (,row "babak-charge-chance" ratio *gauntlet-babak-charge-chance* GAUNTLET_BABAK_CHARGE_CHANCE_DEFAULT 0.0 1.0)
     (,row "babak-blue-speed" ratio *gauntlet-babak-blue-speed* GAUNTLET_BABAK_BLUE_SPEED_DEFAULT 1.0 4.0)
     (,row "worm-cubes-enabled" flag *gauntlet-worm-cubes-enabled* GAUNTLET_WORM_CUBES_ENABLED_DEFAULT 0 0)
     (,row "worm-cube-count" count *gauntlet-worm-cube-count* GAUNTLET_WORM_CUBE_COUNT_DEFAULT 0.0 8.0)
     (,row "lurker-multiplier" count *gauntlet-lurker-multiplier* GAUNTLET_LURKER_MULTIPLIER_DEFAULT 1.0 5.0)
     (,row "klaww-enabled" flag *gauntlet-klaww-enabled* GAUNTLET_KLAWW_ENABLED_DEFAULT 0 0)
     (,row "klaww-throw-interval" seconds *gauntlet-klaww-throw-interval* GAUNTLET_KLAWW_THROW_INTERVAL_DEFAULT 0.5 60.0)
     (,row "klaww-range" meters *gauntlet-klaww-range* GAUNTLET_KLAWW_RANGE_DEFAULT 10.0 500.0)
     (,row "klaww-boulder-radius" meters *gauntlet-klaww-boulder-radius* GAUNTLET_KLAWW_BOULDER_RADIUS_DEFAULT 0.5 30.0)))

;; ---- the settings file

(define *gauntlet-settings-revision* 0) ;; the revision in effect: 0 until a file has been applied
(define *gauntlet-settings-countdown* 0)
(define *gauntlet-settings-applied* 0) ;; keys the file being applied has set so far
(define *gauntlet-settings-bad-revision-told* #f) ;; a file with no revision is told about once, not every poll
(define *gauntlet-setting-key* (new 'global 'string 64 ""))
(define *gauntlet-setting-number* 0.0) ;; what gauntlet-read-number! last read
(define *gauntlet-setting-flag* #f) ;; what gauntlet-read-flag! last read

(defmacro gauntlet-row-reset (name unit global default lo hi)
  "One setting back to its default."
  `(set! ,global ,(if (eq? unit 'seconds) `(the int ,default) default)))

(defmacro gauntlet-row-apply (name unit global default lo hi)
  "If key is this setting, read its value from the file and set the global, or skip the key."
  (if (eq? unit 'flag)
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-flag! file)
         (begin
           (set! ,global *gauntlet-setting-flag*)
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-number! file ,lo ,hi)
         (begin
           (set! ,global
                 ,(cond
                    ((eq? unit 'seconds) '(the int (+ (* *gauntlet-setting-number* 300.0) 0.5)))
                    ((eq? unit 'meters) '(* *gauntlet-setting-number* METER_LENGTH))
                    ((eq? unit 'degrees) '(* *gauntlet-setting-number* (/ DEGREES_PER_ROT 360.0)))
                    ((eq? unit 'ratio) '*gauntlet-setting-number*)
                    (#t '(the int (+ *gauntlet-setting-number* 0.5)))))
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))))

(defun gauntlet-settings-reset! ()
  "Every setting back to its default."
  (gauntlet-setting-table gauntlet-row-reset)
  0)

(defun gauntlet-setting-skip! ((name string))
  "A key whose value is not usable: it keeps its default."
  (format 0 "GAUNTLET SETTINGS ~S skipped, its value is not a usable one~%" name)
  0)

(defun gauntlet-number-word? ((word string))
  "True when word is a plain decimal number: digits, one dot, and a minus sign in front. The game's own string->float
   reads anything as a number (garbage as 0.0), so a value is only trusted after this."
  (let ((digits 0)
        (dots 0)
        (clean #t))
    (dotimes (i (length word))
      (let ((c (-> word data i)))
        (cond
          ((and (>= c #\0) (<= c #\9)) (+! digits 1))
          ((= c #\.) (+! dots 1))
          ((and (= c #\-) (zero? i)))
          (else (set! clean #f)))))
    (and clean (> digits 0) (<= dots 1))))

(defun gauntlet-read-word! ((file file-stream))
  "The next word of the file in *pc-temp-string*, which is empty when the file has no more."
  (set! (-> *pc-temp-string* data 0) 0)
  (file-stream-seek-past-whitespace file)
  (file-stream-read-word file)
  *pc-temp-string*)

(defun gauntlet-read-number! ((file file-stream) (lowest float) (highest float))
  "Read the next word as a number in [lowest, highest] into *gauntlet-setting-number*. False when it is not one."
  (let ((word (gauntlet-read-word! file)))
    (when (gauntlet-number-word? word)
      (let ((value (string->float word)))
        (when (and (>= value lowest) (<= value highest))
          (set! *gauntlet-setting-number* value)
          (return #t)))))
  #f)

(defun gauntlet-read-flag! ((file file-stream))
  "Read the next word as #t or #f into *gauntlet-setting-flag*. False when it is neither."
  (let ((word (gauntlet-read-word! file)))
    (cond
      ((string= word "#t") (set! *gauntlet-setting-flag* #t) #t)
      ((string= word "#f") (set! *gauntlet-setting-flag* #f) #t)
      (else #f))))

(defun gauntlet-skip-past-close ((file file-stream))
  "Read on through the closing bracket of the form being read, whatever is left in it, nested forms included."
  (let ((depth 1))
    (while (> depth 0)
      (let ((c (file-stream-getc file)))
        (cond
          ((= c #x28) (+! depth 1))
          ((= c #x29) (+! depth -1))
          ((= c 255) (set! depth 0))))))
  0)

(defun gauntlet-form-open? ((file file-stream))
  "True when the next thing in the file is an opening bracket, which is read."
  (file-stream-seek-past-whitespace file)
  (= #x28 (file-stream-getc file)))

(defun gauntlet-settings-apply-key! ((file file-stream) (key string))
  "Apply the setting key names, reading its value from the file; an unknown key is skipped."
  (let ((handled #f))
    (gauntlet-setting-table gauntlet-row-apply)
    (when (not handled)
      (format 0 "GAUNTLET SETTINGS ~S skipped, it is not a setting this build knows~%" key)))
  0)

(defun gauntlet-settings-read-revision ((file file-stream))
  "The revision the file opens with, or -1 when its first form is not (revision N)."
  (when (gauntlet-form-open? file)
    (gauntlet-read-word! file)
    (when (string= *pc-temp-string* "revision")
      (let ((word (gauntlet-read-word! file)))
        (when (gauntlet-number-word? word)
          (let ((revision (the int (string->float word))))
            (gauntlet-skip-past-close file)
            (return revision))))))
  -1)

(defun gauntlet-settings-poll! ()
  "Every GAUNTLET_SETTINGS_POLL_FRAMES frames, and on the first look of a boot: read Mods/gauntlet-settings.gc if it is
   there, and if its revision is not the one in effect, put every setting back to its default and apply the file's keys over
   them. A file that has gone away takes the settings it had set with it."
  (+! *gauntlet-settings-countdown* -1)
  (when (>= 0 *gauntlet-settings-countdown*)
    (set! *gauntlet-settings-countdown* GAUNTLET_SETTINGS_POLL_FRAMES)
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-settings.gc" *pc-settings-folder*)
    (cond
      ((not (pc-filepath-exists? *pc-temp-string-1*))
       (when (nonzero? *gauntlet-settings-revision*)
         (gauntlet-settings-reset!)
         (format 0 "GAUNTLET SETTINGS file is gone, defaults restored (was revision ~D)~%" *gauntlet-settings-revision*)
         (set! *gauntlet-settings-revision* 0)))
      (else
       (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
         (when (file-stream-valid? file)
           (let ((revision (gauntlet-settings-read-revision file)))
             (cond
               ((< revision 0)
                (when (not *gauntlet-settings-bad-revision-told*)
                  (set! *gauntlet-settings-bad-revision-told* #t)
                  (format 0 "GAUNTLET SETTINGS file does not open with (revision N), ignored~%")))
               ((= revision *gauntlet-settings-revision*))
               (else
                (set! *gauntlet-settings-bad-revision-told* #f)
                (gauntlet-settings-reset!)
                (set! *gauntlet-settings-applied* 0)
                ;; every form after the revision: its key, then the key's own reader takes the value
                (while (gauntlet-form-open? file)
                  (gauntlet-read-word! file)
                  (format (clear *gauntlet-setting-key*) "~S" *pc-temp-string*)
                  (gauntlet-settings-apply-key! file *gauntlet-setting-key*)
                  (gauntlet-skip-past-close file))
                (set! *gauntlet-settings-revision* revision)
                (format 0 "GAUNTLET SETTINGS revision ~D applied, ~D keys~%" revision *gauntlet-settings-applied*))))
           (file-stream-close file))))))
  0)

;; ---- the state file

(define *gauntlet-frame* 0) ;; polls so far, which is what the state file's frame counts
(define *gauntlet-state-countdown* 0)
(define *gauntlet-state-text* (new 'global 'string 4096 "")) ;; the file is built here and written in one go, so a reader catches as little of it half-written as possible
(define *gauntlet-json-first* #t) ;; true until the object being written has a member, so the next one needs no comma

(defun gauntlet-json-key ((out string) (name string))
  "Start the next member of the object being written: its comma if it needs one, and its name."
  (format out "~S\"~S\":" (if *gauntlet-json-first* "" ",") name)
  (set! *gauntlet-json-first* #f)
  0)

(defun gauntlet-json-open ((out string))
  (format out "{")
  (set! *gauntlet-json-first* #t)
  0)

(defun gauntlet-json-close ((out string))
  (format out "}")
  (set! *gauntlet-json-first* #f)
  0)

(defun gauntlet-json-fixed ((out string) (value float))
  "Append value with three decimals, rounded. format's own ~F cuts digits off instead of rounding them, which would
   turn a 15.0 that went through rotation units and back into 14.9999."
  (let* ((scaled (the int (if (< value 0.0) (- (* value 1000.0) 0.5) (+ (* value 1000.0) 0.5))))
         (magnitude (if (< scaled 0) (- scaled) scaled))
         (whole (/ magnitude 1000))
         (fraction (- magnitude (* whole 1000)))
         (hundreds (/ fraction 100))
         (tens (/ (- fraction (* hundreds 100)) 10))
         (ones (- fraction (* hundreds 100) (* tens 10))))
    (format out "~S~D.~D~D~D" (if (< scaled 0) "-" "") whole hundreds tens ones))
  0)

(defmacro gauntlet-json-row (name unit source)
  "Write one setting, from source (its global or its default), as the member name in the file's own units."
  (cond
    ((eq? unit 'flag) `(begin (gauntlet-json-key out ,name) (format out "~S" (if ,source "true" "false"))))
    ((eq? unit 'count) `(begin (gauntlet-json-key out ,name) (format out "~D" ,source)))
    ((eq? unit 'ratio) `(begin (gauntlet-json-key out ,name) (gauntlet-json-fixed out ,source)))
    (#t
     `(begin
        (gauntlet-json-key out ,name)
        (gauntlet-json-fixed out
                             ,(cond
                                ((eq? unit 'seconds) `(/ (the float ,source) 300.0))
                                ((eq? unit 'meters) `(/ ,source METER_LENGTH))
                                (#t `(/ ,source (/ DEGREES_PER_ROT 360.0)))))))))

(defmacro gauntlet-row-write-now (name unit global default lo hi)
  `(gauntlet-json-row ,name ,unit ,global))

(defmacro gauntlet-row-write-default (name unit global default lo hi)
  `(gauntlet-json-row ,name ,unit ,default))

(defun gauntlet-json-meters ((out string) (name string) (units float))
  "The member name, a length given in game units, written in meters."
  (gauntlet-json-key out name)
  (gauntlet-json-fixed out (/ units METER_LENGTH))
  0)

(defun gauntlet-bomb-process ()
  "The bomb last dropped, if it is still in the world."
  (let ((proc (handle->process *gauntlet-bomb*)))
    (the-as gauntlet-bomb (if (and proc (type-type? (-> proc type) gauntlet-bomb)) proc))))

(defun gauntlet-bomb-state-name ((bomb gauntlet-bomb))
  "What the state file calls the bomb's state, or #f for one that is only waiting to be cleaned up."
  (let ((state (-> bomb next-state)))
    (if state
      (case (-> state name)
        (('gauntlet-bomb-fall) 'falling)
        (('gauntlet-bomb-countdown) 'countdown)
        (('gauntlet-bomb-explode) 'exploding)
        (else #f))
      #f)))

(defun gauntlet-klaww-state-name ()
  "What the state file calls the fight: waiting for the pelican, falling, landing, fighting, or over."
  (let* ((klaww (gauntlet-klaww-process))
         (state (if klaww (-> klaww next-state))))
    (cond
      (*gauntlet-klaww-defeated* "defeated")
      ((not state) "waiting")
      (else
       (case (-> state name)
         (('gauntlet-klaww-fall) "falling")
         (('gauntlet-klaww-land) "landing")
         (else "fighting"))))))

(defun gauntlet-bomb-remaining ((bomb gauntlet-bomb) (state-name symbol))
  "Seconds the bomb has left on its clock: all of it while it falls, none once it has gone off."
  (cond
    ((= state-name 'falling) (/ (the float (-> bomb countdown)) 300.0))
    ((= state-name 'countdown)
     (/ (the float (max 0 (- (-> bomb countdown) (- (current-time) (-> bomb state-time))))) 300.0))
    (else 0.0)))

(defun gauntlet-state-write-world! ((out string))
  "Level, Jak, the bomb, the bridge and Klaww: the members of the state file that are not settings."
  (let ((in-training (and *target* (gauntlet-in-training?))))
    (gauntlet-json-key out "level")
    (format out "\"~A\"" (if *target* (aif (level-get-target-inside *level*) (-> it name) 'none) 'none))
    (gauntlet-json-key out "jak")
    (cond
      (*target*
       (gauntlet-json-open out)
       (gauntlet-json-meters out "x" (-> (target-pos 0) x))
       (gauntlet-json-meters out "y" (-> (target-pos 0) y))
       (gauntlet-json-meters out "z" (-> (target-pos 0) z))
       (gauntlet-json-key out "onGround")
       (format out "~S" (if (logtest? (-> *target* control status) (cshape-moving-flags onground onsurf)) "true" "false"))
       (gauntlet-json-close out))
      (else (format out "null")))
    (gauntlet-json-key out "bomb")
    (let* ((bomb (gauntlet-bomb-process))
           (state-name (if bomb (gauntlet-bomb-state-name bomb) #f)))
      (cond
        (state-name
         (gauntlet-json-open out)
         (gauntlet-json-key out "state")
         (format out "\"~A\"" state-name)
         (gauntlet-json-meters out "x" (-> bomb root trans x))
         (gauntlet-json-meters out "y" (-> bomb root trans y))
         (gauntlet-json-meters out "z" (-> bomb root trans z))
         (gauntlet-json-key out "remaining")
         (gauntlet-json-fixed out (gauntlet-bomb-remaining bomb state-name))
         (gauntlet-json-key out "jakDistance")
         (if *target*
           (gauntlet-json-fixed out (/ (vector-vector-distance (-> bomb root trans) (target-pos 0)) METER_LENGTH))
           (format out "null"))
         (gauntlet-json-close out))
        (else (format out "null"))))
    (gauntlet-json-key out "bridge")
    (cond
      (in-training
       (gauntlet-json-open out)
       (gauntlet-json-key out "armed")
       (format out "~S" (if *gauntlet-bridge-armed* "true" "false"))
       (gauntlet-json-key out "distance")
       (gauntlet-json-fixed out (/ (vector-vector-xz-distance (target-pos 0) *gauntlet-bridge-spot*) METER_LENGTH))
       (gauntlet-json-close out))
      (else (format out "null")))
    (gauntlet-json-key out "klaww")
    (cond
      ((and *target* (or (gauntlet-in-level? 'beach) *gauntlet-klaww-home*))
       (gauntlet-json-open out)
       (gauntlet-json-key out "state")
       (format out "\"~A\"" (gauntlet-klaww-state-name))
       (gauntlet-json-key out "hits")
       (format out "~D" *gauntlet-klaww-hits*)
       (gauntlet-json-key out "max")
       (format out "~D" GAUNTLET_KLAWW_MAX_HITS)
       (gauntlet-json-key out "alive")
       (format out "~S" (if (gauntlet-klaww-alive?) "true" "false"))
       (gauntlet-json-key out "buttonsPressed")
       (format out "~D" *gauntlet-klaww-presses*)
       (gauntlet-json-key out "buttons")
       (format out "~D" (gauntlet-klaww-button-count))
       (gauntlet-json-close out))
      (else (format out "null")))
    (gauntlet-json-key out "effects")
    (gauntlet-json-open out)
    (gauntlet-json-key out "enabled")
    (format out "~S" (if (-> *pc-settings* twitch-effects?) "true" "false"))
    (gauntlet-json-close out))
  0)

(defun gauntlet-state-write! ()
  "Write Mods/gauntlet-state.json."
  (let ((out (clear *gauntlet-state-text*)))
    (gauntlet-json-open out)
    (gauntlet-json-key out "frame")
    (format out "~D" *gauntlet-frame*)
    (gauntlet-json-key out "revision")
    (format out "~D" *gauntlet-settings-revision*)
    (gauntlet-json-key out "settings")
    (gauntlet-json-open out)
    (gauntlet-setting-table gauntlet-row-write-now)
    (gauntlet-json-close out)
    (gauntlet-json-key out "defaults")
    (gauntlet-json-open out)
    (gauntlet-setting-table gauntlet-row-write-default)
    (gauntlet-json-close out)
    (gauntlet-state-write-world! out)
    (gauntlet-json-close out)
    (format out "~%")
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-state.json" *pc-settings-folder*)
    (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'write)))
      (when (file-stream-valid? file)
        (file-stream-write file (-> out data) (the-as uint (length out)))
        (file-stream-close file))))
  0)

(defun gauntlet-state-poll! ()
  "Every GAUNTLET_STATE_POLL_FRAMES frames, publish the state."
  (+! *gauntlet-state-countdown* -1)
  (when (>= 0 *gauntlet-state-countdown*)
    (set! *gauntlet-state-countdown* GAUNTLET_STATE_POLL_FRAMES)
    (gauntlet-state-write!))
  0)

;; ------------------------------------------------------------------ the poll --

(define *gauntlet-drop-countdown* 0)
(define *gauntlet-drop-seen* (new 'global 'string 64 ""))
;; The request file outlives the game, so the first look of a fresh boot only
;; records where its counter is, as the snapshot poll does: a request made
;; before the game started must not go off the moment it does. A boot that
;; finds no file counts as the first look too, so the first request ever
;; made, which creates the file, is not swallowed.
(define *gauntlet-drop-primed* #f)

(defun gauntlet-drop! ((kind string))
  "Drop what kind names at Jak's spot."
  (cond
    ((not *target*) (format 0 "GAUNTLET DROP: ~S asked for with no Jak in the world~%" kind))
    ((string= kind "bomb") (gauntlet-bomb-drop! (target-pos 0)))
    ;; the console's bomb on the bridge: the spot itself, whatever the trigger radius or the arming say
    ((string= kind "bomb-bridge")
     (if (gauntlet-in-training?)
       (gauntlet-bomb-drop! *gauntlet-bridge-spot*)
       (format 0 "GAUNTLET DROP: bomb-bridge asked for off Geyser Rock, ignored~%")))
    ;; the herd, aimed at Jak's spot from where he faces
    ((string= kind "stampede") (gauntlet-stampede-ahead!))
    ;; Klaww falls: onto the pelican's nest on the beach, ahead of Jak anywhere else
    ((string= kind "klaww") (gauntlet-klaww-drop!))
    (else (format 0 "GAUNTLET DROP: do not know how to drop ~S~%" kind)))
  0)

(defun gauntlet-drop-poll! ()
  "Per-frame hook: the console's settings are looked at first, so what they say holds for this frame; the bridge, the
   Sandover spot and the beach are watched every frame; every GAUNTLET_DROP_POLL_FRAMES frames look at the request counter, and drop once when it has changed since
   the last look; last, the state file, which then describes this frame."
  (+! *gauntlet-frame* 1)
  (gauntlet-settings-poll!)
  (gauntlet-bridge-poll!)
  (gauntlet-stampede-poll!)
  (gauntlet-klaww-poll!)
  (+! *gauntlet-drop-countdown* -1)
  (when (>= 0 *gauntlet-drop-countdown*)
    (set! *gauntlet-drop-countdown* GAUNTLET_DROP_POLL_FRAMES)
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-drop-request.txt" *pc-settings-folder*)
    (when (pc-filepath-exists? *pc-temp-string-1*)
      (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
        (when (file-stream-valid? file)
          (file-stream-seek-past-whitespace file)
          (file-stream-read-word file)
          ;; the first word is the counter: an unchanged one means nothing new
          (when (not (string= *pc-temp-string* *gauntlet-drop-seen*))
            (format (clear *gauntlet-drop-seen*) "~S" *pc-temp-string*)
            (when *gauntlet-drop-primed*
              ;; the second word names what to drop
              (file-stream-seek-past-whitespace file)
              (file-stream-read-word file)
              (gauntlet-drop! *pc-temp-string*)))
          (file-stream-close file))))
    (set! *gauntlet-drop-primed* #t))
  (gauntlet-state-poll!)
  (none))
