     (,row beach "lurkerpuppy-7" "crate-648" 56.5)
     (,row beach "lurkercrab-6" "crate-649" 12.0)
     (,row beach "lurkercrab-5" "crate-649" 39.3)
     (,row beach "lurkercrab-7" "crate-651" 47.3)
     (,row jungle "hopper-34" "crate-688" 32.6)
     (,row jungle "hopper-33" "crate-689" 39.0)
