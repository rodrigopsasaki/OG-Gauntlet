(defmacro gauntlet-row-flybox-eco (level name eco)
  `(when (and (= at-level (quote ,level)) (string= at-name ,name))
     (return (gauntlet-eco ,eco))))

(defun gauntlet-flybox-eco ((at-level symbol) (at-name string))
  "The eco the box named at-name of level at-level wants, or none when the table does not know it."
  (gauntlet-flybox-table begin gauntlet-row-flybox-eco)
  (gauntlet-eco none))

(defmacro gauntlet-row-carrier-box (level lurker box distance)
  `(when (and (= at-level (quote ,level)) (string= at-name ,lurker))
     (return ,box)))

(defun gauntlet-carrier-box ((at-level symbol) (at-name string))
  "The name of the box the lurker named at-name of level at-level carries the eco of, or #f when it carries nothing."
  (gauntlet-carrier-table begin gauntlet-row-carrier-box)
  (the-as string #f))

(defmacro gauntlet-row-carrier-say (level lurker box distance)
  `(when (and (= at-level (quote ,level)) (string= at-name ,box))
     (+! found 1)
     (format 0 "GAUNTLET FLYBOX: ~S is carried by ~S, placed ~F m away~%" at-name ,lurker ,distance)))

(defun gauntlet-flybox-say-carriers ((at-level symbol) (at-name string))
  "Say, one line each, the carriers of the box named at-name, and how many there are."
  (let ((found 0))
    (gauntlet-carrier-table begin gauntlet-row-carrier-say)
    found))

(defun gauntlet-eco-name ((eco gauntlet-eco))
  "The word for an eco, in the logs."
  (case eco
    (((gauntlet-eco red)) "red")
    (((gauntlet-eco blue)) "blue")
    (((gauntlet-eco yellow)) "yellow")
    (((gauntlet-eco green)) "green")
    (else "none")))

(defun gauntlet-eco-pickup ((eco gauntlet-eco))
  "The pickup the game makes of an eco."
  (case eco
    (((gauntlet-eco red)) (pickup-type eco-red))
    (((gauntlet-eco blue)) (pickup-type eco-blue))
    (((gauntlet-eco yellow)) (pickup-type eco-yellow))
    (((gauntlet-eco green)) (pickup-type eco-green))
    (else (pickup-type none))))

(defun gauntlet-jak-carries ()
  "What Jak carries, for the logs: his eco's name, or nothing once it has run out."
  (if (and *target* (< 0.0 (-> *target* fact eco-level)))
    (pickup-type->string (-> *target* fact eco-type))
    "nothing"))

(defun gauntlet-flybox-met? ((eco gauntlet-eco) (mode symbol))
  "True when Jak, as he is now, gives a box that wants eco what it asks: he carries that eco (green too, which only the zoomer carries
   after a green vent), or the attack is a yellow shot at a yellow box. Reads his fact and asks him nothing."
  (let ((fact (-> *target* fact)))
    (cond
      ((and (= eco (gauntlet-eco yellow)) (= mode 'eco-yellow)) #t)
      (else (and (= (-> fact eco-type) (gauntlet-eco-pickup eco)) (< 0.0 (-> fact eco-level)))))))

(defun gauntlet-flybox-eco-of ((box crate))
  "The eco box wants: its table row when it is a scout fly box with an entity, else none."
  (if (and (-> box entity) (type-type? (-> box type) crate-buzzer))
    (gauntlet-flybox-eco (-> box entity extra level name) (res-lump-struct (-> box entity) 'name string))
    (gauntlet-eco none)))

(defun gauntlet-eco-scatter! ((centre vector) (kind gauntlet-eco))
  "One burst of kind's eco, the flash and the spark each at a random spot around centre."
  (let ((flash (new 'stack-no-clear 'vector))
        (spark (new 'stack-no-clear 'vector)))
    (set-vector! flash
                 (+ (-> centre x) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre y) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre z) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 1.0)
    (set-vector! spark
                 (+ (-> centre x) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre y) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 (+ (-> centre z) (rand-vu-float-range (- GAUNTLET_FLYBOX_SCATTER) GAUNTLET_FLYBOX_SCATTER))
                 1.0)
    (gauntlet-eco-burst-at! kind flash spark))
  (none))

(defun gauntlet-flybox-bounce! ((box crate) (jak process))
  "Throw Jak back off the box, no damage: a 'shove (the game's bounce off a wall, which takes no health), away from the box
   along the ground, or backwards from where he faces when he is right over it (a ground pound)."
  (let ((away (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> box root trans))))
    (set! (-> away y) 0.0)
    (when (< (vector-xz-length away) 40.96)
      (vector-z-quaternion! away (-> *target* control quat-for-control))
      (vector-negate! away away)
      (set! (-> away y) 0.0))
    (vector-xz-normalize! away *gauntlet-flybox-bounce*)
    (set! (-> away y) GAUNTLET_FLYBOX_SHOVE_UP)
    (send-event jak 'shove #f (static-attack-info ((shove-up GAUNTLET_FLYBOX_SHOVE_UP) (shove-back *gauntlet-flybox-bounce*) (vector away)))))
  0)

(defconstant GAUNTLET_FLYBOX_RACER_GAP (seconds 0.75)) ;; the zoomer is told a box refuses it at most this often
(define *gauntlet-racer-refused* (the-as time-frame 0)) ;; when a box last refused the zoomer

(defun gauntlet-flybox-fresh-refusal? ((box crate) (mode symbol) (id uint))
  "True when this refusal is news. A spin or a flop reaches a crate on more than one frame under one attack id, so an attack is
   told once. The zoomer's ramming (mode 'racer) sends its attack with id 0 every frame it touches the box, so it is told by the
   clock instead, at most once every GAUNTLET_FLYBOX_RACER_GAP, whichever box."
  (cond
    ((= mode 'racer)
     (when (time-elapsed? *gauntlet-racer-refused* GAUNTLET_FLYBOX_RACER_GAP)
       (set-time! *gauntlet-racer-refused*)
       #t))
    (else (!= id (-> box incomming-attack-id)))))

(defun gauntlet-flybox-refuse! ((box crate) (eco gauntlet-eco) (attacker process) (mode symbol) (id uint))
  "The box refuses an attack that would have broken it: a burst of its own colour, and when Jak did it, the log of what he
   carried and the bounce off. Once for each attack, because a spin or a flop reaches a crate on more than one frame. No bounce
   for the zoomer: it is already thrown back by the solid box, and a 'shove sent to a racing Jak is not the walking one."
  (when (gauntlet-flybox-fresh-refusal? box mode id)
    (format 0 "GAUNTLET FLYBOX: ~S (~A) refused ~A, Jak carried ~A~%"
            (res-lump-struct (-> box entity) 'name string) (gauntlet-eco-name eco) mode (gauntlet-jak-carries))
    (let ((middle (new 'stack-no-clear 'vector)))
      (set! (-> middle quad) (-> box root trans quad))
      (+! (-> middle y) GAUNTLET_FLYBOX_LIFT)
      (dotimes (i GAUNTLET_FLYBOX_REFUSE_BURSTS)
        (gauntlet-eco-scatter! middle eco)))
    (if (and (= (-> attacker type) target) (!= mode 'racer)) (gauntlet-flybox-bounce! box attacker)))
  (none))

(defun *crate-attack-gate-hook* ((box crate) (attacker process) (mode symbol) (id uint))
  "The game is about to let attacker break box with an attack of mode mode (or, for 'eco-blue, to let Jak's blue eco pull it
   open): true if it may. Only a scout fly box of the table asks anything, and only of Jak's own attacks and yellow shots. See
   the section above."
  (let ((eco (if (and *gauntlet-flybox-enabled* *target*) (gauntlet-flybox-eco-of box) (gauntlet-eco none))))
    (cond
      ((= eco (gauntlet-eco none)) #t)
      ((= mode 'eco-blue) (= eco (gauntlet-eco blue)))
      ((not (or (= (-> attacker type) target) (= mode 'eco-yellow))) #t)
      ((gauntlet-flybox-met? eco mode)
       (format 0 "GAUNTLET FLYBOX: ~S (~A) open by ~A, Jak carries ~A~%"
               (res-lump-struct (-> box entity) 'name string) (gauntlet-eco-name eco) mode (gauntlet-jak-carries))
       #t)
      (else
       (gauntlet-flybox-refuse! box eco attacker mode id)
       #f))))

;; One small watcher for every box and every carrier of the table, born with it: it keeps the colour on (the glow, the
;; aura), and for a carrier it waits for the lurker's death and spills what it carried. A carrier is dead when its state is
;; the nav enemy's die state; one that is simply gone (the entity system culled it as Jak walked away, a death put the pool
;; away) spilled nothing, and is born again, with a new watcher, by the same hook. Like the horde's watcher it reads the
;; entity's name only while the entity's level is the one running.
(deftype gauntlet-eco-watch (process)
  ((ent         entity-actor)
   (subject     handle) ;; the box or the lurker; null while a dead carrier waits to come back
   (eco         gauntlet-eco)
   (carrier     symbol) ;; true for a lurker, false for a box
   (level-name  symbol)
   (back-at     time-frame)) ;; for a carrier that died: when it comes back; 0 while it is here
  (:states
   gauntlet-eco-watch-run))

(defbehavior gauntlet-eco-watch-name gauntlet-eco-watch ()
  "The subject's name, from its entity: only to be called while its level is active."
  (res-lump-struct (-> self ent) 'name string))

(defbehavior gauntlet-eco-watch-show! gauntlet-eco-watch ((pd process-drawable))
  "One frame of the colour: a carrier wears the aura of Jak's eco of it; a box glows and flares at random about its middle."
  (cond
    ((-> self carrier) (gauntlet-eco-aura! pd (-> self eco)))
    ((not (logtest? (-> pd draw status) (draw-status hidden no-anim)))
     (gauntlet-eco-glow! pd (-> self eco))
     (when (rand-vu-percent? 0.5)
       (let ((middle (new 'stack-no-clear 'vector)))
         (set! (-> middle quad) (-> pd root trans quad))
         (+! (-> middle y) GAUNTLET_FLYBOX_LIFT)
         (gauntlet-eco-scatter! middle (-> self eco))))))
  0)

(defbehavior gauntlet-eco-watch-calm! gauntlet-eco-watch ((pd process-drawable))
  "The setting is off: the subject is plain again, as the game made it."
  (when pd
    (set-vector! (-> pd draw color-mult) 1.0 1.0 1.0 1.0)
    (set-vector! (-> pd draw color-emissive) 0.0 0.0 0.0 0.0))
  0)

(defbehavior gauntlet-eco-watch-spill! gauntlet-eco-watch ((pd process-drawable))
  "The carrier is dying: its eco is a pickup where it fell, with a flare of its colour. (The red one also makes the game say its
   red eco hint the first time, as any red eco born does.)"
  (let ((where (new 'stack-no-clear 'vector)))
    (set! (-> where quad) (-> pd root trans quad))
    (format 0 "GAUNTLET CARRIER: ~S died, spills ~A eco at (~M, ~M, ~M)~%"
            (gauntlet-eco-watch-name) (gauntlet-eco-name (-> self eco)) (-> where x) (-> where y) (-> where z))
    (+! (-> where y) GAUNTLET_FLYBOX_LIFT)
    (dotimes (i GAUNTLET_FLYBOX_SPILL_BURSTS)
      (gauntlet-eco-scatter! where (-> self eco)))
    ;; the fact-info only carries the option: birth-pickup-at-point copies it into the pickup's own, which the eco's die state reads
    (birth-pickup-at-point where (gauntlet-eco-pickup (-> self eco)) (-> *FACT-bank* eco-single-inc) #t *entity-pool*
                           (new 'static 'fact-info :options (fact-options one-off))))
  0)

(defbehavior gauntlet-eco-watch-box-closed? gauntlet-eco-watch ()
  "True when the box this carrier carries the eco of is still closed: it has not been broken, which is what a box's entity records
   (user-int8 0, set by crates.gc on the break). A box the level does not know counts as open, so nothing returns for it."
  (let* ((box (gauntlet-carrier-box (-> self level-name) (gauntlet-eco-watch-name)))
         (ent (if box (entity-by-name box))))
    (and ent (zero? (-> ent extra perm user-int8 0)))))

(defbehavior gauntlet-eco-watch-await-return! gauntlet-eco-watch ()
  "The carrier has just died and spilled. If its box is still closed and the setting allows, it is owed back
   *gauntlet-carrier-return* from now, and the watcher waits for that; else the watcher is done."
  (cond
    ((and (< 0 *gauntlet-carrier-return*) (gauntlet-eco-watch-box-closed?))
     (set! (-> self subject) (the-as handle #f))
     (set! (-> self back-at) (+ (current-time) *gauntlet-carrier-return*))
     (format 0 "GAUNTLET CARRIER: ~S comes back in ~F s~%" (gauntlet-eco-watch-name) (/ (the float *gauntlet-carrier-return*) 300.0)))
    (else
     (format 0 "GAUNTLET CARRIER: ~S does not come back~A~%" (gauntlet-eco-watch-name) (if (< 0 *gauntlet-carrier-return*) ", its box is open" ", the setting is 0"))
     (deactivate self)))
  0)

(defbehavior gauntlet-eco-watch-return! gauntlet-eco-watch ()
  "Time is up for the dead carrier and its box is still closed: a clone of it is born at the spot it was placed at, charged again
   (the glow, and from here the watcher's aura), with a puff of its colour. When no process is free it tries again in a second."
  (let ((home (new 'stack-no-clear 'vector)))
    (set! (-> home quad) (-> self ent extra trans quad))
    (set! (-> home w) 1.0)
    (let* ((twin (gauntlet-horde-clone! (-> self ent) home))
           (born (handle->process twin))
           (pd (if born (as-type born process-drawable))))
      (cond
        (pd
         (gauntlet-eco-glow! pd (-> self eco))
         (+! (-> home y) GAUNTLET_FLYBOX_LIFT)
         (dotimes (i GAUNTLET_FLYBOX_SPILL_BURSTS)
           (gauntlet-eco-scatter! home (-> self eco)))
         (set! (-> self subject) twin)
         (set! (-> self back-at) 0)
         (format 0 "GAUNTLET CARRIER: ~S is back, carrying ~A eco~%" (gauntlet-eco-watch-name) (gauntlet-eco-name (-> self eco))))
        (else
         (set! (-> self back-at) (+ (current-time) (seconds 1)))
         (format 0 "GAUNTLET CARRIER: ~S could not come back, no process was free, trying again~%" (gauntlet-eco-watch-name))))))
  0)

(defstate gauntlet-eco-watch-run (gauntlet-eco-watch)
  :code
    (behavior ()
      (loop
        (let* ((proc (handle->process (-> self subject)))
               (pd (if proc (as-type proc process-drawable))))
          (cond
            ((!= (level-status *level* (-> self level-name)) 'active)
             (deactivate self))
            ((not *gauntlet-flybox-enabled*)
             (gauntlet-eco-watch-calm! pd)
             (if (not pd) (deactivate self)))
            ((nonzero? (-> self back-at))
             (cond
               ((not (gauntlet-eco-watch-box-closed?))
                (format 0 "GAUNTLET CARRIER: ~S does not come back, its box is open~%" (gauntlet-eco-watch-name))
                (deactivate self))
               ((>= (current-time) (-> self back-at)) (gauntlet-eco-watch-return!))))
            ((not pd)
             (format 0 "GAUNTLET ~A: ~S is gone, nothing spilled~%" (if (-> self carrier) "CARRIER" "FLYBOX") (gauntlet-eco-watch-name))
             (deactivate self))
            ((and (-> self carrier)
                  (-> pd next-state)
                  (= (-> pd next-state name) 'nav-enemy-die))
             (gauntlet-eco-watch-spill! pd)
             (gauntlet-eco-watch-await-return!))
            (else (gauntlet-eco-watch-show! pd))))
        (suspend))))

(defbehavior gauntlet-eco-watch-init-by-other gauntlet-eco-watch ((ent entity-actor) (subject handle) (eco gauntlet-eco) (carrier symbol))
  "Watch subject, the process the actor ent was just born as, and keep it wearing eco."
  (set! (-> self ent) ent)
  (set! (-> self subject) subject)
  (set! (-> self eco) eco)
  (set! (-> self carrier) carrier)
  (set! (-> self back-at) 0)
  (set! (-> self level-name) (-> ent extra level name))
  (go gauntlet-eco-watch-run)
  (none))

(defun gauntlet-flybox-box-born! ((ent entity-actor) (proc process-drawable) (level-name symbol))
  "A buzzer crate was born: logged with its place, and if the table gives it an eco and it is not open already, coloured and
   watched, with a word about each carrier it has."
  (let* ((name (res-lump-struct ent 'name string))
         (eco (gauntlet-flybox-eco level-name name)))
    (format 0 "GAUNTLET FLYBOX: ~S born at (~M, ~M, ~M) in ~A, eco ~A~%"
            name (-> ent extra trans x) (-> ent extra trans y) (-> ent extra trans z) level-name (gauntlet-eco-name eco))
    (when (and (!= eco (gauntlet-eco none)) (zero? (-> ent extra perm user-int8 0)))
      (gauntlet-eco-glow! proc eco)
      (let ((carriers (gauntlet-flybox-say-carriers level-name name)))
        (if (zero? carriers)
          (format 0 "GAUNTLET FLYBOX: ~S has no carrier, its ~A eco is the game's own in the level~%" name (gauntlet-eco-name eco))))
      (process-spawn gauntlet-eco-watch :init gauntlet-eco-watch-init-by-other ent (process->handle proc) eco #f :to *entity-pool*)))
  0)

(defun gauntlet-flybox-carrier-born! ((ent entity-actor) (proc process-drawable) (level-name symbol))
  "A nav enemy was born: if the table names it a carrier, and it is not dead already, it is coloured with the eco of its box
   and watched."
  (let* ((name (res-lump-struct ent 'name string))
         (box (gauntlet-carrier-box level-name name)))
    (when box
      (let ((eco (gauntlet-flybox-eco level-name box)))
        (when (and (!= eco (gauntlet-eco none)) (not (logtest? (-> ent extra perm status) (entity-perm-status complete))))
          (gauntlet-eco-glow! proc eco)
          (format 0 "GAUNTLET CARRIER: ~S carries ~A eco for ~S~%" name (gauntlet-eco-name eco) box)
          (process-spawn gauntlet-eco-watch :init gauntlet-eco-watch-init-by-other ent (process->handle proc) eco #t :to *entity-pool*)))))
  0)

(defun gauntlet-flybox-born! ((ent entity-actor))
  "The actor ent has just been born (the entity system's hook, below). A buzzer crate is a scout fly box, and a nav enemy may
   be a carrier of one; the name is only read for those two, since every actor of every level comes through here."
  (let* ((proc (-> ent extra process))
         (pd (if proc (as-type proc process-drawable))))
    (when pd
      (cond
        ((type-type? (-> pd type) crate-buzzer) (gauntlet-flybox-box-born! ent pd (-> ent extra level name)))
        ((type-type? (-> pd type) nav-enemy) (gauntlet-flybox-carrier-born! ent pd (-> ent extra level name))))))
  (none))

;; ------------------------------------------------------------------ the temple --

;; The floating platforms inside the Forbidden Jungle's temple (the level jungleb, the underground one: the ones that ride a path
;; toward the blue eco switch and toward the plant boss) are not there: the temple is crossed on boosted and roll jumps. They are
;; named in a table and refused at birth by *entity-birth-veto-hook* (engine/entity/entity.gc), so no process is ever made for
;; them. Their actors stay in the level, so nothing that walks actors (actor-link-info) loses a neighbour, and a level reload or
;; a death changes nothing: the veto is asked again at each birth. The flipping platforms (plat-flip), the launchers and the
;; elevator are not in the table.
(defmacro gauntlet-temple-table (join row)
  "Expand row once per platform, (row level name): the actor named name of level is not born."
  `(,join
     (,row jungleb "plat-77")
     (,row jungleb "plat-79")
     (,row jungleb "plat-80")
     (,row jungleb "plat-81")
     (,row jungleb "plat-82")
     (,row jungleb "plat-83")
     (,row jungleb "plat-84")
     (,row jungleb "plat-85")
     (,row jungleb "plat-86")
     (,row jungleb "plat-87")))

(defmacro gauntlet-row-temple-platform (level name)
  `(when (and (= at-level (quote ,level)) (string= at-name ,name))
     (return #t)))

(defun gauntlet-temple-platform? ((at-level symbol) (at-name string))
  "Whether the actor named at-name of level at-level is one of the temple's floating platforms."
  (gauntlet-temple-table begin gauntlet-row-temple-platform)
  #f)

(defun *entity-birth-veto-hook* ((ent entity-actor))
  "Asked before each actor is born: true for a temple platform while the setting has them removed. The level is looked at first, since
   every actor of every level comes through here and only jungleb has a name to read."
  (let ((level-name (-> ent extra level name)))
    (when (and *gauntlet-fj-temple-platforms-removed* (= level-name 'jungleb))
      (let ((name (res-lump-struct ent 'name string)))
        (when (gauntlet-temple-platform? level-name name)
          (format 0 "GAUNTLET TEMPLE removed ~S~%" name)
          (return #t)))))
  #f)

;; gauntlet: engine/entity/entity.gc calls this after birth! has run for an actor
(defun *entity-born-hook* ((ent entity-actor))
  (gauntlet-horde-born! ent)
  (gauntlet-flybox-born! ent)
  (none))

(defconstant GAUNTLET_LURKER_TINT_FRAMES 6) ;; how often the lurkers' tint is renewed while the world is turning, 5 times a second

;; The mayhem's lurkers: the Misty lurkers go violet with the light. The world's own draw path (not the hud's) reads a process's color-mult and
;; color-emissive, and the mood's tint (above) already reaches them through the lights, but a lurker's own colour is what the eye finds, so while
;; the blend is up each Misty nav enemy is also pushed toward violet in its own colours, in a sweep of the entity pool every few frames (a sweep is
;; one pass over a pool of a few hundred; nothing writes these two fields on a lurker of Misty but the eco, which is left alone: a charged babak
;; (babak.gc says), a carrier of a scout fly box (the table says; its box glows with it) and the muse and the sharkey, whose looks are their own).
;; When the blend goes back to nothing one last sweep makes them plain again. The values the callback reads are globals, because a lambda has no
;; captures.
(define *gauntlet-lurker-tint* 0.0) ;; the blend the sweep in progress paints with
(define *gauntlet-lurker-tint-countdown* 0)
(define *gauntlet-lurker-tint-lit* #f) ;; the last sweep painted a tint, so a last one is owed that paints none

(defun gauntlet-lurker-tint-one! ((proc process))
  "Paint proc with *gauntlet-lurker-tint* of the violet if it is a Misty lurker that wears no eco."
  (let ((nav (as-type proc nav-enemy)))
    (when (and nav
               (-> nav entity)
               (= (-> nav entity extra level name) 'misty)
               (!= (-> nav type symbol) 'muse)
               (!= (-> nav type symbol) 'sharkey)
               (not (gauntlet-babak-charged? nav))
               (not (gauntlet-carrier-box 'misty (res-lump-struct (-> nav entity) 'name string))))
      (let ((b *gauntlet-lurker-tint*))
        (set-vector! (-> nav draw color-mult) (lerp 1.0 0.75 b) (lerp 1.0 0.45 b) (lerp 1.0 0.85 b) 1.0)
        (set-vector! (-> nav draw color-emissive) (* 0.2 b) 0.0 (* 0.12 b) 0.0))))
  (none))

(defun gauntlet-lurker-tint-poll! ()
  "Per-frame: while the mood is tinted, renew the lurkers' violet every GAUNTLET_LURKER_TINT_FRAMES frames; once it is not, take it away in a
   last sweep (not when Misty is going: its entities are not to be read then, and its lurkers go with it)."
  (let ((blend (* *gauntlet-mayhem-blend* *gauntlet-misty-mayhem-atmosphere*)))
    (cond
      ((< 0.001 blend)
       (+! *gauntlet-lurker-tint-countdown* -1)
       (when (>= 0 *gauntlet-lurker-tint-countdown*)
         (set! *gauntlet-lurker-tint-countdown* GAUNTLET_LURKER_TINT_FRAMES)
         (set! *gauntlet-lurker-tint* blend)
         (set! *gauntlet-lurker-tint-lit* #t)
         (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-lurker-tint-one! proc) (none)) *null-kernel-context*)))
      (*gauntlet-lurker-tint-lit*
       (set! *gauntlet-lurker-tint-lit* #f)
       (set! *gauntlet-lurker-tint-countdown* 0)
       (when (gauntlet-misty-active?)
         (set! *gauntlet-lurker-tint* 0.0)
         (iterate-process-tree *entity-pool* (lambda ((proc process)) (gauntlet-lurker-tint-one! proc) (none)) *null-kernel-context*)))))
  0)

;; --------------------------------------------------------- the muse's body --

;; Catching the muse is the game's (levels/misty/muse.gc): the cell, the cutscene, and she is gone. She is not followed by anything
;; and does not stay with Jak; that she is his is shown by an icon (below) and nothing else. Dropping her makes a new muse, a
;; second process of her type from her own actor, born the way the horde's clones are (gauntlet-horde-clone!, which is why this
;; section follows "the horde"): on her path where Jak lost her (muse.gc reads *gauntlet-muse-start*), loose and not to be caught for
;; GAUNTLET_MUSE_GRACE, then the muse of the game again, chasing and run from, giving a catch that is over at once (muse-caught
;; tells a first catch, which closes the task, from the rest). The game's own muse is never the one, because by the time Jak can
;; lose her hers is gone and her actor marked dead, so no birth by the entity system will bring her back; that is the reason for
;; the new one. The same new muse is also the one that stands on the island on a later visit (or after a death, which puts every
;; process of the entity pool away, hers with them) when the actor is dead and the task closed: the mod makes her at her home.

(deftype gauntlet-muse-world (structure)
  ((muse handle) ;; the muse this mod made, until she is caught or put away
   (icon handle))) ;; the process that drives the icon and owns its picture

(define *gauntlet-muse-world* (new 'global 'gauntlet-muse-world))
(set! (-> *gauntlet-muse-world* muse) (the-as handle #f))
(set! (-> *gauntlet-muse-world* icon) (the-as handle #f))

(define *gauntlet-muse-entity* (the-as entity-actor #f)) ;; her actor, found while Misty is up, forgotten when it goes (its memory is the level's)

(defun gauntlet-muse-entity-find! ()
  "Her actor, muse-2 of Misty Island, found by name when it is not known; #f when Misty is not up."
  (when (not *gauntlet-muse-entity*)
    (let ((found (entity-by-name "muse-2")))
      (if (and found (type-type? (-> found type) entity-actor))
        (set! *gauntlet-muse-entity* (the-as entity-actor found)))))
  *gauntlet-muse-entity*)

(defun gauntlet-muse-spawn! ((near-jak symbol))
  "Make a muse, loose: at her home when near-jak is #f, else on her path where Jak stands."
  (let ((ent (gauntlet-muse-entity-find!)))
    (cond
      ((not ent) (format 0 "GAUNTLET MUSE has no muse-2 actor to make a muse from~%"))
      (else
       (set! (-> *gauntlet-muse-start* w) 0.0)
       (when (and near-jak *target*)
         (set! (-> *gauntlet-muse-start* quad) (-> (target-pos 0) quad))
         (set! (-> *gauntlet-muse-start* w) 1.0))
       (let* ((born (gauntlet-horde-clone! ent (-> ent extra trans)))
              (muse (as-type (handle->process born) process-drawable)))
         (set! (-> *gauntlet-muse-start* w) 0.0)
         (set! (-> *gauntlet-muse-world* muse) born)
         (if muse
           (format 0 "GAUNTLET MUSE loose at (~M, ~M, ~M)~%" (-> muse root trans x) (-> muse root trans y) (-> muse root trans z))
           (format 0 "GAUNTLET MUSE could not be made~%"))))))
  0)

(defun gauntlet-muse-caught! ((kind symbol))
  "The muse's own state calls this as Jak catches her, kind 'first (the game's catch, the cell given) or 'again (the new muse
   the mod made after a drop, nothing given). She is his."
  (when (and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
    (format 0 "GAUNTLET MUSE caught (~A)~%" kind)
    (gauntlet-muse-flip! #t))
  (none))

(defun gauntlet-muse-drop! ((why symbol))
  "Jak has lost the muse he carries, why being 'hit, 'death or the name of a bonk (see *target-bonk-hook*, e.g. 'bonk-wall-roll). She pops out loose where he stands, unless he died: a death
   puts every process of the entity pool away, so the poll below makes her at her home once it has. Dropped once for a hit,
   however many frames of invulnerability follow, because the second finds her loose already."
  (when (and *gauntlet-misty-muse-enabled* *gauntlet-muse-carried* (gauntlet-misty-active?))
    (let ((where (if *target* (target-pos 0) *null-vector*)))
      (format 0 "GAUNTLET MUSE dropped (~A) at (~M, ~M, ~M)~%" why (-> where x) (-> where y) (-> where z)))
    (gauntlet-muse-flip! #f)
    (if (!= why 'death) (gauntlet-muse-spawn! #t)))
  (none))

;; gauntlet: the engine calls this with the bonk's name whenever Jak bonks: a knock-back moment he visibly bounces or stumbles in, never an
;; ordinary landing or a hop onto a platform or an enemy. The five (declared in engine/target/target-handler.gc, called there and in
;; target.gc and target2.gc) are 'bonk-landing, a landing from beyond fall-far on an actor that hears 'bonk, off which he bounces;
;; 'bonk-fall, the painful landing of a fall beyond fall-far onto the ground; and the wall smacks 'bonk-wall-lunge, 'bonk-wall-roll and
;; 'bonk-wall-roll-jump, where the running attack, the roll and the roll jump hit a wall and he is shoved back. The muse log says which.
(defun *target-bonk-hook* ((which symbol))
  (gauntlet-muse-drop! which)
  (none))

(defun gauntlet-muse-health-poll! ()
  "Per-frame, on Misty: a hit is a fall in Jak's health, or his last hit, which does not lower it (he is dying: the flag is set before
   his death begins). Every way he can lose health is a fall in it (an attack, a hit of damage mode, the red babak's second hit),
   which is why this is where hits are seen and not a hook in the hit state; invulnerable frames let no hit land, so nothing falls."
  (let ((health (if *target* (-> *target* fact health) -1.0)))
    (when (and *target* *gauntlet-muse-carried*)
      (cond
        ((or (logtest? (-> *target* state-flags) (state-flags dying)) (>= 0.0 health)) (gauntlet-muse-drop! 'death))
        ((and (<= 0.0 *gauntlet-muse-health*) (< health *gauntlet-muse-health*)) (gauntlet-muse-drop! 'hit))))
    (set! *gauntlet-muse-health* health))
  0)

(defun gauntlet-muse-body-poll! ()
  "Per-frame, on Misty, with the muse loose: if the game will not bring her back (her actor is dead and none of her is standing) and
   the mod has not made one, make her at her home. That is every visit after the first catch, and every death."
  (let ((ent (gauntlet-muse-entity-find!)))
    (when (and ent
               *target*
               (not *gauntlet-muse-carried*)
               (not (-> ent extra process))
               (logtest? (-> ent extra perm status) (entity-perm-status bit-0 dead))
               (not (handle->process (-> *gauntlet-muse-world* muse))))
      (gauntlet-muse-spawn! #f)))
  0)

;; ---------------------------------------------------------------- the icon --

;; Whether the muse is with Jak is shown on screen by a portrait of her face in a corner of the hud, whenever he is on Misty: dim and
;; pulsing while she is loose, lit while she is his, and it pops at each change (gold when she is caught, red when she is lost). It is
;; a flat picture and is drawn the way the game draws its own flat hud icons (the health, the buzzers, the eco timers: hud-classes.gc):
;; a screen-space sprite particle with a hud slot of its own (sprite-allocate-user-hvdf) that is moved to a point of the hud's 512 x 448
;; space, spawned every frame, whose particle function writes its size and its colour (hud.gc, draw-particles, is the position; the
;; part-hud-health-01-func is the function).
;;
;; The picture is the texture `checker` of the effects tpage, replaced by a painting of her face: custom_assets/jak1/texture_replacements/
;; effects/checker.png, which the decompiler's level extraction bakes into GAME.fr3 (a texture replacement is the PC port's only way to
;; a new picture, and it costs the 4 MB of VRAM nothing, because the game keeps the original 16 x 16 texture and only the GL one is new).
;; `checker` is the one texture of that always-resident page that nothing in the game names, and the replacement is global, so
;; nothing else may ever use it. The sprite colour is a multiplier of the texture (128 is neutral, 255 twice as bright), so the
;; picture is painted in its lit colours and the particle function darkens it for a loose muse.
;;
;; Where it stands, in the hud's own space (x from 0 to 512, y from 0 to 448, the middle at 256 and 224): the health is top left (to y 110),
;; the buzzers bottom left (from y 360), the orbs top right and the eco timers bottom right, and the pc port's battle counter right of the
;; middle; the left, x 40 to 110 and y 120 to 300, is free. The middle of the picture is at GAUNTLET_MUSE_ICON_X, 14% in, with the frame
;; 20 px or more clear of the edge.
;;
;; How big it is, worked out from the sprite renderer and not yet measured: the hud sprite's side is its scale / 120 px of the 512 wide
;; space (sprite3_3d.vert, with the hud matrix of sprite.gc, which the pc port scales so that widescreen does not enlarge it: the picture
;; is as square on a wide screen as on a narrow one and needs no aspect of its own), and the hud's pixels are 7 to 6 taller than wide
;; (512 x 448 on a 4:3 screen), so it is scale / 120 * 7 / 6 px of the 448. The pieces of the health badge, 6963.2 (1.7 m, the game's
;; own unit), come out at 58 px wide and 68 tall by that, for their centres 37 px apart. So 4800 is a picture 40 px wide and 47 tall,
;; the face and a little air about it. That is arithmetic from the source and no measurement of a screen: the first run is the check,
;; and the console's misty-muse-icon-scale, which multiplies it, is the dial to find the size that is wanted before it is written here.
(defconstant GAUNTLET_PART_GROUP_MUSE 1006) ;; the one group this icon adds to the particle tables, after the TNT's: its part is 3555
(defconstant GAUNTLET_MUSE_ICON_X 72) ;; the middle of the picture, in the hud's 512 wide space
(defconstant GAUNTLET_MUSE_ICON_Y 200) ;; and in its 448 high one
(defconstant GAUNTLET_MUSE_ICON_DEPTH 1.0) ;; the z of the hud's own particles (init-pos z of the buzzers and the hearts)
(defconstant GAUNTLET_MUSE_ICON_SCALE 4800.0) ;; the sprite's scale, which is its side in the units above, times the console's misty-muse-icon-scale
(defconstant GAUNTLET_MUSE_ICON_POP 0.4) ;; how much bigger the picture is at the instant of a flip, settling back over the flash
(defconstant GAUNTLET_MUSE_FRAME_HALF_W 24) ;; the frame around it: half its width in the hud's 512 wide space at that scale, undone by the aspect
(defconstant GAUNTLET_MUSE_FRAME_HALF_H 14) ;; and half its height in the 2D space of the Klaww bar (y from 0 to 224)
(defconstant GAUNTLET_MUSE_PULSE_PERIOD (seconds 0.5)) ;; the loose frame's pulse, 2 a second
(defconstant GAUNTLET_MUSE_LIGHT_PERIOD (seconds 0.667)) ;; and the loose picture's, 1.5 a second
(defconstant GAUNTLET_MUSE_DIM_LOW 26.0) ;; the loose picture's colour multiplier at its darkest and brightest (128 is the picture as painted)
(defconstant GAUNTLET_MUSE_DIM_HIGH 62.0)
(defconstant GAUNTLET_MUSE_DIM_GREEN 0.55) ;; and how much of that its green and its blue keep, so it is dark red-violet and not grey
(defconstant GAUNTLET_MUSE_DIM_BLUE 0.85)

(define *gauntlet-muse-portrait-scale* GAUNTLET_MUSE_ICON_SCALE) ;; what the particle function writes as the sprite's size, set every frame the picture is drawn
(define *gauntlet-muse-portrait-tint* (new 'global 'vector)) ;; and as its colour: r, g, b, a, the sprite's own units (128 neutral, 255 at most: a byte, a larger one wraps)
(set-vector! *gauntlet-muse-portrait-tint* 128.0 128.0 128.0 128.0)

(defpartgroup group-gauntlet-muse-portrait
  :id 1006
  :flags (screen-space)
  :bounds (static-bspherem 0 0 0 100)
  :parts ((sp-item 3555 :flags (launch-asap))))

;; One frame of life, spawned again every frame, as the hud's own: the hud keeps no particle of its own that lasts.
(defpart 3555
  :init-specs
  ((:texture (checker effects))
   (:num 1.0)
   (:scale-x (meters 1.17))
   (:scale-y :copy scale-x)
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 128.0)
   (:timer (seconds -0.005))
   (:flags (bit2 bit9))
   (:func 'part-gauntlet-muse-portrait-func)))

(defun part-gauntlet-muse-portrait-func ((sys sparticle-system) (info sparticle-cpuinfo) (data matrix))
  "The sprite's size and colour, as part-hud-health-01-func writes them: both scales in the w of the first two rows, the colour in
   the third. The numbers are the process's (gauntlet-muse-portrait-look!), for the state of the muse this frame."
  (set! (-> data vector 0 w) *gauntlet-muse-portrait-scale*)
  (set! (-> data vector 1 w) *gauntlet-muse-portrait-scale*)
  (set! (-> data vector 2 x) (-> *gauntlet-muse-portrait-tint* x))
  (set! (-> data vector 2 y) (-> *gauntlet-muse-portrait-tint* y))
  (set! (-> data vector 2 z) (-> *gauntlet-muse-portrait-tint* z))
  (set! (-> data vector 2 w) (-> *gauntlet-muse-portrait-tint* w))
  0
  (none))

;; The process that owns the picture: its launch control is the particle's owner, and the launch control's matrix is the hud slot the
;; picture is placed with. Both are the hud's own arrangement (hud.gc), and so are the two methods below, copied from it: a launch control is
;; a pointer into the process that the pool moves when it compacts (relocate), and its hud slot is one of 76 for the whole game, which
;; stays taken, with the particles still on the list, if the process goes without giving it back (deactivate).
(deftype gauntlet-muse-portrait (process)
  ((part sparticle-launch-control)) ;; the picture's, made with the process; its matrix is the hud slot
  (:states
   gauntlet-muse-portrait-run))

(defmethod relocate ((this gauntlet-muse-portrait) (offset int))
  (if (nonzero? (-> this part)) (&+! (-> this part) offset))
  (the-as gauntlet-muse-portrait ((method-of-type process relocate) this offset)))

(defmethod deactivate ((this gauntlet-muse-portrait))
  "However the icon's process goes, ending itself with Misty or the setting, or put away by the kernel, its particles are killed and its
   hud slot given back (kill-and-free-particles does that), and the log says it is gone."
  (when (nonzero? (-> this part))
    (kill-and-free-particles (-> this part))
    (set! (-> this part matrix) -1))
  (format 0 "GAUNTLET MUSE icon stopped~%")
  ((method-of-type process deactivate) this)
  (none))

(defun gauntlet-muse-phase ((period int))
  "Where the clock is in a cycle of period ticks, from 0.0 up to 1.0. Taken from the tick count's remainder, so it stays exact however
   long the game has run."
  (/ (the float (mod (current-time) period)) (the float period)))

(defun gauntlet-muse-wave ((period int))
  "A wave of period ticks, from 0.0 to 1.0 and back."
  (+ 0.5 (* 0.5 (sin (* (degrees 360) (gauntlet-muse-phase period))))))

(defun gauntlet-muse-rgba ((r int) (g int) (b int) (a int))
  "A colour whose alpha is not a constant (static-rgba is for those). Alpha 128 is fully opaque, as the letterbox's is."
  (the-as rgba (logior (shl a 24) (shl b 16) (shl g 8) r)))

(defun gauntlet-muse-frame-draw! ((buf dma-buffer) (cx int) (cy int) (half-w int) (half-h int) (thick-x int) (color rgba))
  "The four sides of a card of half-sizes half-w and half-h around (cx, cy), the vertical ones thick-x wide."
  (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) (* 2 half-w) 2 color)
  (draw-sprite2d-xy buf (- cx half-w) (+ cy half-h) (* 2 half-w) 2 color)
  (draw-sprite2d-xy buf (- cx half-w) (- cy half-h) thick-x (* 2 half-h) color)
  (draw-sprite2d-xy buf (+ cx half-w) (- cy half-h) thick-x (* 2 half-h) color)
  0)

(defun gauntlet-muse-icon-shown? ()
  "True when the icon is to be seen: Jak is inside Misty and nothing else has the screen (a cutscene, the progress menu, a fade)."
  (and *target*
       (gauntlet-in-level? 'misty)
       (not (movie?))
       (not *progress-process*)
       (time-elapsed? (-> *game-info* letterbox-time) (seconds 0.1))
       (time-elapsed? (-> *game-info* blackout-time) (seconds 0.1))))

(defun gauntlet-muse-portrait-look! ((carried symbol) (flash float) (size float))
  "Say how the picture looks this frame, for the particle function to write: as painted while she is his, with a gold burn on top
   (more red and green, less blue, up to the byte's end) fading with the flash after a catch; a dark red-violet breathing between
   GAUNTLET_MUSE_DIM_LOW and _HIGH while she is loose, with a red burn after a loss. It is a little bigger at the instant of either, and
   size is the console's multiplier."
  (set! *gauntlet-muse-portrait-scale* (* GAUNTLET_MUSE_ICON_SCALE size (+ 1.0 (* GAUNTLET_MUSE_ICON_POP flash))))
  (let ((tint *gauntlet-muse-portrait-tint*))
    (cond
      (carried
       (set-vector! tint (lerp 128.0 255.0 flash) (lerp 128.0 205.0 flash) (lerp 128.0 90.0 flash) 128.0))
      (else
       (let ((dim (lerp GAUNTLET_MUSE_DIM_LOW GAUNTLET_MUSE_DIM_HIGH (gauntlet-muse-wave GAUNTLET_MUSE_LIGHT_PERIOD))))
         (set-vector! tint
                      (lerp dim 255.0 flash)
                      (lerp (* dim GAUNTLET_MUSE_DIM_GREEN) 40.0 flash)
                      (lerp (* dim GAUNTLET_MUSE_DIM_BLUE) 40.0 flash)
                      128.0)))))
  0)

(defbehavior gauntlet-muse-portrait-place! gauntlet-muse-portrait ()
  "Move the picture's hud slot to (GAUNTLET_MUSE_ICON_X, GAUNTLET_MUSE_ICON_Y) as the hud moves its own particles (hud.gc, draw-particles):
   the point in the middle-based space of the screen, offset by 2048 into the sprite renderer's, and the depth from the camera's."
  (let ((x (+ -256.0 (the float GAUNTLET_MUSE_ICON_X)))
        (y (* 0.5 (- (* (-> *video-parms* relative-y-scale) (the float GAUNTLET_MUSE_ICON_Y)) (the float (-> *video-parms* screen-sy))))))
    (set-vector! (sprite-get-user-hvdf (-> self part matrix))
                 (the float (+ (the int x) 2048))
                 (the float (+ (the int y) 2048))
                 (- (-> *math-camera* hvdf-off z) (* 1024.0 GAUNTLET_MUSE_ICON_DEPTH))
                 (-> *math-camera* hvdf-off w)))
  0)

(defbehavior gauntlet-muse-icon-frame! gauntlet-muse-portrait ()
  "One frame of the icon, when it is to be seen: the picture, looking as the state says, put in its corner and spawned (nothing is
   spawned otherwise, and a particle lives a frame, so it goes at once), and the frame around it: a pulsing violet-red while she is
   loose, a steady gold while she is his, white while it flashes."
  (when (gauntlet-muse-icon-shown?)
    (let* ((since (- (current-time) *gauntlet-muse-flip-time*))
           (flash (fmax 0.0 (- 1.0 (/ (the float since) (the float GAUNTLET_MUSE_FLASH_TIME)))))
           (size *gauntlet-misty-muse-icon-scale*))
      (gauntlet-muse-portrait-look! *gauntlet-muse-carried* flash size)
      (when (> (-> self part matrix) 0)
        (gauntlet-muse-portrait-place!)
        (spawn (-> self part) *null-vector*))
      (gauntlet-mayhem-roar-poll!)
      (let* ((aspect (-> *pc-settings* aspect-ratio-scale))
             (cx GAUNTLET_MUSE_ICON_X)
             ;; the middle of the picture, in the Klaww bar's half-height space
             (cy (the int (* 0.5 (the float GAUNTLET_MUSE_ICON_Y))))
             (grow (the int (* 6.0 flash)))
             (half-w (+ grow (max 1 (the int (/ (* (the float GAUNTLET_MUSE_FRAME_HALF_W) size) aspect)))))
             (half-h (+ grow (max 1 (the int (* (the float GAUNTLET_MUSE_FRAME_HALF_H) size)))))
             (thick-x (max 1 (the int (/ 2.0 aspect))))
             (pulse (gauntlet-muse-wave GAUNTLET_MUSE_PULSE_PERIOD)))
        (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
          ;; a loss flashes the whole screen violet, fading with the icon's flash (misty-mayhem-atmosphere scales it)
          (when (and (not *gauntlet-muse-carried*) (< 0.0 flash))
            (draw-sprite2d-xy buf 0 0 512 224
                              (gauntlet-muse-rgba 150 20 170 (the int (* GAUNTLET_MAYHEM_FLASH_ALPHA flash *gauntlet-misty-mayhem-atmosphere*)))))
          (gauntlet-muse-frame-draw!
            buf cx cy half-w half-h thick-x
            (cond
              ((< 0.0 flash) (static-rgba 255 255 255 150))
              (*gauntlet-muse-carried* (static-rgba 255 190 50 110))
              (else (gauntlet-muse-rgba 200 40 120 (+ 45 (the int (* 80.0 pulse)))))))))))
  0)

(defstate gauntlet-muse-portrait-run (gauntlet-muse-portrait)
  :code
    (behavior ()
      (loop
        (cond
          ((and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
           (gauntlet-muse-icon-frame!)
           (gauntlet-mayhem-music-poll!))
          (else
           (gauntlet-mayhem-music-off!)
           (deactivate self)))
        (suspend))))

(defbehavior gauntlet-muse-portrait-init-by-other gauntlet-muse-portrait ()
  "Make the picture's particle and take its hud slot (0 is what the allocator answers when all 76 are taken, and then nothing is drawn),
   say so in the log, and run."
  (set! (-> self part) (create-launch-control (get-part-group GAUNTLET_PART_GROUP_MUSE) self))
  (set! (-> self part matrix) (sprite-allocate-user-hvdf))
  (format 0 "GAUNTLET MUSE icon started (hud slot ~D)~%" (-> self part matrix))
  (go gauntlet-muse-portrait-run)
  (none))

(defun gauntlet-muse-icon-ensure! ()
  "Keep one process alive that drives the icon for as long as Misty is up. It ends itself when Misty goes or the setting is turned
   off, and its handle lives in a structure, as the Klaww bar's does."
  (when (and *gauntlet-misty-muse-enabled*
             *target*
             (gauntlet-misty-active?)
             (not (handle->process (-> *gauntlet-muse-world* icon))))
    (set! *gauntlet-mayhem-music* #f) ;; a process that is gone took its settings with it
    (set! (-> *gauntlet-muse-world* icon)
          (ppointer->handle
            (process-spawn gauntlet-muse-portrait :init gauntlet-muse-portrait-init-by-other :to *active-pool*))))
  0)

(defun gauntlet-muse-poll! ()
  "Per-frame: the muse's state follows Misty. Entering it, the muse is loose; leaving it, she is loose again for the next visit,
   whatever the visit before ended with. While it is up, hits are watched for, her body is kept, and the icon is."
  (let ((here (gauntlet-misty-active?)))
    (cond
      ((and here (not *gauntlet-muse-was-here*))
       (set! *gauntlet-muse-was-here* #t)
       (set! *gauntlet-muse-carried* #f)
       (set! *gauntlet-muse-health* -1.0)
       (+! *gauntlet-muse-episode* 1)
       (format 0 "GAUNTLET MUSE Misty entered, the muse is loose~%"))
      ((and (not here) *gauntlet-muse-was-here*)
       (set! *gauntlet-muse-was-here* #f)
       (set! *gauntlet-muse-carried* #f)
       (set! *gauntlet-muse-entity* (the-as entity-actor #f))
       (format 0 "GAUNTLET MUSE Misty left, the muse is loose for the next visit~%")))
    (gauntlet-mayhem-blend-poll!)
    (gauntlet-lurker-tint-poll!)
    (when (and here *gauntlet-misty-muse-enabled*)
      (gauntlet-muse-health-poll!)
      (gauntlet-muse-body-poll!)
      (gauntlet-muse-icon-ensure!)))
  0)

;; ----------------------------------------------------------- the flying fish --

;; The Forbidden Jungle's fishing game (levels/jungle/fisher.gc) with a second thing to catch: every so often a big fish, riding a
;; zoomer, flies down the river well above the water. The net cannot reach it from where it is. Holding X lifts the net to its height
;; (a quick ease up, and back down on letting go), and then it is caught if the net is lined up under it, for GAUNTLET_FISHER_FLYER_POUNDS
;; pounds. The price is that, with the net up, the river's fish cannot be caught: they pass it and count as missed exactly as the game
;; counts any it fails to catch. Missing the flying fish loses the game, as too many misses do (fisher-fish-die with the misses it takes to
;; reach the limit); a console flag makes it cost nothing instead.
;;
;; Now and then the thing on the zoomer is an eel instead (the console sets the chance), the same catch-fishc the river's eels are. It is to
;; be dodged: letting it by costs nothing and does not lose the game, and netting it does what netting a river eel does (fisher-fish-caught
;; in fisher.gc: the eel's sound and hint, then 'deadly to the fisher, which ends the game as an eel does).
;;
;; The river's own fish leap, too: any of them, the eels with them, with a chance the console sets, once on its way down, in an arc that is at the
;; net's raised height over the net's line. A fish is caught by the net that is where it is: a lowered one in the water, a raised one in the
;; air. So a leaping fish is a miss for a net that stayed down, and a leaping eel is dodged by keeping the net down.
;;
;; fisher.gc owns the river, the net and the score, and calls in here (gauntlet-fisher-*, declared in gauntlet-h.gc): begin and end
;; around a game, update every frame of it, and net-low? from each river fish's catch test. This file owns everything new: the lift,
;; the schedule and the two processes. Both art groups are not this file's: catch-fishb ships in JUN.DGO and is looked up through
;; the fisher's own level (the rider inherits the fisher's entity), and the zoomer's racer-ag is common (racer-ag.go in GAME.CGO,
;; common_art_groups in the decompiler config; no tpage, the merc renderer binds its textures from the fr3). The flyer is only ever
;; made by the fisher, so it is only ever made in the jungle, where both are there.
;;
;; Two processes, since one process has one skeleton: the zoomer (gauntlet-flyer) flies the lane and decides everything; the rider
;; (gauntlet-flyer-rider) is the fish, sitting on it. Both are children of the fisher, so the fisher's own end of the game (fisher-done
;; puts all its children away) puts them away too. The river is the fisher's path, and a lane across it is where a river fish
;; with the same offset would fly: the same two formulas as fisher-fish-move, so a flyer at lane x is over the net when the net is at x.

;; How fast it flies is a console setting (*gauntlet-fisher-flyer-speed*, in path positions a second, 3.6 m to a position or so). A river fish crosses at
;; 2.6 to 4.1 (fish-vel 1.4 to 2.2 times 1.85). It was 1.1 and is 2.2, which is still slower than any of them, and the catch test (see the zoomer's
;; flying state) looks at everywhere the zoomer went in a frame, so no speed the console allows can carry it over the net unseen.
;;
;; Where it comes from: a river fish starts at position 1 of the path (fisher-fish-init-by-other), about 29 m up the river from the camera
;; at the river's mouth, and is small, low and dim, so it is a speck that is not seen until it is well on its way. The zoomer is a big
;; bike in the air and was whole and plain to see the moment it started there, which read as appearing close to the net. So it starts
;; GAUNTLET_FLYER_START_POS, which is upstream of the river's first point (the path's first segment, carried on backwards), crosses
;; that stretch at GAUNTLET_FLYER_LEAD_SPEED so the way in does not take longer than it has to, and grows from a speck to its size as it
;; comes down the river, until GAUNTLET_FLYER_GROW_END_POS: small where it is far, as the fish are. The net and the jump see none of this.
(defconstant GAUNTLET_FLYER_START_POS -2.0) ;; where it starts: 6.6 m up the river from where a river fish starts, nearly 36 m from the camera
(defconstant GAUNTLET_FLYER_RIVER_POS 1.0) ;; where a river fish starts on the path, and where the zoomer slows to the console's speed
(defconstant GAUNTLET_FLYER_LEAD_SPEED 4.0) ;; positions a second until then
(defconstant GAUNTLET_FLYER_LEAD_UNIT (meters 3.3)) ;; what a position is worth upstream of the path's first point: what the first one is worth on it
(defconstant GAUNTLET_FLYER_GROW_END_POS 4.5) ;; whole size from here on, about 18 m from the camera
(defconstant GAUNTLET_FLYER_GROW_MIN 0.03) ;; and never quite nothing, a zero scale is a matrix that cannot be inverted
(defconstant GAUNTLET_FLYER_END_POS 7.2) ;; and where it is gone (fisher-fish-fall)
(defconstant GAUNTLET_FLYER_SIZE (meters 1.0)) ;; added to the net's radius for the flying fish, as a river fish adds its own size (1.3 m for the big one): 1.7 m in all, a lane of 6.6 m across
(defconstant GAUNTLET_FLYER_REACH 0.2) ;; the net is "up" in this fraction of its rise short of the top (0.7 m at the default height) and "down" in the same fraction above the bottom
(defconstant GAUNTLET_FLYER_RISE_PER_SECOND 4.0) ;; the net goes all the way up in a quarter of a second...
(defconstant GAUNTLET_FLYER_FALL_PER_SECOND 5.0) ;; ...and all the way down in a fifth, a little brisker so letting go catches river fish again at once
(defconstant GAUNTLET_FLYER_BOB (meters 0.25)) ;; the zoomer rides up and down by this much...
(defconstant GAUNTLET_FLYER_BOB_PER_POS (degrees 200)) ;; ...once in 1.8 positions of the path, about every 1.6 s
(defconstant GAUNTLET_FLYER_LANE_MIN 0.15) ;; a flyer takes a lane across the river between these two, a river fish's offset: 0 and 1 are the banks
(defconstant GAUNTLET_FLYER_LANE_MAX 0.85)
(defconstant GAUNTLET_FLYER_ZOOMER_SCALE 0.7) ;; the bike, which is a big one, and the fish on it
(defconstant GAUNTLET_FLYER_FISH_SCALE 0.45)
(defconstant GAUNTLET_FLYER_EEL_SCALE 1.0) ;; the eel on it, in the same proportion to the river's eel (0.9 wide, 0.7 long) as the fish is to the river's big one
(defconstant GAUNTLET_FLYER_EEL_LENGTH 0.8)
(defconstant GAUNTLET_FLYER_SEAT (meters 0.9)) ;; how far above the zoomer's origin the fish sits
(defconstant GAUNTLET_FLYER_INTERVAL_SPREAD 0.25) ;; the interval is out by up to this fraction either way
(defconstant GAUNTLET_FLYER_FIRST_SHARE 0.5) ;; and the first flying fish comes after this share of an interval
(defconstant GAUNTLET_FLYER_BUSY_RETRY (seconds 1)) ;; when one is due and the last is still flying, ask again after this long
;; A river fish that leaps (fisher-fish, fisher.gc) goes up and down in one arc along the river, centered on the net's line, so it is at its highest as
;; it crosses the net.
(defconstant GAUNTLET_FISHER_JUMP_HALF_LENGTH (meters 6)) ;; the arc runs this far upstream of the net's line and this far downstream of it, 12 m in all
(defconstant GAUNTLET_FISHER_JUMP_AIR_SHARE 0.5) ;; a fish lifted above this share of the net's rise is in the air and is for a raised net; under it, it is in the water
(defconstant GAUNTLET_FISHER_JUMP_MAX_PITCH (degrees 55)) ;; the nose is never turned up or down further than this
(defconstant GAUNTLET_PART_GROUP_BADFISH 177) ;; the eel's puffs, group-bad-fish, which fisher.gc defines and the river's eels leave behind them
(defconstant GAUNTLET_PART_GROUP_FISHCATCH 179) ;; the catch's burst, group-fish-collect, which fisher.gc defines (the jungle is loaded whenever a flyer is)

;; What the fishing game keeps between frames. The net's rise is the one number the lift is made of: the eased value of it is what is
;; drawn and what both catch tests read.
(deftype gauntlet-fisher-world (structure)
  ((flyer      handle) ;; the flying fish in the air, if any: one at a time
   (next-flyer time-frame) ;; when the next one is due
   (net        vector :inline) ;; where the net is on the river, at the water (the fisher's paddle-pos), told every frame
   (width      float) ;; the river's lane width and the net's radius, which fisher.gc owns
   (net-radius float)
   (missed     int) ;; the pounds that got past the net, and how many the game allows before it is lost, which fisher.gc owns, told every frame
   (max-missed int)
   (rise       float) ;; 0 net down, 1 net up; linear in time, see gauntlet-fisher-ease
   (held       symbol))) ;; whether X is held, for the log

(define *gauntlet-fisher* (new 'global 'gauntlet-fisher-world))
(set! (-> *gauntlet-fisher* flyer) (the-as handle #f))
(set! (-> *gauntlet-fisher* next-flyer) 0)
(set! (-> *gauntlet-fisher* rise) 0.0)
(set! (-> *gauntlet-fisher* held) #f)
(set! (-> *gauntlet-fisher* missed) 0)
(set! (-> *gauntlet-fisher* max-missed) 0)

;; The racer's exploded model, which is the whole bike in pieces posed together (the game swaps it for the bike when it blows up, see
;; *racer-explode-sg* in racer.gc), not the bike's own racer-geo. The disc's racer-ag has every animation of racer-geo stripped: elements 3
;; to 21 are #f in all five copies (FIC, LAV, MIS, OGR, ROL), so racer-geo's idle animation, element 3, is not an art-joint-anim and
;; initialize-skeleton sent the zoomer to process-drawable-art-error. The explode group's own idle animation (element 24) is there, and
;; it is the one animation the draw needs: a skeleton with no animation at all has no pose to draw.
(defskelgroup *gauntlet-flyer-zoomer-sg*
  racer
  racer-explode-lod0-jg
  racer-explode-idle-ja
  ((racer-explode-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3.5)
  :texture-level 2
  :sort 1)

(defskelgroup *gauntlet-flyer-fish-sg*
  catch-fishb
  catch-fishb-lod0-jg
  catch-fishb-idle-ja
  ((catch-fishb-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

;; the river's eel (*catch-fishc-sg* in fisher.gc, which this is a copy of for the same reason as the fish's)
(defskelgroup *gauntlet-flyer-eel-sg*
  catch-fishc
  catch-fishc-lod0-jg
  catch-fishc-idle-ja
  ((catch-fishc-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defun gauntlet-fisher-ease ()
  "How far up the net is, 0 to 1, eased so it starts and arrives gently: the lift is linear in time, this is its smoothstep."
  (let ((r (-> *gauntlet-fisher* rise)))
    (* r r (- 3.0 (* 2.0 r)))))

(defun gauntlet-fisher-net-rise ()
  "How far the net is raised right now, in game units."
  (* (gauntlet-fisher-ease) *gauntlet-fisher-flyer-height*))

(defun gauntlet-fisher-net-low? ()
  "True while the net is down far enough to catch the river's fish. Always true with nothing lifting it."
  (< (gauntlet-fisher-ease) GAUNTLET_FLYER_REACH))

(defun gauntlet-fisher-net-up? ()
  "True while the net is up far enough to catch the flying fish."
  (>= (gauntlet-fisher-ease) (- 1.0 GAUNTLET_FLYER_REACH)))

(defun gauntlet-fisher-net-catches? ((lift float))
  "True when the net is where a river fish lifted lift game units off its swimming line can be caught: a fish in the water is for a
   lowered net and a fish in the air, one that leapt above the share of the net's rise that is GAUNTLET_FISHER_JUMP_AIR_SHARE, for a
   raised one. Between the two the net catches nothing, which is what keeps tapping X from catching both."
  (if (< lift (* GAUNTLET_FISHER_JUMP_AIR_SHARE *gauntlet-fisher-flyer-height*))
    (gauntlet-fisher-net-low?)
    (gauntlet-fisher-net-up?)))

(defun gauntlet-fisher-jump-roll! ()
  "Whether a river fish being born will leap once on its way down. Never when the net cannot be raised to it (no flying fish)."
  (and *gauntlet-fisher-flyer-enabled*
       (> *gauntlet-fisher-jump-chance* 0)
       (rand-vu-percent? (* 0.01 (the float *gauntlet-fisher-jump-chance*)))))

(defun gauntlet-fisher-jump-along ((trans vector) (dir vector))
  "How far upstream of the net's line a fish at trans, swimming along dir (which points down the river), is: positive before it
   reaches the line, 0 on it, negative after. A very large number when dir has no direction."
  (let ((run (vector-xz-length dir)))
    (if (< run 0.001)
      4096000.0
      (/ (+ (* (- (-> *gauntlet-fisher* net x) (-> trans x)) (-> dir x))
            (* (- (-> *gauntlet-fisher* net z) (-> trans z)) (-> dir z)))
         run))))

(defun gauntlet-fisher-jump-lift ((trans vector) (dir vector))
  "How far above its swimming line a leaping fish at trans, swimming along dir, is: a parabola along the river that is the height of the
   raised net over the net's line and 0 GAUNTLET_FISHER_JUMP_HALF_LENGTH either side of it, so the fish is in the air, at the net's
   height, as it crosses the net."
  (let ((ratio (/ (gauntlet-fisher-jump-along trans dir) GAUNTLET_FISHER_JUMP_HALF_LENGTH)))
    (if (< (fabs ratio) 1.0)
      (* *gauntlet-fisher-flyer-height* (- 1.0 (* ratio ratio)))
      0.0)))

(defun gauntlet-fisher-jump-pitch ((trans vector) (dir vector))
  "How far a leaping fish's nose is turned up, in rotation units: the slope of the arc, so up on the way to the net's line and down on the
   way from it. 0 outside the arc."
  (let ((along (gauntlet-fisher-jump-along trans dir)))
    (if (< (fabs along) GAUNTLET_FISHER_JUMP_HALF_LENGTH)
      (fmax (- GAUNTLET_FISHER_JUMP_MAX_PITCH)
            (fmin GAUNTLET_FISHER_JUMP_MAX_PITCH
                  (atan (/ (* 2.0 *gauntlet-fisher-flyer-height* along) (* GAUNTLET_FISHER_JUMP_HALF_LENGTH GAUNTLET_FISHER_JUMP_HALF_LENGTH))
                        1.0)))
      0.0)))

(defun gauntlet-fisher-net-cspace! ((dest cspace) (hand cspace) (quat quaternion))
  "The fish net's root joint. The game puts it in Jak's right hand, turned as he is (cspace<-cspace+quaternion!); this does that and
   then lifts it straight up in the world by the net's rise, so the net, pole and all, goes up while Jak stays where he is."
  (let ((placed (cspace<-cspace+quaternion! dest hand quat)))
    (+! (-> dest bone transform vector 3 y) (gauntlet-fisher-net-rise))
    placed))

(defun gauntlet-fisher-net-point ((out vector))
  "Where the net's catching part is now, written to out: its place on the river, raised."
  (set! (-> out quad) (-> *gauntlet-fisher* net quad))
  (+! (-> out y) (gauntlet-fisher-net-rise))
  out)

(defun gauntlet-flyer-pause-time ((share float))
  "How long until a flying fish that is share of an interval away, out by the spread either way."
  (the int (* share
              (the float *gauntlet-fisher-flyer-interval*)
              (rand-vu-float-range (- 1.0 GAUNTLET_FLYER_INTERVAL_SPREAD) (+ 1.0 GAUNTLET_FLYER_INTERVAL_SPREAD)))))

;; ---- the zoomer

(defun gauntlet-flyer-eel-roll! ()
  "Whether the flying fish being born is an eel on the zoomer instead of the big fish."
  (and (> *gauntlet-fisher-flyer-eel-chance* 0)
       (rand-vu-percent? (* 0.01 (the float *gauntlet-fisher-flyer-eel-chance*)))))

(defun gauntlet-flyer-grown ((pos float))
  "How much of its size the flying fish has at pos on the river: from nearly nothing where it starts to all of it at GAUNTLET_FLYER_GROW_END_POS,
   slowly at first (the square of how far along), so it is a speck for as long as a river fish is."
  (let ((along (fmax 0.0 (fmin 1.0 (/ (- pos GAUNTLET_FLYER_START_POS) (- GAUNTLET_FLYER_GROW_END_POS GAUNTLET_FLYER_START_POS))))))
    (fmax GAUNTLET_FLYER_GROW_MIN (* along along))))

(deftype gauntlet-flyer (process-drawable)
  ((rider  handle) ;; what is on it
   (kind   symbol) ;; 'fish, to be caught, or 'eel, to be dodged
   (prev-x float) ;; where it was a frame ago on the ground, so the catch can look at the whole way it went
   (prev-z float)
   (pos    float) ;; along the river, in the fisher's path positions
   (offset float) ;; which lane across it, 0 to 1
   (phase  float)) ;; where in its bob it starts, in rotation units
  (:states
   gauntlet-flyer-fly
   gauntlet-flyer-gone))

(deftype gauntlet-flyer-rider (process-drawable)
  ((kind symbol)) ;; 'fish or 'eel, as the zoomer is
  (:states
   gauntlet-flyer-rider-ride
   gauntlet-flyer-rider-netted
   gauntlet-flyer-rider-gone))

;; ---- the fish on it

(defbehavior gauntlet-flyer-rider-event gauntlet-flyer-rider ((proc process) (argc int) (message symbol) (block event-message-block))
  "The zoomer tells it when it has been caught."
  (case message
    (('caught) (go gauntlet-flyer-rider-netted)))
  #f)

(defstate gauntlet-flyer-rider-ride (gauntlet-flyer-rider)
  :event gauntlet-flyer-rider-event
  :trans
    (behavior ()
      ;; the fish goes wherever the zoomer goes; with no zoomer, it is gone
      (let ((zoomer (handle->process (-> *gauntlet-fisher* flyer))))
        (cond
          (zoomer
           (set! (-> self root trans quad) (-> (the-as gauntlet-flyer zoomer) root trans quad))
           (+! (-> self root trans y) GAUNTLET_FLYER_SEAT)
           (let ((grown (gauntlet-flyer-grown (-> (the-as gauntlet-flyer zoomer) pos))))
             (if (= (-> self kind) 'eel)
               (set-vector! (-> self root scale) (* GAUNTLET_FLYER_EEL_SCALE grown) (* GAUNTLET_FLYER_EEL_SCALE grown) (* GAUNTLET_FLYER_EEL_LENGTH grown) 1.0)
               (set-vector! (-> self root scale) (* GAUNTLET_FLYER_FISH_SCALE grown) (* GAUNTLET_FLYER_FISH_SCALE grown) (* GAUNTLET_FLYER_FISH_SCALE grown) 1.0)))
           (quaternion-copy! (-> self root quat) (-> (the-as gauntlet-flyer zoomer) root quat))
           ;; an eel leaves its puffs behind it as the river's do
           (if (and (= (-> self kind) 'eel) (nonzero? (-> self part))) (spawn (-> self part) (-> self root trans))))
          (else (go gauntlet-flyer-rider-gone))))
      (none))
  :code
    (behavior ()
      (ja-channel-push! 1 0)
      (if (= (-> self kind) 'eel)
        (ja :group! catch-fishc-idle-ja :num! min)
        (ja :group! catch-fishb-idle-ja :num! min))
      (loop
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

(defstate gauntlet-flyer-rider-netted (gauntlet-flyer-rider)
  :trans
    (behavior ()
      ;; into the net, small, like a river fish that is caught (fisher-fish-caught)
      (let ((net (gauntlet-fisher-net-point (new 'stack-no-clear 'vector))))
        (vector-lerp! (-> self root trans) (-> self root trans) net 0.3))
      (vector-float*! (-> self root scale) (-> self root scale) 0.93)
      (if (< (-> self root scale x) 0.05) (go gauntlet-flyer-rider-gone))
      (none))
  :code
    (behavior ()
      (loop
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

(defstate gauntlet-flyer-rider-gone (gauntlet-flyer-rider)
  :code
    (behavior ()
      (deactivate self)))

(defbehavior gauntlet-flyer-rider-init-by-other gauntlet-flyer-rider ((kind symbol))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self kind) kind)
  (format 0 "GAUNTLET FLYER rider: building the ~A's skeleton~%" kind)
  (cond
    ((= kind 'eel)
     (set-vector! (-> self root scale) GAUNTLET_FLYER_EEL_SCALE GAUNTLET_FLYER_EEL_SCALE GAUNTLET_FLYER_EEL_LENGTH 1.0)
     (set! (-> self part) (create-launch-control (get-part-group GAUNTLET_PART_GROUP_BADFISH) self))
     (initialize-skeleton self *gauntlet-flyer-eel-sg* '()))
    (else
     (set-vector! (-> self root scale) GAUNTLET_FLYER_FISH_SCALE GAUNTLET_FLYER_FISH_SCALE GAUNTLET_FLYER_FISH_SCALE 1.0)
     (initialize-skeleton self *gauntlet-flyer-fish-sg* '())))
  (format 0 "GAUNTLET FLYER rider: skeleton built~%")
  ;; the dimmer light of the river's fish (fisher-fish-init-by-other)
  (set-vector! (-> self draw color-mult) 0.6 0.6 0.6 1.0)
  (set-vector! (-> self draw color-emissive) 0.6 0.6 0.6 0.0)
  (go gauntlet-flyer-rider-ride)
  (none))

;; ---- the zoomer, flying

(defbehavior gauntlet-flyer-place gauntlet-flyer ()
  "Put the zoomer where it flies: on its lane of the river at its position, the net's height above the water plus the lift's, a little
   up or down for the bob, facing downstream."
  (let* ((fisher (the-as process-drawable (-> self parent 0)))
         (dir (new 'stack-no-clear 'vector))
         (side (new 'stack-no-clear 'vector)))
    (eval-path-curve-div! (-> fisher path) (-> self root trans) (fmax 0.0 (-> self pos)) 'interp)
    (path-control-method-12 (-> fisher path) dir (-> self pos))
    ;; upstream of the path's first point (a negative position the path would hold at that point): carry its first segment on backwards
    (when (< (-> self pos) 0.0)
      (vector-normalize! dir 1.0)
      (vector-float*! dir dir (* (-> self pos) GAUNTLET_FLYER_LEAD_UNIT))
      (vector+! (-> self root trans) (-> self root trans) dir)
      (path-control-method-12 (-> fisher path) dir (-> self pos)))
    (let ((turn (+ 16384.0 (vector-y-angle dir))))
      (set! (-> side x) (sin turn))
      (set! (-> side y) 0.0)
      (set! (-> side z) (cos turn))
      (set! (-> side w) 1.0))
    (vector-normalize! side (* 2.0 (+ -0.5 (-> self offset)) (-> *gauntlet-fisher* width)))
    (vector+! (-> self root trans) (-> self root trans) side)
    (set! (-> self root trans y)
          (+ (-> *gauntlet-fisher* net y)
             *gauntlet-fisher-flyer-height*
             (* GAUNTLET_FLYER_BOB (sin (+ (-> self phase) (* (-> self pos) GAUNTLET_FLYER_BOB_PER_POS))))))
    (quaternion-vector-angle! (-> self root quat) (new 'static 'vector :y 1.0 :w 1.0) (vector-y-angle dir))
    (let ((grown (gauntlet-flyer-grown (-> self pos))))
      (set-vector! (-> self root scale)
                   (* GAUNTLET_FLYER_ZOOMER_SCALE grown)
                   (* GAUNTLET_FLYER_ZOOMER_SCALE grown)
                   (* GAUNTLET_FLYER_ZOOMER_SCALE grown)
                   1.0)))
  0)

(defun gauntlet-flyer-poof! ((at vector))
  "A small burst where something of the flying fish's is leaving, in the jungle's air."
  (process-spawn part-tracker :init part-tracker-init group-punch-hit -1 #f #f #f at :to *entity-pool*)
  0)

(defun gauntlet-flyer-near-net? ((from-x float) (from-z float) (to-x float) (to-z float))
  "True when the net, which is on the ground, is within reach of the zoomer anywhere on its way from (from-x, from-z) to (to-x, to-z) this
   frame, not only where it ended up: the distance from the net to that stretch. A faster zoomer or a slower frame is a longer stretch, never
   a gap the zoomer can jump over the net through."
  (let* ((net-x (-> *gauntlet-fisher* net x))
         (net-z (-> *gauntlet-fisher* net z))
         (run-x (- to-x from-x))
         (run-z (- to-z from-z))
         (run-squared (+ (* run-x run-x) (* run-z run-z)))
         ;; how far along the stretch the point nearest the net is, 0 at its start and 1 at its end
         (along (if (< run-squared 0.001)
                  0.0
                  (fmax 0.0 (fmin 1.0 (/ (+ (* (- net-x from-x) run-x) (* (- net-z from-z) run-z)) run-squared)))))
         (off-x (- net-x (+ from-x (* along run-x))))
         (off-z (- net-z (+ from-z (* along run-z)))))
    (< (sqrtf (+ (* off-x off-x) (* off-z off-z)))
       (+ (-> *gauntlet-fisher* net-radius) GAUNTLET_FLYER_SIZE))))

(defstate gauntlet-flyer-fly (gauntlet-flyer)
  :trans
    (behavior ()
      (set! (-> self prev-x) (-> self root trans x))
      (set! (-> self prev-z) (-> self root trans z))
      (+! (-> self pos)
          (* (if (< (-> self pos) GAUNTLET_FLYER_RIVER_POS) GAUNTLET_FLYER_LEAD_SPEED *gauntlet-fisher-flyer-speed*) (seconds-per-frame)))
      (gauntlet-flyer-place)
      (cond
        ;; the net is up and under it: caught. A fish is for the pounds the console says, with the game's own feedback for a big fish
        ((and (gauntlet-fisher-net-up?)
              (gauntlet-flyer-near-net? (-> self prev-x) (-> self prev-z) (-> self root trans x) (-> self root trans z)))
         (let ((pounds *gauntlet-fisher-flyer-pounds*)
               (rider (handle->process (-> self rider))))
           (cond
             ((= (-> self kind) 'eel)
              ;; an eel is what netting a river eel is (fisher-fish-caught): its sound and hint, then 'deadly, which ends the game
              (format 0 "GAUNTLET FLYER eel caught~%")
              (gauntlet-flyer-poof! (-> self root trans))
              (sound-play "caught-eel")
              (ambient-hint-spawn "sksp0a42" (-> self root trans) *entity-pool* 'ambient)
              (send-event (ppointer->process (-> self parent)) 'deadly)
              (go gauntlet-flyer-gone))
             (else
              (format 0 "GAUNTLET FLYER caught +~D~%" pounds)
              (send-event (ppointer->process (-> self parent)) 'fisher-fish-caught pounds)
              (sound-play "get-big-fish")
              (process-spawn part-tracker :init part-tracker-init (get-part-group GAUNTLET_PART_GROUP_FISHCATCH) -1 #f #f #f (-> self root trans) :to *entity-pool*)
              (gauntlet-flyer-poof! (-> self root trans))
              ;; the fish goes into the net; the zoomer is gone
              (if rider (send-event rider 'caught))
              (go gauntlet-flyer-gone)))))
        ;; past the end of the river: an eel dodged, which is the right play and costs nothing. A fish missed loses the game the way too
        ;; many misses do, unless the console says it costs nothing
        ((and (>= (-> self pos) GAUNTLET_FLYER_END_POS) (= (-> self kind) 'eel))
         (format 0 "GAUNTLET FLYER eel dodged~%")
         (gauntlet-flyer-poof! (-> self root trans))
         (go gauntlet-flyer-gone))
        ((>= (-> self pos) GAUNTLET_FLYER_END_POS)
         (cond
           (*gauntlet-fisher-flyer-miss-loses*
            (format 0 "GAUNTLET FLYER missed, game lost~%")
            ;; the misses it takes to reach the limit: the fisher counts them as it counts any fish that got by, then ends the game
            (send-event (ppointer->process (-> self parent))
                        'fisher-fish-die
                        (max 1 (- (-> *gauntlet-fisher* max-missed) (-> *gauntlet-fisher* missed)))))
           (else (format 0 "GAUNTLET FLYER missed~%")))
         (gauntlet-flyer-poof! (-> self root trans))
         (go gauntlet-flyer-gone)))
      (none))
  :code
    (behavior ()
      (ja-channel-push! 1 0)
      (ja :group! racer-explode-idle-ja :num! min)
      (loop
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

(defstate gauntlet-flyer-gone (gauntlet-flyer)
  :code
    (behavior ()
      (deactivate self)))

(defbehavior gauntlet-flyer-init-by-other gauntlet-flyer ()
  "Appear at the upstream end of the river on a lane of its own, with its fish on it."
  (logclear! (-> self mask) (process-mask actor-pause))
  ;; it inherits the fisher's entity, and the zoomer needs none: texture level 2 finds its art in level-default, as the yakow's does
  (set! (-> self entity) #f)
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self rider) (the-as handle #f))
  (set! (-> self kind) (if (gauntlet-flyer-eel-roll!) 'eel 'fish))
  (set! (-> self pos) GAUNTLET_FLYER_START_POS)
  (set! (-> self offset) (rand-vu-float-range GAUNTLET_FLYER_LANE_MIN GAUNTLET_FLYER_LANE_MAX))
  (set! (-> self phase) (rand-vu-float-range 0.0 (degrees 360)))
  (set-vector! (-> self root scale) GAUNTLET_FLYER_ZOOMER_SCALE GAUNTLET_FLYER_ZOOMER_SCALE GAUNTLET_FLYER_ZOOMER_SCALE 1.0)
  ;; initialize-skeleton does not return when the art is wrong: it goes to process-drawable-art-error, which says nothing
  ;; unless the debug display is on, so a line on each side of it is how a death inside it is told from one after it
  (format 0 "GAUNTLET FLYER zoomer: building its skeleton~%")
  (initialize-skeleton self *gauntlet-flyer-zoomer-sg* '())
  (format 0 "GAUNTLET FLYER zoomer: skeleton built~%")
  (gauntlet-flyer-place)
  (set! (-> self prev-x) (-> self root trans x))
  (set! (-> self prev-z) (-> self root trans z))
  (set! (-> *gauntlet-fisher* flyer) (process->handle self))
  (set! (-> self rider)
        (ppointer->handle (process-spawn gauntlet-flyer-rider (-> self kind) :init gauntlet-flyer-rider-init-by-other :to (ppointer->process (-> self parent)))))
  (format 0 "GAUNTLET FLYER starts at position ~F, at ~M, ~M~%" (-> self pos) (-> self root trans x) (-> self root trans z))
  (format 0 "GAUNTLET FLYER spawned, rider ~S, on lane ~F, ~M m up, ~F positions a second~%"
          (if (= (-> self kind) 'eel) "eel" "fish")
          (-> self offset)
          *gauntlet-fisher-flyer-height*
          *gauntlet-fisher-flyer-speed*)
  (go gauntlet-flyer-fly)
  (none))

;; ---- the game

(defun gauntlet-fisher-begin! ()
  "A game of fishing starts: the net is down, nothing is flying, and the first flying fish is on its way."
  (let ((world *gauntlet-fisher*))
    (set! (-> world flyer) (the-as handle #f))
    (set! (-> world rise) 0.0)
    (set! (-> world held) #f)
    (set! (-> world next-flyer) (+ (current-time) (gauntlet-flyer-pause-time GAUNTLET_FLYER_FIRST_SHARE)))
    (format 0 "GAUNTLET FLYER fishing game started, enabled ~A, now ~D, first one due at ~D, interval ~D~%"
            *gauntlet-fisher-flyer-enabled*
            (current-time)
            (-> world next-flyer)
            *gauntlet-fisher-flyer-interval*))
  0)

(defun gauntlet-fisher-end! ()
  "The game of fishing is over, however it ended. The net is down for the next one; what is flying goes with the fisher's children."
  (set! (-> *gauntlet-fisher* flyer) (the-as handle #f))
  (set! (-> *gauntlet-fisher* rise) 0.0)
  (set! (-> *gauntlet-fisher* held) #f)
  (format 0 "GAUNTLET FLYER fishing game over~%")
  0)

(defun gauntlet-fisher-update! ((fisher process-drawable) (net vector) (width float) (net-radius float) (missed int) (max-missed int))
  "One frame of the fishing game: X held lifts the net, letting go lowers it, and a flying fish is sent when one is due."
  (let ((world *gauntlet-fisher*))
    (set! (-> world net quad) (-> net quad))
    (set! (-> world width) width)
    (set! (-> world net-radius) net-radius)
    (set! (-> world missed) missed)
    (set! (-> world max-missed) max-missed)
    (let ((held (and *gauntlet-fisher-flyer-enabled* (cpad-hold? 0 x))))
      (when (!= held (-> world held))
        (set! (-> world held) held)
        (format 0 "GAUNTLET NET ~S~%" (if held "up" "down")))
      (set! (-> world rise)
            (seek (-> world rise) (if held 1.0 0.0)
                  (* (seconds-per-frame) (if held GAUNTLET_FLYER_RISE_PER_SECOND GAUNTLET_FLYER_FALL_PER_SECOND)))))
    (when (and *gauntlet-fisher-flyer-enabled* (>= (current-time) (-> world next-flyer)))
      (format 0 "GAUNTLET FLYER due at ~D~%" (current-time))
      (cond
        ((handle->process (-> world flyer))
         (format 0 "GAUNTLET FLYER busy, the last is still flying, asking again in a second~%")
         (set! (-> world next-flyer) (+ (current-time) GAUNTLET_FLYER_BUSY_RETRY)))
        ((not (gauntlet-art-ready? *gauntlet-flyer-zoomer-sg*))
         (format 0 "GAUNTLET FLYER: the zoomer's art group is not loaded or not whole (joint geometry, idle animation, mesh), none sent~%")
         (set! (-> world next-flyer) (+ (current-time) (gauntlet-flyer-pause-time 1.0))))
        (else
         (let ((made (process-spawn gauntlet-flyer :init gauntlet-flyer-init-by-other :to fisher)))
           (cond
             ((not made) (format 0 "GAUNTLET FLYER spawn failed: no process from the pool~%"))
             ;; the zoomer's init puts its handle here once it is placed, so an empty one means it died before that
             ((not (handle->process (-> world flyer)))
              (format 0 "GAUNTLET FLYER spawn failed: the zoomer's init ended before it was placed, see the lines above~%"))))
         (set! (-> world next-flyer) (+ (current-time) (gauntlet-flyer-pause-time 1.0)))))))
  (none))

;; --------------------------------------------------------------- the console --

;; A local web console steers the mod while it runs, through two files in Mods/ (the contract is the console's).
;;   gauntlet-settings.gc  the console writes, the game reads: (revision N) first, then one (key value) per setting, in
;;                         human units (meters, seconds, degrees, #t / #f). Looked at every GAUNTLET_SETTINGS_POLL_FRAMES
;;                         frames, and applied only when the revision is not the one in effect. A file is the whole
;;                         truth: a key it does not name goes back to its default. Unknown keys and values that are not
;;                         numbers (or are outside the key's range) are skipped and logged, never fatal.
;;   gauntlet-state.json   the game writes, the console reads, every GAUNTLET_STATE_POLL_FRAMES frames: the settings in
;;                         effect next to the defaults, and where Jak, the bomb and the drop spots are.
;; Every setting is one row of gauntlet-setting-table, which names it, says what unit the file speaks, which global holds
;; it, what its default is and what range it may take; applying, resetting and publishing it are all generated from that
;; row, so a setting cannot be added to one and forgotten in another.

(defconstant GAUNTLET_SETTINGS_POLL_FRAMES 30) ;; how often the settings file is looked at
(defconstant GAUNTLET_STATE_POLL_FRAMES 15) ;; how often the state file is written

(defmacro gauntlet-setting-table (row)
  "Expand row once per setting: (row name unit global default lowest highest). The unit is how the file speaks and
   how the global holds it: seconds (file: seconds, global: ticks), meters (file: meters, global: game units, which
   also covers meters per second and per second squared), degrees (file: degrees, global: rotation units), count
   (both a whole number), ratio (both a plain float: a chance, a multiplier), flag (#t or #f). The range is in file
   units and is ignored for a flag."
  `(begin
     (,row "bomb-countdown" seconds *gauntlet-bomb-countdown* GAUNTLET_BOMB_COUNTDOWN_DEFAULT 0.5 120.0)
     (,row "bomb-blast-radius" meters *gauntlet-bomb-blast-radius* GAUNTLET_BOMB_BLAST_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull-radius" meters *gauntlet-bomb-pull-radius* GAUNTLET_BOMB_PULL_RADIUS_DEFAULT 0.0 500.0)
     (,row "bomb-pull" meters *gauntlet-bomb-pull* GAUNTLET_BOMB_PULL_DEFAULT 0.0 500.0)
     (,row "bomb-ground-pull" meters *gauntlet-bomb-ground-pull* GAUNTLET_BOMB_GROUND_PULL_DEFAULT 0.0 50.0)
     (,row "bomb-drop-height" meters *gauntlet-bomb-drop-height* GAUNTLET_BOMB_DROP_HEIGHT_DEFAULT 0.0 200.0)
     (,row "bomb-gravity" meters *gauntlet-bomb-gravity* GAUNTLET_BOMB_GRAVITY_DEFAULT 1.0 500.0)
     (,row "bridge-enabled" flag *gauntlet-bridge-enabled* GAUNTLET_BRIDGE_ENABLED_DEFAULT 0 0)
     (,row "vent-enabled" flag *gauntlet-vent-enabled* GAUNTLET_VENT_ENABLED_DEFAULT 0 0)
     (,row "bridge-trigger-radius" meters *gauntlet-bridge-trigger-radius* GAUNTLET_BRIDGE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "bridge-rearm-range" meters *gauntlet-bridge-rearm-range* GAUNTLET_BRIDGE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "dummies-enabled" flag *gauntlet-dummies-enabled* GAUNTLET_DUMMIES_ENABLED_DEFAULT 0 0)
     (,row "dummy-volley-interval" seconds *gauntlet-dummy-volley-interval* GAUNTLET_DUMMY_VOLLEY_INTERVAL_DEFAULT 0.1 120.0)
     (,row "dummy-volley-gap" seconds *gauntlet-dummy-volley-gap* GAUNTLET_DUMMY_VOLLEY_GAP_DEFAULT 0.05 60.0)
     (,row "dummy-volley-size" count *gauntlet-dummy-volley-size* GAUNTLET_DUMMY_VOLLEY_SIZE_DEFAULT 1.0 50.0)
     (,row "dummy-volley-spread" degrees *gauntlet-dummy-volley-spread* GAUNTLET_DUMMY_VOLLEY_SPREAD_DEFAULT 0.0 90.0)
     (,row "dummy-range" meters *gauntlet-dummy-range* GAUNTLET_DUMMY_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-leave-range" meters *gauntlet-dummy-leave-range* GAUNTLET_SAGE_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-range" meters *gauntlet-herald-range* GAUNTLET_HERALD_RANGE_DEFAULT 0.0 500.0)
     (,row "herald-leave-range" meters *gauntlet-herald-leave-range* GAUNTLET_HERALD_LEAVE_RANGE_DEFAULT 0.0 500.0)
     (,row "dummy-shot-speed" meters *gauntlet-dummy-shot-speed* GAUNTLET_DUMMY_SHOT_SPEED_DEFAULT 0.0 500.0)
     (,row "stampede-enabled" flag *gauntlet-stampede-enabled* GAUNTLET_STAMPEDE_ENABLED_DEFAULT 0 0)
     (,row "stampede-herd-size" count *gauntlet-stampede-herd-size* GAUNTLET_STAMPEDE_HERD_SIZE_DEFAULT 1.0 30.0)
     (,row "stampede-speed" meters *gauntlet-stampede-speed* GAUNTLET_STAMPEDE_SPEED_DEFAULT 4.0 30.0)
     (,row "stampede-trigger-radius" meters *gauntlet-stampede-trigger-radius* GAUNTLET_STAMPEDE_TRIGGER_RADIUS_DEFAULT 0.0 200.0)
     (,row "stampede-rearm-range" meters *gauntlet-stampede-rearm-range* GAUNTLET_STAMPEDE_REARM_RANGE_DEFAULT 0.0 1000.0)
     (,row "stampede-launch-up" meters *gauntlet-stampede-launch-up* GAUNTLET_STAMPEDE_LAUNCH_UP_DEFAULT 0.0 100.0)
     (,row "stampede-red-count" count *gauntlet-stampede-red-count* GAUNTLET_STAMPEDE_RED_COUNT_DEFAULT 0.0 30.0)
     (,row "yakow-stampede-enabled" flag *gauntlet-yakow-stampede-enabled* GAUNTLET_YAKOW_STAMPEDE_ENABLED_DEFAULT 0 0)
     (,row "babak-charge-enabled" flag *gauntlet-babak-charge-enabled* GAUNTLET_BABAK_CHARGE_ENABLED_DEFAULT 0 0)
     (,row "babak-charge-chance" ratio *gauntlet-babak-charge-chance* GAUNTLET_BABAK_CHARGE_CHANCE_DEFAULT 0.0 1.0)
     (,row "babak-blue-speed" ratio *gauntlet-babak-blue-speed* GAUNTLET_BABAK_BLUE_SPEED_DEFAULT 1.0 4.0)
     (,row "desperation-max" ratio *gauntlet-desperation-max* GAUNTLET_DESPERATION_MAX_DEFAULT 1.0 5.0)
     (,row "cell-heal-enabled" flag *gauntlet-cell-heal-enabled* GAUNTLET_CELL_HEAL_ENABLED_DEFAULT 0 0)
     (,row "misty-muse-enabled" flag *gauntlet-misty-muse-enabled* GAUNTLET_MISTY_MUSE_ENABLED_DEFAULT 0 0)
     (,row "misty-mayhem-extra" count *gauntlet-misty-mayhem-extra* GAUNTLET_MISTY_MAYHEM_EXTRA_DEFAULT 0.0 4.0)
     (,row "misty-mayhem-speed" ratio *gauntlet-misty-mayhem-speed* GAUNTLET_MISTY_MAYHEM_SPEED_DEFAULT 1.0 4.0)
     (,row "misty-mayhem-charge-chance" ratio *gauntlet-misty-mayhem-charge-chance* GAUNTLET_MISTY_MAYHEM_CHARGE_CHANCE_DEFAULT 0.0 1.0)
     (,row "misty-mayhem-music" flag *gauntlet-misty-mayhem-music* GAUNTLET_MISTY_MAYHEM_MUSIC_DEFAULT 0 0)
     (,row "misty-mayhem-voice" flag *gauntlet-misty-mayhem-voice* GAUNTLET_MISTY_MAYHEM_VOICE_DEFAULT 0 0)
     (,row "misty-mayhem-atmosphere" ratio *gauntlet-misty-mayhem-atmosphere* GAUNTLET_MISTY_MAYHEM_ATMOSPHERE_DEFAULT 0.0 1.0)
     (,row "misty-muse-icon-scale" ratio *gauntlet-misty-muse-icon-scale* GAUNTLET_MUSE_ICON_SCALE_DEFAULT 0.5 3.0)
     (,row "worm-cubes-enabled" flag *gauntlet-worm-cubes-enabled* GAUNTLET_WORM_CUBES_ENABLED_DEFAULT 0 0)
     (,row "worm-cube-count" count *gauntlet-worm-cube-count* GAUNTLET_WORM_CUBE_COUNT_DEFAULT 0.0 8.0)
     (,row "lurker-multiplier" count *gauntlet-lurker-multiplier* GAUNTLET_LURKER_MULTIPLIER_DEFAULT 1.0 5.0)
     (,row "horde-max-clones" count *gauntlet-horde-max-clones* GAUNTLET_HORDE_MAX_CLONES_DEFAULT 0.0 300.0)
     (,row "klaww-enabled" flag *gauntlet-klaww-enabled* GAUNTLET_KLAWW_ENABLED_DEFAULT 0 0)
     (,row "klaww-throw-interval" seconds *gauntlet-klaww-throw-interval* GAUNTLET_KLAWW_THROW_INTERVAL_DEFAULT 0.5 60.0)
     (,row "klaww-rage-max" ratio *gauntlet-klaww-rage-max* GAUNTLET_KLAWW_RAGE_MAX_DEFAULT 1.0 5.0)
     (,row "klaww-radius-max" ratio *gauntlet-klaww-radius-max* GAUNTLET_KLAWW_RADIUS_MAX_DEFAULT 1.0 5.0)
     (,row "klaww-range" meters *gauntlet-klaww-range* GAUNTLET_KLAWW_RANGE_DEFAULT 10.0 500.0)
     (,row "klaww-boulder-radius" meters *gauntlet-klaww-boulder-radius* GAUNTLET_KLAWW_BOULDER_RADIUS_DEFAULT 0.5 30.0)
     (,row "flybox-enabled" flag *gauntlet-flybox-enabled* GAUNTLET_FLYBOX_ENABLED_DEFAULT 0 0)
     (,row "flybox-bounce" meters *gauntlet-flybox-bounce* GAUNTLET_FLYBOX_BOUNCE_DEFAULT 0.0 20.0)
     (,row "flybox-carrier-return" seconds *gauntlet-carrier-return* GAUNTLET_CARRIER_RETURN_DEFAULT 0.0 600.0)
     (,row "tnt-enabled" flag *gauntlet-tnt-enabled* GAUNTLET_TNT_ENABLED_DEFAULT 0 0)
     (,row "fj-temple-platforms-removed" flag *gauntlet-fj-temple-platforms-removed* GAUNTLET_FJ_TEMPLE_PLATFORMS_REMOVED_DEFAULT 0 0)
     (,row "fisher-flyer-enabled" flag *gauntlet-fisher-flyer-enabled* GAUNTLET_FISHER_FLYER_ENABLED_DEFAULT 0 0)
     (,row "fisher-flyer-interval" seconds *gauntlet-fisher-flyer-interval* GAUNTLET_FISHER_FLYER_INTERVAL_DEFAULT 5.0 120.0)
     (,row "fisher-flyer-pounds" count *gauntlet-fisher-flyer-pounds* GAUNTLET_FISHER_FLYER_POUNDS_DEFAULT 1.0 100.0)
     (,row "fisher-flyer-speed" ratio *gauntlet-fisher-flyer-speed* GAUNTLET_FISHER_FLYER_SPEED_DEFAULT 0.5 6.0)
     (,row "fisher-flyer-eel-chance" count *gauntlet-fisher-flyer-eel-chance* GAUNTLET_FISHER_FLYER_EEL_CHANCE_DEFAULT 0.0 100.0)
     (,row "fisher-flyer-miss-loses" flag *gauntlet-fisher-flyer-miss-loses* GAUNTLET_FISHER_FLYER_MISS_LOSES_DEFAULT 0 0)
     (,row "fisher-jump-chance" count *gauntlet-fisher-jump-chance* GAUNTLET_FISHER_JUMP_CHANCE_DEFAULT 0.0 100.0)
     (,row "fisher-flyer-height" meters *gauntlet-fisher-flyer-height* GAUNTLET_FISHER_FLYER_HEIGHT_DEFAULT 1.0 8.0)))

;; ---- the settings file

(define *gauntlet-settings-revision* 0) ;; the revision in effect: 0 until a file has been applied
(define *gauntlet-settings-countdown* 0)
(define *gauntlet-settings-applied* 0) ;; keys the file being applied has set so far
(define *gauntlet-settings-bad-revision-told* #f) ;; a file with no revision is told about once, not every poll
(define *gauntlet-setting-key* (new 'global 'string 64 ""))
(define *gauntlet-setting-number* 0.0) ;; what gauntlet-read-number! last read
(define *gauntlet-setting-flag* #f) ;; what gauntlet-read-flag! last read

(defmacro gauntlet-row-reset (name unit global default lo hi)
  "One setting back to its default."
  `(set! ,global ,(if (eq? unit 'seconds) `(the int ,default) default)))

(defmacro gauntlet-row-apply (name unit global default lo hi)
  "If key is this setting, read its value from the file and set the global, or skip the key."
  (if (eq? unit 'flag)
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-flag! file)
         (begin
           (set! ,global *gauntlet-setting-flag*)
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))
    `(when (string= key ,name)
       (set! handled #t)
       (if (gauntlet-read-number! file ,lo ,hi)
         (begin
           (set! ,global
                 ,(cond
                    ((eq? unit 'seconds) '(the int (+ (* *gauntlet-setting-number* 300.0) 0.5)))
                    ((eq? unit 'meters) '(* *gauntlet-setting-number* METER_LENGTH))
                    ((eq? unit 'degrees) '(* *gauntlet-setting-number* (/ DEGREES_PER_ROT 360.0)))
                    ((eq? unit 'ratio) '*gauntlet-setting-number*)
                    (#t '(the int (+ *gauntlet-setting-number* 0.5)))))
           (+! *gauntlet-settings-applied* 1))
         (gauntlet-setting-skip! ,name)))))

(defun gauntlet-settings-reset! ()
  "Every setting back to its default."
  (gauntlet-setting-table gauntlet-row-reset)
  0)

(defun gauntlet-setting-skip! ((name string))
  "A key whose value is not usable: it keeps its default."
  (format 0 "GAUNTLET SETTINGS ~S skipped, its value is not a usable one~%" name)
  0)

(defun gauntlet-number-word? ((word string))
  "True when word is a plain decimal number: digits, one dot, and a minus sign in front. The game's own string->float
   reads anything as a number (garbage as 0.0), so a value is only trusted after this."
  (let ((digits 0)
        (dots 0)
        (clean #t))
    (dotimes (i (length word))
      (let ((c (-> word data i)))
        (cond
          ((and (>= c #\0) (<= c #\9)) (+! digits 1))
          ((= c #\.) (+! dots 1))
          ((and (= c #\-) (zero? i)))
          (else (set! clean #f)))))
    (and clean (> digits 0) (<= dots 1))))

(defun gauntlet-read-word! ((file file-stream))
  "The next word of the file in *pc-temp-string*, which is empty when the file has no more."
  (set! (-> *pc-temp-string* data 0) 0)
  (file-stream-seek-past-whitespace file)
  (file-stream-read-word file)
  *pc-temp-string*)

(defun gauntlet-read-number! ((file file-stream) (lowest float) (highest float))
  "Read the next word as a number in [lowest, highest] into *gauntlet-setting-number*. False when it is not one."
  (let ((word (gauntlet-read-word! file)))
    (when (gauntlet-number-word? word)
      (let ((value (string->float word)))
        (when (and (>= value lowest) (<= value highest))
          (set! *gauntlet-setting-number* value)
          (return #t)))))
  #f)

(defun gauntlet-read-flag! ((file file-stream))
  "Read the next word as #t or #f into *gauntlet-setting-flag*. False when it is neither."
  (let ((word (gauntlet-read-word! file)))
    (cond
      ((string= word "#t") (set! *gauntlet-setting-flag* #t) #t)
      ((string= word "#f") (set! *gauntlet-setting-flag* #f) #t)
      (else #f))))

(defun gauntlet-skip-past-close ((file file-stream))
  "Read on through the closing bracket of the form being read, whatever is left in it, nested forms included."
  (let ((depth 1))
    (while (> depth 0)
      (let ((c (file-stream-getc file)))
        (cond
          ((= c #x28) (+! depth 1))
          ((= c #x29) (+! depth -1))
          ((= c 255) (set! depth 0))))))
  0)

(defun gauntlet-form-open? ((file file-stream))
  "True when the next thing in the file is an opening bracket, which is read."
  (file-stream-seek-past-whitespace file)
  (= #x28 (file-stream-getc file)))

(defun gauntlet-settings-apply-key! ((file file-stream) (key string))
  "Apply the setting key names, reading its value from the file; an unknown key is skipped."
  (let ((handled #f))
    (gauntlet-setting-table gauntlet-row-apply)
    (when (not handled)
      (format 0 "GAUNTLET SETTINGS ~S skipped, it is not a setting this build knows~%" key)))
  0)

(defun gauntlet-settings-read-revision ((file file-stream))
  "The revision the file opens with, or -1 when its first form is not (revision N)."
  (when (gauntlet-form-open? file)
    (gauntlet-read-word! file)
    (when (string= *pc-temp-string* "revision")
      (let ((word (gauntlet-read-word! file)))
        (when (gauntlet-number-word? word)
          (let ((revision (the int (string->float word))))
            (gauntlet-skip-past-close file)
            (return revision))))))
  -1)

(defun gauntlet-settings-poll! ()
  "Every GAUNTLET_SETTINGS_POLL_FRAMES frames, and on the first look of a boot: read Mods/gauntlet-settings.gc if it is
   there, and if its revision is not the one in effect, put every setting back to its default and apply the file's keys over
   them. A file that has gone away takes the settings it had set with it."
  (+! *gauntlet-settings-countdown* -1)
  (when (>= 0 *gauntlet-settings-countdown*)
    (set! *gauntlet-settings-countdown* GAUNTLET_SETTINGS_POLL_FRAMES)
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-settings.gc" *pc-settings-folder*)
    (cond
      ((not (pc-filepath-exists? *pc-temp-string-1*))
       (when (nonzero? *gauntlet-settings-revision*)
         (gauntlet-settings-reset!)
         (format 0 "GAUNTLET SETTINGS file is gone, defaults restored (was revision ~D)~%" *gauntlet-settings-revision*)
         (set! *gauntlet-settings-revision* 0)))
      (else
       (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
         (when (file-stream-valid? file)
           (let ((revision (gauntlet-settings-read-revision file)))
             (cond
               ((< revision 0)
                (when (not *gauntlet-settings-bad-revision-told*)
                  (set! *gauntlet-settings-bad-revision-told* #t)
                  (format 0 "GAUNTLET SETTINGS file does not open with (revision N), ignored~%")))
               ((= revision *gauntlet-settings-revision*))
               (else
                (set! *gauntlet-settings-bad-revision-told* #f)
                (gauntlet-settings-reset!)
                (set! *gauntlet-settings-applied* 0)
                ;; every form after the revision: its key, then the key's own reader takes the value
                (while (gauntlet-form-open? file)
                  (gauntlet-read-word! file)
                  (format (clear *gauntlet-setting-key*) "~S" *pc-temp-string*)
                  (gauntlet-settings-apply-key! file *gauntlet-setting-key*)
                  (gauntlet-skip-past-close file))
                (set! *gauntlet-settings-revision* revision)
                (format 0 "GAUNTLET SETTINGS revision ~D applied, ~D keys~%" revision *gauntlet-settings-applied*))))
           (file-stream-close file))))))
  0)

;; ---- the state file

(define *gauntlet-frame* 0) ;; polls so far, which is what the state file's frame counts
(define *gauntlet-state-countdown* 0)
(define *gauntlet-state-text* (new 'global 'string 8192 "")) ;; the file is built here and written in one go, so a reader catches as little of it half-written as possible; the settings are in it twice (in effect, and their defaults), about sixty of them, so it needs room
(define *gauntlet-json-first* #t) ;; true until the object being written has a member, so the next one needs no comma

(defun gauntlet-json-key ((out string) (name string))
  "Start the next member of the object being written: its comma if it needs one, and its name."
  (format out "~S\"~S\":" (if *gauntlet-json-first* "" ",") name)
  (set! *gauntlet-json-first* #f)
  0)

(defun gauntlet-json-open ((out string))
  (format out "{")
  (set! *gauntlet-json-first* #t)
  0)

(defun gauntlet-json-close ((out string))
  (format out "}")
  (set! *gauntlet-json-first* #f)
  0)

(defun gauntlet-json-fixed ((out string) (value float))
  "Append value with three decimals, rounded. format's own ~F cuts digits off instead of rounding them, which would
   turn a 15.0 that went through rotation units and back into 14.9999."
  (let* ((scaled (the int (if (< value 0.0) (- (* value 1000.0) 0.5) (+ (* value 1000.0) 0.5))))
         (magnitude (if (< scaled 0) (- scaled) scaled))
         (whole (/ magnitude 1000))
         (fraction (- magnitude (* whole 1000)))
         (hundreds (/ fraction 100))
         (tens (/ (- fraction (* hundreds 100)) 10))
         (ones (- fraction (* hundreds 100) (* tens 10))))
    (format out "~S~D.~D~D~D" (if (< scaled 0) "-" "") whole hundreds tens ones))
  0)

(defmacro gauntlet-json-row (name unit source)
  "Write one setting, from source (its global or its default), as the member name in the file's own units."
  (cond
    ((eq? unit 'flag) `(begin (gauntlet-json-key out ,name) (format out "~S" (if ,source "true" "false"))))
    ((eq? unit 'count) `(begin (gauntlet-json-key out ,name) (format out "~D" ,source)))
    ((eq? unit 'ratio) `(begin (gauntlet-json-key out ,name) (gauntlet-json-fixed out ,source)))
    (#t
     `(begin
        (gauntlet-json-key out ,name)
        (gauntlet-json-fixed out
                             ,(cond
                                ((eq? unit 'seconds) `(/ (the float ,source) 300.0))
                                ((eq? unit 'meters) `(/ ,source METER_LENGTH))
                                (#t `(/ ,source (/ DEGREES_PER_ROT 360.0)))))))))

(defmacro gauntlet-row-write-now (name unit global default lo hi)
  `(gauntlet-json-row ,name ,unit ,global))

(defmacro gauntlet-row-write-default (name unit global default lo hi)
  `(gauntlet-json-row ,name ,unit ,default))

(defun gauntlet-json-meters ((out string) (name string) (units float))
  "The member name, a length given in game units, written in meters."
  (gauntlet-json-key out name)
  (gauntlet-json-fixed out (/ units METER_LENGTH))
  0)

(defun gauntlet-bomb-process ()
  "The bomb last dropped, if it is still in the world."
  (let ((proc (handle->process (-> *gauntlet-bomb* bomb))))
    (the-as gauntlet-bomb (if (and proc (type-type? (-> proc type) gauntlet-bomb)) proc))))

(defun gauntlet-bomb-state-name ((bomb gauntlet-bomb))
  "What the state file calls the bomb's state, or #f for one that is only waiting to be cleaned up."
  (let ((state (-> bomb next-state)))
    (if state
      (case (-> state name)
        (('gauntlet-bomb-fall) 'falling)
        (('gauntlet-bomb-countdown) 'countdown)
        (('gauntlet-bomb-explode) 'exploding)
        (else #f))
      #f)))

(defun gauntlet-klaww-state-name ()
  "What the state file calls the fight: waiting for the pelican, falling, landing, fighting, or over."
  (let* ((klaww (gauntlet-klaww-process))
         (state (if klaww (-> klaww next-state))))
    (cond
      (*gauntlet-klaww-defeated* "defeated")
      ((not state) "waiting")
      (else
       (case (-> state name)
         (('gauntlet-klaww-fall) "falling")
         (('gauntlet-klaww-land) "landing")
         (else "fighting"))))))

(defun gauntlet-bomb-remaining ((bomb gauntlet-bomb) (state-name symbol))
  "Seconds the bomb has left on its clock: all of it while it falls, none once it has gone off."
  (cond
    ((= state-name 'falling) (/ (the float (-> bomb countdown)) 300.0))
    ((= state-name 'countdown)
     (/ (the float (max 0 (- (-> bomb countdown) (- (current-time) (-> bomb state-time))))) 300.0))
    (else 0.0)))

(defmacro gauntlet-row-spot-state (index name enabled x y z ax az bx bz)
  `(begin
     (gauntlet-json-key out ,name)
     (cond
       (in-training
        (gauntlet-json-open out)
        (gauntlet-json-key out "armed")
        (format out "~S" (if (-> *gauntlet-drop-world* armed ,index) "true" "false"))
        (gauntlet-json-key out "distance")
        (gauntlet-json-fixed out (/ (gauntlet-drop-reach ,index) METER_LENGTH))
        (gauntlet-json-close out))
       (else (format out "null")))))

(defun gauntlet-state-write-world! ((out string))
  "Level, Jak, the bomb, the drop spots, Klaww and the horde: the members of the state file that are not settings."
  (let ((in-training (and *target* (gauntlet-in-training?))))
    (gauntlet-json-key out "level")
    (format out "\"~A\"" (if *target* (aif (level-get-target-inside *level*) (-> it name) 'none) 'none))
    (gauntlet-json-key out "jak")
    (cond
      (*target*
       (gauntlet-json-open out)
       (gauntlet-json-meters out "x" (-> (target-pos 0) x))
       (gauntlet-json-meters out "y" (-> (target-pos 0) y))
       (gauntlet-json-meters out "z" (-> (target-pos 0) z))
       (gauntlet-json-key out "onGround")
       (format out "~S" (if (logtest? (-> *target* control status) (cshape-moving-flags onground onsurf)) "true" "false"))
       (gauntlet-json-close out))
      (else (format out "null")))
    ;; what the eco is doing to Jak now: the multiplier on every effect, and the health it comes from
    (gauntlet-json-key out "desperation")
    (gauntlet-json-open out)
    (gauntlet-json-key out "value")
    (gauntlet-json-fixed out (gauntlet-desperation))
    (gauntlet-json-key out "health")
    (if *target* (gauntlet-json-fixed out (-> *target* fact health)) (format out "null"))
    (gauntlet-json-key out "healthMax")
    (if *target* (gauntlet-json-fixed out (-> *target* fact health-max)) (format out "null"))
    (gauntlet-json-close out)
    ;; whether the muse is with Jak: "carried" or "loose" while Misty is up, null anywhere else (and with the setting off)
    (gauntlet-json-key out "muse")
    (cond
      ((and *gauntlet-misty-muse-enabled* (gauntlet-misty-active?))
       (format out "\"~A\"" (if *gauntlet-muse-carried* "carried" "loose")))
      (else (format out "null")))
    (gauntlet-json-key out "bomb")
    (let* ((bomb (gauntlet-bomb-process))
           (state-name (if bomb (gauntlet-bomb-state-name bomb) #f)))
      (cond
        (state-name
         (gauntlet-json-open out)
         (gauntlet-json-key out "state")
         (format out "\"~A\"" state-name)
         (gauntlet-json-meters out "x" (-> bomb root trans x))
         (gauntlet-json-meters out "y" (-> bomb root trans y))
         (gauntlet-json-meters out "z" (-> bomb root trans z))
         (gauntlet-json-key out "remaining")
         (gauntlet-json-fixed out (gauntlet-bomb-remaining bomb state-name))
         (gauntlet-json-key out "jakDistance")
         (if *target*
           (gauntlet-json-fixed out (/ (vector-vector-distance (-> bomb root trans) (target-pos 0)) METER_LENGTH))
           (format out "null"))
         (gauntlet-json-close out))
        (else (format out "null"))))
    ;; one member per drop spot of the table, named for it ("bridge", "vent"): armed and how far Jak is, null off Geyser Rock
    (gauntlet-drop-spot-table begin gauntlet-row-spot-state)
    (gauntlet-json-key out "klaww")
    (cond
      ((and *target* (or (gauntlet-in-level? 'beach) *gauntlet-klaww-home*))
       (gauntlet-json-open out)
       (gauntlet-json-key out "state")
       (format out "\"~A\"" (gauntlet-klaww-state-name))
       (gauntlet-json-key out "hits")
       (format out "~D" (gauntlet-klaww-hit-count))
       (gauntlet-json-key out "max")
       (format out "~D" GAUNTLET_KLAWW_MAX_HITS)
       (gauntlet-json-key out "alive")
       (format out "~S" (if (gauntlet-klaww-alive?) "true" "false"))
       (gauntlet-json-key out "buttonsPressed")
       (format out "~D" (gauntlet-klaww-hit-count))
       (gauntlet-json-key out "buttons")
       (format out "~D" GAUNTLET_KLAWW_BUTTONS)
       ;; his rage now, and how often that makes him throw, in seconds
       (gauntlet-json-key out "rage")
       (gauntlet-json-fixed out (gauntlet-klaww-rage))
       (gauntlet-json-key out "throwEvery")
       (gauntlet-json-fixed out (/ (the float (gauntlet-klaww-throw-gap)) (the float (seconds 1))))
       ;; how wide a boulder thrown now would blast, in meters: the console's radius widened by his fury
       (gauntlet-json-meters out "radius" (gauntlet-klaww-boulder-radius))
       (gauntlet-json-close out))
      (else (format out "null")))
    ;; always there, on every level: the census is taken now, so the numbers are this frame's
    (gauntlet-json-key out "horde")
    (gauntlet-horde-recount!)
    (gauntlet-json-open out)
    (gauntlet-json-key out "groups")
    (format out "~D" *gauntlet-horde-groups*)
    (gauntlet-json-key out "clones")
    (format out "~D" *gauntlet-horde-clones*)
    (gauntlet-json-key out "max")
    (format out "~D" *gauntlet-horde-max-clones*)
    (gauntlet-json-key out "multiplier")
    (format out "~D" *gauntlet-lurker-multiplier*)
    (gauntlet-json-close out)
    (gauntlet-json-key out "effects")
    (gauntlet-json-open out)
    (gauntlet-json-key out "enabled")
    (format out "~S" (if (-> *pc-settings* twitch-effects?) "true" "false"))
    (gauntlet-json-close out))
  0)

(defun gauntlet-state-write! ()
  "Write Mods/gauntlet-state.json."
  (let ((out (clear *gauntlet-state-text*)))
    (gauntlet-json-open out)
    (gauntlet-json-key out "frame")
    (format out "~D" *gauntlet-frame*)
    (gauntlet-json-key out "revision")
    (format out "~D" *gauntlet-settings-revision*)
    (gauntlet-json-key out "settings")
    (gauntlet-json-open out)
    (gauntlet-setting-table gauntlet-row-write-now)
    (gauntlet-json-close out)
    (gauntlet-json-key out "defaults")
    (gauntlet-json-open out)
    (gauntlet-setting-table gauntlet-row-write-default)
    (gauntlet-json-close out)
    (gauntlet-state-write-world! out)
    (gauntlet-json-close out)
    (format out "~%")
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-state.json" *pc-settings-folder*)
    (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'write)))
      (when (file-stream-valid? file)
        (file-stream-write file (-> out data) (the-as uint (length out)))
        (file-stream-close file))))
  0)

(defun gauntlet-state-poll! ()
  "Every GAUNTLET_STATE_POLL_FRAMES frames, publish the state."
  (+! *gauntlet-state-countdown* -1)
  (when (>= 0 *gauntlet-state-countdown*)
    (set! *gauntlet-state-countdown* GAUNTLET_STATE_POLL_FRAMES)
    (gauntlet-state-write!))
  0)

;; ------------------------------------------------------------------ the poll --

(define *gauntlet-drop-countdown* 0)
(define *gauntlet-drop-seen* (new 'global 'string 64 ""))
;; The request file outlives the game, so the first look of a fresh boot only
;; records where its counter is, as the snapshot poll does: a request made
;; before the game started must not go off the moment it does. A boot that
;; finds no file counts as the first look too, so the first request ever
;; made, which creates the file, is not swallowed.
(define *gauntlet-drop-primed* #f)

(defun gauntlet-drop! ((kind string))
  "Drop what kind names at Jak's spot."
  (cond
    ((not *target*) (format 0 "GAUNTLET DROP: ~S asked for with no Jak in the world~%" kind))
    ((string= kind "bomb") (gauntlet-bomb-drop! (target-pos 0)))
    ;; the console's bomb on a drop spot (rows 0 and 1 of gauntlet-drop-spot-table): the spot itself, whatever the trigger radius or the arming say
    ((string= kind "bomb-bridge") (gauntlet-drop-on-spot! 0 kind))
    ((string= kind "bomb-vent") (gauntlet-drop-on-spot! 1 kind))
    ;; the herd, aimed at Jak's spot from where he faces
    ((string= kind "stampede") (gauntlet-stampede-ahead!))
    ;; Klaww falls: onto the pelican's nest on the beach, ahead of Jak anywhere else
    ((string= kind "klaww") (gauntlet-klaww-drop!))
    (else (format 0 "GAUNTLET DROP: do not know how to drop ~S~%" kind)))
  0)

(defun gauntlet-drop-poll! ()
  "Per-frame hook: the console's settings are looked at first, so what they say holds for this frame; Jak's health, for the desperation; the drop spots, the
   Sandover spot, the beach and the TNT barrels are watched every frame; every GAUNTLET_DROP_POLL_FRAMES frames look at the request counter, and drop once when it has changed since
   the last look; last, the state file, which then describes this frame."
  (+! *gauntlet-frame* 1)
  (gauntlet-settings-poll!)
  (gauntlet-desperation-poll!)
  (gauntlet-muse-poll!)
  (gauntlet-drop-spots-poll!)
  (gauntlet-stampede-poll!)
  (gauntlet-klaww-poll!)
  (gauntlet-tnt-poll!)
  (+! *gauntlet-drop-countdown* -1)
  (when (>= 0 *gauntlet-drop-countdown*)
    (set! *gauntlet-drop-countdown* GAUNTLET_DROP_POLL_FRAMES)
    (format (clear *pc-temp-string-1*) "~S/Mods/gauntlet-drop-request.txt" *pc-settings-folder*)
    (when (pc-filepath-exists? *pc-temp-string-1*)
      (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
        (when (file-stream-valid? file)
          (file-stream-seek-past-whitespace file)
          (file-stream-read-word file)
          ;; the first word is the counter: an unchanged one means nothing new
          (when (not (string= *pc-temp-string* *gauntlet-drop-seen*))
            ;; counters count up by one a request, so a jump of more than one is requests made within one look: only the
            ;; last is in the file to be read, and the rest would go unremarked
            (when (and *gauntlet-drop-primed* (gauntlet-number-word? *pc-temp-string*) (gauntlet-number-word? *gauntlet-drop-seen*))
              (let ((skipped (+ (the int (- (string->float *pc-temp-string*) (string->float *gauntlet-drop-seen*))) -1)))
                (if (< 0 skipped)
                  (format 0 "GAUNTLET DROP: ~D earlier requests arrived within one look and are not dropped, only the last one is~%" skipped))))
            (format (clear *gauntlet-drop-seen*) "~S" *pc-temp-string*)
            (when *gauntlet-drop-primed*
              ;; the second word names what to drop
              (file-stream-seek-past-whitespace file)
              (file-stream-read-word file)
              (gauntlet-drop! *pc-temp-string*)))
          (file-stream-close file))))
    (set! *gauntlet-drop-primed* #t))
  (gauntlet-state-poll!)
  (none))
