;;-*-Lisp-*-
(in-package goal)

;; Declarations for the twitch module. main.gc calls the per-frame poll and
;; compiles long before pc/features/twitch.gc, so the poll needs declaring here
;; the way ap-struct-h does for archipelago.

(define-extern twitch-poll! (function none))
(define-extern twitch-log-push! (function string none))
(define-extern twitch-banner! (function symbol int none))
(define-extern twitch-warp! (function none))
(define-extern *twitch-warp-target* string)
;; the rolling log itself: the archipelago state file mirrors it into the
;; overlay panel, so it is read across files as well as written here
(define-extern *twitch-log* (array string))

;; when the run actually began, for the overlay's timer
(define-extern *run-started* symbol)
(define-extern *run-ended* symbol)
(define-extern run-start-poll! (function none))

;; jump lab
(define-extern jump-probe-poll! (function none))
(define-extern *jump-last* float)
(define-extern *jump-apex* float)
