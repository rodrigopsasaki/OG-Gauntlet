
;;-*-Lisp-*-
(in-package goal)

;; Stream plumbing: chat effects, the on-screen log, and the publishers the
;; overlay panels read, including run splits.
;;
;; This lived inside ap-struct.gc, which meant it only existed in the
;; archipelago build: the randomizer build had no chat, no input panel and no
;; state file, so the overlay sat empty against it. None of it was ever
;; archipelago-specific -- the extracted code referenced no seed, no ledger and
;; no check table -- it was simply written in the wrong place. It is global now,
;; and the mods add only what they actually add.
;;
;; The file paths keep their archipelago- names so the existing streamkit server
;; keeps working untouched; renaming them is a two-sided change for no gain.

(define *twitch-log* (new 'global 'boxed-array string 4))
(dotimes (i 4)
  (set! (-> *twitch-log* i) (new 'global 'string 64 "")))
;; log placement, in the 2D text space draw-build-revision uses. Tune here.
;; Calibrated from an on-screen ruler: this 2D text space runs y 0 (top) to about
;; 222 (bottom) and x 0 to about 512. The old 352 was well below the screen, which
;; is why the log was never visible at all.
(defconstant TWITCH_LOG_X 16.0)
(defconstant TWITCH_LOG_Y 190.0)
(defconstant TWITCH_LOG_LINE 9.0)
;; Font size is fixed on this path, and that is fine: measured against a real
;; ArchipelaGOAL capture, its in-game log uses this same jak1 font at ~18px/char
;; against our ~20. Tried and rejected: draw-string-xy-scaled (draws nothing),
;; the pc-hack flag (shifts x, does not resize), and font-context's scale field
;; (draw-string ignores it).
(define *twitch-log-time* (the-as time-frame 0))

(define *twitch-scratch* (new 'global 'string 128 ""))

(defun twitch-log-push! ((text string))
  "shift the rolling log and put text on top, then hand it to the overlay"
  (format (clear (-> *twitch-log* 3)) "~S" (-> *twitch-log* 2))
  (format (clear (-> *twitch-log* 2)) "~S" (-> *twitch-log* 1))
  (format (clear (-> *twitch-log* 1)) "~S" (-> *twitch-log* 0))
  (format (clear (-> *twitch-log* 0)) "~S" text)
  (set! *twitch-log-time* (current-time))
  ;; arm the overlay here rather than only at seed load, so effects are visible
  ;; in a no-seed run too
  (pc-ap-log-active 1)
  (dotimes (i 3)
    (pc-ap-log-set i (-> *twitch-log* i)))
  (none))

(defun twitch-banner! ((name symbol) (amount int))
  ;; ~A on a symbol is right; ~S is what you need for string-to-string, because
  ;; ~A prints a GOAL string *with its quotes*.
  (if (> amount 0)
    (format (clear *twitch-scratch*) "FOUND ~D ~A" amount name)
    (format (clear *twitch-scratch*) "FOUND ~A" name))
  (twitch-log-push! *twitch-scratch*)
  (none))

(defun twitch-draw-banner ()
  "kept as main.gc's hook, but the log is drawn by the imgui overlay now"
  (none))


(define *twitch-warp-points*
  (new 'static 'boxed-array :type string
    "village1-warp" "beach-start" "jungle-start" "misty-start"
    "firecanyon-start" "village2-warp" "swamp-start" "sunken-start"
    "rolling-start" "ogre-start" "village3-warp" "snow-start"
    "maincave-start" "lavatube-start" "citadel-start"))

(define *twitch-warp-target* (new 'global 'string 64 ""))

(defun twitch-warp! ()
  "Drop Jak at a random checkpoint.

   The two steps are the level-select menu's own, but WHERE they run matters:
   initialize! tears levels down and streams new ones in, and the command poll
   runs inside main.gc's per-frame hook. Doing it from there crashed the game
   mid-stream. The menu performs it from a process, so this does too, on the same
   pattern ap-auto-save! already uses. The suspend lets the current frame finish
   before anything is torn down."
  ;; empty target means the caller asked for a random one
  (when (string= *twitch-warp-target* "")
    (format (clear *twitch-warp-target*) "~S"
            (-> *twitch-warp-points* (rand-vu-int-count (-> *twitch-warp-points* length)))))
  (process-spawn-function process
    (lambda :behavior process ()
      (suspend)
      (let ((dest (get-continue-by-name *game-info* *twitch-warp-target*)))
        ;; an unknown name would null the continue and strand the reload
        (when dest
          (set! (-> *game-info* current-continue) dest)
          (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f))))))
  (none))

(define *twitch-cmd-countdown* 0)
(define *twitch-pad-countdown* 0)
;; last pad state actually written, so an unchanging pad costs nothing
(define *twitch-pad-last-b* 0)
(define *twitch-pad-last-axes* 0)

(defun twitch-write-pad! ()
  "Publish the pad THE GAME received, for the input panel.
   A browser is only handed gamepad data while its page has focus, so a panel
   that reads the controller itself goes dead exactly when you are playing and
   the game holds focus. Reading it from here is both focus-proof and more
   honest: the panel shows what the game acted on, not a second opinion about
   the hardware."
  (let ((pad (-> *cpad-list* cpads 0)))
    (format (clear *pc-temp-string-1*) "~S/Mods/archipelago-pad.js" *pc-settings-folder*)
    (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'write)))
      (when (file-stream-valid? file)
        ;; two writes, not one: a GOAL call takes at most eight parameters
        (format file
                "window.AP_PAD={\"on\":~D,\"b\":~D,\"lx\":~D,\"ly\":~D,"
                (if (zero? (-> pad valid)) 1 0)
                (the-as int (-> pad button0-abs 0))
                (-> pad leftx) (-> pad lefty))
        (format file
                "\"rx\":~D,\"ry\":~D,\"l2\":~D,\"r2\":~D}~%"
                (-> pad rightx) (-> pad righty)
                (-> pad abutton (abutton-idx l2))
                (-> pad abutton (abutton-idx r2)))
        (file-stream-close file))))
  (none))

;; A spooled voice line is read out of VAGWAD.<LANG>, so which take you hear is
;; decided by the game's audio language, not by the cue name. !despair wants the
;; japanese warrior cry whether or not the run itself is in japanese, so `say`
;; takes an optional language, flips to it for the length of the clip, and puts
;; the player's own language back. The countdown is frames.
(define *twitch-lang-restore* 0)
(define *twitch-lang-saved* (language-enum english))

(defun twitch-language-for ((name string))
  "Language named by a command word, or -1 when it names no language."
  (cond
    ((or (string= name "jap") (string= name "japanese")) (language-enum japanese))
    ((or (string= name "eng") (string= name "english"))  (language-enum english))
    ((string= name "french")   (language-enum french))
    ((string= name "german")   (language-enum german))
    ((string= name "spanish")  (language-enum spanish))
    ((string= name "italian")  (language-enum italian))
    (else (the language-enum -1))))

(defun twitch-announce ((file file-stream) (what string))
  "the command file is \"<verb> <who>\"; credit the viewer by name"
  (file-stream-seek-past-whitespace file)
  (file-stream-read-word file)
  (format (clear *twitch-scratch*) "~S ~S" *pc-temp-string* what)
  (twitch-log-push! *twitch-scratch*)
  (none))


;; ---------------------------------------------------------------- settings --

;; Both default on, which is what a stream wants; the menu turns them off for a
;; run where chat should watch rather than participate.
;; The menu writes these, and pckernel persists them, so a choice survives a
;; restart. Read through accessors rather than copied into globals: a copy is a
;; second source of truth that goes stale the moment the menu writes one.

(define *twitch-chat-countdown* 0)
(define *twitch-chat-seen* (new 'global 'string 64 ""))
;; The chat file outlives the game, so the first poll of a fresh boot would find
;; whatever was said before you launched and draw it as new. The first read
;; therefore only records where the counter is: chat starts when the game does.
(define *twitch-chat-primed* #f)

(defun twitch-poll-chat! ()
  "Pull the newest chat line and put it in the same log the effects announce
   through. The log is already an on-screen overlay, so seeing chat in game
   costs a file read rather than a renderer.

   The server writes one line per message and we only ever look at the newest,
   so a burst shows the last of it rather than replaying a backlog into a
   four-line window."
  (+! *twitch-chat-countdown* -1)
  (when (>= 0 *twitch-chat-countdown*)
    (set! *twitch-chat-countdown* 30)
    (format (clear *pc-temp-string-1*) "~S/Mods/twitch-chat.txt" *pc-settings-folder*)
    (when (pc-filepath-exists? *pc-temp-string-1*)
      (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
        (when (file-stream-valid? file)
          (file-stream-seek-past-whitespace file)
          (file-stream-read-word file)
          ;; the first word is a counter the server bumps per message, so an
          ;; unchanged one means nothing new rather than requiring us to diff text
          (when (not (string= *pc-temp-string* *twitch-chat-seen*))
            (format (clear *twitch-chat-seen*) "~S" *pc-temp-string*)
            ;; the rest of the line, word by word. file-stream-read-word is the
            ;; only reader here and it stops at whitespace, so a sentence has to
            ;; be reassembled; the cap is what stops a malformed file spinning.
            (clear *twitch-scratch*)
            (dotimes (w 12)
              (file-stream-seek-past-whitespace file)
              (file-stream-read-word file)
              (when (nonzero? (length *pc-temp-string*))
                (if (zero? (length *twitch-scratch*))
                  (format *twitch-scratch* "~S" *pc-temp-string*)
                  (format *twitch-scratch* " ~S" *pc-temp-string*))))
            ;; The first read of a boot only records where the counter is. The
            ;; chat file outlives the game, so without this the first poll finds
            ;; whatever was said before launch and draws it as new.
            (if (not *twitch-chat-primed*)
              (set! *twitch-chat-primed* #t)
              (when (nonzero? (length *twitch-scratch*))
                (twitch-log-push! *twitch-scratch*))))
          (file-stream-close file)))))
  (none))

;; -------------------------------------------------------------------- poll --

(defun twitch-poll! ()
  "Per-frame hook: publish the pad, drain one chat effect, show one chat line.

   Effects are deliberately additive or self-terminating, and nothing here may
   touch a mod's own state. Chat can shove you; it can never strand a run."
  ;; Every third frame, ~50Hz at the 150fps target. This was cut to 12 frames on
  ;; the theory that the file write was making the GAME choppy; it was not --
  ;; only the panel ever was, and cutting the publisher is what made it so. The
  ;; write has run at this rate since it was written with no effect on the game.
  ;; An unchanged pad is still skipped, so menus and cutscenes cost nothing.
  (+! *twitch-pad-countdown* -1)
  (when (>= 0 *twitch-pad-countdown*)
    ;; Publish at roughly 60Hz whatever the game is running at. A fixed frame
    ;; interval is a different publish rate at every fps -- three frames is 50Hz
    ;; at 150 but only 20Hz at 60, which is where the panel actually lives, and
    ;; that is why it never felt like realtime.
    (set! *twitch-pad-countdown*
          (max 1 (/ (the int (-> *pc-settings* target-fps)) 60)))
    (let* ((pad (-> *cpad-list* cpads 0))
           (b (the-as int (-> pad button0-abs 0)))
           (axes (+ (* (the int (-> pad leftx)) 16777216)
                    (* (the int (-> pad lefty)) 65536)
                    (* (the int (-> pad rightx)) 256)
                    (the int (-> pad righty)))))
      (when (or (!= b *twitch-pad-last-b*) (!= axes *twitch-pad-last-axes*))
        (set! *twitch-pad-last-b* b)
        (set! *twitch-pad-last-axes* axes)
        (twitch-write-pad!))))
  ;; put the player's language back once a borrowed line has had time to play
  (when (nonzero? *twitch-lang-restore*)
    (+! *twitch-lang-restore* -1)
    (when (zero? *twitch-lang-restore*)
      (set-language *twitch-lang-saved*)))
  ;; the whole of chat's reach into the game hangs on this one flag
  (when (-> *pc-settings* twitch-effects?)
    (+! *twitch-cmd-countdown* -1)
    (when (>= 0 *twitch-cmd-countdown*)
      (set! *twitch-cmd-countdown* 20)
      (format (clear *pc-temp-string-1*) "~S/Mods/archipelago-command.gc" *pc-settings-folder*)
      (when (pc-filepath-exists? *pc-temp-string-1*)
        (let ((file (new 'stack 'file-stream *pc-temp-string-1* 'read)))
          (when (file-stream-valid? file)
            (file-stream-seek-past-whitespace file)
            (file-stream-read-word file)
            (case-str *pc-temp-string*
              (("trip")
               (twitch-announce file "TRIPPED YOU")
               (when *target* (send-event *target* 'ap-trip)))
              (("freeze")
               (twitch-announce file "FROZE YOU")
               (when *target* (send-event *target* 'ap-freeze)))
              (("say")
               ;; play a spooled voice line by name. The cue comes from the
               ;; command file rather than being baked in, so which line !despair
               ;; uses is a server-side edit, not a rebuild. 'camera kills any
               ;; hint already playing so this always lands.
               (twitch-announce file "CUED A LINE")
               (file-stream-seek-past-whitespace file)
               (file-stream-read-word file)
               (format (clear *twitch-scratch*) "~S" *pc-temp-string*)
               ;; optional fourth word: the language this one line plays in
               (file-stream-seek-past-whitespace file)
               (file-stream-read-word file)
               (let ((lang (twitch-language-for *pc-temp-string*)))
                 (when (>= (the int lang) 0)
                   (when (zero? *twitch-lang-restore*)
                     (set! *twitch-lang-saved* (-> *setting-control* current language)))
                   (set-language lang)
                   (set! *twitch-lang-restore* 360)))
               (ambient-hint-spawn *twitch-scratch* (the-as vector #f) *entity-pool* 'camera))
              (("warp")
               (twitch-announce file "WARPED YOU")
               ;; third word is the destination continue point, or "random"
               (file-stream-seek-past-whitespace file)
               (file-stream-read-word file)
               (if (string= *pc-temp-string* "random")
                 (clear *twitch-warp-target*)
                 (format (clear *twitch-warp-target*) "~S" *pc-temp-string*))
               (twitch-warp!))
              (else #f))
            (file-stream-close file)))
        ;; truncate so the command fires once
        (let ((out (new 'stack 'file-stream *pc-temp-string-1* 'write)))
          (if (file-stream-valid? out) (file-stream-close out))))))
  (when (-> *pc-settings* twitch-show-chat?) (twitch-poll-chat!))
  (run-start-poll!)
  (jump-probe-poll!)
  (none))

;; ---------------------------------------------------------- run start ------

;; When a run really begins. Speedrunner mode already computes this, but only
;; while it is enabled, and enabling it forces 60fps -- a trade worth refusing
;; if you are timing yourself for fun rather than submitting. So the same
;; condition is evaluated here, ungated and costing nothing: out of the blackout,
;; not fading, and Jak has touched ground. That is the moment a real timer
;; starts, rather than the moment the title screen goes away.
(define *run-started* #f)
;; The run ends on the light eco, which is finalboss-movies closing at
;; need-introduction. That is the community autosplitter's own finish condition
;; (its "Collect Light Eco (finish run)" option reads exactly this flag), so the
;; overlay stops where a real timer stops rather than at some cell count that
;; only makes sense for one category.
(define *run-ended* #f)
;; consecutive frames with no Jak: a death is a handful, the title is forever
(define *run-away-frames* 0)

(defun run-start-poll! ()
  (when (and (not *run-started*) *target*
             (>= (-> *display* base-frame-counter) (-> *game-info* blackout-time))
             (!= (-> *setting-control* current bg-a-force) 1.0)
             (or (logtest? (-> *target* control status)
                           (cshape-moving-flags onground onsurf on-water))
                 (= (-> *target* next-state name) 'target-hit-ground)))
    (set! *run-started* #t))
  (set! *run-ended*
        (and *run-started*
             (task-closed? (game-task finalboss-movies) (task-status need-introduction))))
  ;; Only leaving the game ends a run. *target* is briefly absent on every death
  ;; and every load, so clearing on a single frame of it made every death look
  ;; like quitting: the splits reset under you mid-run. A death is brief and the
  ;; title screen is not, so the difference is duration, not state.
  (if *target*
    (set! *run-away-frames* 0)
    (+! *run-away-frames* 1))
  (when (and *run-started* (> *run-away-frames* 300))
    (set! *run-started* #f)
    (set! *run-ended* #f))
  (none))

;; ------------------------------------------------------------- jump probe --

;; Peak height of the last jump, measured in-game at full frame rate. Sampling
;; this over the wire would fold the publish rate into the answer, which is the
;; one thing the measurement is trying to isolate.
;;
;; Height is taken along the gravity normal, from wherever Jak last stood, so it
;; reads the same on a slope as on flat ground.
(define *jump-from* 0.0)      ;; height on the ground he left
(define *jump-apex* 0.0)      ;; best height above it this airborne stretch
(define *jump-last* 0.0)      ;; the apex of the jump that just ended
(define *jump-airborne* #f)
;; A counter, not just a value: two identical jumps in a row are two jumps, and
;; a reader watching the number change would see one. That flaw made the first
;; lab session mix filler jumps into both sets.
(define *jump-count* 0)
(define *jump-air-start* (the-as time-frame 0))
(define *jump-rise-start* (the-as time-frame 0))
(define *jump-airtime* 0.0)   ;; ground to ground, seconds
(define *jump-hang* 0.0)      ;; time spent within 10cm of the apex, seconds

(defun jump-probe-poll! ()
  (when *target*
    (let* ((g (-> *target* control dynam gravity-normal))
           (h (vector-dot g (-> *target* control trans)))
           (on-ground (logtest? (-> *target* control status)
                                (cshape-moving-flags onground onsurf))))
      (cond
        (on-ground
         ;; landing closes the measurement; the values survive for the probe
         (when *jump-airborne*
           (set! *jump-last* *jump-apex*)
           (set! *jump-airtime*
                 (* 0.0033333334 (the float (- (current-time) *jump-air-start*))))
           (set! *jump-hang*
                 (* 0.0033333334 (the float (- (current-time) *jump-rise-start*))))
           (+! *jump-count* 1)
           (set! *jump-airborne* #f))
         (set! *jump-from* h)
         (set! *jump-apex* 0.0))
        (else
         (when (not *jump-airborne*)
           (set! *jump-airborne* #t)
           (set! *jump-air-start* (current-time))
           (set! *jump-rise-start* (current-time)))
         (let ((rise (- h *jump-from*)))
           (when (> rise *jump-apex*)
             (set! *jump-apex* rise)
             ;; still climbing, so the hang has not begun
             (set! *jump-rise-start* (current-time))))))))
  (none))
